import { Slider } from "std-widgets.slint";
import { HveColors } from "./theme.slint";

// ─── Preset Card ────────────────────────────────────────────────────
export component PresetCard inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <string> tag;
    in property <color> accent;
    in property <bool> active: false;
    callback toggled(bool);

    height: (active || ta.has-hover || fs.has-focus) ? 120px : 68px;
    border-radius: 10px;
    clip: true;
    background: active ? HveColors.bg-hover : ((ta.has-hover || fs.has-focus) ? HveColors.bg-hover : HveColors.bg-card);
    border-width: active ? 2px : 1px;
    border-color: active ? accent : ((ta.has-hover || fs.has-focus) ? accent.transparentize(0.6) : HveColors.border);

    // Glow sutil al estar activo
    drop-shadow-blur: active ? 12px : 0px;
    drop-shadow-color: active ? accent.transparentize(0.8) : transparent;

    animate background { duration: 200ms; easing: ease-in-out; }
    animate border-color { duration: 200ms; easing: ease-in-out; }
    animate drop-shadow-blur { duration: 300ms; easing: ease-out; }
    animate height { duration: 250ms; easing: ease-in-out-back; }

    // ── Contenido visual (declarado primero, queda detrás) ──
    HorizontalLayout {
        padding: 14px;
        spacing: 16px;

        // Left: icon + text
        Rectangle {
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 16px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 8px;
                    background: active ? accent.transparentize(0.85) : HveColors.bg-surface;
                    animate background { duration: 200ms; }

                    Text {
                        text: root.active ? "●" : "○";
                        color: accent;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    vertical-stretch: 1;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: root.title;
                            color: active ? HveColors.text : ((ta.has-hover || fs.has-focus) ? HveColors.text : HveColors.text-muted);
                            font-size: 14px;
                            font-weight: active ? 700 : 500;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            animate color { duration: 200ms; }
                        }

                        Rectangle {
                            height: 20px;
                            width: tag-text.preferred-width + 16px;
                            border-radius: 10px;
                            background: active ? accent.transparentize(0.8) : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: active ? accent.transparentize(0.5) : transparent;
                            animate background { duration: 200ms; }
                            animate border-color { duration: 200ms; }

                            tag-text := Text {
                                text: root.tag;
                                color: active ? accent : HveColors.text-muted;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: root.desc;
                        color: HveColors.text-muted;
                        font-size: 12px;
                        overflow: elide;
                        wrap: (active || ta.has-hover || fs.has-focus) ? word-wrap : no-wrap;
                    }
                }
            }
        }

        // Right: toggle switch
        Rectangle {
            width: 44px;
            height: 24px;
            border-radius: 12px;
            background: active ? accent : HveColors.border;
            animate background { duration: 250ms; easing: ease-in-out; }

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: HveColors.bg-dark;
                x: active ? parent.width - self.width - 3px : 3px;
                y: 3px;
                animate x { duration: 350ms; easing: ease-in-out-back; }
            }
        }
    }

    // ── FocusScope (workaround: focus-on-click: false) ──
    fs := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.toggled(!root.active);
                accept
            } else {
                reject
            }
        }
    }

    // ── TouchArea (encima de todo) ──
    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggled(!root.active); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                fs.focus();
            }
        }
    }
}

// ─── Nav Button ─────────────────────────────────────────────────────
export component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> icon-text;
    in property <color> accent;
    in property <bool> selected: false;
    callback clicked;

    height: 48px;
    border-radius: 8px;
    background: selected ? HveColors.bg-hover : ((nb-ta.has-hover || nb-fs.has-focus) ? HveColors.bg-hover.transparentize(0.5) : transparent);
    animate background { duration: 200ms; }

    // ── Indicador lateral + contenido (detrás) ──
    Rectangle {
        width: 4px;
        height: selected ? parent.height * 0.6 : 0px;
        x: 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: accent;
        animate height { duration: 250ms; easing: ease-in-out-back; }
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 16px;
        spacing: 14px;

        Text {
            text: root.icon-text;
            color: selected ? accent : (nb-fs.has-focus ? accent : HveColors.text-muted);
            font-size: 18px;
            vertical-alignment: center;
            animate color { duration: 200ms; }
        }

        Text {
            text: root.label;
            color: selected ? HveColors.text : ((nb-ta.has-hover || nb-fs.has-focus) ? HveColors.text : HveColors.text-muted);
            font-size: 14px;
            font-weight: selected ? 800 : (nb-fs.has-focus ? 700 : 500);
            vertical-alignment: center;
            animate color { duration: 200ms; }
        }
    }

    // ── FocusScope (workaround: focus-on-click: false) ──
    nb-fs := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    // ── TouchArea (encima de todo) ──
    nb-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                nb-fs.focus();
            }
        }
    }
}

// ─── Section Header ─────────────────────────────────────────────────
export component SectionHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <color> accent;

    spacing: 4px;

    Text {
        text: root.title;
        color: root.accent;
        font-size: 18px;
        font-weight: 700;
    }

    Text {
        text: root.subtitle;
        color: HveColors.text-muted;
        font-size: 11px;
    }
}

// ─── Geometry Slider ────────────────────────────────────────────────
export component GeometrySlider inherits Rectangle {
    in property <int> value: 2;
    in property <int> min: 1;
    in property <int> max: 5;
    in property <string> label: "Border Thickness";
    callback changed(int);

    height: 80px;
    border-radius: 8px;
    background: HveColors.bg-card;
    border-width: 1px;
    border-color: HveColors.border;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            Text {
                text: root.label;
                color: HveColors.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.value + "px";
                color: HveColors.accent-cyan;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Slider {
            minimum: root.min;
            maximum: root.max;
            value: root.value;
            changed(v) => { root.changed(v); }
        }
    }
}

// ─── Welcome Card ───────────────────────────────────────────────────
export component WelcomeCard inherits Rectangle {
    in property <string> card-title;
    in property <string> icon-text;
    in property <color> accent;
    in property <string> description;

    border-radius: 12px;
    background: HveColors.bg-card;
    border-width: 1px;
    border-color: HveColors.border;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;

            Text {
                text: root.icon-text;
                color: root.accent;
                font-size: 18px;
                vertical-alignment: center;
            }

            Text {
                text: root.card-title;
                color: HveColors.text;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: HveColors.border;
        }

        Text {
            text: root.description;
            color: HveColors.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// ─── Close Button ───────────────────────────────────────────────────
export component CloseButton inherits Rectangle {
    in property <bool> countdown-active: false;
    in property <int> countdown-seconds: 5;
    in property <float> countdown-progress: 1.0;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: cb-ta.has-hover ? HveColors.accent-red.transparentize(0.8) : transparent;
    border-width: 1.5px;
    border-color: countdown-active ? HveColors.accent-red : (cb-ta.has-hover ? HveColors.accent-red.transparentize(0.5) : HveColors.text-muted.transparentize(0.3));
    clip: true;

    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }
    animate border-radius { duration: 300ms; easing: ease-in-out; }
    animate width { duration: 300ms; easing: ease-in-out; }
    animate height { duration: 300ms; easing: ease-in-out; }

    // Expand slightly during countdown for visibility
    states [
        countdown when root.countdown-active : {
            width: 28px;
            height: 28px;
            border-radius: 14px;
        }
    ]

    // ── Icono X (normal) ──
    if !countdown-active: Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        Path {
            width: 100%;
            height: 100%;
            stroke: cb-ta.has-hover ? HveColors.accent-red : HveColors.text-muted;
            stroke-width: 1.5px;
            fill: transparent;
            animate stroke { duration: 200ms; }
            commands: "M 0 0 L 10 10 M 0 10 L 10 0";
        }
    }

    // ── Countdown (circular progress + número) ──
    if countdown-active: Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;

        // Background circle
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 14px;
            background: HveColors.bg-surface;
            border-width: 1.5px;
            border-color: HveColors.accent-red.transparentize(0.3);
        }

        // Progress fill (bottom-up within the circle)
        Rectangle {
            width: 100%;
            height: parent.height * (1.0 - root.countdown-progress);
            y: parent.height - self.height;
            background: HveColors.accent-red.transparentize(0.4);
            animate height { duration: 300ms; easing: ease-in-out; }
        }

        // Seconds number
        Text {
            text: root.countdown-seconds + "s";
            color: HveColors.accent-red;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ── TouchArea (encima de todo) ──
    cb-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}


// ─── Activation Toggle Card ─────────────────────────────────────────
export component ActivationCard inherits Rectangle {
    in property <bool> active: false;
    in property <string> card-title: "System Activation";
    in property <string> active-text: "Visual effects are safely managed by HVE.";
    in property <string> inactive-text: "System halted. Enable to start.";
    callback toggled(bool);

    height: 88px;
    border-radius: 12px;
    background: active ? HveColors.bg-card : HveColors.bg-surface;
    border-width: 2px;
    border-color: active ? HveColors.accent-green : HveColors.accent-red;

    drop-shadow-blur: active ? 16px : 0px;
    drop-shadow-color: active ? HveColors.accent-green.transparentize(0.85) : transparent;

    animate background { duration: 300ms; }
    animate border-color { duration: 300ms; }
    animate drop-shadow-blur { duration: 400ms; easing: ease-out; }

    HorizontalLayout {
        padding: 14px;
        spacing: 14px;

        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: active ? HveColors.accent-green.transparentize(0.8) : HveColors.accent-red.transparentize(0.85);
            animate background { duration: 300ms; }

            Text {
                text: active ? "⚡" : "⏸";
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 2px;
            vertical-stretch: 1;
            alignment: center;

            Text {
                text: root.card-title;
                color: HveColors.text;
                font-size: 16px;
                font-weight: 700;
                animate color { duration: 300ms; }
            }

            Text {
                text: root.active ? root.active-text : root.inactive-text;
                color: HveColors.text-muted;
                font-size: 11px;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        Rectangle {
            width: 52px;
            height: 28px;
            border-radius: 14px;
            background: active ? HveColors.accent-green : HveColors.border;
            y: (parent.height - self.height) / 2;
            animate background { duration: 300ms; }

            TouchArea {
                clicked => { root.toggled(!root.active); }
            }

            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: HveColors.text;
                x: active ? parent.width - self.width - 3px : 3px;
                y: 3px;
                animate x { duration: 400ms; easing: ease-in-out-back; }
            }
        }
    }
}

// ─── Accordion Card ──────────────────────────────────────────────────
export component AccordionCard inherits Rectangle {
    in property <string> card-title;
    in property <string> icon-text;
    in property <color> accent;
    in property <color> border;
    in property <string> short-desc;
    in property <string> full-desc;
    in property <bool> expanded: false;
    callback toggled();

    height: expanded ? 160px : 68px;
    border-radius: 10px;
    background: HveColors.bg-card;
    border-width: 1.5px;
    border-color: border;
    clip: true;

    animate height { duration: 250ms; easing: ease-in-out-back; }
    animate border-color { duration: 250ms; }

    Rectangle {
        height: 44px;
        background: expanded ? HveColors.bg-hover : transparent;
        animate background { duration: 200ms; }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 10px;
            vertical-stretch: 1;

            Text {
                text: root.icon-text;
                font-size: 14px;
                vertical-alignment: center;
            }

            Text {
                text: root.card-title;
                color: HveColors.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: root.expanded ? "▲" : "▼";
                color: root.border;
                font-size: 9px;
                vertical-alignment: center;
            }
        }
    }

    Text {
        y: 44px;
        x: 14px;
        width: parent.width - 28px;
        height: 24px;
        text: root.short-desc;
        color: HveColors.text-muted;
        font-size: 11px;
        wrap: word-wrap;
        overflow: elide;
    }

    if expanded: VerticalLayout {
        y: 68px;
        padding-left: 14px;
        padding-right: 14px;
        padding-bottom: 10px;
        spacing: 4px;
        width: 100%;

        Rectangle {
            height: 1px;
            background: HveColors.border;
        }

        Text {
            text: root.full-desc;
            color: HveColors.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    ac-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggled(); }
    }
}

// ─── Quick Nav Card (hover-lift) ─────────────────────────────────────
export component NavCard inherits Rectangle {
    in property <string> icon-text;
    in property <string> label;
    in property <string> count-text;
    in property <color> accent;
    callback clicked;

    height: nc-ta.has-hover ? 84px : 64px;
    border-radius: 10px;
    background: nc-ta.has-hover ? accent.transparentize(0.92) : HveColors.bg-surface;
    border-width: 1px;
    border-color: nc-ta.has-hover ? accent : HveColors.border;

    drop-shadow-blur: nc-ta.has-hover ? 12px : 0px;
    drop-shadow-color: nc-ta.has-hover ? accent.transparentize(0.85) : transparent;

    animate height { duration: 200ms; easing: ease-in-out-back; }
    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }
    animate drop-shadow-blur { duration: 250ms; easing: ease-out; }

    VerticalLayout {
        padding: 12px;
        spacing: 3px;
        alignment: center;

        Text {
            text: root.icon-text;
            font-size: 20px;
            color: accent;
            horizontal-alignment: center;
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: nc-ta.has-hover ? HveColors.text : HveColors.text-muted;
            horizontal-alignment: center;
            animate color { duration: 200ms; }
        }

        Text {
            text: root.count-text;
            font-size: 10px;
            color: HveColors.text-muted;
            horizontal-alignment: center;
        }
    }

    nc-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}
