import { Slider, ScrollView } from "std-widgets.slint";
import { HveColors } from "./theme.slint";

export struct AboutItem {
    text: string,
    color: color,
}

// ─── Preset Card ────────────────────────────────────────────────────
export component PresetCard inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <string> tag;
    in property <color> accent;
    in property <bool> active: false;
    in property <int> index: 0;
    in-out property <bool> keyboard-focused: false;
    in property <bool> fast-expand: false;
    // Focus-follows-mouse (opt-in per section): when true, merely hovering
    // the card moves keyboard focus to it — same index, same animations.
    in property <bool> hover-moves-focus: false;
    callback toggled();
    callback focus-requested(int);

     height: (active || ta.has-hover || root.keyboard-focused) ? 100px : 58px;
     border-radius: 10px;
     clip: true;
     background: active ? HveColors.bg-hover : ((ta.has-hover || root.keyboard-focused) ? HveColors.bg-hover : HveColors.bg-card);
     border-width: active ? 3px : (root.keyboard-focused ? 1.5px : 1px);
     border-color: (active && root.keyboard-focused) ? HveColors.text : (active ? accent : ((ta.has-hover || root.keyboard-focused) ? (root.keyboard-focused ? accent : accent.transparentize(0.6)) : HveColors.border));

    // Glow sutil al estar activo
    drop-shadow-blur: active ? 12px : 0px;
    drop-shadow-color: active ? accent.transparentize(0.8) : transparent;

    animate background {
        duration: 200ms;
        easing: ease-in-out;
    }
    animate border-color {
        duration: 200ms;
        easing: ease-in-out;
    }
    animate drop-shadow-blur {
        duration: 300ms;
        easing: ease-out;
    }
    animate height {
        duration: root.fast-expand ? 120ms : 250ms;
        easing: ease-in-out-back;
    }

    // ── Contenido visual ──
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;

        // Left: indicator + text
        Rectangle {
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 12px;

                // Indicador de estado: círculo geométrico (evita descentrado de caracteres Unicode)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 8px;
                        background: active ? accent.transparentize(0.85) : HveColors.bg-surface;
                        animate background { duration: 200ms; }

                        Rectangle {
                            width: active ? 12px : 8px;
                            height: active ? 12px : 8px;
                            border-radius: active ? 6px : 4px;
                            border-width: active ? 0px : 2px;
                            border-color: accent;
                            background: active ? accent : transparent;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            animate width { duration: 200ms; easing: ease-in-out-back; }
                            animate height { duration: 200ms; easing: ease-in-out-back; }
                            animate border-width { duration: 200ms; }
                            animate background { duration: 200ms; }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    vertical-stretch: 1;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: root.title;
                            color: active ? HveColors.text : ((ta.has-hover || root.keyboard-focused) ? HveColors.text : HveColors.text-muted);
                            font-size: 14px;
                            font-weight: active ? 700 : 500;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            animate color { duration: 200ms; }
                        }

                        Rectangle {
                            height: 18px;
                            width: tag-text.preferred-width + 14px;
                            border-radius: 9px;
                            background: active ? accent.transparentize(0.8) : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: active ? accent.transparentize(0.5) : transparent;
                            animate horizontal-stretch {
                                duration: 200ms;
                                easing: ease-out;
                            }
                            animate background { duration: 200ms; }
                            animate border-color { duration: 200ms; }

                            tag-text := Text {
                                text: root.tag;
                                color: active ? accent : HveColors.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: root.desc;
                        color: HveColors.text-muted;
                        font-size: 12px;
                        overflow: elide;
                        wrap: (active || ta.has-hover || root.keyboard-focused) ? word-wrap : no-wrap;
                    }
                }
            }
        }

        // Right: toggle switch
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 22px;
                border-radius: 11px;
                background: active ? accent : HveColors.border;
                animate background {
                    duration: 250ms;
                    easing: ease-in-out;
                }

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: HveColors.bg-dark;
                    x: active ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    animate x {
                        duration: 350ms;
                        easing: ease-in-out-back;
                    }
                }
            }
        }
    }

    // ── TouchArea (solo toggle, sin pointer-event para evitar foco atascado) ──
    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.focus-requested(root.index); root.toggled(); }
        changed has-hover => {
            if (self.has-hover && root.hover-moves-focus) {
                root.focus-requested(root.index);
            }
        }
    }
}

// ─── Nav Button ─────────────────────────────────────────────────────
export component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> icon-text;
    in property <color> accent;
    in property <bool> selected: false;
    in property <bool> sidebar-mode: true;
    callback clicked;

    min-height: 40px;
    max-height: 64px;
    border-radius: 8px;
    background: selected && sidebar-mode ? HveColors.bg-hover :
                selected ? HveColors.bg-hover.transparentize(0.6) :
                (nb-ta.has-hover ? HveColors.bg-hover.transparentize(0.5) : transparent);
    animate background { duration: 200ms; }

    // ── Indicador lateral ──
    Rectangle {
        width: 4px;
        height: selected ? parent.height * 0.8 : 0px;
        x: 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: selected && sidebar-mode ? accent : accent.transparentize(0.5);
        animate height {
            duration: 250ms;
            easing: ease-in-out-back;
        }
        animate background { duration: 200ms; }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                    Text {
                        text: root.icon-text;
                        color: selected && sidebar-mode ? accent :
                               selected ? accent.transparentize(0.4) :
                               (nb-ta.has-hover ? HveColors.text : HveColors.text-muted);
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate color { duration: 200ms; }
                    }
                }
            }

            Text {
                text: root.label;
                color: selected && sidebar-mode ? HveColors.text :
                       selected ? HveColors.text.transparentize(0.4) :
                       (nb-ta.has-hover ? HveColors.text : HveColors.text-muted);
                font-size: 14px;
                font-weight: selected && sidebar-mode ? 700 : 500;
                vertical-alignment: center;
                horizontal-stretch: 1;
                animate color { duration: 200ms; }
            }
        }

        // ── TouchArea (encima de todo) ──
        nb-ta := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.clicked(); }
        }
}

// ─── Section Header ─────────────────────────────────────────────────
export component SectionHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <color> accent;

    spacing: 4px;

    Text {
        text: root.title;
        color: root.accent;
        font-size: 18px;
        font-weight: 700;
    }

    Text {
        text: root.subtitle;
        color: HveColors.text-muted;
        font-size: 11px;
    }
}

// ─── Knob Slider ────────────────────────────────────────────────────
// Custom horizontal slider: track + accent fill + knob circle.
// The std Slider draws its thumb from the global palette (not recolorable),
// so keyboard R11 v3 "engaged" emphasis (colored knob + 3px wrapper ring)
// needs a widget that owns its pixels. Drag moves the knob (TouchArea);
// release ends the drag. Keyboard stays with the section FocusScope, so
// this widget takes no keys — it mirrors value and engaged only.
export component HveKnobSlider inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> min: 0;
    in property <float> max: 1;
    in property <color> accent: #8fd8ff;
    in property <bool> engaged: false;
    callback changed(float);

    property <length> knob-r: 10px;
    // range-d is guarded against 0 (identical min/max); set-from-x keeps
    // value inside [min, max], so frac stays in [0, 1] without clamping.
    property <float> range-d: root.max > root.min ? (root.max - root.min) : 0.0001;
    property <float> frac: root.max > root.min ? (root.value - root.min) / root.range-d : 0;

    height: 24px;

    track := Rectangle {
        x: 0;
        width: 100%;
        height: 4px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: HveColors.bg-surface;
    }

    fill := Rectangle {
        // Anchored to the knob's own center by construction: whatever the
        // knob reads, the fill ends exactly there (no shared-formula drift).
        x: 0;
        width: knob.x + root.knob-r;
        height: 4px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: root.accent;
    }

    knob := Rectangle {
        width: 2 * root.knob-r;
        height: 2 * root.knob-r;
        x: (parent.width - self.width) * root.frac;
        y: (parent.height - self.height) / 2;
        border-radius: root.knob-r;
        // Idle: white knob with cyan ring (skwd look). Engaged: fills with
        // the accent so the grabbed slider reads at a glance.
        background: root.engaged ? root.accent : #ffffff;
        border-width: 2px;
        border-color: root.engaged ? #ffffff : root.accent;
        animate background { duration: 150ms; easing: ease-in-out; }
        animate border-color { duration: 150ms; easing: ease-in-out; }
    }

    function set-from-x(x: length) {
        let usable = root.width > 2 * root.knob-r ? (root.width - 2 * root.knob-r) : 1px;
        let raw = (x - root.knob-r) / usable;
        let t = raw < 0 ? 0 : (raw > 1 ? 1 : raw);
        let v = root.min + t * (root.max - root.min);
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }

    drag := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        accessible-role: slider;
        property <bool> dragging: false;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                self.dragging = true;
                root.set-from-x(self.mouse-x);
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.dragging = false;
            }
        }
        moved => {
            if (self.dragging) {
                root.set-from-x(self.mouse-x);
            }
        }
    }
}

// ─── Geometry Slider ────────────────────────────────────────────────
export component GeometrySlider inherits Rectangle {
    in property <int> value: 2;
    in property <int> min: 1;
    in property <int> max: 5;
    in property <string> label: "Border Thickness";
    in property <bool> engaged: false;
    in property <bool> focused: false;
    callback changed(int);

    height: 80px;
    // Bare content: the section wrapper owns ALL card visuals
    // (background, border, radius, expansion). This inner layer stays
    // transparent and borderless so there is exactly one visible frame.
    background: transparent;
    border-width: 0px;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            Text {
                text: root.label;
                color: root.engaged ? #8fd8ff : HveColors.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: root.value + "px";
                color: HveColors.accent-cyan;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HveKnobSlider {
            min: root.min;
            max: root.max;
            value: root.value;
            engaged: root.engaged;
            changed(v) => { root.changed(Math.round(v)); }
        }
    }
}

// ─── Welcome Card ───────────────────────────────────────────────────
export component WelcomeCard inherits Rectangle {
    in property <string> card-title;
    in property <string> icon-text;
    in property <color> accent;
    in property <string> description;

    border-radius: 12px;
    background: HveColors.bg-card;
    border-width: 1px;
    border-color: HveColors.border;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;

            Text {
                text: root.icon-text;
                color: root.accent;
                font-size: 18px;
                vertical-alignment: center;
            }

            Text {
                text: root.card-title;
                color: HveColors.text;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: HveColors.border;
        }

        Text {
            text: root.description;
            color: HveColors.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// ─── Close Button ───────────────────────────────────────────────────
export component CloseButton inherits Rectangle {
    in property <bool> countdown-active: false;
    in property <int> countdown-seconds: 5;
    in property <float> countdown-progress: 1.0;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: cb-ta.has-hover ? HveColors.accent-red.transparentize(0.8) : transparent;
    border-width: 1.5px;
    border-color: countdown-active ? HveColors.accent-red : (cb-ta.has-hover ? HveColors.accent-red.transparentize(0.5) : HveColors.text-muted.transparentize(0.3));
    clip: true;

    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }
    animate border-radius {
        duration: 300ms;
        easing: ease-in-out;
    }
    animate width {
        duration: 300ms;
        easing: ease-in-out;
    }
    animate height {
        duration: 300ms;
        easing: ease-in-out;
    }

    // Expand slightly during countdown for visibility
    states [
        countdown when root.countdown-active: {
            width: 28px;
            height: 28px;
            border-radius: 14px;
        }
    ]

    // ── Icono X (normal) ──
    if !countdown-active: Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        Path {
            width: 100%;
            height: 100%;
            stroke: cb-ta.has-hover ? HveColors.accent-red : HveColors.text-muted;
            stroke-width: 1.5px;
            fill: transparent;
            animate stroke { duration: 200ms; }
            commands: "M 0 0 L 10 10 M 0 10 L 10 0";
        }
    }

    // ── Countdown (circular progress + número) ──
    if countdown-active: Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;

        // Background circle
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 14px;
            background: HveColors.bg-surface;
            border-width: 1.5px;
            border-color: HveColors.accent-red.transparentize(0.3);
        }

        // Progress fill (bottom-up within the circle)
        Rectangle {
            width: 100%;
            height: parent.height * (1.0 - root.countdown-progress);
            y: parent.height - self.height;
            background: HveColors.accent-red.transparentize(0.4);
            animate height {
                duration: 300ms;
                easing: ease-in-out;
            }
        }

        // Seconds number
        Text {
            text: root.countdown-seconds + "s";
            color: HveColors.accent-red;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ── TouchArea (encima de todo) ──
    cb-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}


// ─── Activation Toggle Card ─────────────────────────────────────────
export component ActivationCard inherits Rectangle {
    in property <bool> active: false;
    in property <string> card-title: "System Activation";
    in property <string> active-text: "Visual effects are safely managed by HVE.";
    in property <string> inactive-text: "System halted. Enable to start.";
    callback toggled(bool);

    height: 84px;
    border-radius: 12px;
    background: active ? HveColors.bg-card : HveColors.bg-surface;
    border-width: 2px;
    border-color: active ? HveColors.accent-green : HveColors.accent-red;

    drop-shadow-blur: active ? 16px : 0px;
    drop-shadow-color: active ? HveColors.accent-green.transparentize(0.85) : transparent;

    animate background { duration: 300ms; }
    animate border-color { duration: 300ms; }
    animate drop-shadow-blur {
        duration: 400ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        // Sin alignment — flujo natural izquierda a derecha

        // Centrado vertical del icono izquierdo — círculo ON/OFF
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: active ? HveColors.accent-green : HveColors.bg-surface;
                animate background { duration: 300ms; }

                Text {
                    text: active ? "ON" : "OFF";
                    color: HveColors.text;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Textos del core central
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.card-title;
                color: HveColors.text;
                font-size: 15px;
                font-weight: 700;
                animate color { duration: 300ms; }
            }

            Text {
                text: root.active ? root.active-text : root.inactive-text;
                color: HveColors.text-muted;
                font-size: 11px;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        // Centrado vertical del switch derecho
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 50px;
                height: 26px;
                border-radius: 13px;
                background: active ? HveColors.accent-green : HveColors.border;
                animate background { duration: 300ms; }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.toggled(!root.active); }
                }

                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: HveColors.text;
                    x: active ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    animate x {
                        duration: 400ms;
                        easing: ease-in-out-back;
                    }
                }
            }
        }
    }
}

// ─── Accordion Card ───────────────────────────────────────────────────
export component AccordionCard inherits Rectangle {
    in property <string> card-title;
    in property <string> icon-text;
    in property <color> accent;
    in property <color> border;
    in property <string> short-desc;
    in property <string> full-desc;
    in property <[AboutItem]> about-items: [];
    in property <bool> expanded: false;
    in property <string> tree-label;
    in property <[string]> tree-paths;
    in property <[string]> tree-descs;
    in property <string> tree-path-max;
    in property <string> docs-label;
    callback toggled();
    callback open-docs();

    // Ancho de la columna del árbol: el path más largo medido con la fuente real (monospace),
    // más un pequeño margen. Así todas las definiciones arrancan en el mismo x.
    private property <length> tree-path-col-width: tree-path-measure.preferred-width + 14px;

    tree-path-measure := Text {
        text: root.tree-path-max;
        font-family: "monospace";
        font-size: 12px;
        opacity: 0;
        x: -10000px;
        y: -10000px;
    }

    height: lv.preferred-height;
    border-radius: 12px;
    background: expanded ? accent.transparentize(0.93) : HveColors.bg-card;
    border-width: expanded ? 2px : 1.5px;
    border-color: expanded ? accent : border;
    clip: true;

    drop-shadow-blur: expanded ? 16px : 0px;
    drop-shadow-color: expanded ? accent.transparentize(0.85) : transparent;

    animate background { duration: 250ms; }
    animate border-color { duration: 250ms; }
    animate border-width { duration: 250ms; }
    animate drop-shadow-blur { duration: 300ms; easing: ease-out; }
    animate height { duration: 250ms; easing: ease-in-out; }

    lv := VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: expanded ? 10px : 6px;

        animate spacing { duration: 200ms; }

        // ── Header (Icono + Título + Flecha) ──
        HorizontalLayout {
            spacing: 12px;

            // Icono con fondo circular
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: accent.transparentize(0.85);
                animate background { duration: 200ms; }

                Text {
                    text: root.icon-text;
                    color: root.accent;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.card-title;
                color: expanded ? root.accent : HveColors.text;
                font-size: expanded ? 15px : 14px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                animate color { duration: 200ms; }
                animate font-size { duration: 200ms; }
            }

            // Flecha
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.expanded ? "▲" : "▼";
                    color: expanded ? root.accent : HveColors.text-muted;
                    font-size: 10px;
                    animate color { duration: 200ms; }
                }
            }
        }

        // ── Descripción corta (colapsado) ──
        if !expanded : Text {
            text: root.short-desc;
            color: HveColors.text-muted;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
        }

        // ── Cuerpo expandido ──
        if expanded : VerticalLayout {
            spacing: 10px;
            padding-top: 8px;

            Rectangle {
                height: 1px;
                background: accent.transparentize(0.3);
            }

            // Descripción completa del proyecto
            Text {
                text: root.full-desc;
                color: HveColors.text;
                font-size: 13px;
                wrap: word-wrap;
            }

            // Feature points
            for item in root.about-items: Rectangle {
                height: 32px;
                border-radius: 6px;
                background: item.color.transparentize(0.85);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: item.color;
                        }
                    }

                    Text {
                        text: item.text;
                        color: HveColors.text;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }

            // ── Árbol del proyecto ──
            if root.tree-label != "" : VerticalLayout {
                spacing: 8px;
                padding-top: 4px;

                Rectangle {
                    height: 1px;
                    background: accent.transparentize(0.3);
                }

                Text {
                    text: root.tree-label;
                    color: root.accent;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 1px;
                }

                Rectangle {
                    border-radius: 8px;
                    background: HveColors.bg-surface;
                    border-width: 1px;
                    border-color: HveColors.border;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 3px;

                        for i in root.tree-paths.length: HorizontalLayout {
                            spacing: 4px;

                            // Columna 1 (ancho fijo = path más largo): ramas del árbol + puntos
                            // que rellenan hasta el borde derecho de la columna.
                            HorizontalLayout {
                                width: root.tree-path-col-width;
                                spacing: 0px;

                                Text {
                                    text: root.tree-paths[i];
                                    color: HveColors.text;
                                    font-size: 12px;
                                    font-family: "monospace";
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.tree-descs[i] != "" ? "...................................................................................................." : "";
                                    color: HveColors.text-muted;
                                    font-size: 12px;
                                    font-family: "monospace";
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    min-width: 0px;
                                    overflow: clip;
                                }
                            }

                            // Columna 2: definición, siempre arranca en el mismo x.
                            Text {
                                text: root.tree-descs[i];
                                color: HveColors.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── Botón Documentación ──
            if root.docs-label != "" : Rectangle {
                height: 38px;
                border-radius: 8px;
                background: accent.transparentize(0.85);
                border-width: 1px;
                border-color: accent.transparentize(0.45);

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "📖";
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.docs-label;
                        color: root.accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "↗";
                        color: root.accent;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                doc-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.open-docs(); }
                }
            }
        }
    }

    ac-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggled(); }
    }
}

// ─── Quick Nav Card (Optimizado para Nitidez) ─────────────────────────
export component NavCard inherits Rectangle {
    in property <string> icon-text;
    in property <string> label;
    in property <string> count-text;
    in property <color> accent;
    in property <bool> keyboard-focused: false;
    callback clicked;

    // Alto base 96px para compensar texto más grande sin hinting. Hover/keyboard-focused sube a 106px.
    height: (nc-ta.has-hover || root.keyboard-focused) ? 106px : 96px;
    border-radius: 10px;
    horizontal-stretch: (nc-ta.has-hover || root.keyboard-focused) ? 1.3 : 1.0;
    background: (nc-ta.has-hover || root.keyboard-focused) ? accent.transparentize(0.92) : HveColors.bg-card;
    border-width: (nc-ta.has-hover || root.keyboard-focused) ? 2px : 1px;
    border-color: (nc-ta.has-hover || root.keyboard-focused) ? accent : HveColors.border;

    drop-shadow-blur: (nc-ta.has-hover || root.keyboard-focused) ? 12px : 0px;
    drop-shadow-color: (nc-ta.has-hover || root.keyboard-focused) ? accent.transparentize(0.85) : transparent;

    animate height {
        duration: 200ms;
        easing: ease-in-out-back;
    }
    animate horizontal-stretch {
        duration: 200ms;
        easing: ease-out;
    }
    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }
    animate drop-shadow-blur {
        duration: 250ms;
        easing: ease-out;
    }

    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 6px; // Más aire entre icono, label y count
        alignment: center;

        Rectangle {
            height: 28px;

            Text {
                text: root.icon-text;
                font-size: 22px;
                color: accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.label;
            font-size: 14px;       // 12→14px: más píxeles para rasterizar sin hinting
            font-weight: 600;
            color: HveColors.text; // Siempre blanco, contraste ~7.8:1 contra bg-card
            horizontal-alignment: center;
        }

        Text {
            text: root.count-text;
            font-size: 11px;       // 10→11px: mejora legibilidad sin hinting
            color: HveColors.text-muted;
            horizontal-alignment: center;
        }
    }

    nc-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// ─── Settings Panel (legacy centered overlay) — REMOVED in slice 8 (R8) ───
// Rows relocated to ui/panel/sections/SystemSection.slint; overlay and open/close wiring deleted.
// The handlers that SystemSection still uses (toggle-auto-minimize, language, etc.) survive in
// src/main.rs / src/callbacks.rs; only the overlay component and its unique settings-open state are gone.

// ─── Icon Button with Tooltip ─────────────────────────────────────────
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> bg-color;
    in property <color> hover-bg-color: bg-color;
    in property <string> tooltip-text;
    in property <bool> disabled: false;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;

    property <bool> show-tooltip: false;

    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: ta.has-hover ? hover-bg-color : bg-color;
    opacity: root.disabled ? 0.5 : 1.0;
    animate background { duration: 150ms; }
    animate opacity { duration: 150ms; }

    Text {
        text: root.icon;
        color: HveColors.text;
        font-size: 15px;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            if (!root.disabled) {
                root.show-tooltip = false;
                root.clicked();
            }
        }
    }

    // Timer de 300ms
    tt-timer := Timer {
        interval: 300ms;
        running: ta.has-hover;
        triggered => {
            if (ta.has-hover && root.tooltip-text != "") {
                root.show-tooltip = true;
            }
        }
    }

    // Apaga el tooltip al salir del botón
    changed has-hover => {
        if (!ta.has-hover) {
            root.show-tooltip = false;
        }
    }

    // ── Tooltip (Rectangle flotante, sin PopupWindow) ──
    if (root.show-tooltip) : Rectangle {
        x: (parent.width - 80px) / 2;
        y: -36px;
        width: 80px;
        height: 24px;
        z: 100;

        Rectangle {
            width: 100%;
            height: 100%;
            background: #1e1e2e;
            border-radius: 6px;
            border-width: 1px;
            border-color: HveColors.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000080;

            Text {
                text: root.tooltip-text;
                color: HveColors.text;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
