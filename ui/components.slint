import { Slider, ScrollView } from "std-widgets.slint";
import { HveColors } from "./theme.slint";

// ─── Preset Card ────────────────────────────────────────────────────
export component PresetCard inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <string> tag;
    in property <color> accent;
    in property <bool> active: false;
    callback toggled(bool);

    height: (active || ta.has-hover || fs.has-focus) ? 100px : 58px;
    border-radius: 10px;
    clip: true;
    background: active ? HveColors.bg-hover : ((ta.has-hover || fs.has-focus) ? HveColors.bg-hover : HveColors.bg-card);
    border-width: active ? 2px : 1px;
    border-color: active ? accent : ((ta.has-hover || fs.has-focus) ? accent.transparentize(0.6) : HveColors.border);

    // Glow sutil al estar activo
    drop-shadow-blur: active ? 12px : 0px;
    drop-shadow-color: active ? accent.transparentize(0.8) : transparent;

    animate background {
        duration: 200ms;
        easing: ease-in-out;
    }
    animate border-color {
        duration: 200ms;
        easing: ease-in-out;
    }
    animate drop-shadow-blur {
        duration: 300ms;
        easing: ease-out;
    }
    animate height {
        duration: 250ms;
        easing: ease-in-out-back;
    }

    // ── Contenido visual ──
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;

        // Left: indicator + text
        Rectangle {
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 12px;

                // Indicador de estado: círculo geométrico (evita descentrado de caracteres Unicode)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 8px;
                        background: active ? accent.transparentize(0.85) : HveColors.bg-surface;
                        animate background { duration: 200ms; }

                        Rectangle {
                            width: active ? 12px : 8px;
                            height: active ? 12px : 8px;
                            border-radius: active ? 6px : 4px;
                            border-width: active ? 0px : 2px;
                            border-color: accent;
                            background: active ? accent : transparent;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            animate width { duration: 200ms; easing: ease-in-out-back; }
                            animate height { duration: 200ms; easing: ease-in-out-back; }
                            animate border-width { duration: 200ms; }
                            animate background { duration: 200ms; }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    vertical-stretch: 1;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: root.title;
                            color: active ? HveColors.text : ((ta.has-hover || fs.has-focus) ? HveColors.text : HveColors.text-muted);
                            font-size: 14px;
                            font-weight: active ? 700 : 500;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            animate color { duration: 200ms; }
                        }

                        Rectangle {
                            height: 18px;
                            width: tag-text.preferred-width + 14px;
                            border-radius: 9px;
                            background: active ? accent.transparentize(0.8) : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: active ? accent.transparentize(0.5) : transparent;
                            animate horizontal-stretch {
                                duration: 200ms;
                                easing: ease-out;
                            }
                            animate background { duration: 200ms; }
                            animate border-color { duration: 200ms; }

                            tag-text := Text {
                                text: root.tag;
                                color: active ? accent : HveColors.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: root.desc;
                        color: HveColors.text-muted;
                        font-size: 12px;
                        overflow: elide;
                        wrap: (active || ta.has-hover || fs.has-focus) ? word-wrap : no-wrap;
                    }
                }
            }
        }

        // Right: toggle switch
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 22px;
                border-radius: 11px;
                background: active ? accent : HveColors.border;
                animate background {
                    duration: 250ms;
                    easing: ease-in-out;
                }

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: HveColors.bg-dark;
                    x: active ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    animate x {
                        duration: 350ms;
                        easing: ease-in-out-back;
                    }
                }
            }
        }
    }

    // ── FocusScope (workaround: focus-on-click: false) ──
    fs := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.toggled(!root.active);
                accept
            } else {
                reject
            }
        }
    }

    // ── TouchArea (encima de todo) ──
    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggled(!root.active); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                fs.focus();
            }
        }
    }
}

// ─── Nav Button ─────────────────────────────────────────────────────
export component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> icon-text;
    in property <color> accent;
    in property <bool> selected: false;
    callback clicked;

    height: 48px;
    border-radius: 8px;
    // selected -> activo; has-hover -> hover ratón; has-focus -> tab navegación teclado
    background: selected ? HveColors.bg-hover : ((nb-ta.has-hover || nb-fs.has-focus) ? HveColors.bg-hover.transparentize(0.5) : transparent);
    animate background { duration: 200ms; }

    // ── Indicador lateral ──
    Rectangle {
        width: 4px;
        height: selected ? parent.height * 0.6 : 0px;
        x: 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: accent;
        animate height {
            duration: 250ms;
            easing: ease-in-out-back;
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        // Sin alignment — por defecto alinea a la izquierda (start), que es lo que queremos

        // Contenedor vertical: centra el icono verticalmente sin tocar el eje horizontal
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                Text {
                    text: root.icon-text;
                    color: (selected || nb-fs.has-focus) ? accent : (nb-ta.has-hover ? HveColors.text : HveColors.text-muted);
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: 200ms; }
                }
            }
        }

        // El texto se centra verticalmente con su propiedad nativa
        Text {
            text: root.label;
            color: selected ? HveColors.text : ((nb-ta.has-hover || nb-fs.has-focus) ? HveColors.text : HveColors.text-muted);
            font-size: 14px;
            font-weight: selected ? 700 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            animate color { duration: 200ms; }
        }
    }

    // ── FocusScope (workaround: focus-on-click: false) ──
    nb-fs := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    // ── TouchArea (encima de todo) ──
    nb-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// ─── Section Header ─────────────────────────────────────────────────
export component SectionHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <color> accent;

    spacing: 4px;

    Text {
        text: root.title;
        color: root.accent;
        font-size: 18px;
        font-weight: 700;
    }

    Text {
        text: root.subtitle;
        color: HveColors.text-muted;
        font-size: 11px;
    }
}

// ─── Geometry Slider ────────────────────────────────────────────────
export component GeometrySlider inherits Rectangle {
    in property <int> value: 2;
    in property <int> min: 1;
    in property <int> max: 5;
    in property <string> label: "Border Thickness";
    callback changed(int);

    height: 80px;
    border-radius: 8px;
    background: HveColors.bg-card;
    border-width: 1px;
    border-color: HveColors.border;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            Text {
                text: root.label;
                color: HveColors.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: root.value + "px";
                color: HveColors.accent-cyan;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Slider {
            minimum: root.min;
            maximum: root.max;
            value: root.value;
            changed(v) => { root.changed(v); }
        }
    }
}

// ─── Welcome Card ───────────────────────────────────────────────────
export component WelcomeCard inherits Rectangle {
    in property <string> card-title;
    in property <string> icon-text;
    in property <color> accent;
    in property <string> description;

    border-radius: 12px;
    background: HveColors.bg-card;
    border-width: 1px;
    border-color: HveColors.border;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;

            Text {
                text: root.icon-text;
                color: root.accent;
                font-size: 18px;
                vertical-alignment: center;
            }

            Text {
                text: root.card-title;
                color: HveColors.text;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: HveColors.border;
        }

        Text {
            text: root.description;
            color: HveColors.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// ─── Close Button ───────────────────────────────────────────────────
export component CloseButton inherits Rectangle {
    in property <bool> countdown-active: false;
    in property <int> countdown-seconds: 5;
    in property <float> countdown-progress: 1.0;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: cb-ta.has-hover ? HveColors.accent-red.transparentize(0.8) : transparent;
    border-width: 1.5px;
    border-color: countdown-active ? HveColors.accent-red : (cb-ta.has-hover ? HveColors.accent-red.transparentize(0.5) : HveColors.text-muted.transparentize(0.3));
    clip: true;

    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }
    animate border-radius {
        duration: 300ms;
        easing: ease-in-out;
    }
    animate width {
        duration: 300ms;
        easing: ease-in-out;
    }
    animate height {
        duration: 300ms;
        easing: ease-in-out;
    }

    // Expand slightly during countdown for visibility
    states [
        countdown when root.countdown-active: {
            width: 28px;
            height: 28px;
            border-radius: 14px;
        }
    ]

    // ── Icono X (normal) ──
    if !countdown-active: Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        Path {
            width: 100%;
            height: 100%;
            stroke: cb-ta.has-hover ? HveColors.accent-red : HveColors.text-muted;
            stroke-width: 1.5px;
            fill: transparent;
            animate stroke { duration: 200ms; }
            commands: "M 0 0 L 10 10 M 0 10 L 10 0";
        }
    }

    // ── Countdown (circular progress + número) ──
    if countdown-active: Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;

        // Background circle
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 14px;
            background: HveColors.bg-surface;
            border-width: 1.5px;
            border-color: HveColors.accent-red.transparentize(0.3);
        }

        // Progress fill (bottom-up within the circle)
        Rectangle {
            width: 100%;
            height: parent.height * (1.0 - root.countdown-progress);
            y: parent.height - self.height;
            background: HveColors.accent-red.transparentize(0.4);
            animate height {
                duration: 300ms;
                easing: ease-in-out;
            }
        }

        // Seconds number
        Text {
            text: root.countdown-seconds + "s";
            color: HveColors.accent-red;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ── TouchArea (encima de todo) ──
    cb-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}


// ─── Activation Toggle Card ─────────────────────────────────────────
export component ActivationCard inherits Rectangle {
    in property <bool> active: false;
    in property <string> card-title: "System Activation";
    in property <string> active-text: "Visual effects are safely managed by HVE.";
    in property <string> inactive-text: "System halted. Enable to start.";
    callback toggled(bool);

    height: 84px;
    border-radius: 12px;
    background: active ? HveColors.bg-card : HveColors.bg-surface;
    border-width: 2px;
    border-color: active ? HveColors.accent-green : HveColors.accent-red;

    drop-shadow-blur: active ? 16px : 0px;
    drop-shadow-color: active ? HveColors.accent-green.transparentize(0.85) : transparent;

    animate background { duration: 300ms; }
    animate border-color { duration: 300ms; }
    animate drop-shadow-blur {
        duration: 400ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        // Sin alignment — flujo natural izquierda a derecha

        // Centrado vertical del icono izquierdo — círculo ON/OFF
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: active ? HveColors.accent-green : HveColors.bg-surface;
                animate background { duration: 300ms; }

                Text {
                    text: active ? "ON" : "OFF";
                    color: HveColors.text;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Textos del core central
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.card-title;
                color: HveColors.text;
                font-size: 15px;
                font-weight: 700;
                animate color { duration: 300ms; }
            }

            Text {
                text: root.active ? root.active-text : root.inactive-text;
                color: HveColors.text-muted;
                font-size: 11px;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        // Centrado vertical del switch derecho
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 50px;
                height: 26px;
                border-radius: 13px;
                background: active ? HveColors.accent-green : HveColors.border;
                animate background { duration: 300ms; }

                TouchArea {
                    clicked => { root.toggled(!root.active); }
                }

                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: HveColors.text;
                    x: active ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    animate x {
                        duration: 400ms;
                        easing: ease-in-out-back;
                    }
                }
            }
        }
    }
}

// ─── Accordion Card (Optimizado) ─────────────────────────────────────
export component AccordionCard inherits Rectangle {
    in property <string> card-title;
    in property <string> icon-text;
    in property <color> accent;
    in property <color> border;
    in property <string> short-desc;
    in property <string> full-desc;
    in property <bool> expanded: false;
    callback toggled();

    // Dejamos que la altura responda de forma fluida al contenido interno
    height: lv.preferred-height;
    border-radius: 10px;
    background: HveColors.bg-card;
    border-width: 1.5px;
    border-color: border;
    clip: true;

    animate border-color { duration: 250ms; }

    // Un solo contenedor vertical controla todo el aire del componente
    lv := VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 6px; // <-- Este es el truco: controla la separación exacta entre título y subtítulo

        // ── Línea del Header (Icono + Título + Flecha) ──
        HorizontalLayout {
            spacing: 10px;

            // Centramos la bombilla verticalmente
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.icon-text;
                    color: root.accent;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Centramos el título
            Text {
                text: root.card-title;
                color: root.accent;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // Centramos la flecha del desplegable
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.expanded ? "▲" : "▼";
                    color: root.border.transparentize(0.3);
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // ── Descripción Corta (Sólo visible si está colapsado) ──
        if !expanded : Text {
            text: root.short-desc;
            color: HveColors.text-muted;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
        }

        // ── Cuerpo Expandido ──
        if expanded : VerticalLayout {
            spacing: 8px;
            padding-top: 6px;

            Rectangle {
                height: 1px;
                background: HveColors.border.transparentize(0.5);
            }

            Text {
                text: root.full-desc;
                color: HveColors.text-muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }

    // Área de interacción total sobre la tarjeta
    ac-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggled(); }
    }
}

// ─── Quick Nav Card (Optimizado para Nitidez) ─────────────────────────
export component NavCard inherits Rectangle {
    in property <string> icon-text;
    in property <string> label;
    in property <string> count-text;
    in property <color> accent;
    callback clicked;

    // Alto base 96px para compensar texto más grande sin hinting. Hover sube a 106px.
    height: nc-ta.has-hover ? 106px : 96px;
    border-radius: 10px;
    horizontal-stretch: nc-ta.has-hover ? 1.3 : 1.0;
    background: nc-ta.has-hover ? accent.transparentize(0.92) : HveColors.bg-card;
    border-width: 1px;
    border-color: nc-ta.has-hover ? accent : HveColors.border;

    drop-shadow-blur: nc-ta.has-hover ? 12px : 0px;
    drop-shadow-color: nc-ta.has-hover ? accent.transparentize(0.85) : transparent;

    animate height {
        duration: 200ms;
        easing: ease-in-out-back;
    }
    animate horizontal-stretch {
        duration: 200ms;
        easing: ease-out;
    }
    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }
    animate drop-shadow-blur {
        duration: 250ms;
        easing: ease-out;
    }

    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 6px; // Más aire entre icono, label y count
        alignment: center;

        Rectangle {
            height: 28px;

            Text {
                text: root.icon-text;
                font-size: 22px;
                color: accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.label;
            font-size: 14px;       // 12→14px: más píxeles para rasterizar sin hinting
            font-weight: 600;
            color: HveColors.text; // Siempre blanco, contraste ~7.8:1 contra bg-card
            horizontal-alignment: center;
        }

        Text {
            text: root.count-text;
            font-size: 11px;       // 10→11px: mejora legibilidad sin hinting
            color: HveColors.text-muted;
            horizontal-alignment: center;
        }
    }

    nc-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// ─── Settings Button (Gear) ──────────────────────────────────────────
export component SettingsButton inherits Rectangle {
    in property <bool> settings-open: false;
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: sb-ta.has-hover ? HveColors.bg-hover : (root.settings-open ? HveColors.bg-hover : transparent);
    animate background { duration: 200ms; }

    Text {
        text: "⚙";
        color: root.settings-open ? HveColors.accent-cyan : (sb-ta.has-hover ? HveColors.text : HveColors.text-muted);
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 200ms; }
    }

    sb-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// ─── Settings Panel ──────────────────────────────────────────────────
export component SettingsPanel inherits Rectangle {
    in-out property <bool> is-open: false;
    in property <bool> auto-minimize: true;
    in property <int> minimize-seconds: 5;
    in property <string> language: "en";
    in property <bool> tiling-mode: false;
    in property <bool> autostart: false;
    in property <string> theme: "system";
    in-out property <bool> restart-required: false;
    in property <string> restart-banner-text: "⚠ Restart required";
    in property <string> restart-button-text: "Restart";

    callback close-panel();
    callback toggle-auto-minimize(bool);
    callback change-minimize-seconds(int);
    callback change-language(string);
    callback toggle-tiling-mode(bool);
    callback toggle-autostart(bool);
    callback change-theme(string);
    callback reset-presets();
    callback restart-app();

    width: 100%;
    height: 100%;
    background: transparent;

    // ── Overlay semitransparente (detrás) ──
    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000060;

        ta := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.close-panel(); }
        }
    }

    // ── Panel en sí (centrado) ──
    Rectangle {
        width: min(400px, parent.width - 48px);
        height: min(480px, parent.height - 48px);
        border-radius: 16px;
        background: HveColors.bg-surface;
        border-width: 1px;
        border-color: HveColors.border;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        drop-shadow-blur: 30px;
        drop-shadow-color: #00000060;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            // ── Header ──
            HorizontalLayout {
                spacing: 12px;

                Text {
                    text: "Settings";
                    color: HveColors.text;
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                // Close X button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: sp-close.has-hover ? HveColors.accent-red.transparentize(0.8) : transparent;
                    animate background { duration: 200ms; }

                    Text {
                        text: "✕";
                        color: sp-close.has-hover ? HveColors.accent-red : HveColors.text-muted;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate color { duration: 200ms; }
                    }

                    sp-close := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.close-panel(); }
                    }
                }
            }

            Rectangle { height: 1px; background: HveColors.border; }

            // ── Restart required banner ──
            if root.restart-required : Rectangle {
                height: 32px;
                border-radius: 8px;
                background: HveColors.accent-amber.transparentize(0.85);
                border-width: 1px;
                border-color: HveColors.accent-amber.transparentize(0.4);

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;

                    Text {
                        text: root.restart-banner-text;
                        color: HveColors.accent-amber;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 60px;
                            height: 24px;
                            border-radius: 6px;
                            background: rr-btn.has-hover ? HveColors.accent-amber : HveColors.bg-card;
                            animate background { duration: 150ms; }

                            Text {
                                text: root.restart-button-text;
                                color: rr-btn.has-hover ? HveColors.bg-dark : HveColors.accent-amber;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                animate color { duration: 150ms; }
                            }

                            rr-btn := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.restart-app(); }
                            }
                        }
                    }
                }
            }

            // ── Scroll de opciones ──
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 20px;
                    padding-bottom: 8px;

                    // ── Auto-minimize ──
                    VerticalLayout {
                        spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Auto-minimize";
                            color: HveColors.text;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        // Toggle switch mini
                        Rectangle {
                                width: 40px;
                                height: 22px;
                                border-radius: 11px;
                                background: root.auto-minimize ? HveColors.accent-green : HveColors.border;
                                animate background { duration: 250ms; }

                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: HveColors.bg-dark;
                                    x: root.auto-minimize ? parent.width - self.width - 3px : 3px;
                                    y: 3px;
                                    animate x { duration: 350ms; easing: ease-in-out-back; }
                                }

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.toggle-auto-minimize(!root.auto-minimize); }
                                }
                            }
                        }

                        // Time selector (visible only when auto-minimize is on)
                        if root.auto-minimize : HorizontalLayout {
                            spacing: 8px;
                            padding-left: 4px;

                            Text {
                                text: "Timer:";
                                color: HveColors.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            for sec in [3, 5, 10] : Rectangle {
                                width: 36px;
                                height: 28px;
                                border-radius: 6px;
                                background: root.minimize-seconds == sec ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                                border-width: 1px;
                                border-color: root.minimize-seconds == sec ? HveColors.accent-cyan : HveColors.border;
                                animate background { duration: 150ms; }
                                animate border-color { duration: 150ms; }

                                Text {
                                    text: sec;
                                    color: root.minimize-seconds == sec ? HveColors.accent-cyan : HveColors.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.change-minimize-seconds(sec); }
                                }
                            }

                            Text {
                                text: "s";
                                color: HveColors.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // ── Language ──
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Language";
                            color: HveColors.text;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 60px;
                            height: 28px;
                            border-radius: 6px;
                            background: HveColors.bg-card;
                            border-width: 1px;
                            border-color: HveColors.border;

                            HorizontalLayout {
                                spacing: 0px;

                                Rectangle {
                                    width: 50%;
                                    height: 100%;
                                    border-radius: root.language == "en" ? 5px : 0px;
                                    background: root.language == "en" ? HveColors.accent-cyan.transparentize(0.8) : transparent;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: "EN";
                                        color: root.language == "en" ? HveColors.accent-cyan : HveColors.text-muted;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.change-language("en"); }
                                    }
                                }

                                Rectangle {
                                    width: 50%;
                                    height: 100%;
                                    border-radius: root.language == "es" ? 5px : 0px;
                                    background: root.language == "es" ? HveColors.accent-cyan.transparentize(0.8) : transparent;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: "ES";
                                        color: root.language == "es" ? HveColors.accent-cyan : HveColors.text-muted;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.change-language("es"); }
                                    }
                                }
                            }
                        }
                    }

                    // ── Tiling Mode ──
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Tiling mode";
                            color: HveColors.text;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 40px;
                            height: 22px;
                            border-radius: 11px;
                            background: root.tiling-mode ? HveColors.accent-cyan : HveColors.border;
                            animate background { duration: 250ms; }

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: HveColors.bg-dark;
                                x: root.tiling-mode ? parent.width - self.width - 3px : 3px;
                                y: 3px;
                                animate x { duration: 350ms; easing: ease-in-out-back; }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.toggle-tiling-mode(!root.tiling-mode); }
                            }
                        }
                    }

                    // ── Autostart ──
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Autostart";
                            color: HveColors.text;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 40px;
                            height: 22px;
                            border-radius: 11px;
                            background: root.autostart ? HveColors.accent-cyan : HveColors.border;
                            animate background { duration: 250ms; }

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: HveColors.bg-dark;
                                x: root.autostart ? parent.width - self.width - 3px : 3px;
                                y: 3px;
                                animate x { duration: 350ms; easing: ease-in-out-back; }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.toggle-autostart(!root.autostart); }
                            }
                        }
                    }

                    // ── Theme ──
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Theme";
                            color: HveColors.text;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 4px;

                            for t in ["dark", "light", "system"] : Rectangle {
                                width: 56px;
                                height: 28px;
                                border-radius: 6px;
                                background: root.theme == t ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                                border-width: 1px;
                                border-color: root.theme == t ? HveColors.accent-cyan : HveColors.border;
                                animate background { duration: 150ms; }
                                animate border-color { duration: 150ms; }

                                Text {
                                    text: t;
                                    color: root.theme == t ? HveColors.accent-cyan : HveColors.text;
                                    font-size: 10px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.change-theme(t); }
                                }
                            }
                        }
                    }

                    // ── Reset Presets ──
                    Rectangle {
                        height: 1px;
                        background: HveColors.border;
                    }

                    Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: rp-ta.has-hover ? HveColors.accent-red.transparentize(0.85) : HveColors.bg-card;
                        border-width: 1px;
                        border-color: rp-ta.has-hover ? HveColors.accent-red.transparentize(0.5) : HveColors.border;
                        animate background { duration: 200ms; }
                        animate border-color { duration: 200ms; }

                        Text {
                            text: "Reset presets";
                            color: rp-ta.has-hover ? HveColors.accent-red : HveColors.text-muted;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate color { duration: 200ms; }
                        }

                        rp-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.reset-presets(); }
                        }
                    }
                }
            }
        }
    }
}
