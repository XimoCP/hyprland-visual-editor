import { HveColors } from "./theme.slint";
import { CloseButton, AboutItem } from "./components.slint";
import { ShellRoot, SkwdTokens } from "./shell.slint";
import { BordersText } from "panel/sections/borders_text.slint";
import { MotionText } from "panel/sections/motion_text.slint";
import { SaveText } from "panel/sections/save_text.slint";
import { FiltersText } from "panel/sections/filters_text.slint";
import { SystemText } from "panel/sections/system_text.slint";
import { PanelText } from "panel/panel_text.slint";
import { GalleryCardData } from "gallery/ThemeCardDelegate.slint";
import { ThemeInfoData } from "gallery/ThemeInfoPanel.slint";
import { SliceTileData } from "gallery/SliceCarousel.slint";
import { MosaicTileData } from "gallery/MosaicView.slint";

// Re-export SkwdTokens so Rust can access it via crate::SkwdTokens.
export { SkwdTokens }
// Same for the Borders panel text: Rust fills it from the embedded i18n map
// (`panel_i18n::apply_borders`), so the global must be part of this
// compilation unit's public API.
export { BordersText }
// And the shared panel chrome (nav rail + header hint): Rust fills it from the
// same map through `panel_i18n::apply_panel_chrome`.
export { PanelText }
// Motion's new tune controls (speed + style): same channel, same map, filled by
// `panel_i18n::apply_motion`.
export { MotionText }
// Save and Filters section copy (form title/description/tip, section title/
// description/empty/hint): same channel, filled by `panel_i18n::apply_save`
// and `panel_i18n::apply_filters`.
export { SaveText }
export { FiltersText }
// System / About section copy (header, section description, restart row,
// activation card, row labels and About defaults): same channel, filled by
// `panel_i18n::apply_system`.
export { SystemText }


// ─── MAIN WINDOW ────────────────────────────────────────────────────
export component MainWindow inherits Window {
    title: "Hyprland Visual Editor";
    min-width: 800px;
    min-height: 580px;
    preferred-width: 900px;
    preferred-height: 680px;
    default-font-family: "Inter, sans-serif";

    // ── Theme (re-exported so Rust can set them via window.set_*) ──
    in-out property <color> bg-dark <=> HveColors.bg-dark;
    in-out property <color> bg-surface <=> HveColors.bg-surface;
    in-out property <color> bg-card <=> HveColors.bg-card;
    in-out property <color> bg-hover <=> HveColors.bg-hover;
    in-out property <color> text <=> HveColors.text;
    in-out property <color> text-muted <=> HveColors.text-muted;
    in-out property <color> accent-cyan <=> HveColors.accent-cyan;
    in-out property <color> accent-amber <=> HveColors.accent-amber;
    in-out property <color> accent-green <=> HveColors.accent-green;
    in-out property <color> accent-purple <=> HveColors.accent-purple;
    in-out property <color> accent-pink <=> HveColors.accent-pink;
    in-out property <color> accent-red <=> HveColors.accent-red;
    in-out property <color> border <=> HveColors.border;
    // Palette token swatches for border preset display (A2 RESOLVED)
    in-out property <color> token-primary <=> HveColors.token-primary;
    in-out property <color> token-secondary <=> HveColors.token-secondary;
    in-out property <color> token-tertiary <=> HveColors.token-tertiary;
    in-out property <color> token-error <=> HveColors.token-error;
    in-out property <color> token-surface <=> HveColors.token-surface;
    in-out property <color> token-surface-lowest <=> HveColors.token-surface-lowest;

    // Immersive Gallery session (PR1.1): a transparent WINDOW background lets
    // the desktop show through behind the gallery's alpha-0 backdrop. Any other
    // screen keeps the opaque dark base.
    background: root.mounted-screen == 1 ? transparent : HveColors.bg-dark;

    // ── Theme transition fade (Slint-only, independent of system animations) ──
    // Two-directional dissolve driven by states: exit accelerates away
    // (ease-in, 420ms — matches the Rust stage timer at 560ms), entrance
    // settles gently (ease-out, 520ms — Rust restores compositor masks at
    // +570ms after the return flip). Keep the Rust timers in sync with
    // these durations (src/main.rs theme transition block).
    in-out property <bool> theme-transitioning: false;
    // Gallery focus-restore nonce (U6 extension): Rust bumps it on a small
    // bounded schedule after a custom-palette apply, because the provider
    // re-assert can mutate the desktop (~2 s later) and drop Slint's
    // internal focus again after the transition-end reseed already ran.
    in-out property <int> focus-restore-nonce: 0;
    property <float> theme-fade: 1.0;
    states [
        theme-hidden when root.theme-transitioning: {
            theme-fade: 0.0;
            in {
                animate theme-fade { duration: 420ms; easing: ease-in; }
            }
        }
        theme-shown when !root.theme-transitioning: {
            theme-fade: 1.0;
            in {
                animate theme-fade { duration: 520ms; easing: ease-out; }
            }
        }
    ]

    // ── Legacy legacy_tab state — REMOVED in slice 8 (R8) ──
    // Replaced by panel-section + is-mutating / is-panel-open (PanelState).
    in-out property <bool> system-active: false;
    in property <image> logo-image;

    // ── i18n strings (legacy Home/Tab headers — REMOVED in slice 8) ──
    // WelcomeCards / Active Config moved to panel System About (home-about-* kept below).
    in property <string> home-about-title;
    in property <string> home-about-short;
    in property <string> home-about-full;
    in property <[AboutItem]> home-about-items;
    in property <string> home-about-tree-label;
    in property <[string]> home-about-tree-paths;
    in property <[string]> home-about-tree-descs;
    in property <string> home-about-tree-path-max;
    in property <string> home-about-docs-label;
    // ── i18n: Settings strings ──
    in property <string> settings-restart-banner;
    in property <string> settings-restart-button;
    in property <string> settings-title;
    in property <string> auto-minimize-label;
    in property <string> timer-label;
    in property <string> language-label;
    in property <string> tiling-label;
    in property <string> autostart-label;
    in property <string> theme-label;
    in property <string> reset-label;

    // Animation data
    in property <[string]> anim-titles;
    in property <[string]> anim-descs;
    in property <[string]> anim-tags;
    in property <[string]> anim-files;
    in-out property <int> active-anim-index: -1;

    // Border data
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in-out property <int> active-border-index: -1;
    in-out property <int> border-size: 2;
    in-out property <int> corner-radius: 32;
    in property <string> border-radius-label;
    in-out property <int> gap-in: 5;
    in-out property <int> gap-out: 5;
    in property <string> gap-in-label;
    in property <string> gap-out-label;
    // Border preset state
    in-out property <string> border-preset-name: "";
    in property <string> border-save-error: "";
    in property <[string]> user-border-preset-names;
    in property <[string]> user-border-preset-tags;
    // Border preset rename/delete dialogs (shared Dialogs.slint)
    in-out property <string> border-dialog-mode: "";
    in-out property <string> border-dialog-target: "";
    in-out property <string> border-rename-input: "";
    in property <string> border-rename-title: "Rename border preset";
    in property <string> border-delete-title: "Delete border preset";
    in property <string> border-delete-msg: "Are you sure you want to delete";
    in property <string> border-cancel-text: "Cancel";
    // Tune pane — dynamic (Unit 2)
    in-out property <[string]> tune-active-colors: [];
    in-out property <int> tune-color-count: 0;
    // Resolved colours (tokens + custom) in a FIXED 11-slot layout:
    // 0..7 slots, 8 inactive, 9 glow, 10 glow inactive. Slint cannot parse
    // "#rrggbbaa", so Rust resolves them for previews and picker seeds.
    in-out property <[color]> tune-colors-resolved: [];
    in-out property <int> tune-angle: 90;
    in-out property <string> tune-inactive-color: "";
    in-out property <string> tune-glow: "";
    in-out property <bool> tune-glow-enabled: false;
    in-out property <int> tune-glow-range: 20;
    in-out property <int> tune-glow-render-power: 4;
    in-out property <string> tune-glow-color: "p:primary";
    in-out property <string> tune-glow-color-inactive: "p:surface_lowest";
    in-out property <string> tune-animations: "";
    in-out property <bool> tune-anim-borderangle-enabled: false;
    in-out property <int> tune-anim-borderangle-speed: 30;
    in-out property <string> tune-anim-borderangle-bezier: "default";
    in-out property <string> tune-anim-borderangle-style: "";
    in-out property <bool> tune-anim-border-enabled: false;
    in-out property <int> tune-anim-border-speed: 30;
    in-out property <string> tune-anim-border-bezier: "default";
    in-out property <string> tune-anim-border-style: "";
    in-out property <bool> tune-anim-fadeshadow-enabled: false;
    in-out property <int> tune-anim-fadeshadow-speed: 30;
    in-out property <string> tune-anim-fadeshadow-bezier: "default";
    in-out property <string> tune-anim-fadeshadow-style: "";
    in-out property <[string]> tune-anim-curves: [];
    in-out property <bool> tune-rule-enabled: false;
    // D4 live-vs-saved: true while the working state differs from what was
    // loaded/saved. Slint sets it on every edit; Rust clears it on load and
    // after a successful save, so both directions stay truthful.
    in-out property <bool> tune-dirty: false;
    // Channel whose custom colour the shared picker has open (-1 = closed).
    in-out property <int> tune-editing-slot: -1;
    in-out property <string> animation-preset-name: "";
    in property <string> animation-save-error: "";
    in property <[string]> user-animation-preset-names;
    in property <[string]> user-animation-preset-tags;
    // Animation preset rename/delete dialogs (shared Dialogs.slint)
    in-out property <string> animation-dialog-mode: "";
    in-out property <string> animation-dialog-target: "";
    in-out property <string> animation-rename-input: "";
    in property <string> animation-rename-title: "Rename animation preset";
    in property <string> animation-rename-placeholder: "Animation preset name…";
    in property <string> animation-delete-title: "Delete animation preset";
    in property <string> animation-delete-msg: "Are you sure you want to delete";
    in property <string> animation-cancel-text: "Cancel";

    // Shader data
    in property <[string]> shader-titles;
    in property <[string]> shader-descs;
    in property <[string]> shader-tags;
    in property <[string]> shader-files;
    in-out property <int> active-shader-index: -1;

    // Theme data
    in-out property <[string]> theme-names;
    in-out property <[string]> theme-saved-ats;
    in-out property <[bool]> theme-is-actives;
    in-out property <int> active-theme-index: -1;
    in-out property <bool> theme-busy: false;
    // ── Legacy ThemesModule i18n — REMOVED slice 8 (R8) ──
    // Save/apply handled via panel SaveSection + Gallery cards; list/search/rename/delete UI removed.
    in property <string> app-version-label;
    in-out property <string> theme-error-text: "";
    in-out property <string> home-active-theme-name: "";

    // Countdown (auto-minimize when it loses focus)
    in-out property <bool> countdown-active: false;
    in-out property <int> countdown-seconds: 5;
    in-out property <float> countdown-progress: 1.0;

    // ── HVE shell state mirrors (delivery 4/5) ──
    // Written by the Rust Shell, read by ShellRoot.
    in-out property <int> mounted-screen: 0;
    in-out property <bool> expanded: false;
    in-out property <int> focused-card: 0;

    // ── Panel responsive breakpoint (two settings panes side by side) ──
    // The panel is FULL-BLEED (100% of the window: see the panel container in
    // shell.slint) and the rail takes 160px +1px divider, so the section
    // content width is `window - 161px`. Switch to two panes when the section
    // has at least ~520px to split; below that the panes stack into one
    // column. Computed from the WINDOW width (external, not layout-derived) so
    // it cannot loop with the panel layout. Single source of truth — tune the
    // threshold here.
    //
    // 852px is kept, deliberately: at the full-bleed width the original
    // "~520px of content" rule would land at a 681px window, i.e. below the
    // 800px window minimum, which would leave the stacked layout unreachable
    // and the narrow-window renders meaningless. 852px means the panel stacks
    // in the 800-851px band and splits from 852px up (691px of content).
    property <length> panel-two-col-min-window: 852px;
    property <bool> panel-two-col: root.width >= root.panel-two-col-min-window;

    // ── Shell chrome i18n strings (nav-shell spec R5) ──
    in property <string> shell-brand-text: "HVE";
    in property <string> shell-brand-subtitle: "Hyprland Visual Editor";
    in property <string> shell-status-text: "Ready";
    in property <string> shell-back-hint: "Esc hides";
    // Bottom-bar shortcut list, one string per context (keyboard-shortcuts-footer).
    // Rust fills them from the i18n `shell.shortcuts.*` keys; the shell derives
    // `shell-shortcuts` (read-only) from the current context.
    in property <string> shell-shortcuts-home: "";
    in property <string> shell-shortcuts-slider: "";
    in property <string> shell-shortcuts-mosaic: "";
    in property <string> shell-shortcuts-panel: "";
    out property <string> shell-shortcuts: shell.shortcuts-hint;
    in property <string> shell-home-hint: "Home — theme cards land in module 2";
    in property <string> shell-gallery-hint: "Gallery slot — module 2";
    in property <string> shell-workshop-hint: "Workshop slot — module 4";

    // ── Shell navigation callbacks (nav-shell spec R4; design D8) ──
    callback card-activated(screen: int);
    callback back-activated();
    callback nav-move(direction: string);

    // ── Gallery wiring (PR4.5 + V3 strip) — visible gallery ──
    in-out property <int> gallery-style: 0;
    in-out property <int> gallery-focused: 0;
    in property <[GalleryCardData]> gallery-cards;
    // Two behind-drawers state mirrors (Ctrl+Up -> Settings, Ctrl+Down -> Slider/Mosaic;
    // the mouse arrow buttons toggle them too)
    in-out property <bool> gallery-top-open: false;
    in-out property <bool> gallery-bottom-open: false;
    // V3 relative strip tiles (center=0) + strip-offset/rebasing for fluid directional slide.
    in property <[SliceTileData]> gallery-slice-tiles;
    in-out property <float> gallery-slice-focus-pos: 0.0;
    in-out property <int> gallery-slice-delta-base: 0;
    in-out property <bool> gallery-slice-rebasing: false;
    // Justified-rows Mosaic geometry (Rust-computed), piped like cards.
    in property <[MosaicTileData]> gallery-mosaic-tiles;
    // Tramo 9: frozen copy of the outgoing page tiles (under layer for curtain).
    in property <[MosaicTileData]> gallery-mosaic-under-tiles;
    // Mosaic pagination mirrors (Rust page model is the source of truth).
    in property <int> gallery-mosaic-current-page: 0;
    in property <int> gallery-mosaic-total-pages: 1;
    in property <[int]> gallery-mosaic-page-numbers;
    in property <bool> gallery-empty: false;
    in property <string> gallery-empty-text: "No themes yet. Save your current setup as a theme.";
    in property <string> gallery-mit-footer: "Visual language translated from skwd-wall (MIT, © liixini) https://github.com/liixini/skwd-wall";
    in property <string> gallery-mit-link: "https://github.com/liixini/skwd-wall";
    in property <bool> gallery-reduced-motion: false;
    // Theme info panel (right-click on a Slider card / the `i` key): the data
    // is read from each theme's own saved records by Rust, and Rust owns
    // `gallery-info-open` so open and close travel one way.
    in property <ThemeInfoData> gallery-info;
    in-out property <bool> gallery-info-open: false;
    in-out property <int> gallery-info-index: -1;
    // Mosaic: the keyboard cursor and the tile grown into the Slider card
    // (positions in the current page, -1 = none). Rust owns both, because the
    // wall's layout — and therefore where a move lands — lives in Rust.
    in-out property <int> gallery-mosaic-cursor: -1;
    in-out property <int> gallery-mosaic-selected: -1;
    // The two beats of the grown tile, sequenced by Rust: beat 1 the tile has
    // grown into the card, beat 2 the info face is out inside it.
    in-out property <bool> gallery-mosaic-card-open: false;
    in-out property <bool> gallery-mosaic-face-open: false;
    callback gallery-mosaic-nav(direction: string);
    callback gallery-mosaic-activate();
    callback gallery-mosaic-select(pos: int);
    callback gallery-mosaic-deselect();
    callback gallery-mosaic-cursor-requested(pos: int);
    callback gallery-style-selected(int);
    callback gallery-card-clicked(int);
    callback gallery-card-right-clicked(int);
    callback gallery-wheel-step(int);
    callback gallery-mosaic-page-step(int);
    callback gallery-mit-open();
    callback gallery-info-requested(int);
    callback gallery-info-close();
    // Stage geometry events piped from GalleryRoot through ShellRoot
    // (logical lengths) — drives the mosaic tiles recompute.
    callback gallery-stage-geometry-changed(length, length);

    // ── Mutating panel (slice 1 skeleton + slice 2 Save R10 + slice 3 Borders pick + slice 4 tune color-gated + slice 5 Motion + slice 6 Filters) ──
    in-out property <int> panel-section: 0;
    // Keyboard R11 v3 render hooks (headless tests): -1/false = keyboard-driven.
    in-out property <int> panel-kbd-preview-index: -1;
    in-out property <bool> panel-kbd-preview-engaged: false;
    in-out property <bool> is-mutating: false;
    in-out property <bool> is-panel-open: false;
    in-out property <string> panel-save-input: "";
    in-out property <string> panel-save-error: "";
    in property <string> panel-save-placeholder: "Theme name…";
    in property <string> panel-save-button-text: "Save";
    in property <string> panel-save-list-title: "My Themes";
    in property <string> panel-save-search-placeholder: "Search themes...";
    in property <string> panel-save-empty-text: "No themes yet.";
    in property <string> panel-save-apply-text: "Apply";
    in property <string> panel-save-refresh-text: "Refresh";
    in property <string> panel-save-rename-text: "Rename";
    in property <string> panel-save-delete-text: "Delete";
    in-out property <string> panel-save-search-query: "";
    in property <string> panel-save-rename-title: "Rename theme";
    in property <string> panel-save-confirm-delete: "Delete theme";
    in property <string> panel-save-confirm-delete-msg: "Are you sure you want to delete";
    in property <string> panel-save-confirm-refresh: "Refresh theme";
    in property <string> panel-save-confirm-refresh-msg: "This will reload the theme with the current configuration. Continue?";
    in property <string> panel-save-overwrite-title: "Overwrite theme";
    in property <string> panel-save-overwrite-msg: "already exists. Overwrite it with the current setup?";
    in property <string> panel-save-cancel-text: "Cancel";
    in-out property <string> panel-save-dialog-mode: "";
    in-out property <string> panel-save-dialog-target: "";
    in property <int> panel-save-focused-index: -1;
    in-out property <float> bezier-a: 0.25;
    in-out property <float> bezier-b: 0.1;
    in-out property <float> bezier-c: 0.25;
    in-out property <float> bezier-d: 1.0;
    // Motion tune — global model (Phase 2): one speed, one style family, and a
    // Motion-owned dirty flag (distinct from Borders' `tune-dirty`).
    in-out property <float> anim-speed: 2.0;
    in-out property <string> anim-style: "slide";
    in-out property <bool> motion-dirty: false;
    callback panel-back();
    callback panel-section-selected(int);
    callback panel-mouse-trace(string);
    callback panel-focus-trace(string);
    callback panel-save-nav(int);
    callback panel-save-focus-requested(int);
    callback panel-save-theme(string);
    callback panel-rename-saved-theme(string, string);
    callback panel-delete-saved-theme(string);
    callback panel-refresh-saved-theme();
    callback panel-overwrite-saved-theme(string);
    callback panel-save-search-changed(string);
    callback panel-apply-saved-theme(int);
    callback panel-apply-border(int, string);
    callback panel-apply-geometry(int, int, int, int);
    callback panel-apply-animation(int, string);
    callback panel-apply-shader(int, string);
    callback panel-save-border-preset(string);
    callback panel-rename-border-preset(string, string);
    callback panel-delete-border-preset(string);
    callback panel-tune-changed([string], int, string, string, string, bool);
    // Border slot management
    callback panel-add-color-slot();
    callback panel-remove-color-slot();
    callback panel-save-animation-preset(string);
    callback panel-rename-animation-preset(string, string);
    callback panel-delete-animation-preset(string);


    // ── Settings (panel System reuses these rows) ──
    // settings-open / toggle-settings removed — overlay deleted, rows live in SystemSection
    in-out property <bool> auto-minimize: true;
    in-out property <int> minimize-seconds: 5;
    in property <string> language: "en";
    in-out property <bool> tiling-mode: false;
    in-out property <bool> autostart: false;
    in property <string> theme: "system";
    in-out property <bool> restart-required: false;

    // ── Callbacks ──
    callback toggle-system(bool);
    callback close-button-clicked();
    callback toggle-auto-minimize(bool);
    callback change-minimize-seconds(int);
    callback change-language(string);
    callback toggle-tiling-mode(bool);
    callback toggle-autostart(bool);
    callback change-theme(string);
    callback reset-presets();
    callback restart-app();
    callback open-docs();

    // ── Legacy held-key nav (legacy_tab) — REMOVED slice 8 (R8) ──
    // Panel sections handle their own FocusScope keyboard nav (R11).

    // ── HVE shell mount (delivery 4/5 + PR4.5 gallery wiring) ──
    shell := ShellRoot {
        width: 100%;
        height: 100%;
        opacity: root.theme-fade;
        mounted-screen: root.mounted-screen;
        expanded: root.expanded;
        focused-card: root.focused-card;
        brand-text: root.shell-brand-text;
        brand-subtitle: root.shell-brand-subtitle;
        logo-image: root.logo-image;
        status-text: root.shell-status-text;
        back-hint: root.shell-back-hint;
        shortcuts-home: root.shell-shortcuts-home;
        shortcuts-slider: root.shell-shortcuts-slider;
        shortcuts-mosaic: root.shell-shortcuts-mosaic;
        shortcuts-panel: root.shell-shortcuts-panel;
        slot-home-hint: root.shell-home-hint;
        slot-gallery-hint: root.shell-gallery-hint;
        slot-workshop-hint: root.shell-workshop-hint;
        card-activated(screen) => { root.card-activated(screen); }
        back-activated => { root.back-activated(); }
        nav-move(direction) => { root.nav-move(direction); }
        gallery-style: root.gallery-style;
        gallery-focused: root.gallery-focused;
        gallery-cards: root.gallery-cards;
        gallery-slice-tiles: root.gallery-slice-tiles;
        gallery-slice-focus-pos: root.gallery-slice-focus-pos;
        gallery-slice-delta-base: root.gallery-slice-delta-base;
        gallery-slice-rebasing: root.gallery-slice-rebasing;
        gallery-mosaic-tiles: root.gallery-mosaic-tiles;
        gallery-mosaic-under-tiles: root.gallery-mosaic-under-tiles;
        gallery-mosaic-current-page: root.gallery-mosaic-current-page;
        gallery-mosaic-total-pages: root.gallery-mosaic-total-pages;
        gallery-mosaic-page-numbers: root.gallery-mosaic-page-numbers;
        gallery-empty: root.gallery-empty;
        gallery-empty-text: root.gallery-empty-text;
        gallery-mit-footer: root.gallery-mit-footer;
        gallery-mit-link: root.gallery-mit-link;
        gallery-reduced-motion: root.gallery-reduced-motion;
        gallery-info: root.gallery-info;
        gallery-info-open <=> root.gallery-info-open;
        gallery-info-index <=> root.gallery-info-index;
        gallery-mosaic-cursor <=> root.gallery-mosaic-cursor;
        gallery-mosaic-selected <=> root.gallery-mosaic-selected;
        gallery-mosaic-card-open <=> root.gallery-mosaic-card-open;
        gallery-mosaic-face-open <=> root.gallery-mosaic-face-open;
        gallery-top-open <=> root.gallery-top-open;
        gallery-bottom-open <=> root.gallery-bottom-open;
        panel-section: root.panel-section;
        panel-two-col: root.panel-two-col;
        panel-kbd-preview-index: root.panel-kbd-preview-index;
        panel-kbd-preview-engaged: root.panel-kbd-preview-engaged;
        is-mutating: root.is-mutating;
        is-panel-open: root.is-panel-open;
