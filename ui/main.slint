import { NavModule, HveColors } from "./theme.slint";
import { NavButton, CloseButton, SettingsButton, SettingsPanel, AboutItem } from "./components.slint";
import {
    HomeModule,
    AnimationsModule,
    BordersModule,
    ShadersModule,
    ThemesModule,
} from "./modules.slint";

// ─── MAIN WINDOW ────────────────────────────────────────────────────
export component MainWindow inherits Window {
    title: "Hyprland Visual Editor";
    min-width: 800px;
    min-height: 580px;
    preferred-width: 900px;
    preferred-height: 680px;
    default-font-family: "Inter, sans-serif";

    // ── Theme (re-exported so Rust can set them via window.set_*) ──
    in-out property <color> bg-dark <=> HveColors.bg-dark;
    in-out property <color> bg-surface <=> HveColors.bg-surface;
    in-out property <color> bg-card <=> HveColors.bg-card;
    in-out property <color> bg-hover <=> HveColors.bg-hover;
    in-out property <color> text <=> HveColors.text;
    in-out property <color> text-muted <=> HveColors.text-muted;
    in-out property <color> accent-cyan <=> HveColors.accent-cyan;
    in-out property <color> accent-amber <=> HveColors.accent-amber;
    in-out property <color> accent-green <=> HveColors.accent-green;
    in-out property <color> accent-purple <=> HveColors.accent-purple;
    in-out property <color> accent-pink <=> HveColors.accent-pink;
    in-out property <color> accent-red <=> HveColors.accent-red;
    in-out property <color> border <=> HveColors.border;

    background: HveColors.bg-dark;

    // ── State ──
    in-out property <int> active-tab: 0;
    in-out property <bool> nav-ready: true;
    in-out property <int> anim-focused-index: -1;
    in-out property <int> border-focused-index: -1;
    in-out property <int> shader-focused-index: -1;
    in-out property <int> theme-focused-index: -1;
    property <bool> sidebar-mode: anim-focused-index == -1 && border-focused-index == -1 && shader-focused-index == -1 && theme-focused-index == -1;

    // ── Held-key navigation state ──
    property <bool> _nav-down-held: false;
    property <bool> _nav-up-held: false;
    property <int> _nav-repeat-interval: 150;  // ms between repeats once the OS confirms the hold
    property <bool> _nav-repeat-active: false; // true once OS auto-repeat confirms the hold
    property <bool> _nav-rapid: false;         // true during OS-confirmed repeat (fast expand)

    in property <[NavModule]> nav-modules;
    in-out property <bool> system-active: false;
    in property <image> logo-image;

    // ── i18n strings ──
    in property <string> sidebar-subtitle;
    in property <string> home-header-title;
    in property <string> home-header-subtitle;
    in property <string> activation-title;
    in property <string> activation-active-text;
    in property <string> activation-inactive-text;
    in property <string> feature-title;
    in property <string> feature-desc;
    in property <string> how-title;
    in property <string> how-desc;
    in property <string> anim-header-title;
    in property <string> anim-header-subtitle;
    in property <string> border-header-title;
    in property <string> border-header-subtitle;
    in property <string> border-geometry-label;
    in property <string> shader-header-title;
    in property <string> shader-header-subtitle;
    // ── i18n: Home strings ──
    in property <string> home-status-active;
    in property <string> home-status-inactive;
    in property <string> home-nav-animations;
    in property <string> home-nav-borders;
    in property <string> home-nav-shaders;
    in property <string> home-count-styles;
    in property <string> home-count-filters;
    in property <string> home-active-config-title;
    in property <string> home-active-anim-label;
    in property <string> home-active-border-label;
    in property <string> home-active-shader-label;
    in property <string> home-active-theme-label;
    in property <string> home-none-theme;
    in property <string> home-none-anim;
    in property <string> home-none-border;
    in property <string> home-none-shader;
    in property <string> home-about-title;
    in property <string> home-about-short;
    in property <string> home-about-full;
    in property <[AboutItem]> home-about-items;
    in property <string> home-about-tree-label;
    in property <[string]> home-about-tree-paths;
    in property <[string]> home-about-tree-descs;
    in property <string> home-about-tree-path-max;
    in property <string> home-about-docs-label;
    // ── i18n: Settings strings ──
    in property <string> settings-restart-banner;
    in property <string> settings-restart-button;
    in property <string> settings-title;
    in property <string> auto-minimize-label;
    in property <string> timer-label;
    in property <string> language-label;
    in property <string> tiling-label;
    in property <string> autostart-label;
    in property <string> theme-label;
    in property <string> reset-label;
    in property <string> keybinds-label;

    // Animation data
    in property <[string]> anim-titles;
    in property <[string]> anim-descs;
    in property <[string]> anim-tags;
    in property <[string]> anim-files;
    in-out property <int> active-anim-index: -1;

    // Border data
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in-out property <int> active-border-index: -1;
    in-out property <int> border-size: 2;
    in-out property <int> corner-radius: 32;
    in property <string> border-radius-label;
    in-out property <int> gap-in: 5;
    in-out property <int> gap-out: 5;
    in property <string> gap-in-label;
    in property <string> gap-out-label;

    // Shader data
    in property <[string]> shader-titles;
    in property <[string]> shader-descs;
    in property <[string]> shader-tags;
    in property <[string]> shader-files;
    in-out property <int> active-shader-index: -1;

    // Theme data
    in-out property <[string]> theme-names;
    in-out property <[string]> theme-saved-ats;
    in-out property <[bool]> theme-is-actives;
    in-out property <int> active-theme-index: -1;
    in-out property <bool> theme-busy: false;
    in property <string> theme-header-title;
    in property <string> theme-header-subtitle;
    in property <string> theme-save-placeholder;
    in property <string> theme-save-button;
    in property <string> theme-search-placeholder;
    in property <string> theme-empty-text;
    in property <string> theme-apply-text;
    in property <string> theme-rename-text;
    in property <string> theme-delete-text;
    in property <string> theme-cancel-text;
    in property <string> theme-confirm-delete;
    in property <string> theme-confirm-delete-msg;
    in property <string> theme-confirm-refresh;
    in property <string> theme-confirm-refresh-msg;
    in property <string> theme-refresh-text;
    in property <string> theme-rename-title;
    in property <string> theme-save-section-text;
    in property <string> theme-list-section-text;
    in property <string> app-version-label;
    in-out property <string> theme-error-text: "";
    in-out property <string> home-active-theme-name: "";

    // Countdown (auto-minimize cuando pierde foco)
    in-out property <bool> countdown-active: false;
    in-out property <int> countdown-seconds: 5;
    in-out property <float> countdown-progress: 1.0;

    // ── Settings ──
    in-out property <bool> settings-open: false;
    in-out property <bool> auto-minimize: true;
    in-out property <int> minimize-seconds: 5;
    in property <string> language: "en";
    in-out property <bool> tiling-mode: false;
    in property <bool> keybinds-mode: false;
    in-out property <bool> autostart: false;
    in property <string> theme: "system";
    in-out property <bool> restart-required: false;

    // ── Callbacks ──
    callback toggle-system(bool);
    callback apply-animation(int, string);
    callback apply-border(int, string);
    callback apply-shader(int, string);
    callback apply-geometry(int);
    callback apply-geometry-radius(int);
    callback apply-geometry-gaps-in(int);
    callback apply-geometry-gaps-out(int);
    callback close-button-clicked();
    callback toggle-settings();
    callback toggle-auto-minimize(bool);
    callback change-minimize-seconds(int);
    callback change-language(string);
    callback toggle-tiling-mode(bool);
    callback toggle-keybinds(bool);
    callback toggle-autostart(bool);
    callback change-theme(string);
    callback reset-presets();
    callback restart-app();
    callback save-theme(string);
    callback apply-theme(string);
    callback delete-theme(string);
    callback rename-theme(string, string);
    callback overwrite-theme(string);
    callback refresh-themes();
    callback search-query-changed(string);
    callback open-docs();

    // ── Keyboard step helpers (called once per press, then on 120ms timer while held) ──
    function step-down() {
        if (root.active-tab == 1 && root.anim-focused-index >= 0) {
            if (root.anim-focused-index >= root.anim-titles.length - 1) {
                root.anim-focused-index = 0;
            } else {
                root.anim-focused-index += 1;
            }
        } else if (root.active-tab == 2 && root.border-focused-index >= 0) {
            if (root.border-focused-index >= root.border-titles.length - 1) {
                root.border-focused-index = 0;
            } else {
                root.border-focused-index += 1;
            }
        } else if (root.active-tab == 3 && root.shader-focused-index >= 0) {
            if (root.shader-focused-index >= root.shader-titles.length - 1) {
                root.shader-focused-index = 0;
            } else {
                root.shader-focused-index += 1;
            }
        } else if (root.active-tab == 4 && root.theme-focused-index >= 0) {
            if (root.theme-focused-index >= root.theme-names.length - 1) {
                root.theme-focused-index = 0;
            } else {
                root.theme-focused-index += 1;
            }
        } else {
            if (root.active-tab >= 4) {
                root.active-tab = 0;
            } else {
                root.active-tab += 1;
            }
        }
    }
    function step-up() {
        if (root.active-tab == 1 && root.anim-focused-index >= 0) {
            if (root.anim-focused-index <= 0) {
                root.anim-focused-index = root.anim-titles.length - 1;
            } else {
                root.anim-focused-index -= 1;
            }
        } else if (root.active-tab == 2 && root.border-focused-index >= 0) {
            if (root.border-focused-index <= 0) {
                root.border-focused-index = root.border-titles.length - 1;
            } else {
                root.border-focused-index -= 1;
            }
        } else if (root.active-tab == 3 && root.shader-focused-index >= 0) {
            if (root.shader-focused-index <= 0) {
                root.shader-focused-index = root.shader-titles.length - 1;
            } else {
                root.shader-focused-index -= 1;
            }
        } else if (root.active-tab == 4 && root.theme-focused-index >= 0) {
            if (root.theme-focused-index <= 0) {
                root.theme-focused-index = root.theme-names.length - 1;
            } else {
                root.theme-focused-index -= 1;
            }
        } else {
            if (root.active-tab <= 0) {
                root.active-tab = 4;
            } else {
                root.active-tab -= 1;
            }
        }
    }

    // ── Root FocusScope — centralized keyboard handler ──
    forward-focus: root-kbd;

    root-kbd := FocusScope {
        // ── Down/Up: navigate presets (or cycle tabs in sidebar mode).
        // A first press steps immediately. The OS auto-repeat (event.repeat)
        // confirms a hold; only then does this Timer take over the repeat
        // cadence (150ms inside a module, 300ms between tabs). Starting the
        // Timer on the first press caused a premature second step at 400ms —
        // the "jumps two tabs" bug. ──
        Timer {
            interval: root._nav-repeat-interval * 1ms;
            running: root._nav-repeat-active;
            triggered => {
                if (root._nav-down-held) {
                    root.step-down();
                }
                if (root._nav-up-held) {
                    root.step-up();
                }
            }
        }

        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                if (root.nav-ready && !root._nav-down-held) {
                    root._nav-down-held = true;
                    root.step-down();
                } else if (root.nav-ready && event.repeat && root._nav-down-held && !root._nav-repeat-active) {
                    // OS confirmed the hold → take over repeat cadence
                    root._nav-repeat-active = true;
                    root._nav-rapid = true;
                    root._nav-repeat-interval = root.sidebar-mode ? 300 : 150;
                }
                accept
            } else if (event.text == Key.UpArrow) {
                if (root.nav-ready && !root._nav-up-held) {
                    root._nav-up-held = true;
                    root.step-up();
                } else if (root.nav-ready && event.repeat && root._nav-up-held && !root._nav-repeat-active) {
                    root._nav-repeat-active = true;
                    root._nav-rapid = true;
                    root._nav-repeat-interval = root.sidebar-mode ? 300 : 150;
                }
                accept
            } else {
                reject
            }
        }

        key-released(event) => {
            if (event.text == Key.DownArrow) {
                root._nav-down-held = false;
                root._nav-repeat-active = false;
                root._nav-rapid = false;
                accept
            } else if (event.text == Key.UpArrow) {
                root._nav-up-held = false;
                root._nav-repeat-active = false;
                root._nav-rapid = false;
                accept
            } else {
                reject
            }
        }

        // Reset nav state when focus leaves or returns (e.g. tray menu steals
        // keyboard focus on Wayland — a held arrow key's release never reaches
        // us and would wedge the repeat timer otherwise).
        focus-lost => {
            root._nav-down-held = false;
            root._nav-up-held = false;
            root._nav-repeat-active = false;
            root._nav-rapid = false;
        }

        focus-gained => {
            root._nav-down-held = false;
            root._nav-up-held = false;
            root._nav-repeat-active = false;
            root._nav-rapid = false;
        }

        // Right: enter module (select active preset, fallback first)
        KeyBinding {
            keys: @keys(RightArrow);
            enabled: root.nav-ready && root.active-tab != 0 && root.active-tab <= 4;
            activated => {
                if (root.active-tab == 1) {
                    root.anim-focused-index = root.active-anim-index >= 0 ? root.active-anim-index : 0;
                } else if (root.active-tab == 2) {
                    root.border-focused-index = root.active-border-index >= 0 ? root.active-border-index : 0;
                } else if (root.active-tab == 3) {
                    root.shader-focused-index = root.active-shader-index >= 0 ? root.active-shader-index : 0;
                } else if (root.active-tab == 4) {
                    root.theme-focused-index = root.active-theme-index >= 0 ? root.active-theme-index : 0;
                }
            }
        }

        // Left: exit module (back to tab nav)
        KeyBinding {
            enabled: root.nav-ready;
            keys: @keys(LeftArrow);
            activated => {
                root.anim-focused-index = -1;
                root.border-focused-index = -1;
                root.shader-focused-index = -1;
                root.theme-focused-index = -1;
            }
        }

        // Enter: toggle preset if inside module
        KeyBinding {
            enabled: root.nav-ready;
            keys: @keys(Return);
            activated => {
                if (root.active-tab == 1 && root.anim-focused-index >= 0) {
                    root.apply-animation(root.anim-focused-index, root.anim-files[root.anim-focused-index]);
                } else if (root.active-tab == 2 && root.border-focused-index >= 0) {
                    root.apply-border(root.border-focused-index, root.border-files[root.border-focused-index]);
                } else if (root.active-tab == 3 && root.shader-focused-index >= 0) {
                    root.apply-shader(root.shader-focused-index, root.shader-files[root.shader-focused-index]);
                } else if (root.active-tab == 4 && root.theme-focused-index >= 0) {
                    root.apply-theme(root.theme-names[root.theme-focused-index]);
                }
            }
        }

        // Space: toggle preset if inside module
        KeyBinding {
            keys: @keys(Space);
            activated => {
                if (root.active-tab == 1 && root.anim-focused-index >= 0) {
                    root.apply-animation(root.anim-focused-index, root.anim-files[root.anim-focused-index]);
                } else if (root.active-tab == 2 && root.border-focused-index >= 0) {
                    root.apply-border(root.border-focused-index, root.border-files[root.border-focused-index]);
                } else if (root.active-tab == 3 && root.shader-focused-index >= 0) {
                    root.apply-shader(root.shader-focused-index, root.shader-files[root.shader-focused-index]);
                } else if (root.active-tab == 4 && root.theme-focused-index >= 0) {
                    root.apply-theme(root.theme-names[root.theme-focused-index]);
                }
            }
        }
    }

    Rectangle {
        // ── Main content (sidebar + content area) ──
        HorizontalLayout {
            // ── Sidebar ──
            Rectangle {
                width: 240px;
                background: HveColors.bg-surface;

                // Sombra lateral para separar del contenido
                drop-shadow-blur: 15px;
                drop-shadow-color: #00000040;
                drop-shadow-offset-x: 5px;

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 12px;

                    // Logo anclado en la zona superior (sin alignment vertical)
                    VerticalLayout {
                        padding-top: 28px;
                        padding-bottom: 12px;
                        spacing: 8px;

                        // Contenedor del logo centrado horizontalmente
                        HorizontalLayout {
                            alignment: center;

                            Rectangle {
                                width: 140px;
                                height: 73px;

                                Image {
                                    source: root.logo-image;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                            }
                        }

                        // Subtitle "Hyprland Visual Editor" centrado horizontalmente
                        HorizontalLayout {
                            alignment: center;
                            spacing: 0px;

                            Text { text: "H"; color: HveColors.accent-amber; font-weight: 700; font-size: 14px; }
                            Text { text: "yprland "; color: HveColors.text-muted; font-size: 14px; }
                            Text { text: "V"; color: HveColors.accent-purple; font-weight: 700; font-size: 14px; }
                            Text { text: "isual "; color: HveColors.text-muted; font-size: 14px; }
                            Text { text: "E"; color: HveColors.accent-green; font-weight: 700; font-size: 14px; }
                            Text { text: "ditor"; color: HveColors.text-muted; font-size: 14px; }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: HveColors.border;
                    }

                    // Nav (data-driven from Rust)
                    for nav-module in root.nav-modules: NavButton {
                        label: nav-module.label;
                        icon-text: nav-module.icon;
                        accent: nav-module.accent;
                        selected: root.active-tab == nav-module.tab-index;
                        sidebar-mode: root.sidebar-mode;
                        clicked => {
                            root.anim-focused-index = -1;
                            root.border-focused-index = -1;
                            root.shader-focused-index = -1;
                            root.theme-focused-index = -1;
                            root.active-tab = nav-module.tab-index;
                        }
                    }

                    // Spacer variable: absorbe el espacio extra debajo de los nav buttons
                    Rectangle {
                        vertical-stretch: 1;
                    }

                    Rectangle {
                        height: 1px;
                        background: HveColors.border;
                    }

                    // ── Gear button + version ──
                    HorizontalLayout {
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: start;

                        SettingsButton {
                            settings-open: root.settings-open;
                            clicked => { root.toggle-settings(); }
                        }

                        Text {
                            text: root.app-version-label;
                            color: HveColors.text-muted;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                    }

                }
            }

            // ── Sidebar right border ──
            Rectangle {
                width: 1px;
                background: HveColors.border;
            }

            // ── Content ──
            Rectangle {
                background: HveColors.bg-dark;
                vertical-stretch: 1;

                // ── Home ──────────────────────────────────────────────────
                Rectangle {
                    width: root.active-tab == 0 ? 100% : 0%;
                    height: root.active-tab == 0 ? 100% : 0%;
                    clip: true;

                    HomeModule {
                        width: 100%;
                        height: 100%;
                        anim-titles: root.anim-titles;
                        border-titles: root.border-titles;
                        shader-titles: root.shader-titles;
                        active-anim-index: root.active-anim-index;
                        active-border-index: root.active-border-index;
                        active-shader-index: root.active-shader-index;
                        activation-title: root.activation-title;
                        activation-active-text: root.activation-active-text;
                        activation-inactive-text: root.activation-inactive-text;
                        system-active: root.system-active;
                        // i18n wired properties
                        status-active: root.home-status-active;
                        status-inactive: root.home-status-inactive;
                        nav-animations: root.home-nav-animations;
                        nav-borders: root.home-nav-borders;
                        nav-shaders: root.home-nav-shaders;
                        count-styles: root.home-count-styles;
                        count-filters: root.home-count-filters;
                        active-config-title: root.home-active-config-title;
                        active-anim-label: root.home-active-anim-label;
                        active-border-label: root.home-active-border-label;
                        active-shader-label: root.home-active-shader-label;
                        active-theme-label: root.home-active-theme-label;
                        none-anim: root.home-none-anim;
                        none-border: root.home-none-border;
                        none-shader: root.home-none-shader;
                        none-theme: root.home-none-theme;
                        active-theme-name: root.home-active-theme-name;
                        about-title: root.home-about-title;
                        about-short: root.home-about-short;
                        about-full: root.home-about-full;
                        about-items: root.home-about-items;
                        about-tree-label: root.home-about-tree-label;
                        about-tree-paths: root.home-about-tree-paths;
                        about-tree-descs: root.home-about-tree-descs;
                        about-tree-path-max: root.home-about-tree-path-max;
                        about-docs-label: root.home-about-docs-label;
                        toggle-system(v) => { root.toggle-system(v); }
                        navigate-to(tab) => {
                            root.anim-focused-index = -1;
                            root.border-focused-index = -1;
                            root.shader-focused-index = -1;
                            root.theme-focused-index = -1;
                            root.active-tab = tab;
                        }
                        open-docs => { root.open-docs(); }
                    }
                }

                // ── Animaciones ──────────────────────────────────────
                Rectangle {
                    width: root.active-tab == 1 ? 100% : 0%;
                    height: root.active-tab == 1 ? 100% : 0%;
                    clip: true;

                    AnimationsModule {
                        width: 100%;
                        height: 100%;
                        header-title: root.anim-header-title;
                        header-subtitle: root.anim-header-subtitle;
                        anim-titles: root.anim-titles;
                        anim-descs: root.anim-descs;
                        anim-tags: root.anim-tags;
                        anim-files: root.anim-files;
                        active-index: root.active-anim-index;
                        focused-index: root.anim-focused-index;
                        is-active: root.active-tab == 1;
                        fast-expand: root._nav-rapid;
                        focus-requested(idx) => { root.anim-focused-index = idx; }
                        anim-toggled(idx, file) => { root.apply-animation(idx, file); }
                    }
                }

                // ── Bordes ───────────────────────────────────────────
                Rectangle {
                    width: root.active-tab == 2 ? 100% : 0%;
                    height: root.active-tab == 2 ? 100% : 0%;
                    clip: true;

                    BordersModule {
                        width: 100%;
                        height: 100%;
                        header-title: root.border-header-title;
                        header-subtitle: root.border-header-subtitle;
                        geometry-label: root.border-geometry-label;
                        border-titles: root.border-titles;
                        border-descs: root.border-descs;
                        border-tags: root.border-tags;
                        border-files: root.border-files;
                        active-index: root.active-border-index;
                        border-size: root.border-size;
                        corner-radius: root.corner-radius;
                        border-radius-label: root.border-radius-label;
                        gap-in: root.gap-in;
                        gap-out: root.gap-out;
                        gap-in-label: root.gap-in-label;
                        gap-out-label: root.gap-out-label;
                        focused-index: root.border-focused-index;
                        is-active: root.active-tab == 2;
                        fast-expand: root._nav-rapid;
                        focus-requested(idx) => { root.border-focused-index = idx; }
                        border-toggled(idx, file) => { root.apply-border(idx, file); }
                        geometry-changed(v) => { root.apply-geometry(v); }
                        geometry-radius-changed(v) => { root.apply-geometry-radius(v); }
                        geometry-gaps-in-changed(v) => { root.apply-geometry-gaps-in(v); }
                        geometry-gaps-out-changed(v) => { root.apply-geometry-gaps-out(v); }
                    }
                }

                // ── Shaders ──────────────────────────────────────────
                Rectangle {
                    width: root.active-tab == 3 ? 100% : 0%;
                    height: root.active-tab == 3 ? 100% : 0%;
                    clip: true;

                    ShadersModule {
                        width: 100%;
                        height: 100%;
                        header-title: root.shader-header-title;
                        header-subtitle: root.shader-header-subtitle;
                        shader-titles: root.shader-titles;
                        shader-descs: root.shader-descs;
                        shader-tags: root.shader-tags;
                        shader-files: root.shader-files;
                        active-index: root.active-shader-index;
                        focused-index: root.shader-focused-index;
                        is-active: root.active-tab == 3;
                        fast-expand: root._nav-rapid;
                        focus-requested(idx) => { root.shader-focused-index = idx; }
                        shader-toggled(idx, file) => { root.apply-shader(idx, file); }
                    }
                }

                // ── Themes ──────────────────────────────────────────────
                Rectangle {
                    width: root.active-tab == 4 ? 100% : 0%;
                    height: root.active-tab == 4 ? 100% : 0%;
                    clip: true;

                    ThemesModule {
                        width: 100%;
                        height: 100%;
                        theme-names: root.theme-names;
                        theme-saved-ats: root.theme-saved-ats;
                        theme-is-actives: root.theme-is-actives;
                        is-busy: root.theme-busy;
                        focused-index: root.theme-focused-index;
                        is-active: root.active-tab == 4;
                        fast-expand: root._nav-rapid;
                        active-index: root.active-theme-index;
                        focus-requested(idx) => { root.theme-focused-index = idx; }
                        header-title: root.theme-header-title;
                        header-subtitle: root.theme-header-subtitle;
                        save-placeholder: root.theme-save-placeholder;
                        save-button: root.theme-save-button;
                        search-placeholder: root.theme-search-placeholder;
                        empty-text: root.theme-empty-text;
                        apply-text: root.theme-apply-text;
                        rename-text: root.theme-rename-text;
                        delete-text: root.theme-delete-text;
                        refresh-text: root.theme-refresh-text;
                        cancel-text: root.theme-cancel-text;
                        confirm-delete: root.theme-confirm-delete;
                        confirm-delete-msg: root.theme-confirm-delete-msg;
                        confirm-refresh: root.theme-confirm-refresh;
                        confirm-refresh-msg: root.theme-confirm-refresh-msg;
                        rename-title: root.theme-rename-title;
                        save-section-text: root.theme-save-section-text;
                        list-section-text: root.theme-list-section-text;
                        error-text: root.theme-error-text;
                        save-theme(v) => { root.save-theme(v); }
                        apply-theme(v) => { root.apply-theme(v); }
                        delete-theme(v) => { root.delete-theme(v); }
                        rename-theme(old, new) => { root.rename-theme(old, new); }
                        overwrite-theme(v) => { root.overwrite-theme(v); }
                        refresh-themes => { root.refresh-themes(); }
                        search-query-changed(q) => { root.search-query-changed(q); }
                    }
                }
            }
        }

        // ── Close button floating at top-left (absolute, overlays sidebar) ──
        CloseButton {
            x: 12px;
            y: 12px;
            countdown-active: root.countdown-active;
            countdown-seconds: root.countdown-seconds;
            countdown-progress: root.countdown-progress;
            clicked => { root.close-button-clicked(); }
        }

        // ── Settings Panel overlay ──
        if root.settings-open : SettingsPanel {
            is-open: root.settings-open;
            auto-minimize: root.auto-minimize;
            minimize-seconds: root.minimize-seconds;
            language: root.language;
            tiling-mode: root.tiling-mode;
            keybinds-mode: root.keybinds-mode;
            autostart: root.autostart;
            theme: root.theme;
            restart-banner-text: root.settings-restart-banner;
            restart-button-text: root.settings-restart-button;
            settings-title: root.settings-title;
            auto-minimize-label: root.auto-minimize-label;
            timer-label: root.timer-label;
            language-label: root.language-label;
            tiling-label: root.tiling-label;
            autostart-label: root.autostart-label;
            theme-label: root.theme-label;
            reset-label: root.reset-label;
            keybinds-label: root.keybinds-label;

            restart-required: root.restart-required;
            close-panel => { root.toggle-settings(); }
            toggle-auto-minimize(v) => { root.toggle-auto-minimize(v); }
            change-minimize-seconds(v) => { root.change-minimize-seconds(v); }
            change-language(v) => { root.change-language(v); }
            toggle-tiling-mode(v) => { root.toggle-tiling-mode(v); }
            toggle-keybinds(v) => { root.toggle-keybinds(v); }
            toggle-autostart(v) => { root.toggle-autostart(v); }
            change-theme(v) => { root.change-theme(v); }
            reset-presets => { root.reset-presets(); }
            restart-app => { root.restart-app(); }
        }
    }
}
