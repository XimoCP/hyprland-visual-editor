// Theme — Design tokens for HVE Standalone
// ─── Nav module definition ──────────────────────────────────────────
export struct NavModule {
    label: string,
    icon: string,
    accent: color,
    tab-index: int,
}

// ─── Theme colors (globally accessible, settable from Rust) ──────────
export global HveColors {
    in-out property <color> bg-dark: #0d1117;
    in-out property <color> bg-surface: #161b22;
    in-out property <color> bg-card: #1c2128;
    in-out property <color> bg-hover: #252d38;
    in-out property <color> text: #e6edf3;
    in-out property <color> text-muted: #7d8590;
    in-out property <color> accent-cyan: #38bdf8;
    in-out property <color> accent-amber: #fbbf24;
    in-out property <color> accent-green: #10b981;
    in-out property <color> accent-purple: #c084fc;
    in-out property <color> accent-pink: #f472b6;
    in-out property <color> accent-red: #f87171;
    in-out property <color> border: #30363d;
}
