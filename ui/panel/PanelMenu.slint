// HVE 2 — PanelMenu (mutating-window slice 1 stub).
//
// Left rail for the panel's internal navigation (R2). 5 sections, active
// indicator, keyboard arrows, section-selected callback. Skeleton only —
// visual refinement and focus detail land in later slices.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> has-focus;
    in property <bool> reduced-motion: false;
    callback selected();

    height: 36px;
    background: root.active ? HveColors.accent-cyan : (root.has-focus ? HveColors.bg-card.transparentize(0.2) : transparent);
    border-width: root.has-focus ? 1px : 0px;
    border-color: #8fd8ff;
    border-radius: SkwdTokens.radius-8;
    animate background { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }

    Text {
        text: root.label;
        color: root.active ? HveColors.bg-dark : (root.has-focus ? HveColors.accent-cyan : HveColors.text-muted);
        font-family: SkwdTokens.font-body;
        font-size: SkwdTokens.size-13;
        vertical-alignment: center;
        x: 12px;
    }

    // Active indicator (left accent bar)
    if root.active : Rectangle {
        width: 3px;
        height: 20px;
        y: (parent.height - self.height) / 2;
        x: 0px;
        background: HveColors.accent-cyan;
        border-radius: 2px;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

export component PanelMenu inherits Rectangle {
    in property <int> active-section: 0;
    in property <bool> reduced-motion: false;
    // Keyboard R11 v3 render hook (headless tests): >= 0 pins the focused
    // item for a snapshot; < 0 = keyboard-driven (production).
    in property <int> preview-index: -1;
    callback section-selected(int);
    callback back();
    callback menu-left();
    callback take-focus();

    property <int> menu-index: root.preview-index >= 0 ? root.preview-index : 0;

    // Public focus entry: the content hands focus here with Left (R11 v3
    // spatial model — rail ↔ content, no Tab cycling).
    take-focus => { menu-fs.focus(); }

    menu-fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.back(); return accept; }
            if (event.text == Key.DownArrow) {
                root.menu-index = min(root.menu-index + 1, 4);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.menu-index = max(root.menu-index - 1, 0);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.Return || event.text == Key.Space) {
                root.section-selected(root.menu-index);
                return accept;
            }
            if (event.text == Key.LeftArrow) { root.menu-left(); return accept; }
            return reject;
        }

        VerticalLayout {
            spacing: 4px;
            padding: 12px;

            MenuItem {
                label: "Save";
                active: root.active-section == 0;
                has-focus: (menu-fs.has-focus || root.preview-index >= 0) && root.menu-index == 0;
                reduced-motion: root.reduced-motion;
                selected => { root.section-selected(0); }
            }
            MenuItem {
                label: "Borders";
                active: root.active-section == 1;
                has-focus: (menu-fs.has-focus || root.preview-index >= 0) && root.menu-index == 1;
                reduced-motion: root.reduced-motion;
                selected => { root.section-selected(1); }
            }
            MenuItem {
                label: "Motion";
                active: root.active-section == 2;
                has-focus: (menu-fs.has-focus || root.preview-index >= 0) && root.menu-index == 2;
                reduced-motion: root.reduced-motion;
                selected => { root.section-selected(2); }
            }
            MenuItem {
                label: "Filters";
                active: root.active-section == 3;
                has-focus: (menu-fs.has-focus || root.preview-index >= 0) && root.menu-index == 3;
                reduced-motion: root.reduced-motion;
                selected => { root.section-selected(3); }
            }
            MenuItem {
                label: "System";
                active: root.active-section == 4;
                has-focus: (menu-fs.has-focus || root.preview-index >= 0) && root.menu-index == 4;
                reduced-motion: root.reduced-motion;
                selected => { root.section-selected(4); }
            }
        }
    }
}
