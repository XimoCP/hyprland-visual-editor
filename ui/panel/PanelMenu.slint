// HVE — PanelMenu (presentational left rail).
//
// Left rail for the panel's internal navigation (R2): 5 sections, active
// indicator and keyboard highlight ring. ALL keyboard handling for the
// panel lives in PanelRoot's single `panel-kbd` FocusScope (HVE 1 pattern);
// this component only renders the state it is given and reports mouse
// selections. It owns no FocusScope.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";
import { PanelText } from "panel_text.slint";

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> has-focus;
    in property <bool> reduced-motion: false;
    callback selected();

    height: 36px;
    background: root.active ? HveColors.accent-cyan : (root.has-focus ? HveColors.bg-card.transparentize(0.2) : transparent);
    border-width: root.has-focus ? 2px : 0px;
    border-color: #8fd8ff;
    border-radius: SkwdTokens.radius-8;
    animate background { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }

    Text {
        text: root.label;
        color: root.active ? HveColors.bg-dark : (root.has-focus ? HveColors.accent-cyan : HveColors.text-muted);
        font-family: SkwdTokens.font-body;
        font-size: SkwdTokens.size-13;
        vertical-alignment: center;
        x: 12px;
    }

    // Active indicator (left accent bar)
    if root.active : Rectangle {
        width: 3px;
        height: 20px;
        y: (parent.height - self.height) / 2;
        x: 0px;
        background: HveColors.accent-cyan;
        border-radius: 2px;
    }

    // Keyboard cursor mark: a chevron, so the cursor is unmistakable even
    // when it sits on the already-active (filled) item — the thin ring alone
    // was lost against the cyan fill.
    if root.has-focus : Text {
        text: "▶";
        color: root.active ? HveColors.bg-dark : HveColors.accent-cyan;
        font-size: 12px;
        width: 14px;
        height: root.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: root.width - 22px;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

export component PanelMenu inherits Rectangle {
    in property <int> active-section: 0;
    in property <bool> reduced-motion: false;
    // Keyboard state owned by PanelRoot's single FocusScope. `menu-active`
    // is true only while the rail owns the keyboard cursor; `focused-index`
    // mirrors PanelRoot's `menu-focused-index`.
    in property <bool> menu-active: false;
    in property <int> focused-index: 0;
    // Keyboard R11 v3 render hook (headless tests): >= 0 pins the focused
    // item for a snapshot; < 0 = keyboard-driven (production).
    in property <int> preview-index: -1;
    callback section-selected(int);

    property <int> menu-index: root.preview-index >= 0 ? root.preview-index : root.focused-index;
    // Ring lights while the rail owns the keyboard cursor, or when the
    // headless preview hook pins an item.
    property <bool> keyboard-ring: (root.menu-active && root.preview-index < 0) || root.preview-index >= 0;

    VerticalLayout {
        spacing: 4px;
        padding: 12px;

        MenuItem {
            label: PanelText.nav-save;
            active: root.active-section == 0;
            has-focus: root.keyboard-ring && root.menu-index == 0;
            reduced-motion: root.reduced-motion;
            // 1:1 legacy: mouse NEVER moves keyboard focus — it only changes section.
            // menu-index stays where keyboard left it; active-section drives the highlight.
            selected => { root.section-selected(0); }
        }
        MenuItem {
            label: PanelText.nav-borders;
            active: root.active-section == 1;
            has-focus: root.keyboard-ring && root.menu-index == 1;
            reduced-motion: root.reduced-motion;
            selected => { root.section-selected(1); }
        }
        MenuItem {
            label: PanelText.nav-motion;
            active: root.active-section == 2;
            has-focus: root.keyboard-ring && root.menu-index == 2;
            reduced-motion: root.reduced-motion;
            selected => { root.section-selected(2); }
        }
        MenuItem {
            label: PanelText.nav-filters;
            active: root.active-section == 3;
            has-focus: root.keyboard-ring && root.menu-index == 3;
            reduced-motion: root.reduced-motion;
            selected => { root.section-selected(3); }
        }
        MenuItem {
            label: PanelText.nav-system;
            active: root.active-section == 4;
            has-focus: root.keyboard-ring && root.menu-index == 4;
            reduced-motion: root.reduced-motion;
            selected => { root.section-selected(4); }
        }
    }
}
