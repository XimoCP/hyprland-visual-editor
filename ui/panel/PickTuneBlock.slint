// HVE 2 — PickTuneBlock (mutating-window R3).
//
// Reusable two-layer: pick (cards) above divider, tune below. Visible
// together, scrolling if needed. Pick layer holds PresetCards from
// scan("borders") → apply_border; tune layer is placeholder until slice 4.
// Keyboard: arrows navigate pick, Tab pick→tune, focus icy-cyan #8fd8ff.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";

export component PickTuneBlock inherits Rectangle {
    background: transparent;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        // Scroll container for pick+tune (single window mutates, never stacks)
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 16px;
                // Pick layer is populated by the parent section (e.g. BordersSection)
                // Divider is always present between pick and tune (R3)
                // Tune placeholder is below the divider (visible together, no tabs)
            }
        }
    }

    // Divider style reference (used by BordersSection):
    // Rectangle { height: 1px; background: SkwdTokens.outline.transparentize(0.6); }
}
