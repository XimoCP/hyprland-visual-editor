// HVE 2 — CurvePreview (mutating-window R4).
//
// Mini Path bezier preview fed a,b,c,d (cubic-bezier). 120×48, SkwdTokens
// colors, redraws on slider changed via property binding.
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";

export component CurvePreview inherits Rectangle {
    in property <float> a: 0.25;
    in property <float> b: 0.1;
    in property <float> c: 0.25;
    in property <float> d: 1.0;
    // Control-point dot diameter. Defaults to a value derived from the element
    // height so the dots stay visible when the preview is enlarged (e.g. the
    // 260×120 Motion header preview gets ~10px dots instead of the old 6px).
    in property <length> dot-size: max(6px, self.height / 12);

    width: 120px;
    height: 48px;
    background: HveColors.bg-card;
    border-radius: SkwdTokens.radius-8;
    border-width: 1px;
    border-color: HveColors.border.transparentize(0.6);
    clip: true;

    // faint diagonal guide
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 120;
        viewbox-height: 48;
        stroke: HveColors.text-muted.transparentize(0.7);
        stroke-width: 1px;
        fill: transparent;
        MoveTo { x: 0; y: 48; }
        LineTo { x: 120; y: 0; }
    }

    // bezier curve 0,48 → a,b → c,d → 120,0
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 120;
        viewbox-height: 48;
        stroke: HveColors.accent-cyan;
        stroke-width: 2px;
        fill: transparent;
        MoveTo { x: 0; y: 48; }
        CubicTo {
            control-1-x: root.a * 120;
            control-1-y: (1.0 - root.b) * 48;
            control-2-x: root.c * 120;
            control-2-y: (1.0 - root.d) * 48;
            x: 120;
            y: 0;
        }
    }

    // control points dots (icy-cyan), sized from the element so they scale
    // with the preview instead of staying at a fixed 6px.
    Rectangle {
        width: root.dot-size;
        height: root.dot-size;
        border-radius: root.dot-size / 2;
        background: #8fd8ff;
        x: parent.width * root.a - root.dot-size / 2;
        y: parent.height * (1.0 - root.b) - root.dot-size / 2;
    }
    Rectangle {
        width: root.dot-size;
        height: root.dot-size;
        border-radius: root.dot-size / 2;
        background: #8fd8ff;
        x: parent.width * root.c - root.dot-size / 2;
        y: parent.height * (1.0 - root.d) - root.dot-size / 2;
    }
}
