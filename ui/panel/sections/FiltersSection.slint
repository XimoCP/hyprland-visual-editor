// HVE 2 — FiltersSection (mutating-window R5).
//
// Pick layer: PresetCards from scan("shaders") → apply_shader, active
// indicator + repick active → none (apply "none"). No tune layer.
// 3s shader_overlay suppressed while PanelState != Closed and 3s after
// Mutating (guard in GallerySlot::trigger_shader_overlay, hidden Rect below).
//
// Keyboard R11: arrows navigate cards, Enter/Space activates,
// icy-cyan #8fd8ff focus. ALL keyboard dispatch lives in PanelRoot's
// single `panel-kbd` FocusScope (HVE 1 pattern); this section is
// presentational and owns no FocusScope. A mouse body click acts AND moves
// the keyboard cursor to the clicked card (keyboard == mouse); hover stays
// visual-only.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";
import { PresetCard } from "../../components.slint";

export component FiltersSection inherits Rectangle {
    in property <[string]> shader-titles;
    in property <[string]> shader-descs;
    in property <[string]> shader-tags;
    in property <[string]> shader-files;
    in property <int> active-index: -1;
    // Keyboard state owned by PanelRoot's single panel-kbd FocusScope.
    in property <int> focused-index: 0;
    in property <bool> has-focus: false;
    callback apply-shader(int, string);
    // Keyboard == mouse: a card body click asks PanelRoot to move the keyboard
    // cursor to that card (PanelRoot owns `filters-focused-index`).
    callback focus-requested(int);

    background: transparent;
    clip: true;

    // Scroll follows KEYBOARD focus only: when fs has focus, viewport
    // follows focused-index; when false (rail has focus), viewport freezes
    // where the mouse left it.
    //
    // Viewport control must be IMPERATIVE, never a binding. Slint DROPS a
    // property's binding the moment code assigns it, and the ScrollView
    // assigns `viewport-y` itself whenever the user turns the wheel. With
    // `viewport-y: <expr>` the wheel therefore killed the binding for the rest
    // of the session: the list stopped following the focused shader, so
    // resuming with the keyboard left the cursor invisible until it reached the
    // zone the mouse had parked. Assigning on the events that should move the
    // pane keeps both paths alive. (Same fix as BordersSection.)
    property <length> saved-scroll-y: 0px;
    // The scroll position is OURS to own: own the target, clamp it against the
    // REAL content height, and stay pinned when the content grows under the
    // pointer (a hover expansion must not push the end out of reach).
    property <length> scroll-target: 0px;
    property <length> max-scroll: max(0px, column.height - scroll.height);
    property <bool> at-end: false;
    function clamp-scroll(v: length) -> length {
        return max(0px - root.max-scroll, min(0px, v));
    }

    changed focused-index => { scroll.follow-focus(); }
    changed has-focus => { scroll.follow-focus(); }
    changed max-scroll => {
        if (root.at-end) {
            root.scroll-target = 0px - root.max-scroll;
            scroll.viewport-y = root.scroll-target;
        }
    }

    // hidden Rect for shader_overlay suppression documentation (R5)
    // While PanelState != Closed the overlay is SUPPRESSED via GallerySlot guard;
    // this Rect stays hidden and documents the mitigation point.
    Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        background: transparent;
    }

    // Presentational content. PanelRoot's single panel-kbd FocusScope owns
    // ALL keyboard dispatch for the panel; the section owns no FocusScope.
    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                Text {
                    text: "Filters";
                    font-family: SkwdTokens.font-heading;
                    font-size: SkwdTokens.size-16;
                    font-weight: 700;
                    color: HveColors.accent-cyan;
                }
                Text {
                    text: "Pick a shader — instantly applied. Repick active to turn off.";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: HveColors.text-muted;
                    wrap: word-wrap;
                }
            }

            scroll := ScrollView {
                vertical-stretch: 1;
                // Scroll follows the keyboard focus (cards only, pitch 66px).
                // Frozen while the mouse drives (root.has-focus false) so a click
                // never yanks the viewport that follows the keyboard focus.
                property <length> focus-y:
                    root.focused-index * 66px
                    + (root.active-index >= 0 && root.active-index < root.focused-index ? 42px : 0px)
                    + (root.active-index == root.focused-index ? 21px : 0px);
                // IMPERATIVE, never a binding — see the note on the root: a
                // wheel writes `viewport-y`, which would drop a binding and
                // leave the list unable to follow the keyboard afterwards.
                public function follow-focus() {
                    if (root.has-focus) {
                        if (root.focused-index >= 0) {
                            root.scroll-target = root.clamp-scroll(
                                0px - max(0px, self.focus-y + 29px - self.height / 2));
                            self.viewport-y = root.scroll-target;
                        } else {
                            self.viewport-y = 0px;
                        }
                    }
                }
                // The binding re-aimed whenever `self.height` changed (panel
                // open, window resize, section switch). An imperative follow
                // must do the same or it computes its target from a transient
                // height and sticks there.
                changed height => { self.follow-focus(); }
                // NEVER animated. `viewport-y` is the property the wheel writes, so an
                // animation on it makes any tick that lands mid-flight compute its target
                // from the INTERPOLATED value — which drops the travel the previous tick
                // had not finished. Exact beats smooth for a scrollable pane.
                changed viewport-y => {
                    root.saved-scroll-y = self.viewport-y;
                    root.scroll-target = self.viewport-y;
                    root.at-end = root.scroll-target <= 0px - root.max-scroll + 1px;
                }
                column := VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 12px;
                    spacing: 8px;

                    for i in root.shader-files.length : PresetCard {
                        title: root.shader-titles[i];
                        desc: root.shader-descs[i];
                        tag: root.shader-tags[i];
                        accent: #8fd8ff;
                        active: i == root.active-index;
                        keyboard-focused: i == root.focused-index && root.has-focus;
                        index: i;
                        // Keyboard == mouse: the body click acts (toggled) AND
                        // converges the keyboard cursor here. Hover stays
                        // visual-only (never moves focus).
                        hover-moves-focus: false;
                        toggled => { root.apply-shader(i, root.shader-files[i]); }
                        focus-requested(idx) => { root.focus-requested(idx); }
                    }

                    if root.shader-files.length == 0 : Text {
                        text: "No shader presets found.";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        color: HveColors.text-muted;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "↑↓ navigate • Enter/Space apply • Tab pick→next • Esc back";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        color: HveColors.text-muted.transparentize(0.4);
                        horizontal-alignment: center;
                    }
                }
            }
        }
}
