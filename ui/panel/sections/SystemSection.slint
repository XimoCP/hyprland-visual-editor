// HVE 2 — SystemSection (mutating-window R7 + R11, two-pane).
//
// Two INDEPENDENT scroll regions:
//   • Settings pane — System ON/OFF + rows (retardo, language, autostart,
//     theme, restart). Reuses SettingsPanel patterns + callbacks.rs handlers.
//   • About pane    — About HVE accordion (reused from HomeModule via tr.rs).
// Wide section → panes side by side; narrow → stacked. Each pane owns its
// ScrollView. The keyboard stays the single linear sequence owned by
// PanelRoot's panel-kbd: rows 0..split-1 target the settings pane, the About
// row (split) targets the About pane. ← / → jump one panel.
//
// Tiling toggle stays EXACTLY as-is (deferred window-rules/fullscreen-redesign).
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";
import { ActivationCard, AccordionCard, AboutItem } from "../../components.slint";

// ─── Settings pane: activation + settings rows. Own ScrollView + scroll memory. ───
component SystemSettingsPane inherits Rectangle {
    in property <bool> system-active: false;
    in property <bool> auto-minimize: true;
    in property <int> minimize-seconds: 5;
    in property <string> language: "en";
    in property <bool> autostart: false;
    in property <string> theme: "system";
    in property <bool> restart-required: false;
    in property <string> restart-banner-text: "⚠ Restart required";
    in property <string> restart-button-text: "Restart";
    in property <string> auto-minimize-label: "Auto-minimize";
    in property <string> timer-label: "Timer:";
    in property <string> language-label: "Language";
    in property <string> autostart-label: "Autostart";
    in property <string> theme-label: "Theme";
    in property <int> focused-row: 0;
    in property <bool> has-focus: false;
    in property <bool> option-engaged: false;
    in property <bool> follow: false;
    in-out property <int> mouse-row: -1;
    callback toggle-system(bool);
    callback toggle-auto-minimize(bool);
    callback change-minimize-seconds(int);
    callback change-language(string);
    callback toggle-autostart(bool);
    callback change-theme(string);
    callback restart-app();

    property <length> saved-scroll-y: 0px;
    // Viewport control must be IMPERATIVE, never a binding. Slint DROPS a
    // property's binding the moment code assigns it, and the ScrollView assigns
    // `viewport-y` itself whenever the user turns the wheel. With
    // `viewport-y: <expr>` the wheel therefore killed the binding for the rest
    // of the session: the settings pane stopped following the focused row, so
    // navigating by keyboard no longer brought the lower settings into view.
    // Same fix as BordersSection/MotionSection/FiltersSection/SaveSection.
    //
    // The scroll position is OURS to own: own the target, clamp it against the
    // REAL content height, and stay pinned when the content grows under the
    // pointer.
    property <length> scroll-target: 0px;
    property <length> max-scroll: max(0px, settings-col.height - settings-scroll.height);
    property <bool> at-end: false;
    function clamp-scroll(v: length) -> length {
        return max(0px - root.max-scroll, min(0px, v));
    }

    changed focused-row => { settings-scroll.follow-focus(); }
    changed follow => { settings-scroll.follow-focus(); }
    changed max-scroll => {
        if (root.at-end) {
            root.scroll-target = 0px - root.max-scroll;
            settings-scroll.viewport-y = root.scroll-target;
        }
    }

    background: transparent;
    clip: true;

    settings-scroll := ScrollView {
        // Fills the pane Rectangle by default (no explicit height). Scroll
        // follows the keyboard focus (rows ~36-40px + 10 spacing → pitch 46px).
        property <length> focus-y: root.focused-row * 46px;
        // IMPERATIVE, never a binding — see the note above: a wheel writes
        // `viewport-y`, which would drop a binding and leave the pane unable to
        // follow the keyboard afterwards.
        public function follow-focus() {
            if (root.follow && root.focused-row >= 0) {
                root.scroll-target = root.clamp-scroll(
                    0px - max(0px, self.focus-y + 18px - self.height / 2));
                self.viewport-y = root.scroll-target;
            }
        }
        // NEVER animated. `viewport-y` is the property the wheel writes, so an
        // animation on it makes any tick that lands mid-flight compute its target
        // from the INTERPOLATED value — which drops the travel the previous tick
        // had not finished. Exact beats smooth for a scrollable pane.
        changed viewport-y => {
            root.saved-scroll-y = self.viewport-y;
            root.scroll-target = self.viewport-y;
            root.at-end = root.scroll-target <= 0px - root.max-scroll + 1px;
        }
        settings-col := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 14px;
            alignment: start;

            // 0 — System ON/OFF status block (reuse ActivationCard pattern, icy focus)
            Rectangle {
                // Plain holder: the ActivationCard draws its own single focus
                // border (the old wrapper ring caused the double border).
                height: 88px;
                ActivationCard {
                    width: parent.width - 4px;
                    x: 2px;
                    y: 2px;
                    focused: (root.focused-row == 0 && root.has-focus) || root.mouse-row == 0;
                    active: root.system-active;
                    card-title: "System Activation";
                    active-text: "Visual Editor Enabled";
                    inactive-text: "Visual Editor Disabled";
                    toggled(v) => { root.mouse-row = 0; root.toggle-system(v); }
                }
            }

            Rectangle { height: 1px; background: HveColors.border.transparentize(0.6); }

            // Restart banner when required
            if root.restart-required : Rectangle {
                height: 32px;
                border-radius: 8px;
                background: HveColors.accent-amber.transparentize(0.85);
                border-width: 1px;
                border-color: HveColors.accent-amber.transparentize(0.4);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text {
                        text: root.restart-banner-text;
                        color: HveColors.accent-amber;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 60px; height: 24px; border-radius: 6px;
                        background: HveColors.bg-card;
                        Text { text: root.restart-button-text; color: HveColors.accent-amber; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: 100%; height: 100%; clicked => { root.restart-app(); } changed has-hover => { if (self.has-hover) { root.mouse-row = 6; } } }
                    }
                }
            }

            // 1+2 — Delay when hiding — hovering chips/toggle does not turn off the row
            retardo-wrap := Rectangle {
                property <bool> lit: ((root.focused-row == 1 || root.focused-row == 2) && root.has-focus) || root.mouse-row == 1 || root.mouse-row == 2 || hover-retardo.has-hover || sec0-ta.has-hover || sec2-ta.has-hover || sec4-ta.has-hover || sec6-ta.has-hover || sec8-ta.has-hover || sec10-ta.has-hover || retardo-toggle-ta.has-hover;
                // Grabbed only on the chips stop (row 2), so the two keyboard
                // stops on this card stay visually distinguishable.
                property <bool> grabbed: root.option-engaged && root.focused-row == 2 && root.has-focus;
                height: 40px;
                border-radius: 8px;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card; animate background { duration: 200ms; easing: ease-in-out; }
                border-width: self.grabbed ? 2px : 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                hover-retardo := TouchArea {
                    width: 100%; height: 100%;
                    clicked => { root.mouse-row = 1; }
                    changed has-hover => { if (self.has-hover) { root.mouse-row = 1; } }
                }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px; y: (parent.height - self.height) / 2; width: parent.width; height: self.preferred-height;
                    Text { text: root.auto-minimize-label; color: HveColors.text; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                    HorizontalLayout {
                        spacing: 4px; alignment: center;
                        visible: root.auto-minimize;
                        // This card holds two keyboard stops; dim the chips
                        // while the switch stop (row 1) owns the cursor so it
                        // is obvious which one Enter will act on.
                        opacity: (root.focused-row == 1 && root.has-focus) ? 0.3 : 1.0;
                        animate opacity { duration: 150ms; easing: ease-in-out; }
                        Rectangle {
                            width: 40px; height: 28px; border-radius: 6px;
                            background: root.minimize-seconds == 0 ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                            border-width: 1px;
                            border-color: root.minimize-seconds == 0 ? HveColors.accent-cyan : HveColors.border;
                            Text { text: "Off"; color: root.minimize-seconds == 0 ? HveColors.accent-cyan : HveColors.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            sec0-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 2; root.change-minimize-seconds(0); } changed has-hover => { if (self.has-hover) { root.mouse-row = 2; } } }
                        }
                        Rectangle {
                            width: 30px; height: 28px; border-radius: 6px;
                            background: root.minimize-seconds == 2 ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                            border-width: 1px;
                            border-color: root.minimize-seconds == 2 ? HveColors.accent-cyan : HveColors.border;
                            Text { text: "2"; color: root.minimize-seconds == 2 ? HveColors.accent-cyan : HveColors.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            sec2-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 2; root.change-minimize-seconds(2); } changed has-hover => { if (self.has-hover) { root.mouse-row = 2; } } }
                        }
                        Rectangle {
                            width: 30px; height: 28px; border-radius: 6px;
                            background: root.minimize-seconds == 4 ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                            border-width: 1px;
                            border-color: root.minimize-seconds == 4 ? HveColors.accent-cyan : HveColors.border;
                            Text { text: "4"; color: root.minimize-seconds == 4 ? HveColors.accent-cyan : HveColors.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            sec4-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 2; root.change-minimize-seconds(4); } changed has-hover => { if (self.has-hover) { root.mouse-row = 2; } } }
                        }
                        Rectangle {
                            width: 30px; height: 28px; border-radius: 6px;
                            background: root.minimize-seconds == 6 ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                            border-width: 1px;
                            border-color: root.minimize-seconds == 6 ? HveColors.accent-cyan : HveColors.border;
                            Text { text: "6"; color: root.minimize-seconds == 6 ? HveColors.accent-cyan : HveColors.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            sec6-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 2; root.change-minimize-seconds(6); } changed has-hover => { if (self.has-hover) { root.mouse-row = 2; } } }
                        }
                        Rectangle {
                            width: 30px; height: 28px; border-radius: 6px;
                            background: root.minimize-seconds == 8 ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                            border-width: 1px;
                            border-color: root.minimize-seconds == 8 ? HveColors.accent-cyan : HveColors.border;
                            Text { text: "8"; color: root.minimize-seconds == 8 ? HveColors.accent-cyan : HveColors.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            sec8-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 2; root.change-minimize-seconds(8); } changed has-hover => { if (self.has-hover) { root.mouse-row = 2; } } }
                        }
                        Rectangle {
                            width: 30px; height: 28px; border-radius: 6px;
                            background: root.minimize-seconds == 10 ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                            border-width: 1px;
                            border-color: root.minimize-seconds == 10 ? HveColors.accent-cyan : HveColors.border;
                            Text { text: "10"; color: root.minimize-seconds == 10 ? HveColors.accent-cyan : HveColors.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            sec10-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 2; root.change-minimize-seconds(10); } changed has-hover => { if (self.has-hover) { root.mouse-row = 2; } } }
                        }
                        Text { text: "s"; color: HveColors.text-muted; font-size: 12px; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 40px; height: 28px;
                        // Mirror of the chips dim: while the chips stop (row 2)
                        // owns the cursor the switch steps back.
                        opacity: (root.focused-row == 2 && root.has-focus && root.auto-minimize) ? 0.3 : 1.0;
                        animate opacity { duration: 150ms; easing: ease-in-out; }
                        Rectangle {
                            width: 40px; height: 22px; border-radius: 11px; y: (parent.height - self.height) / 2;
                            background: root.auto-minimize ? HveColors.accent-green : HveColors.border;
                            Rectangle { width: 16px; height: 16px; border-radius: 8px; background: HveColors.bg-dark; x: root.auto-minimize ? parent.width - self.width - 3px : 3px; y: 3px; animate x { duration: 150ms; easing: ease-out; } }
                            retardo-toggle-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 1; root.toggle-auto-minimize(!root.auto-minimize); } changed has-hover => { if (self.has-hover) { root.mouse-row = 1; } } }
                        }
                    }
                }
            }

            // 3 — Language EN/ES
            lang-wrap := Rectangle {
                property <bool> lit: (root.focused-row == 3 && root.has-focus) || root.mouse-row == 3 || hover-lang.has-hover || en-ta.has-hover || es-ta.has-hover;
                property <bool> grabbed: root.option-engaged && root.focused-row == 3 && root.has-focus;
                height: 40px;
                border-radius: 8px;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card; animate background { duration: 200ms; easing: ease-in-out; }
                border-width: self.grabbed ? 2px : 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                hover-lang := TouchArea {
                    width: 100%; height: 100%;
                    clicked => { root.mouse-row = 3; }
                    changed has-hover => { if (self.has-hover) { root.mouse-row = 3; } }
                }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px; y: (parent.height - self.height) / 2; width: parent.width; height: self.preferred-height;
                    Text { text: root.language-label; color: HveColors.text; font-size: 14px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; min-width: 0px; overflow: elide; }
                    Rectangle {
                        width: 60px; height: 28px; border-radius: 6px; background: HveColors.bg-card; border-width: 1px; border-color: HveColors.border;
                        HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 50%; height: 100%; border-radius: root.language == "en" ? 5px : 0px; background: root.language == "en" ? HveColors.accent-cyan.transparentize(0.8) : transparent;
                                Text { text: "EN"; color: root.language == "en" ? HveColors.accent-cyan : HveColors.text-muted; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                en-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 3; root.change-language("en"); } changed has-hover => { if (self.has-hover) { root.mouse-row = 3; } } }
                            }
                            Rectangle {
                                width: 50%; height: 100%; border-radius: root.language == "es" ? 5px : 0px; background: root.language == "es" ? HveColors.accent-cyan.transparentize(0.8) : transparent;
                                Text { text: "ES"; color: root.language == "es" ? HveColors.accent-cyan : HveColors.text-muted; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                es-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 3; root.change-language("es"); } changed has-hover => { if (self.has-hover) { root.mouse-row = 3; } } }
                            }
                        }
                    }
                }
            }

            // 4 — Autostart
            autostart-wrap := Rectangle {
                property <bool> lit: (root.focused-row == 4 && root.has-focus) || root.mouse-row == 4 || hover-autostart.has-hover || autostart-toggle-ta.has-hover;
                height: 40px;
                border-radius: 8px;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card; animate background { duration: 200ms; easing: ease-in-out; }
                border-width: self.lit ? 1px : 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                hover-autostart := TouchArea {
                    width: 100%; height: 100%;
                    clicked => { root.mouse-row = 4; }
                    changed has-hover => { if (self.has-hover) { root.mouse-row = 4; } }
                }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px; y: (parent.height - self.height) / 2; width: parent.width; height: self.preferred-height;
                    Text { text: root.autostart-label; color: HveColors.text; font-size: 14px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; min-width: 0px; overflow: elide; }
                    Rectangle {
                        width: 40px; height: 28px;
                        Rectangle {
                            width: 40px; height: 22px; border-radius: 11px; y: (parent.height - self.height) / 2; background: root.autostart ? HveColors.accent-cyan : HveColors.border;
                            Rectangle { width: 16px; height: 16px; border-radius: 8px; background: HveColors.bg-dark; x: root.autostart ? parent.width - self.width - 3px : 3px; y: 3px; }
                            autostart-toggle-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 4; root.toggle-autostart(!root.autostart); } changed has-hover => { if (self.has-hover) { root.mouse-row = 4; } } }
                        }
                    }
                }
            }

            // 5 — Theme preference
            theme-wrap := Rectangle {
                property <bool> lit: (root.focused-row == 5 && root.has-focus) || root.mouse-row == 5 || hover-theme.has-hover || theme-dark-ta.has-hover || theme-light-ta.has-hover || theme-system-ta.has-hover;
                property <bool> grabbed: root.option-engaged && root.focused-row == 5 && root.has-focus;
                height: 40px;
                border-radius: 8px;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card; animate background { duration: 200ms; easing: ease-in-out; }
                border-width: self.grabbed ? 2px : 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                hover-theme := TouchArea {
                    width: 100%; height: 100%;
                    clicked => { root.mouse-row = 5; }
                    changed has-hover => { if (self.has-hover) { root.mouse-row = 5; } }
                }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px; y: (parent.height - self.height) / 2; width: parent.width; height: self.preferred-height;
                    Text { text: root.theme-label; color: HveColors.text; font-size: 14px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; min-width: 0px; overflow: elide; }
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            width: 56px; height: 28px; border-radius: 6px;
                            background: root.theme == "dark" ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                            border-width: 1px;
                            border-color: root.theme == "dark" ? HveColors.accent-cyan : HveColors.border;
                            Text { text: "dark"; color: root.theme == "dark" ? HveColors.accent-cyan : HveColors.text; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            theme-dark-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 5; root.change-theme("dark"); } changed has-hover => { if (self.has-hover) { root.mouse-row = 5; } } }
                        }
                        Rectangle {
                            width: 56px; height: 28px; border-radius: 6px;
                            background: root.theme == "light" ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                            border-width: 1px;
                            border-color: root.theme == "light" ? HveColors.accent-cyan : HveColors.border;
                            Text { text: "light"; color: root.theme == "light" ? HveColors.accent-cyan : HveColors.text; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            theme-light-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 5; root.change-theme("light"); } changed has-hover => { if (self.has-hover) { root.mouse-row = 5; } } }
                        }
                        Rectangle {
                            width: 56px; height: 28px; border-radius: 6px;
                            background: root.theme == "system" ? HveColors.accent-cyan.transparentize(0.8) : HveColors.bg-card;
                            border-width: 1px;
                            border-color: root.theme == "system" ? HveColors.accent-cyan : HveColors.border;
                            Text { text: "system"; color: root.theme == "system" ? HveColors.accent-cyan : HveColors.text; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            theme-system-ta := TouchArea { width: 100%; height: 100%; clicked => { root.mouse-row = 5; root.change-theme("system"); } changed has-hover => { if (self.has-hover) { root.mouse-row = 5; } } }
                        }
                    }
                }
            }

            // 6 — Restart (only when restart required)
            if root.restart-required : Rectangle {
                height: 36px; border-radius: 8px;
                background: HveColors.accent-amber.transparentize(0.85);
                border-width: root.focused-row == 6 && root.has-focus ? 1px : 1px;
                border-color: (root.focused-row == 6 && root.has-focus) || root.mouse-row == 6 ? #8fd8ff : HveColors.accent-amber.transparentize(0.4);
                Text { text: "Restart"; color: HveColors.accent-amber; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: 100%; height: 100%; clicked => { root.restart-app(); } }
            }

            Text {
                text: root.option-engaged ? "←→ pick option • ↑↓/Esc exit" : "↑↓ navigate • ←→ switch panel • Enter/Space toggle • Esc back";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted.transparentize(0.4);
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// ─── About pane: About HVE accordion. Own ScrollView. ───
component SystemAboutPane inherits Rectangle {
    in property <string> about-title: "About HVE";
    in property <string> about-short: "Hyprland Visual Editor makes your desktop truly yours.";
    in property <string> about-full: "HVE is a graphical app to visually manage your Hyprland desktop aesthetics.";
    in property <[AboutItem]> about-items;
    in property <string> tree-label: "Project structure";
    in property <[string]> tree-paths;
    in property <[string]> tree-descs;
    in property <string> tree-path-max: "";
    in property <string> docs-label: "View documentation";
    // Row index of the About block (6 without the restart row, 7 with it).
    in property <int> about-row: 6;
    in property <int> focused-row: 0;
    in property <bool> has-focus: false;
    in property <bool> follow: false;
    in-out property <int> mouse-row: -1;
    in-out property <bool> about-expanded: false;
    callback open-docs();

    property <length> saved-scroll-y: 0px;
    // Viewport control must be IMPERATIVE, never a binding (same reason as the
    // settings pane): the wheel assigns `viewport-y` and DROPS the binding, so
    // the About block no longer returned to the top when it reclaimed the
    // cursor. Its follow target is always 0px — the About block is a single
    // card pinned to the top — so the list panes' clamp/at-end machinery buys
    // nothing here. The equivalent behaviour is: follow snaps to the top, and
    // leaving the pane restores the position the wheel left.
    changed focused-row => { about-scroll.follow-focus(); }
    changed follow => { about-scroll.follow-focus(); }

    background: transparent;
    clip: true;

    about-scroll := ScrollView {
        // Fills the pane Rectangle by default (no explicit height).
        property <length> focus-y: 0px;
        public function follow-focus() {
            self.viewport-y = root.follow ? 0px : root.saved-scroll-y;
        }
        // NEVER animated. `viewport-y` is the property the wheel writes, so an
        // animation on it makes any tick that lands mid-flight compute its target
        // from the INTERPOLATED value — which drops the travel the previous tick
        // had not finished. Exact beats smooth for a scrollable pane.
        changed viewport-y => { root.saved-scroll-y = self.viewport-y; }
        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            alignment: start;

            Rectangle {
                // Plain holder: the AccordionCard draws its own single focus
                // border (no wrapper ring → no double border).
                height: about-acc.height + 4px;
                about-acc := AccordionCard {
                    width: parent.width - 4px;
                    x: 2px;
                    y: 2px;
                    focused: (root.focused-row == root.about-row && root.has-focus) || root.mouse-row == root.about-row;
                    card-title: root.about-title;
                    icon-text: "💡";
                    accent: HveColors.accent-cyan;
                    border: HveColors.border;
                    short-desc: root.about-short;
                    full-desc: root.about-full;
                    about-items: root.about-items;
                    tree-label: root.tree-label;
                    tree-paths: root.tree-paths;
                    tree-descs: root.tree-descs;
                    tree-path-max: root.tree-path-max;
                    docs-label: root.docs-label;
                    expanded: root.about-expanded;
                    toggled => { root.mouse-row = root.about-row; root.about-expanded = !root.about-expanded; }
                    open-docs => { root.mouse-row = root.about-row; root.open-docs(); }
                }
            }
        }
    }
}

export component SystemSection inherits Rectangle {
    // System state
    in property <bool> system-active: false;
    in property <bool> auto-minimize: true;
    in property <int> minimize-seconds: 5;
    in property <string> language: "en";
    in property <bool> tiling-mode: false;
    in property <bool> autostart: false;
    in property <string> theme: "system";
    in property <bool> restart-required: false;
    // Labels (reuse SettingsPanel i18n)
    in property <string> settings-title: "System";
    in property <string> auto-minimize-label: "Retardo al ocultar";
    in property <string> timer-label: "Retardo:";
    in property <string> language-label: "Language";
    in property <string> tiling-label: "Tiling mode";
    in property <string> autostart-label: "Autostart";
    in property <string> theme-label: "Theme";
    in property <string> reset-label: "Reset presets";
    in property <string> restart-banner-text: "⚠ Restart required";
    in property <string> restart-button-text: "Restart";
    // About (from HomeModule via tr.rs)
    in property <string> about-title: "About HVE";
    in property <string> about-short: "Hyprland Visual Editor makes your desktop truly yours.";
    in property <string> about-full: "HVE is a graphical app to visually manage your Hyprland desktop aesthetics.";
    in property <[AboutItem]> about-items;
    in property <string> tree-label: "Project structure";
    in property <[string]> tree-paths;
    in property <[string]> tree-descs;
    in property <string> tree-path-max: "";
    in property <string> docs-label: "View documentation";

    callback toggle-system(bool);
    callback toggle-auto-minimize(bool);
    callback change-minimize-seconds(int);
    callback change-language(string);
    callback toggle-tiling-mode(bool);
    callback toggle-autostart(bool);
    callback change-theme(string);
    callback reset-presets();
    callback restart-app();
    callback open-docs();
    // Keyboard state owned by PanelRoot's single panel-kbd FocusScope.
    in property <bool> has-focus: false;

    in property <int> focused-row: 0;
    // True while the focused compound row is engaged (Enter): ←/→ pick an
    // option inside the row instead of jumping panels. Owned by PanelRoot.
    in property <bool> option-engaged: false;
    // Mouse-owned mark: set on every click/hover. Shared by both panes.
    in-out property <int> mouse-row: -1;
    property <int> row-count: root.restart-required ? 8 : 7;
    in-out property <bool> about-expanded: false;

    background: transparent;
    clip: true;

    // Responsive split from the window width (ShellRoot), never from
    // root.width (binding loop). Wide → two panes; narrow → stacked.
    in property <bool> two-col: false;
    // About row index: the last row (6 without the restart row, 7 with it).
    property <int> about-row: root.restart-required ? 7 : 6;

    // ── Compound-row option navigation ──────────────────────────────
    // Rows 2 (timer), 3 (language) and 5 (theme) hold horizontal chips.
    // PanelRoot's panel-kbd owns the keys and calls move-option() while the
    // row is engaged; picking applies the value immediately, exactly like a
    // mouse click on the chip.

    // Nearest chip index for the current seconds: 0=Off, then 2/4/6/8/10.
    // Legacy configs can hold a value outside the chip set (e.g. 5 from the
    // old migration default); snapping to the nearest keeps ←/→ predictable.
    function timer-index() -> int {
        if (root.minimize-seconds <= 1) { return 0; }
        if (root.minimize-seconds <= 3) { return 1; }
        if (root.minimize-seconds <= 5) { return 2; }
        if (root.minimize-seconds <= 7) { return 3; }
        if (root.minimize-seconds <= 9) { return 4; }
        return 5;
    }

    function apply-timer-index(idx: int) {
        if (idx == 0) { root.change-minimize-seconds(0); }
        else if (idx == 1) { root.change-minimize-seconds(2); }
        else if (idx == 2) { root.change-minimize-seconds(4); }
        else if (idx == 3) { root.change-minimize-seconds(6); }
        else if (idx == 4) { root.change-minimize-seconds(8); }
        else { root.change-minimize-seconds(10); }
    }

    // PanelRoot calls this only while `option-engaged` is true, so the
    // engaged row is always the focused one.
    public function move-option(right: bool) {
        if (root.focused-row == 2) {
            if (!root.auto-minimize) { return; }
            let idx = root.timer-index();
            let next = right ? min(idx + 1, 5) : max(idx - 1, 0);
            if (next != idx) { root.apply-timer-index(next); }
        } else if (root.focused-row == 3) {
            let idx = root.language == "en" ? 0 : 1;
            let next = right ? min(idx + 1, 1) : max(idx - 1, 0);
            if (next != idx) { root.change-language(next == 0 ? "en" : "es"); }
        } else if (root.focused-row == 5) {
            let idx = root.theme == "dark" ? 0 : (root.theme == "light" ? 1 : 2);
            let next = right ? min(idx + 1, 2) : max(idx - 1, 0);
            if (next != idx) {
                if (next == 0) { root.change-theme("dark"); }
                else if (next == 1) { root.change-theme("light"); }
                else { root.change-theme("system"); }
            }
        }
    }

    VerticalLayout {
        spacing: 0px;

        // Header
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "System";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }
            Text {
                text: "Activation, settings and About. Tiling stays as-is.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }
        }

        // Two independent panes. Wide: side by side. Narrow: stacked.
        if root.two-col : HorizontalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            SystemSettingsPane {
                horizontal-stretch: 1;
                system-active: root.system-active;
                auto-minimize: root.auto-minimize;
                minimize-seconds: root.minimize-seconds;
                language: root.language;
                autostart: root.autostart;
                theme: root.theme;
                restart-required: root.restart-required;
                restart-banner-text: root.restart-banner-text;
                restart-button-text: root.restart-button-text;
                auto-minimize-label: root.auto-minimize-label;
                timer-label: root.timer-label;
                language-label: root.language-label;
                autostart-label: root.autostart-label;
                theme-label: root.theme-label;
                focused-row: root.focused-row;
                option-engaged: root.option-engaged;
                has-focus: root.has-focus;
                follow: root.focused-row < root.about-row;
                mouse-row <=> root.mouse-row;
                toggle-system(v) => { root.toggle-system(v); }
                toggle-auto-minimize(v) => { root.toggle-auto-minimize(v); }
                change-minimize-seconds(v) => { root.change-minimize-seconds(v); }
                change-language(v) => { root.change-language(v); }
                toggle-autostart(v) => { root.toggle-autostart(v); }
                change-theme(v) => { root.change-theme(v); }
                restart-app => { root.restart-app(); }
            }

            Rectangle { width: 1px; background: HveColors.border.transparentize(0.6); }

            SystemAboutPane {
                horizontal-stretch: 1;
                about-title: root.about-title;
                about-short: root.about-short;
                about-full: root.about-full;
                about-items: root.about-items;
                tree-label: root.tree-label;
                tree-paths: root.tree-paths;
                tree-descs: root.tree-descs;
                tree-path-max: root.tree-path-max;
                docs-label: root.docs-label;
                about-row: root.about-row;
                focused-row: root.focused-row;
                has-focus: root.has-focus;
                follow: root.focused-row >= root.about-row;
                mouse-row <=> root.mouse-row;
                about-expanded <=> root.about-expanded;
                open-docs => { root.open-docs(); }
            }
        }
        if !root.two-col : VerticalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            SystemSettingsPane {
                vertical-stretch: 1;
                system-active: root.system-active;
                auto-minimize: root.auto-minimize;
                minimize-seconds: root.minimize-seconds;
                language: root.language;
                autostart: root.autostart;
                theme: root.theme;
                restart-required: root.restart-required;
                restart-banner-text: root.restart-banner-text;
                restart-button-text: root.restart-button-text;
                auto-minimize-label: root.auto-minimize-label;
                timer-label: root.timer-label;
                language-label: root.language-label;
                autostart-label: root.autostart-label;
                theme-label: root.theme-label;
                focused-row: root.focused-row;
                option-engaged: root.option-engaged;
                has-focus: root.has-focus;
                follow: root.focused-row < root.about-row;
                mouse-row <=> root.mouse-row;
                toggle-system(v) => { root.toggle-system(v); }
                toggle-auto-minimize(v) => { root.toggle-auto-minimize(v); }
                change-minimize-seconds(v) => { root.change-minimize-seconds(v); }
                change-language(v) => { root.change-language(v); }
                toggle-autostart(v) => { root.toggle-autostart(v); }
                change-theme(v) => { root.change-theme(v); }
                restart-app => { root.restart-app(); }
            }

            Rectangle { height: 1px; background: HveColors.border.transparentize(0.6); }

            SystemAboutPane {
                vertical-stretch: 1;
                about-title: root.about-title;
                about-short: root.about-short;
                about-full: root.about-full;
                about-items: root.about-items;
                tree-label: root.tree-label;
                tree-paths: root.tree-paths;
                tree-descs: root.tree-descs;
                tree-path-max: root.tree-path-max;
                docs-label: root.docs-label;
                about-row: root.about-row;
                focused-row: root.focused-row;
                has-focus: root.has-focus;
                follow: root.focused-row >= root.about-row;
                mouse-row <=> root.mouse-row;
                about-expanded <=> root.about-expanded;
                open-docs => { root.open-docs(); }
            }
        }
    }
}
