// HVE 2 — MotionSection (tune + preset list, two-pane).
//
// Two INDEPENDENT scroll regions:
//   • Fixed header — the enlarged CurvePreview (260×120), always visible.
//   • Tune pane  — 4 bezier sliders a,b,c,d (x1,y1,x2,y2), then the
//     global-model SPEED slider and STYLE family segmented row, plus the save
//     form (LineEdit + Save button) at the bottom for saving the current
//     curve/speed/style as a user preset.
//   • List pane  — Built-in presets (apply only) + user presets (apply,
//     rename, delete) via SavedPresetCard. User presets carry a ★ badge.
// Wide section → panes side by side; narrow → stacked. Each pane owns its own
// ScrollView. Keyboard: single linear sequence owned by PanelRoot's panel-kbd;
// ← / → jump one panel at a time (menu → tune → list).
//
// Ranges: a,c in [0,1], b,d in [-1,2] per CSS bezier convention; defaults
// 0.25/0.1/0.25/1. Arrow steps ±0.05 clamped.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { LineEdit, ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";
import { HveKnobSlider } from "../../components.slint";
import { CurvePreview } from "../CurvePreview.slint";
import { SavedPresetCard } from "SavedPresetCard.slint";
import { MotionText } from "motion_text.slint";
import { ConfirmDialog, RenameDialog } from "Dialogs.slint";

component BezierSlider inherits Rectangle {
    in property <float> value: 0.25;
    in property <float> min: 0.0;
    in property <float> max: 1.0;
    in property <string> label: "";
    in property <bool> engaged: false;
    in property <bool> focused: false;
    callback changed(float);
    height: 72px;
    background: transparent;
    border-width: 0px;
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: root.label;
                color: root.engaged ? #ffffff : HveColors.accent-cyan;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: Math.round(root.value * 100) / 100;
                color: #8fd8ff;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        HveKnobSlider {
            min: root.min;
            max: root.max;
            value: root.value;
            engaged: root.engaged;
            changed(v) => { root.changed(v); }
        }
    }
}

// ─── Tune pane: CurvePreview + 4 bezier sliders + save form. ───
component MotionTunePane inherits Rectangle {
    in-out property <float> bezier-a: 0.25;
    in-out property <float> bezier-b: 0.1;
    in-out property <float> bezier-c: 0.25;
    in-out property <float> bezier-d: 1.0;
    // Phase 2 — global model: one speed, one style family, one dirty flag.
    in-out property <float> anim-speed: 2.0;
    in-out property <string> anim-style: "slide";
    in-out property <bool> motion-dirty: false;
    in property <int> focused-index: 0;
    in property <int> split: 0;
    in property <bool> has-focus: false;
    in property <int> engaged-slider: -1;
    in property <bool> follow: false;
    // Save form state
    in property <string> error-text: "";
    in-out property <string> preset-name: "";
    callback save-preset(string);

    property <length> saved-scroll-y: 0px;
    // 0..3 = bezier sliders; 4 = speed; 5 = style; 6 = save form
    property <int> local-focus: root.focused-index - root.split;
    background: transparent;
    clip: true;

    ScrollView {
        // All seven stops sit on an 80px pitch, so the follow target is a
        // single linear expression again (bezier a..d, speed, style, save).
        // The curve preview now lives in the section header, so the first stop
        // starts at the ScrollView's 16px top padding (14px keeps the previous
        // 2px slop that centred a stop's 44px half-height).
        property <length> focus-y: 14px + root.local-focus * 80px;
        viewport-y: root.follow ? (root.local-focus >= 0
            ? (0px - max(0px, self.focus-y + 44px - self.height / 2))
            : 0px) : root.saved-scroll-y;
        // NEVER animated. `viewport-y` is the property the wheel writes, so an
        // animation on it makes any tick that lands mid-flight compute its target
        // from the INTERPOLATED value — which drops the travel the previous tick
        // had not finished. Exact beats smooth for a scrollable pane.
        changed viewport-y => { root.saved-scroll-y = self.viewport-y; }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 28px;
            spacing: 8px;

            a-wrap := Rectangle {
                property <bool> lit: (root.local-focus == 0 && root.has-focus) || hover-a.has-hover;
                property <bool> grabbed: root.engaged-slider == 0 && root.has-focus;
                height: self.lit ? (self.grabbed ? 104px : 88px) : 72px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-a := TouchArea { width: 100%; height: 100%; clicked => { } }
                BezierSlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 0;
                    focused: a-wrap.lit;
                    label: "X1 — a";
                    value: root.bezier-a;
                    min: 0.0;
                    max: 1.0;
                    changed(v) => { root.bezier-a = v; root.motion-dirty = true; }
                }
            }
            b-wrap := Rectangle {
                property <bool> lit: (root.local-focus == 1 && root.has-focus) || hover-b.has-hover;
                property <bool> grabbed: root.engaged-slider == 1 && root.has-focus;
                height: self.lit ? (self.grabbed ? 104px : 88px) : 72px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-b := TouchArea { width: 100%; height: 100%; clicked => { } }
                BezierSlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 1;
                    focused: b-wrap.lit;
                    label: "Y1 — b";
                    value: root.bezier-b;
                    min: -1.0;
                    max: 2.0;
                    changed(v) => { root.bezier-b = v; root.motion-dirty = true; }
                }
            }
            c-wrap := Rectangle {
                property <bool> lit: (root.local-focus == 2 && root.has-focus) || hover-c.has-hover;
                property <bool> grabbed: root.engaged-slider == 2 && root.has-focus;
                height: self.lit ? (self.grabbed ? 104px : 88px) : 72px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-c := TouchArea { width: 100%; height: 100%; clicked => { } }
                BezierSlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 2;
                    focused: c-wrap.lit;
                    label: "X2 — c";
                    value: root.bezier-c;
                    min: 0.0;
                    max: 1.0;
                    changed(v) => { root.bezier-c = v; root.motion-dirty = true; }
                }
            }
            d-wrap := Rectangle {
                property <bool> lit: (root.local-focus == 3 && root.has-focus) || hover-d.has-hover;
                property <bool> grabbed: root.engaged-slider == 3 && root.has-focus;
                height: self.lit ? (self.grabbed ? 104px : 88px) : 72px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-d := TouchArea { width: 100%; height: 100%; clicked => { } }
                BezierSlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 3;
                    focused: d-wrap.lit;
                    label: "Y2 — d";
                    value: root.bezier-d;
                    min: -1.0;
                    max: 2.0;
                    changed(v) => { root.bezier-d = v; root.motion-dirty = true; }
                }
            }

            // ── Speed (local 4) — global model, 0.5..6.0, step 0.5 ──
            speed-wrap := Rectangle {
                property <bool> lit: (root.local-focus == 4 && root.has-focus) || hover-speed.has-hover;
                property <bool> grabbed: root.engaged-slider == 4 && root.has-focus;
                height: self.lit ? (self.grabbed ? 104px : 88px) : 72px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-speed := TouchArea { width: 100%; height: 100%; clicked => { } }
                BezierSlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 4;
                    focused: speed-wrap.lit;
                    label: MotionText.speed-label;
                    value: root.anim-speed;
                    min: 0.5;
                    max: 6.0;
                    changed(v) => {
                        root.anim-speed = v;
                        root.motion-dirty = true;
                    }
                }
            }

            // ── Style family (local 5) — segmented row, acts at once ──
            style-wrap := Rectangle {
                property <bool> lit: (root.local-focus == 5 && root.has-focus) || hover-style.has-hover;
                height: self.lit ? 88px : 72px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-style := TouchArea { width: 100%; height: 100%; clicked => { } }
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text {
                        text: MotionText.style-label;
                        color: style-wrap.lit ? #ffffff : HveColors.accent-cyan;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        for style-val in ["slide", "fade", "popin"] : Rectangle {
                            horizontal-stretch: 1;
                            height: 32px;
                            border-radius: SkwdTokens.radius-4;
                            background: root.anim-style == style-val ? HveColors.accent-cyan : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: root.anim-style == style-val ? HveColors.accent-cyan : HveColors.border;
                            Text {
                                text: style-val == "slide" ? MotionText.style-slide
                                    : (style-val == "fade" ? MotionText.style-fade : MotionText.style-popin);
                                color: root.anim-style == style-val ? HveColors.bg-dark : HveColors.text-muted;
                                font-family: SkwdTokens.font-body;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.anim-style = style-val;
                                    root.motion-dirty = true;
                                }
                            }
                        }
                    }
                }
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // Save form
            Text {
                text: "Save as Preset";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-14;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }

            HorizontalLayout {
                spacing: SkwdTokens.spacing-8;
                height: 36px;

                save-line-wrap := Rectangle {
                    // Tune-local stop 6 is the save form; light it so the
                    // keyboard cursor is visible when it lands there.
                    property <bool> lit: root.local-focus == 6 && root.has-focus;
                    horizontal-stretch: 1;
                    height: 36px;
                    background: HveColors.bg-card;
                    border-radius: SkwdTokens.radius-8;
                    border-width: (save-input.has-focus || self.lit) ? 1px : 0px;
                    border-color: #8fd8ff;

                    save-input := LineEdit {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        placeholder-text: "Animation preset name…";
                        text <=> root.preset-name;
                        font-size: SkwdTokens.size-13;
                        accepted(text) => {
                            if (text != "") {
                                root.save-preset(text);
                            }
                        }
                    }
                }

                save-btn := Rectangle {
                    property <bool> lit: root.local-focus == 6 && root.has-focus;
                    width: 84px;
                    height: 36px;
                    background: save-ta.has-hover ? HveColors.accent-cyan.transparentize(0.2) : HveColors.accent-cyan;
                    border-radius: SkwdTokens.radius-8;
                    border-width: self.lit ? 1.5px : 0px;
                    border-color: #8fd8ff;

                    Text {
                        text: "Save";
                        color: HveColors.bg-dark;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-13;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    save-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.preset-name != "") {
                                root.save-preset(root.preset-name);
                            }
                        }
                    }
                }
            }

            if root.error-text != "" : Text {
                text: root.error-text;
                color: HveColors.accent-red;
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                wrap: word-wrap;
            }

            // Keyboard hint
            Text {
                text: "↑↓ navigate • ←→ switch panel • Enter/Space apply/engage • arrows adjust • Esc back";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted.transparentize(0.4);
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// ─── List pane: built-in + user presets. ───
component MotionListPane inherits Rectangle {
    in property <[string]> builtin-names;
    in property <[string]> builtin-tags;
    in property <[string]> user-names;
    in property <[string]> user-tags;
    in property <int> active-index: -1;
    in property <int> focused-index: 0;
    in property <bool> has-focus: false;
    in property <bool> follow: false;
    callback apply-preset(int, string);
    callback open-rename(string);
    callback open-delete(string);

    property <length> saved-scroll-y: 0px;
    property <int> builtin-count: root.builtin-names.length;
    property <int> total-count: root.builtin-names.length + root.user-names.length;
    background: transparent;
    clip: true;

    ScrollView {
        property <length> focus-y: root.focused-index * 66px;
        viewport-y: root.follow ? (root.focused-index >= 0
            ? (0px - max(0px, self.focus-y + 29px - self.height / 2))
            : 0px) : root.saved-scroll-y;
        // NEVER animated. `viewport-y` is the property the wheel writes, so an
        // animation on it makes any tick that lands mid-flight compute its target
        // from the INTERPOLATED value — which drops the travel the previous tick
        // had not finished. Exact beats smooth for a scrollable pane.
        changed viewport-y => { root.saved-scroll-y = self.viewport-y; }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 8px;

            // Built-in presets header
            if root.builtin-names.length > 0 : Text {
                text: "Built-in";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-12;
                font-weight: 600;
                color: HveColors.text-muted;
            }

            for i in root.builtin-names.length : SavedPresetCard {
                preset-name: root.builtin-names[i];
                is-active: i == root.active-index;
                is-user: false;
                keyboard-focused: root.focused-index == i && root.has-focus;
                accent: #8fd8ff;
                index: i;
                apply-preset(idx, name) => { root.apply-preset(idx, name); }
                refocus() => { }
            }

            // User presets header
            if root.user-names.length > 0 : Rectangle { height: 8px; }
            if root.user-names.length > 0 : Text {
                text: "My Animation Presets";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-12;
                font-weight: 600;
                color: HveColors.text-muted;
            }

            for i in root.user-names.length : SavedPresetCard {
                preset-name: root.user-names[i];
                is-active: root.builtin-names.length + i == root.active-index;
                is-user: true;
                keyboard-focused: root.focused-index == root.builtin-names.length + i && root.has-focus;
                accent: HveColors.accent-amber;
                index: root.builtin-names.length + i;
                apply-preset(idx, name) => { root.apply-preset(idx, name); }
                open-rename(name) => { root.open-rename(name); }
                open-delete(name) => { root.open-delete(name); }
                refocus() => { }
            }

            // Empty state
            if root.total-count == 0 : Text {
                text: "No animation presets found.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}

// ══════════════════════════════════════════════════════════════════════════════
// MotionSection (exported)
// ══════════════════════════════════════════════════════════════════════════════
export component MotionSection inherits Rectangle {
    // Built-in presets
    in property <[string]> anim-titles;
    in property <[string]> anim-descs;
    in property <[string]> anim-tags;
    in property <[string]> anim-files;
    // User presets
    in property <[string]> user-preset-names;
    in property <[string]> user-preset-tags;
    // Active selection
    in property <int> active-index: -1;
    // Keyboard state (owned by PanelRoot)
    in property <int> focused-index: 0;
    in property <int> engaged-slider: -1;
    in property <bool> has-focus: false;
    // Save form error
    in property <string> save-error: "";
    in-out property <string> preset-name: "";
    // Callbacks
    callback apply-animation(int, string);
    callback save-animation-preset(string);
    callback rename-animation-preset(string, string);
    callback delete-animation-preset(string);
    // Preset rename/delete dialogs (shared Dialogs.slint). State on the root
    // because the pane is instantiated twice (two-col / stacked).
    in-out property <string> preset-dialog-mode: "";
    in-out property <string> preset-dialog-target: "";
    in-out property <string> preset-rename-input: "";
    in property <string> rename-title: "Rename animation preset";
    in property <string> rename-placeholder: "Animation preset name…";
    in property <string> delete-title: "Delete animation preset";
    in property <string> delete-message: "Are you sure you want to delete";
    in property <string> cancel-text: "Cancel";

    // Tune layer — 4 bezier values + the global speed / style model
    in-out property <float> bezier-a: 0.25;
    in-out property <float> bezier-b: 0.1;
    in-out property <float> bezier-c: 0.25;
    in-out property <float> bezier-d: 1.0;
    in-out property <float> anim-speed: 2.0;
    in-out property <string> anim-style: "slide";
    in-out property <bool> motion-dirty: false;

    background: transparent;
    clip: true;

    // Responsive split from window width (ShellRoot).
    in property <bool> two-col: false;
    // Cards-first global sequence, mirroring BordersSection: 0..list-count-1
    // are the built-in + user cards, then the tune stops. `split` is the tune
    // start, so the list pane reads the GLOBAL focused index and the tune pane
    // subtracts the split.
    property <int> list-count: root.anim-files.length + root.user-preset-names.length;
    property <int> split: root.list-count;
    // 4 bezier sliders + speed + style + the save form. Mirrors PanelRoot's
    // motion-total.
    out property <int> tune-count: 7;

    // Slider adjust (keyboard arrows: bezier ±0.05, speed ±0.5, clamped).
    // Any edit marks the Motion tune dirty, mirroring Borders' notify.
    public function adjust-slider(up: bool) {
        if (root.engaged-slider == 0) {
            let next = up ? min(root.bezier-a + 0.05, 1.0) : max(root.bezier-a - 0.05, 0.0);
            if (next != root.bezier-a) { root.bezier-a = next; root.motion-dirty = true; }
        } else if (root.engaged-slider == 1) {
            let next = up ? min(root.bezier-b + 0.05, 2.0) : max(root.bezier-b - 0.05, -1.0);
            if (next != root.bezier-b) { root.bezier-b = next; root.motion-dirty = true; }
        } else if (root.engaged-slider == 2) {
            let next = up ? min(root.bezier-c + 0.05, 1.0) : max(root.bezier-c - 0.05, 0.0);
            if (next != root.bezier-c) { root.bezier-c = next; root.motion-dirty = true; }
        } else if (root.engaged-slider == 3) {
            let next = up ? min(root.bezier-d + 0.05, 2.0) : max(root.bezier-d - 0.05, -1.0);
            if (next != root.bezier-d) { root.bezier-d = next; root.motion-dirty = true; }
        } else if (root.engaged-slider == 4) {
            let next = up ? min(root.anim-speed + 0.5, 6.0) : max(root.anim-speed - 0.5, 0.5);
            if (next != root.anim-speed) { root.anim-speed = next; root.motion-dirty = true; }
        }
    }

    // The STYLE stop (local 5) acts at once: Enter/Space cycles the family.
    // PanelRoot calls this and leaves `engaged-slider` untouched, so arrows keep
    // cycling the family afterwards.
    public function cycle-style() {
        if (root.anim-style == "slide") {
            root.anim-style = "fade";
        } else if (root.anim-style == "fade") {
            root.anim-style = "popin";
        } else {
            root.anim-style = "slide";
        }
        root.motion-dirty = true;
    }

    // Tune-enter seat map, mirroring BordersSection.tune-enter: returns 1 when
    // the stop acted at once (the style stop), 0 when PanelRoot must engage it.
    public function tune-enter() -> int {
        let local = root.focused-index - root.list-count;
        if (local == 5) { root.cycle-style(); return 1; }
        return 0;
    }

    VerticalLayout {
        spacing: 0px;

        // Header fixed
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "Motion";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }
            Text {
                text: "Shape the curve, then save as a preset. Or pick an existing animation.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // Phase 5 — always-visible curve indicator. Fixed header, OUTSIDE
            // both panes' ScrollViews (same idiom as the Borders dirty
            // indicator), so it never scrolls out of sight while in Motion.
            // Enlarged from 120×48 to 260×120, centred.
            HorizontalLayout {
                alignment: center;
                // Fixed height: without this the layout claims the section's
                // spare vertical space and floats the preview mid-header.
                vertical-stretch: 0;
                CurvePreview {
                    a: root.bezier-a;
                    b: root.bezier-b;
                    c: root.bezier-c;
                    d: root.bezier-d;
                    width: 260px;
                    height: 120px;
                }
            }
        }

        // Two independent panes. Wide: side by side. Narrow: stacked.
        if root.two-col : HorizontalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            MotionListPane {
                horizontal-stretch: 1;
                builtin-names: root.anim-titles;
                builtin-tags: root.anim-tags;
                user-names: root.user-preset-names;
                user-tags: root.user-preset-tags;
                active-index: root.active-index;
                focused-index: root.focused-index;
                has-focus: root.has-focus;
                // The list follows only while the focus is on a CARD.
                follow: root.focused-index < root.split;
                apply-preset(idx, name) => { root.apply-animation(idx, name); }
                open-rename(name) => {
                    root.preset-rename-input = name;
                    root.preset-dialog-target = name;
                    root.preset-dialog-mode = "rename";
                }
                open-delete(name) => {
                    root.preset-dialog-target = name;
                    root.preset-dialog-mode = "delete";
                }
            }

            Rectangle { width: 1px; background: HveColors.border.transparentize(0.6); }

            MotionTunePane {
                horizontal-stretch: 1;
                bezier-a <=> root.bezier-a;
                bezier-b <=> root.bezier-b;
                bezier-c <=> root.bezier-c;
                bezier-d <=> root.bezier-d;
                anim-speed <=> root.anim-speed;
                anim-style <=> root.anim-style;
                motion-dirty <=> root.motion-dirty;
                // Tune-local index: the pane subtracts the split internally.
                focused-index: root.focused-index - root.split;
                split: 0;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index >= root.split;
                error-text: root.save-error;
                preset-name <=> root.preset-name;
                save-preset(name) => { root.save-animation-preset(name); }
            }
        }
        if !root.two-col : VerticalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            MotionListPane {
                vertical-stretch: 1;
                builtin-names: root.anim-titles;
                builtin-tags: root.anim-tags;
                user-names: root.user-preset-names;
                user-tags: root.user-preset-tags;
                active-index: root.active-index;
                focused-index: root.focused-index;
                has-focus: root.has-focus;
                // The list follows only while the focus is on a CARD.
                follow: root.focused-index < root.split;
                apply-preset(idx, name) => { root.apply-animation(idx, name); }
                open-rename(name) => {
                    root.preset-rename-input = name;
                    root.preset-dialog-target = name;
                    root.preset-dialog-mode = "rename";
                }
                open-delete(name) => {
                    root.preset-dialog-target = name;
                    root.preset-dialog-mode = "delete";
                }
            }

            Rectangle { height: 1px; background: HveColors.border.transparentize(0.6); }

            MotionTunePane {
                vertical-stretch: 1;
                bezier-a <=> root.bezier-a;
                bezier-b <=> root.bezier-b;
                bezier-c <=> root.bezier-c;
                bezier-d <=> root.bezier-d;
                anim-speed <=> root.anim-speed;
                anim-style <=> root.anim-style;
                motion-dirty <=> root.motion-dirty;
                // Tune-local index: the pane subtracts the split internally.
                focused-index: root.focused-index - root.split;
                split: 0;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index >= root.split;
                error-text: root.save-error;
                preset-name <=> root.preset-name;
                save-preset(name) => { root.save-animation-preset(name); }
            }
        }
    }

    // ── Preset rename/delete dialogs (shared Dialogs.slint) ──
    if root.preset-dialog-mode == "rename" : RenameDialog {
        title: root.rename-title;
        placeholder: root.rename-placeholder;
        cancel-text: root.cancel-text;
        confirm-text: "Rename";
        confirm-color: HveColors.accent-pink;
        error-text: root.save-error;
        value <=> root.preset-rename-input;
        confirm(value) => {
            if (value != "" && value != root.preset-dialog-target) {
                root.rename-animation-preset(root.preset-dialog-target, value);
            }
            root.preset-dialog-mode = "";
        }
        cancel => { root.preset-dialog-mode = ""; }
    }
    if root.preset-dialog-mode == "delete" : ConfirmDialog {
        title: root.delete-title;
        title-color: HveColors.accent-red;
        message: root.delete-message + " \"" + root.preset-dialog-target + "\"?";
        cancel-text: root.cancel-text;
        confirm-text: "Delete";
        confirm-color: HveColors.accent-red;
        confirm => {
            root.delete-animation-preset(root.preset-dialog-target);
            root.preset-dialog-mode = "";
        }
        cancel => { root.preset-dialog-mode = ""; }
    }
}
