// HVE 2 — MotionSection (mutating-window R4 pick + tune + CurvePreview).
//
// Pick layer: PresetCards from scan("animations") → apply_animation, active
// indicator + toggle-off → none. Tune layer below divider: 4 bezier sliders
// a,b,c,d (x1,y1,x2,y2) + mini CurvePreview Path 120×48 redraws on slider
// changed. Ranges: a,c in [0,1], b,d in [-1,2] per CSS bezier convention;
// defaults 0.25/0.1/0.25/1. Arrow steps ±0.05 clamped.
//
// Keyboard R11: arrows navigate cards/sliders, Enter/Space activates,
// sliders ±0.05, Tab pick→tune→next never traps, icy-cyan #8fd8ff focus.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { Slider, ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";
import { PresetCard, HveKnobSlider } from "../../components.slint";
import { CurvePreview } from "../CurvePreview.slint";

component BezierSlider inherits Rectangle {
    in property <float> value: 0.25;
    in property <float> min: 0.0;
    in property <float> max: 1.0;
    in property <string> label: "";
    in property <bool> engaged: false;
    in property <bool> focused: false;
    callback changed(float);
    height: 72px;
    // Bare content: the section wrapper owns ALL card visuals
    // (background, border, radius, expansion). This inner layer stays
    // transparent and borderless so there is exactly one visible frame.
    background: transparent;
    border-width: 0px;
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: root.label;
                color: root.engaged ? #ffffff : HveColors.accent-cyan;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: Math.round(root.value * 100) / 100;
                color: #8fd8ff;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        HveKnobSlider {
            min: root.min;
            max: root.max;
            value: root.value;
            engaged: root.engaged;
            changed(v) => { root.changed(v); }
        }
    }
}

export component MotionSection inherits Rectangle {
    in property <[string]> anim-titles;
    in property <[string]> anim-descs;
    in property <[string]> anim-tags;
    in property <[string]> anim-files;
    in property <int> active-index: -1;
    callback apply-animation(int, string);
    callback back();
    callback menu-focus();
    in property <int> preview-index: -1;
    in property <bool> preview-engaged: false;
    in property <int> focus-gen: 0;

    // Tune layer — 4 bezier values (in-out so Rust snap can write them if needed)
    in-out property <float> bezier-a: 0.25;
    in-out property <float> bezier-b: 0.1;
    in-out property <float> bezier-c: 0.25;
    in-out property <float> bezier-d: 1.0;

    background: transparent;
    clip: true;

    // Keyboard R11 v3 (spatial): ONE linear sequence — preset cards first,
    // then the four bezier sliders. Up/Down walk, Enter engages a slider
    // (Left/Right adjust ±0.05 while engaged), Tab/Esc disengage, Left
    // (disengaged) hands focus to the left rail, Esc closes the panel.
    property <int> focused-index: root.preview-index >= 0 ? root.preview-index : 0;
    property <int> engaged-slider: root.preview-engaged ? (root.preview-index >= root.anim-files.length ? root.preview-index - root.anim-files.length : 0) : -1;
    property <int> control-count: root.anim-files.length + 4;
    // Scroll follows KEYBOARD focus only: arrows set focus-is-kbd, mouse
    // hover clears it (the hovered item is always on screen, so freezing
    // the view kills the seasick auto-scroll without losing key follow).
    property <bool> focus-is-kbd: true;
    property <length> saved-scroll-y: 0px;

    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.engaged-slider >= 0) { root.engaged-slider = -1; }
                else { root.back(); }
                return accept;
            }
            if (event.text == Key.Tab) {
                if (root.engaged-slider >= 0) { root.engaged-slider = -1; return accept; }
                return reject;
            }
            if (root.engaged-slider >= 0) {
                // Engaged bezier slider: Left/Right adjust ±0.05 clamped.
                if (event.text == Key.RightArrow || event.text == Key.LeftArrow) {
                    let up = event.text == Key.RightArrow;
                    if (root.engaged-slider == 0) {
                        let next = up ? min(root.bezier-a + 0.05, 1.0) : max(root.bezier-a - 0.05, 0.0);
                        if (next != root.bezier-a) { root.bezier-a = next; }
                    }
                    else if (root.engaged-slider == 1) {
                        let next = up ? min(root.bezier-b + 0.05, 2.0) : max(root.bezier-b - 0.05, -1.0);
                        if (next != root.bezier-b) { root.bezier-b = next; }
                    }
                    else if (root.engaged-slider == 2) {
                        let next = up ? min(root.bezier-c + 0.05, 1.0) : max(root.bezier-c - 0.05, 0.0);
                        if (next != root.bezier-c) { root.bezier-c = next; }
                    }
                    else if (root.engaged-slider == 3) {
                        let next = up ? min(root.bezier-d + 0.05, 2.0) : max(root.bezier-d - 0.05, -1.0);
                        if (next != root.bezier-d) { root.bezier-d = next; }
                    }
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.focused-index = min(root.focused-index + 1, root.control-count - 1);
                root.focus-is-kbd = true;
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.focused-index = max(root.focused-index - 1, 0);
                root.focus-is-kbd = true;
                return accept;
            }
            if (event.text == Key.LeftArrow) { root.menu-focus(); return accept; }
            if (event.text == Key.Return || event.text == Key.Space) {
                if (root.focused-index < root.anim-files.length) {
                    if (root.focused-index >= 0 && root.anim-files.length > 0) {
                        root.apply-animation(root.focused-index, root.anim-files[root.focused-index]);
                    }
                } else {
                    root.engaged-slider = root.focused-index - root.anim-files.length;
                }
                return accept;
            }
            return reject;
        }
    }

    // Save/System pattern: no zone border on the root — it toggled
    // width on focus gain and relayouted content between press and
    // release, eating the first click. Keyboard marks live on rows/cards.
    init => { fs.focus(); }
    changed focus-gen => { fs.focus(); }

    VerticalLayout {
        spacing: 0px;

        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "Motion";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }
            Text {
                text: "Pick an animation — instantly applied. Tune curve below.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            // Scroll follows the keyboard focus: cards pitch 66px, the
            // bezier tune blocks (~72px + spacing) sit after the divider
            // and the curve preview. Frozen while the mouse drives focus
            // (focus-is-kbd false).
            property <length> focus-y:
                root.focused-index < root.anim-files.length
                    ? root.focused-index * 66px
                      + (root.active-index >= 0 && root.active-index < root.focused-index ? 42px : 0px)
                      + (root.active-index == root.focused-index ? 21px : 0px)
                    : root.anim-files.length * 66px + 70px + (root.active-index >= 0 ? 42px : 0px)
                      + (root.focused-index - root.anim-files.length) * 80px;
            viewport-y: root.focus-is-kbd ? (root.focused-index >= 0
                // Slider rows center on half the LIT height (44px = 88/2):
                // the focused slider grows 72→88 (104 grabbed), so the card
                // half-height (29px) would park it too low and clip Y2-d.
                ? (0px - max(0px, self.focus-y + (root.focused-index < root.anim-files.length ? 29px : 44px) - self.height / 2))
                : 0px) : root.saved-scroll-y;
            animate viewport-y { duration: 250ms; easing: ease-out; }
            changed viewport-y => { root.saved-scroll-y = self.viewport-y; }
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                // 28px bottom breathing room (not 12px like the card-only
                // sections): the lit Y2-d block grows 72→88px (104 grabbed),
                // so 12px clips it. 28 covers the +16 lit delta; the spacer
                // below covers the grabbed delta + help text.
                padding-bottom: 28px;
                spacing: 8px;

                for i in root.anim-files.length : PresetCard {
                    title: root.anim-titles[i];
                    desc: root.anim-descs[i];
                    tag: root.anim-tags[i];
                    accent: #8fd8ff;
                    active: i == root.active-index;
                    keyboard-focused: i == root.focused-index && fs.has-focus && root.engaged-slider < 0;
                    index: i;
                    hover-moves-focus: false;
                    toggled => { root.focused-index = i; root.focus-is-kbd = false; root.apply-animation(i, root.anim-files[i]); }
                    focus-requested(idx) => { root.focused-index = idx; root.focus-is-kbd = false; }
                }

                if root.anim-files.length == 0 : Text {
                    text: "No animation presets found.";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: HveColors.text-muted;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 1px;
                    background: HveColors.border.transparentize(0.6);
                }

                // Curve preview 120×48 — redraws on slider changed via binding
                HorizontalLayout {
                    alignment: center;
                    CurvePreview {
                        a: root.bezier-a;
                        b: root.bezier-b;
                        c: root.bezier-c;
                        d: root.bezier-d;
                        width: 120px;
                        height: 48px;
                    }
                }

                // Bezier sliders a,b,c,d — arrow steps ±0.05 clamped, Tab no trap
                a-wrap := Rectangle {
                    // Card-like block: lights up on keyboard focus OR mouse
                    // hover (lit), reads "grabbed" when engaged. Heights mirror
                    // the cards proportionally (250ms bounce).
                    property <bool> lit: (root.focused-index == root.anim-files.length && fs.has-focus) || hover-a.has-hover;
                    property <bool> grabbed: root.engaged-slider == 0 && fs.has-focus;
                    height: self.lit ? (self.grabbed ? 104px : 88px) : 72px;
                    animate height { duration: 250ms; easing: ease-in-out-back; }
                    border-width: 1px;
                    border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    hover-a := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.focused-index = root.anim-files.length; }
                    }
                    BezierSlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == 0;
                        focused: a-wrap.lit;
                        label: "X1 — a";
                        value: root.bezier-a;
                        min: 0.0;
                        max: 1.0;
                        changed(v) => { root.bezier-a = v; }
                    }
                }
                b-wrap := Rectangle {
                    // Card-like block: lights up on keyboard focus OR mouse
                    // hover (lit), reads "grabbed" when engaged. Heights mirror
                    // the cards proportionally (250ms bounce).
                    property <bool> lit: (root.focused-index == root.anim-files.length + 1 && fs.has-focus) || hover-b.has-hover;
                    property <bool> grabbed: root.engaged-slider == 1 && fs.has-focus;
                    height: self.lit ? (self.grabbed ? 104px : 88px) : 72px;
                    animate height { duration: 250ms; easing: ease-in-out-back; }
                    border-width: 1px;
                    border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    hover-b := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.focused-index = root.anim-files.length + 1; }
                    }
                    BezierSlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == 1;
                        focused: b-wrap.lit;
                        label: "Y1 — b";
                        value: root.bezier-b;
                        min: -1.0;
                        max: 2.0;
                        changed(v) => { root.bezier-b = v; }
                    }
                }
                c-wrap := Rectangle {
                    // Card-like block: lights up on keyboard focus OR mouse
                    // hover (lit), reads "grabbed" when engaged. Heights mirror
                    // the cards proportionally (250ms bounce).
                    property <bool> lit: (root.focused-index == root.anim-files.length + 2 && fs.has-focus) || hover-c.has-hover;
                    property <bool> grabbed: root.engaged-slider == 2 && fs.has-focus;
                    height: self.lit ? (self.grabbed ? 104px : 88px) : 72px;
                    animate height { duration: 250ms; easing: ease-in-out-back; }
                    border-width: 1px;
                    border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    hover-c := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.focused-index = root.anim-files.length + 2; }
                    }
                    BezierSlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == 2;
                        focused: c-wrap.lit;
                        label: "X2 — c";
                        value: root.bezier-c;
                        min: 0.0;
                        max: 1.0;
                        changed(v) => { root.bezier-c = v; }
                    }
                }
                d-wrap := Rectangle {
                    // Card-like block: lights up on keyboard focus OR mouse
                    // hover (lit), reads "grabbed" when engaged. Heights mirror
                    // the cards proportionally (250ms bounce).
                    property <bool> lit: (root.focused-index == root.anim-files.length + 3 && fs.has-focus) || hover-d.has-hover;
                    property <bool> grabbed: root.engaged-slider == 3 && fs.has-focus;
                    height: self.lit ? (self.grabbed ? 104px : 88px) : 72px;
                    animate height { duration: 250ms; easing: ease-in-out-back; }
                    border-width: 1px;
                    border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    hover-d := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.focused-index = root.anim-files.length + 3; }
                    }
                    BezierSlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == 3;
                        focused: d-wrap.lit;
                        label: "Y2 — d";
                        value: root.bezier-d;
                        min: -1.0;
                        max: 2.0;
                        changed(v) => { root.bezier-d = v; }
                    }
                }

                Text {
                    text: "↑↓ navigate • Enter/Space apply • arrows ±0.05 • Tab pick→tune→next • Esc back";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: HveColors.text-muted.transparentize(0.4);
                    horizontal-alignment: center;
                }

                // Over-scroll spacer: lets the ScrollView travel far enough
                // that the grabbed Y2-d block (104px) + help text above fully
                // reveal when scrolled to the bottom (keyboard or mouse).
                Rectangle { height: 16px; }
            }
        }
    }
}
