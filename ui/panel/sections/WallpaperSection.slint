// HVE 2 — WallpaperSection (mutating-window R6 RO).
//
// Read-only view of the current theme's wallpaper bundle — static thumb
// + video badge when the theme has an mpvpaper video, via the thumbs
// pipeline data. Explicitly NO picker, no write path.
//
// Keyboard R11: arrows move focus between thumb container and badge area,
// Tab never traps, icy-cyan #8fd8ff focus.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";

export component WallpaperSection inherits Rectangle {
    // RO wallpaper bundle — static thumb + optional video badge
    in property <image> wallpaper-thumb;
    in property <string> wallpaper-thumb-path: "";
    in property <bool> has-video: false;
    in property <string> video-file: "";

    background: transparent;
    clip: true;

    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Tab) {
                return reject;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                // RO: no action, but accept to keep focus
                return accept;
            }
            return reject;
        }
    }

    border-width: fs.has-focus ? 1px : 0px;
    border-color: #8fd8ff;
    border-radius: SkwdTokens.radius-8;

    init => { fs.focus(); }

    VerticalLayout {
        spacing: 0px;
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "Wallpaper";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
                color: SkwdTokens.primary;
            }
            Text {
                text: "Current theme wallpapers — read-only. Video badge when animated.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: SkwdTokens.outline;
                wrap: word-wrap;
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 12px;
                spacing: 12px;

                // Static thumb container
                Rectangle {
                    height: 200px;
                    background: SkwdTokens.surface-container;
                    border-radius: SkwdTokens.radius-12;
                    border-width: 1px;
                    border-color: SkwdTokens.outline.transparentize(0.6);
                    clip: true;

                    if root.wallpaper-thumb-path != "" || root.wallpaper-thumb.width > 0 : Image {
                        width: 100%;
                        height: 100%;
                        source: root.wallpaper-thumb;
                        image-fit: cover;
                    }

                    if root.wallpaper-thumb-path == "" && root.wallpaper-thumb.width == 0 : Text {
                        text: "No wallpaper in this theme";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-14;
                        color: SkwdTokens.outline;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Video badge when mpvpaper video present
                    if root.has-video : Rectangle {
                        // positioned at bottom-right via layout alignment
                        x: parent.width - self.width - 8px;
                        y: parent.height - self.height - 8px;
                        width: badge-text.preferred-width + 20px;
                        height: 28px;
                        background: #ffb4ab; // primary
                        border-radius: SkwdTokens.radius-8;
                        badge-text := Text {
                            text: root.video-file != "" ? "▶ " + root.video-file : "▶ VIDEO";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            font-weight: 700;
                            color: #1d100e;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.has-video : Text {
                    text: "Animated wallpaper — video badge shown above.";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: SkwdTokens.outline;
                    horizontal-alignment: center;
                }

                if !root.has-video : Text {
                    text: "Static wallpaper only.";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: SkwdTokens.outline;
                    horizontal-alignment: center;
                }

                // Info about RO nature
                Rectangle {
                    height: 36px;
                    background: SkwdTokens.surface-container.transparentize(0.6);
                    border-radius: SkwdTokens.radius-8;
                    Text {
                        text: "Read-only — no picker in this view";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        color: SkwdTokens.outline.transparentize(0.3);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Tab focus • Esc back";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: SkwdTokens.outline.transparentize(0.4);
                    horizontal-alignment: center;
                }
            }
        }
    }
}
