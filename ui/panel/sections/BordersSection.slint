// HVE 2 — BordersSection (mutating-window R3, pick layer only).
//
// Pick layer: PresetCards from scan("borders") → apply_border, active
// indicator. Above a divider (R3). Tune layer (sliders) is slice 4 —
// NOT built here. No color. Keyboard R11: arrows navigate cards,
// Enter/Space activates, focus visible icy-cyan #8fd8ff, Tab pick→tune.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { PresetCard } from "../../components.slint";

export component BordersSection inherits Rectangle {
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in property <int> active-index: -1;
    callback apply-border(int, string);

    background: transparent;
    clip: true;

    // Internal keyboard focus index for arrow navigation (R11)
    property <int> focused-index: 0;

    // Focus scope for the whole section — arrows navigate cards, Enter/Space activates,
    // Tab is rejected so it bubbles to next focusable (pick→tune order, no trap).
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.DownArrow || event.text == Key.RightArrow) {
                if (root.border-files.length > 0) {
                    root.focused-index = min(root.focused-index + 1, root.border-files.length - 1);
                }
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.LeftArrow) {
                if (root.border-files.length > 0) {
                    root.focused-index = max(root.focused-index - 1, 0);
                }
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                if (root.focused-index >= 0 && root.focused-index < root.border-files.length) {
                    root.apply-border(root.focused-index, root.border-files[root.focused-index]);
                }
                return accept;
            }
            return reject;
        }
    }

    // Outer icy-cyan focus border when section has focus (R11)
    border-width: fs.has-focus ? 1px : 0px;
    border-color: #8fd8ff;
    border-radius: SkwdTokens.radius-8;

    init => { fs.focus(); }

    VerticalLayout {
        spacing: 0px;

        // Header
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "Borders";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
                color: SkwdTokens.primary;
            }
            Text {
                text: "Pick a border style — instantly applied. Tune (size/radius/gaps) lands next slice.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: SkwdTokens.outline;
                wrap: word-wrap;
            }
        }

        // Pick layer: scrollable PresetCards
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 12px;
                spacing: 8px;

                for i in root.border-files.length : PresetCard {
                    title: root.border-titles[i];
                    desc: root.border-descs[i];
                    tag: root.border-tags[i];
                    accent: #8fd8ff;
                    active: i == root.active-index;
                    keyboard-focused: i == root.focused-index && fs.has-focus;
                    index: i;
                    toggled => { root.apply-border(i, root.border-files[i]); }
                    focus-requested(idx) => { root.focused-index = idx; fs.focus(); }
                }

                if root.border-files.length == 0 : Text {
                    text: "No border presets found.";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: SkwdTokens.outline;
                    horizontal-alignment: center;
                }
            }
        }

        // Divider between pick and tune (R3 stacked layout)
        Rectangle {
            height: 1px;
            background: SkwdTokens.outline.transparentize(0.6);
        }

        // Tune placeholder — visible together, not behind tabs (slice 4 owns it)
        Rectangle {
            height: 48px;
            background: transparent;
            Text {
                text: "Tune — sliders for size, radius, gaps (next slice)";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: SkwdTokens.outline.transparentize(0.3);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: "↑↓ navigate • Enter/Space apply • Tab pick→tune • Esc back";
            font-family: SkwdTokens.font-body;
            font-size: SkwdTokens.size-12;
            color: SkwdTokens.outline.transparentize(0.4);
            horizontal-alignment: center;
            // use padding via parent
        }
    }
}
