// HVE 2 — BordersSection (mutating-window R3 pick + R3 tune debounced).
//
// Pick layer: PresetCards from scan("borders") → apply_border, active
// indicator + snap-on-pick (preset→4 sliders one-way). Tune layer below
// divider (R3 stacked): 4 GeometrySliders (size1-5, radius0-100, gap_in/out0-30)
// → 80ms Timer last-wins → apply_geometry compare-then-apply, skip init.
// COLOR GATED: inert color-slot placeholder only.
//
// Keyboard R11: arrows navigate cards/sliders, Enter/Space activates,
// sliders ±1, Tab pick→tune→next never traps, icy-cyan #8fd8ff focus.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";
import { PresetCard, GeometrySlider } from "../../components.slint";

export component BordersSection inherits Rectangle {
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in property <int> active-index: -1;
    callback apply-border(int, string);
    callback back();
    callback menu-focus();
    in property <int> preview-index: -1;
    in property <bool> preview-engaged: false;
    in property <int> focus-gen: 0;

    // Tune layer — 4 geometry values (in-out so Rust snap can write them)
    in-out property <int> geom-size: 2;
    in-out property <int> geom-radius: 32;
    in-out property <int> geom-gap-in: 5;
    in-out property <int> geom-gap-out: 5;
    callback apply-geometry(int, int, int, int);

    background: transparent;
    clip: true;

    // Keyboard R11 v3 (spatial): ONE linear sequence over the section's
    // controls — preset cards first, then the four tune sliders. Up/Down
    // walk the sequence, Enter engages a slider (then Left/Right adjust),
    // Tab/Esc disengage, Left (disengaged) hands focus to the left rail,
    // Esc (disengaged) closes the panel.
    property <int> focused-index: root.preview-index >= 0 ? root.preview-index : 0;
    property <int> engaged-slider: root.preview-engaged ? (root.preview-index >= root.border-files.length ? root.preview-index - root.border-files.length : 0) : -1;
    property <int> control-count: root.border-files.length + 4;

    // Tune debounce + skip-init + last-wins (R3)
    property <bool> size-init: false;
    property <bool> radius-init: false;
    property <bool> gap-in-init: false;
    property <bool> gap-out-init: false;
    property <int> pending-size: root.geom-size;
    property <int> pending-radius: root.geom-radius;
    property <int> pending-gap-in: root.geom-gap-in;
    property <int> pending-gap-out: root.geom-gap-out;
    property <int> last-size: root.geom-size;
    property <int> last-radius: root.geom-radius;
    property <int> last-gap-in: root.geom-gap-in;
    property <int> last-gap-out: root.geom-gap-out;
    property <bool> geom-dirty: false;

    geom-timer := Timer {
        interval: 80ms;
        running: root.geom-dirty;
        triggered => {
            if (root.pending-size != root.last-size || root.pending-radius != root.last-radius || root.pending-gap-in != root.last-gap-in || root.pending-gap-out != root.last-gap-out) {
                root.apply-geometry(root.pending-size, root.pending-radius, root.pending-gap-in, root.pending-gap-out);
                root.last-size = root.pending-size;
                root.last-radius = root.pending-radius;
                root.last-gap-in = root.pending-gap-in;
                root.last-gap-out = root.pending-gap-out;
            }
            root.geom-dirty = false;
        }
    }

    // Focus scope for pick — arrows navigate cards, Enter/Space activates.
    // Keyboard R11 v2 Tab contract: Tab moves to the NEXT GROUP explicitly
    // (first tune slider), Shift+Tab leaves to the previous section; the
    // last tune scope hands Tab to tab-next — no traps, deterministic order.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.engaged-slider >= 0) { root.engaged-slider = -1; }
                else { root.back(); }
                return accept;
            }
            if (event.text == Key.Tab) {
                if (root.engaged-slider >= 0) { root.engaged-slider = -1; return accept; }
                return reject;
            }
            if (root.engaged-slider >= 0) {
                // Engaged slider: Left/Right adjust (±1, horizontal widget).
                if (event.text == Key.RightArrow || event.text == Key.LeftArrow) {
                    let up = event.text == Key.RightArrow;
                    if (root.engaged-slider == 0) {
                        let next = up ? min(root.geom-size + 1, 5) : max(root.geom-size - 1, 1);
                        if (next != root.geom-size) {
                            root.geom-size = next;
                            if (!root.size-init) { root.size-init = true; return accept; }
                            root.pending-size = next;
                            root.geom-dirty = false;
                            root.geom-dirty = true;
                            geom-timer.restart();
                        }
                    }
                    else if (root.engaged-slider == 1) {
                        let next = up ? min(root.geom-radius + 1, 100) : max(root.geom-radius - 1, 0);
                        if (next != root.geom-radius) {
                            root.geom-radius = next;
                            if (!root.radius-init) { root.radius-init = true; return accept; }
                            root.pending-radius = next;
                            root.geom-dirty = false;
                            root.geom-dirty = true;
                            geom-timer.restart();
                        }
                    }
                    else if (root.engaged-slider == 2) {
                        let next = up ? min(root.geom-gap-in + 1, 30) : max(root.geom-gap-in - 1, 0);
                        if (next != root.geom-gap-in) {
                            root.geom-gap-in = next;
                            if (!root.gap-in-init) { root.gap-in-init = true; return accept; }
                            root.pending-gap-in = next;
                            root.geom-dirty = false;
                            root.geom-dirty = true;
                            geom-timer.restart();
                        }
                    }
                    else if (root.engaged-slider == 3) {
                        let next = up ? min(root.geom-gap-out + 1, 30) : max(root.geom-gap-out - 1, 0);
                        if (next != root.geom-gap-out) {
                            root.geom-gap-out = next;
                            if (!root.gap-out-init) { root.gap-out-init = true; return accept; }
                            root.pending-gap-out = next;
                            root.geom-dirty = false;
                            root.geom-dirty = true;
                            geom-timer.restart();
                        }
                    }
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.focused-index = min(root.focused-index + 1, root.control-count - 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.focused-index = max(root.focused-index - 1, 0);
                return accept;
            }
            if (event.text == Key.LeftArrow) { root.menu-focus(); return accept; }
            if (event.text == Key.Return || event.text == Key.Space) {
                if (root.focused-index < root.border-files.length) {
                    if (root.focused-index >= 0 && root.border-files.length > 0) {
                        root.apply-border(root.focused-index, root.border-files[root.focused-index]);
                    }
                } else {
                    root.engaged-slider = root.focused-index - root.border-files.length;
                }
                return accept;
            }
            return reject;
        }
    }

    // Outer icy-cyan focus border when section has focus (R11)
    border-width: fs.has-focus ? 1px : 0px;
    border-color: #8fd8ff;
    border-radius: SkwdTokens.radius-8;

    init => { fs.focus(); }
    changed focus-gen => { fs.focus(); }

    // Keep pending/last in sync when Rust snaps sliders (pick→tune one-way)
    changed geom-size => {
        if (!root.geom-dirty) {
            root.pending-size = root.geom-size;
            root.last-size = root.geom-size;
        }
    }
    changed geom-radius => {
        if (!root.geom-dirty) {
            root.pending-radius = root.geom-radius;
            root.last-radius = root.geom-radius;
        }
    }
    changed geom-gap-in => {
        if (!root.geom-dirty) {
            root.pending-gap-in = root.geom-gap-in;
            root.last-gap-in = root.geom-gap-in;
        }
    }
    changed geom-gap-out => {
        if (!root.geom-dirty) {
            root.pending-gap-out = root.geom-gap-out;
            root.last-gap-out = root.geom-gap-out;
        }
    }

    VerticalLayout {
        spacing: 0px;

        // Header fixed
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "Borders";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }
            Text {
                text: "Pick a border style — instantly applied. Tune below.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }
        }

        // Scrollable stacked pick+tune (visible together, scroll if overflow)
        ScrollView {
            vertical-stretch: 1;
            // Scroll follows the keyboard focus (master recipe adapted):
            // cards pitch 66px (58 + 8), an expanded card above adds 42px,
            // slider blocks ~88px after the divider + color placeholder.
            property <length> focus-y:
                root.focused-index < root.border-files.length
                    ? root.focused-index * 66px
                      + (root.active-index >= 0 && root.active-index < root.focused-index ? 42px : 0px)
                      + (root.active-index == root.focused-index ? 21px : 0px)
                    : root.border-files.length * 66px + 40px + (root.active-index >= 0 ? 42px : 0px)
                      + (root.focused-index - root.border-files.length) * 88px;
            viewport-y: root.focused-index >= 0
                ? (0px - max(0px, self.focus-y + 29px - self.height / 2))
                : 0px;
            animate viewport-y { duration: 250ms; easing: ease-out; }
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 12px;
                spacing: 8px;

                // Pick cards
                for i in root.border-files.length : PresetCard {
                    title: root.border-titles[i];
                    desc: root.border-descs[i];
                    tag: root.border-tags[i];
                    accent: #8fd8ff;
                    active: i == root.active-index;
                    keyboard-focused: i == root.focused-index && fs.has-focus && root.engaged-slider < 0;
                    index: i;
                    toggled => { root.apply-border(i, root.border-files[i]); }
                    focus-requested(idx) => { root.focused-index = idx; fs.focus(); }
                }

                if root.border-files.length == 0 : Text {
                    text: "No border presets found.";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: HveColors.text-muted;
                    horizontal-alignment: center;
                }

                // Divider between pick and tune (R3 stacked layout)
                Rectangle {
                    height: 1px;
                    background: HveColors.border.transparentize(0.6);
                }

                // COLOR_GATE: inert placeholder (must stay inert, no color behavior)
                // COLOR_GATE: needs Engine::apply_border_color + config field — USER DECISION REQUIRED
                Rectangle {
                    height: 28px;
                    background: transparent;
                    border-width: 1px;
                    border-color: #8fd8ff.transparentize(0.7);
                    border-radius: SkwdTokens.radius-8;
                    Text {
                        text: "color — gated (next slice)";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        color: HveColors.text-muted.transparentize(0.3);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Size 1-5
                size-wrap := Rectangle {
                    // Card-like block: lights up on keyboard focus OR mouse
                    // hover (lit), reads "grabbed" when engaged. Heights mirror
                    // the cards proportionally (250ms bounce).
                    property <bool> lit: (root.focused-index == root.border-files.length && fs.has-focus) || hover-size.has-hover;
                    property <bool> grabbed: root.engaged-slider == 0 && fs.has-focus;
                    height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                    animate height { duration: 250ms; easing: ease-in-out-back; }
                    border-width: self.grabbed ? 3px : (self.lit ? 1px : 0px);
                    border-color: self.grabbed ? #ffffff : #8fd8ff;
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    hover-size := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.focused-index = root.border-files.length; fs.focus(); }
                    }
                    GeometrySlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == 0;
                        focused: size-wrap.lit;
                        label: "Border Thickness";
                        value: root.geom-size;
                        min: 1;
                        max: 5;
                        changed(v) => {
                            if (!root.size-init) { root.size-init = true; return; }
                            if (v == root.last-size) { return; }
                            root.geom-size = v;
                            root.pending-size = v;
                            root.geom-dirty = false;
                            root.geom-dirty = true;
                            geom-timer.restart();
                        }
                    }
                }

                // Radius 0-100
                radius-wrap := Rectangle {
                    // Card-like block: lights up on keyboard focus OR mouse
                    // hover (lit), reads "grabbed" when engaged. Heights mirror
                    // the cards proportionally (250ms bounce).
                    property <bool> lit: (root.focused-index == root.border-files.length + 1 && fs.has-focus) || hover-radius.has-hover;
                    property <bool> grabbed: root.engaged-slider == 1 && fs.has-focus;
                    height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                    animate height { duration: 250ms; easing: ease-in-out-back; }
                    border-width: self.grabbed ? 3px : (self.lit ? 1px : 0px);
                    border-color: self.grabbed ? #ffffff : #8fd8ff;
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    hover-radius := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.focused-index = root.border-files.length + 1; fs.focus(); }
                    }
                    GeometrySlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == 1;
                        focused: radius-wrap.lit;
                        label: "Corner Radius";
                        value: root.geom-radius;
                        min: 0;
                        max: 100;
                        changed(v) => {
                            if (!root.radius-init) { root.radius-init = true; return; }
                            if (v == root.last-radius) { return; }
                            root.geom-radius = v;
                            root.pending-radius = v;
                            root.geom-dirty = false;
                            root.geom-dirty = true;
                            geom-timer.restart();
                        }
                    }
                }

                // Gap In 0-30
                gap-in-wrap := Rectangle {
                    // Card-like block: lights up on keyboard focus OR mouse
                    // hover (lit), reads "grabbed" when engaged. Heights mirror
                    // the cards proportionally (250ms bounce).
                    property <bool> lit: (root.focused-index == root.border-files.length + 2 && fs.has-focus) || hover-gap-in.has-hover;
                    property <bool> grabbed: root.engaged-slider == 2 && fs.has-focus;
                    height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                    animate height { duration: 250ms; easing: ease-in-out-back; }
                    border-width: self.grabbed ? 3px : (self.lit ? 1px : 0px);
                    border-color: self.grabbed ? #ffffff : #8fd8ff;
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    hover-gap-in := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.focused-index = root.border-files.length + 2; fs.focus(); }
                    }
                    GeometrySlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == 2;
                        focused: gap-in-wrap.lit;
                        label: "Inner Gap";
                        value: root.geom-gap-in;
                        min: 0;
                        max: 30;
                        changed(v) => {
                            if (!root.gap-in-init) { root.gap-in-init = true; return; }
                            if (v == root.last-gap-in) { return; }
                            root.geom-gap-in = v;
                            root.pending-gap-in = v;
                            root.geom-dirty = false;
                            root.geom-dirty = true;
                            geom-timer.restart();
                        }
                    }
                }

                // Gap Out 0-30
                gap-out-wrap := Rectangle {
                    // Card-like block: lights up on keyboard focus OR mouse
                    // hover (lit), reads "grabbed" when engaged. Heights mirror
                    // the cards proportionally (250ms bounce).
                    property <bool> lit: (root.focused-index == root.border-files.length + 3 && fs.has-focus) || hover-gap-out.has-hover;
                    property <bool> grabbed: root.engaged-slider == 3 && fs.has-focus;
                    height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                    animate height { duration: 250ms; easing: ease-in-out-back; }
                    border-width: self.grabbed ? 3px : (self.lit ? 1px : 0px);
                    border-color: self.grabbed ? #ffffff : #8fd8ff;
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    hover-gap-out := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.focused-index = root.border-files.length + 3; fs.focus(); }
                    }
                    GeometrySlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == 3;
                        focused: gap-out-wrap.lit;
                        label: "Outer Gap";
                        value: root.geom-gap-out;
                        min: 0;
                        max: 30;
                        changed(v) => {
                            if (!root.gap-out-init) { root.gap-out-init = true; return; }
                            if (v == root.last-gap-out) { return; }
                            root.geom-gap-out = v;
                            root.pending-gap-out = v;
                            root.geom-dirty = false;
                            root.geom-dirty = true;
                            geom-timer.restart();
                        }
                    }
                }

                Text {
                    text: "↑↓ navigate • Enter apply/engage • ←→ adjust • Esc/Tab release • ← menu • Esc back";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: HveColors.text-muted.transparentize(0.4);
                    horizontal-alignment: center;
                }
            }
        }
    }
}
