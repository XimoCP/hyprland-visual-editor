// HVE 2 — BordersSection (tune + preset list, two-pane).
//
// Two INDEPENDENT scroll regions:
//   • Tune pane  — size slider (1-5) → 80ms debounce → apply_geometry,
//     angle segmented control (30/45/90), inactive color row, dynamic
//     color slots (2..8) from tune-active-colors model with interactive
//     token swatches, add/remove controls, plus save form
//     (LineEdit + Save button) at the bottom.
//   • List pane  — Built-in presets (apply only) + user presets (apply,
//     rename, delete) via SavedPresetCard. User presets carry a ★ badge.
// Wide section → panes side by side; narrow section → stacked. Each pane owns
// its own ScrollView. Keyboard: single linear sequence owned by PanelRoot's
// panel-kbd; ← / → jump one panel at a time (menu → tune → list).
//
// Keyboard R11: arrows navigate cards/sliders, Enter/Space activates,
// sliders ±1, icy-cyan #8fd8ff focus.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { LineEdit, ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";
import { GeometrySlider } from "../../components.slint";
import { SavedPresetCard } from "SavedPresetCard.slint";
import { BorderColorSlot } from "BorderColorSlot.slint";

// ─── Tune pane: dynamic color slots + angle + inactive + size + save form. ───
// Rebuilt in U3a: old 4-slider geometry block removed; only size 1-5 kept.
// Dynamic color slots (2..8) rendered from tune-active-colors model.
// Angle segmented control (30/45/90).
// Inactive color row.
// Every control carries a plain-language description (frozen requirement).
component BordersTunePane inherits Rectangle {
    in property <int> size: 2;
    in property <int> focused-index: 0;
    in property <int> split: 0;
    in property <bool> has-focus: false;
    in property <int> engaged-slider: -1;
    in property <bool> follow: false;
    // Tune pane — dynamic (Unit 2)
    in property <[string]> tune-active-colors: [];
    in property <int> tune-color-count: 0;
    in-out property <int> tune-angle: 90;
    in property <string> tune-inactive-color: "";
    // Save form state
    in property <string> error-text: "";
    in-out property <string> preset-name: "";
    callback slider-changed(int, int);
    callback save-preset(string);
    // Slot management callbacks
    callback add-color-slot();
    callback remove-color-slot();
    callback slot-color-changed(int, string);
    // The inactive color is an `in` property here (the section owns the tune
    // state), so a mouse pick has to travel back up as a callback.
    callback inactive-color-changed(string);
    // Glow group
    in property <bool> glow-enabled: false;
    in-out property <int> glow-range: 20;
    in-out property <int> glow-render-power: 4;
    in-out property <string> glow-color: "p:primary";
    in-out property <string> glow-color-inactive: "p:surface_lowest";
    callback glow-changed(bool, int, int, string, string);
    // Animation leaves
    in-out property <bool> anim-borderangle-enabled: false;
    in-out property <int> anim-borderangle-speed: 30;
    in-out property <string> anim-borderangle-bezier: "default";
    in-out property <string> anim-borderangle-style: "";
    in-out property <bool> anim-border-enabled: false;
    in-out property <int> anim-border-speed: 30;
    in-out property <string> anim-border-bezier: "default";
    in-out property <string> anim-border-style: "";
    in-out property <bool> anim-fadeshadow-enabled: false;
    in-out property <int> anim-fadeshadow-speed: 30;
    in-out property <string> anim-fadeshadow-bezier: "default";
    in-out property <string> anim-fadeshadow-style: "";
    in-out property <[string]> anim-curves: [];
    callback anim-changed(string, bool, int, string, string);
    // Rule toggle
    in-out property <bool> tune-rule-enabled: false;

    property <length> saved-scroll-y: 0px;
    // Tune-local indices (cards-first global minus list split):
    // 0=size, 1=angle, 2=inactive, 3..3+N-1=slots, 3+N=add, 4+N=remove,
    // 5+N=glow-enabled (+range, power, color, inactive when on), then per
    // anim leaf enabled (+speed, bezier, style when on) x3, rule, save-name,
    // save-button. Mirrors callbacks::borders_tune_stop_count.
    property <int> local-focus: root.focused-index - root.split;
    property <int> slot-count: clamp(root.tune-color-count, 0, 8);
    property <int> first-slot-idx: 3;
    property <int> idx-add: 3 + root.slot-count;
    property <int> idx-remove: 4 + root.slot-count;
    property <int> idx-glow-en: 5 + root.slot-count;
    property <int> idx-glow-range: 6 + root.slot-count;
    property <int> idx-glow-power: 7 + root.slot-count;
    property <int> idx-glow-color: 8 + root.slot-count;
    property <int> idx-glow-inactive: 9 + root.slot-count;
    property <int> base-anim: root.glow-enabled ? 10 + root.slot-count : 6 + root.slot-count;
    property <int> idx-a0-en: root.base-anim;
    property <int> idx-a0-speed: root.base-anim + 1;
    property <int> idx-a0-bezier: root.base-anim + 2;
    property <int> idx-a0-style: root.base-anim + 3;
    property <int> base-a1: root.base-anim + 1 + (root.anim-borderangle-enabled ? 3 : 0);
    property <int> idx-a1-en: root.base-a1;
    property <int> idx-a1-speed: root.base-a1 + 1;
    property <int> idx-a1-bezier: root.base-a1 + 2;
    property <int> idx-a1-style: root.base-a1 + 3;
    property <int> base-a2: root.base-a1 + 1 + (root.anim-border-enabled ? 3 : 0);
    property <int> idx-a2-en: root.base-a2;
    property <int> idx-a2-speed: root.base-a2 + 1;
    property <int> idx-a2-bezier: root.base-a2 + 2;
    property <int> idx-a2-style: root.base-a2 + 3;
    property <int> base-tail: root.base-a2 + 1 + (root.anim-fadeshadow-enabled ? 3 : 0);
    property <int> idx-rule: root.base-tail;
    property <int> idx-save-name: root.base-tail + 1;
    property <int> idx-save-btn: root.base-tail + 2;

    // Slint has no substring op, so the encoded value ("p:primary", "c:rrggbbaa")
    // is mapped to a readable label explicitly. Raw encodings must never reach
    // the UI: showing "p:surface_lowest" was a real defect (F1).
    function readable-color(v: string) -> string {
        if (v == "p:primary") { return "primary"; }
        if (v == "p:secondary") { return "secondary"; }
        if (v == "p:tertiary") { return "tertiary"; }
        if (v == "p:error") { return "error"; }
        if (v == "p:surface") { return "surface"; }
        if (v == "p:surface_lowest") { return "surface_lowest"; }
        if (v == "") { return "(none)"; }
        return v;
    }
    function is-token-color(v: string) -> bool {
        return v == "p:primary" || v == "p:secondary" || v == "p:tertiary"
            || v == "p:error" || v == "p:surface" || v == "p:surface_lowest";
    }
    background: transparent;
    clip: true;

    ScrollView {
        // Linear estimate keeps every stop scrollable: the viewport centers
        // on the focused stop so it is always visible (no dead stops).
        // Clamped to [height - content, 0] so the first and last stops can
        // never scroll into the void, whatever the inventory mix.
        property <length> focus-y: root.local-focus * 96px;
        viewport-y: root.follow ? (root.local-focus >= 0
            ? max(self.height - tune-col.height, min(0px, 0px - max(0px, self.focus-y + 48px - self.height / 2)))
            : 0px) : root.saved-scroll-y;
        animate viewport-y { duration: 250ms; easing: ease-out; }
        changed viewport-y => { root.saved-scroll-y = self.viewport-y; }
        tune-col := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 8px;

            // ── Size 1-5 ──
            size-wrap := Rectangle {
                property <bool> lit: (root.focused-index == root.split && root.has-focus) || hover-size.has-hover;
                property <bool> grabbed: root.engaged-slider == 0 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-size := TouchArea { width: 100%; height: 100%; clicked => { } }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 0;
                    focused: size-wrap.lit;
                    label: "Border Thickness";
                    value: root.size;
                    min: 1;
                    max: 5;
                    changed(v) => { root.slider-changed(0, v); }
                }
            }

            // ── Description: size ──
            Text {
                text: "Border width in pixels (1 thin, 5 thick).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // ── Angle segmented control (30 / 45 / 90) ──
            angle-wrap := Rectangle {
                property <bool> lit: root.local-focus == 1 && root.has-focus;
                property <bool> grabbed: root.engaged-slider == 1 && root.has-focus;
                height: self.lit ? 96px : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "Gradient Angle";
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 4px;

                        for angle-val in [30, 45, 90] : Rectangle {
                            width: 60px;
                            height: 32px;
                            border-radius: SkwdTokens.radius-4;
                            background: root.tune-angle == angle-val ? HveColors.accent-cyan : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: root.tune-angle == angle-val ? HveColors.accent-cyan : HveColors.border;

                            Text {
                                text: angle-val + "°";
                                color: root.tune-angle == angle-val ? HveColors.bg-dark : HveColors.text-muted;
                                font-family: SkwdTokens.font-body;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.tune-angle = angle-val; }
                            }
                        }
                    }
                }
            }

            // ── Description: angle ──
            Text {
                text: "Direction of the active border gradient (30/45/90 degrees).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // ── Inactive color row ──
            inactive-wrap := Rectangle {
                property <bool> lit: root.focused-index == root.split + 2 && root.has-focus;
                // Tall enough for title + full BorderColorSlot (label + description):
                // padding 32 + spacing 4 + title ~18 + slot 110 = ~164.
                height: self.lit ? 184px : 168px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }

                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;

                    Text {
                        text: "Inactive Border Color";
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    BorderColorSlot {
                        width: 100%;
                        slot-value: root.tune-inactive-color;
                        slot-description: "Color of unfocused window borders. Tap a swatch to change it.";
                        display-label: root.readable-color(root.tune-inactive-color);
                        editable: true;
                        slot-changed(v) => { root.inactive-color-changed(v); }
                    }
                }
            }

            // ── Description: inactive ──
            Text {
                text: "Color applied to borders of unfocused (inactive) windows.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // ── Dynamic color slots ──
            if root.slot-count > 0 : Text {
                text: "Active Border Colors (" + root.slot-count + " slots)";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-12;
                font-weight: 600;
                color: HveColors.text-muted;
            }

            for i in root.tune-active-colors.length : Rectangle {
                property <bool> slot-lit: root.focused-index == root.split + root.first-slot-idx + i && root.has-focus;
                height: 130px;
                border-width: 1px;
                border-color: self.slot-lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.slot-lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }

                BorderColorSlot {
                    width: 100%;
                    slot-value: root.tune-active-colors[i];
                    slot-description: "Active gradient color slot " + (i + 1) + " of " + root.slot-count + ". Tap a swatch to change.";
                    // Name the current pick too, so the user reads "Slot 2 · tertiary"
                    // instead of having to decode which swatch is outlined.
                    display-label: "Slot " + (i + 1) + " · " + root.readable-color(root.tune-active-colors[i]);
                    editable: true;
                    is-token: root.is-token-color(root.tune-active-colors[i]);
                    slot-changed(v) => { root.slot-color-changed(i, v); }
                }
            }

            // ── Add / Remove slot controls ──
            if root.slot-count > 0 : HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-remove && root.has-focus;
                    width: 36px;
                    height: 28px;
                    border-radius: SkwdTokens.radius-4;
                    background: self.lit ? HveColors.bg-hover : (root.slot-count > 2 && remove-ta.has-hover ? HveColors.bg-hover : HveColors.bg-surface);
                    border-width: 1px;
                    border-color: self.lit ? #8fd8ff : (root.slot-count > 2 ? HveColors.border : HveColors.border.transparentize(0.5));
                    opacity: root.slot-count > 2 ? 1.0 : 0.4;

                    Text {
                        text: "−";
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    remove-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { if (root.slot-count > 2) { root.remove-color-slot(); } }
                    }
                }

                Text {
                    text: root.slot-count + " of 8";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    color: HveColors.text-muted;
                    vertical-alignment: center;
                }

                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-add && root.has-focus;
                    width: 36px;
                    height: 28px;
                    border-radius: SkwdTokens.radius-4;
                    background: self.lit ? HveColors.bg-hover : (root.slot-count < 8 && add-ta.has-hover ? HveColors.bg-hover : HveColors.bg-surface);
                    border-width: 1px;
                    border-color: self.lit ? #8fd8ff : (root.slot-count < 8 ? HveColors.border : HveColors.border.transparentize(0.5));
                    opacity: root.slot-count < 8 ? 1.0 : 0.4;

                    Text {
                        text: "+";
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    add-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { if (root.slot-count < 8) { root.add-color-slot(); } }
                    }
                }
            }

            // ── Description: dynamic slots ──
            if root.slot-count > 0 : Text {
                text: "Each slot is one color in the active border gradient. Order matches the preset file. 2-8 slots supported by Hyprland.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // ── Glow group ──
            if !root.glow-enabled : Rectangle {
                property <bool> lit: root.local-focus == root.idx-glow-en && root.has-focus;
                height: self.lit ? 64px : 56px;
                border-width: 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: space-between;

                    Text {
                        text: "Glow (shadow decoration)";
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-13;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 80px;
                        height: 28px;
                        border-radius: SkwdTokens.radius-4;
                        background: glow-add-ta.has-hover ? HveColors.accent-cyan.transparentize(0.2) : HveColors.accent-cyan;

                        Text {
                            text: "Add";
                            color: HveColors.bg-dark;
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        glow-add-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.glow-changed(true, root.glow-range, root.glow-render-power, root.glow-color, root.glow-color-inactive); }
                        }
                    }
                }
            }

            // ── Description: glow (empty state) ──
            // Task 3.4 requires the addable state to explain itself, not just
            // show a button.
            if !root.glow-enabled : Text {
                text: "This preset has no glow. Add one to give the border a coloured shadow around focused windows.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            if root.glow-enabled : VerticalLayout {
                spacing: 8px;

                // Glow header with remove button (enabled stop)
                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-glow-en && root.has-focus;
                    height: self.lit ? 64px : 56px;
                    border-width: 1px;
                    border-color: self.lit ? #8fd8ff : HveColors.border;
                    border-radius: SkwdTokens.radius-8;
                    background: self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        alignment: space-between;
                        Text {
                            text: "Glow (shadow decoration)";
                            color: HveColors.accent-cyan;
                            font-family: SkwdTokens.font-heading;
                            font-size: SkwdTokens.size-13;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: SkwdTokens.radius-4;
                            background: glow-remove-ta.has-hover ? HveColors.accent-red.transparentize(0.2) : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: HveColors.border;

                        Text {
                            text: "×";
                            color: HveColors.text-muted;
                            font-family: SkwdTokens.font-body;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        glow-remove-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.glow-changed(false, root.glow-range, root.glow-render-power, root.glow-color, root.glow-color-inactive); }
                        }
                        }
                    }
                }

                // Range slider
                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-glow-range && root.has-focus;
                    property <bool> grabbed: root.engaged-slider == root.idx-glow-range && root.has-focus;
                    height: self.lit ? 64px : 56px;
                    border-width: 1px;
                    border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;

                    GeometrySlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == root.idx-glow-range;
                        focused: root.local-focus == root.idx-glow-range && root.has-focus;
                        label: "Range";
                        value: root.glow-range;
                        min: 5;
                        max: 40;
                        changed(v) => { root.glow-changed(root.glow-enabled, v, root.glow-render-power, root.glow-color, root.glow-color-inactive); }
                    }
                }

                Text {
                    text: "How far the shadow extends from the window edge (5 near, 40 far).";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    color: HveColors.text-muted;
                    wrap: word-wrap;
                }

                // Render power slider
                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-glow-power && root.has-focus;
                    property <bool> grabbed: root.engaged-slider == root.idx-glow-power && root.has-focus;
                    height: self.lit ? 64px : 56px;
                    border-width: 1px;
                    border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;

                    GeometrySlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == root.idx-glow-power;
                        focused: root.local-focus == root.idx-glow-power && root.has-focus;
                        label: "Power";
                        value: root.glow-render-power;
                        min: 1;
                        max: 8;
                        changed(v) => { root.glow-changed(root.glow-enabled, root.glow-range, v, root.glow-color, root.glow-color-inactive); }
                    }
                }

                Text {
                    text: "Shadow intensity (1 subtle, 8 strong).";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    color: HveColors.text-muted;
                    wrap: word-wrap;
                }

                // Glow color
                // Height must fit title + BorderColorSlot (110px): the old 72/80px
                // let the slot overflow and paint OVER the next title. Same sizing
                // as the inactive-color card, which already fits.
                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-glow-color && root.has-focus;
                    height: self.lit ? 184px : 168px;
                    border-width: 1px;
                    border-color: self.lit ? #8fd8ff : HveColors.border;
                    border-radius: SkwdTokens.radius-8;
                    background: self.lit ? HveColors.bg-hover : HveColors.bg-card;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 4px;

                        Text {
                            text: "Glow Color";
                            color: HveColors.text;
                            font-family: SkwdTokens.font-body;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        BorderColorSlot {
                            width: 100%;
                            slot-value: root.glow-color;
                            slot-description: "Color of the glow on focused windows. Tap a swatch to change it.";
                            display-label: root.readable-color(root.glow-color);
                            editable: true;
                            is-token: root.is-token-color(root.glow-color);
                            slot-changed(v) => {
                                root.glow-changed(root.glow-enabled, root.glow-range, root.glow-render-power, v, root.glow-color-inactive);
                            }
                        }
                    }
                }

                // Glow inactive color
                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-glow-inactive && root.has-focus;
                    height: self.lit ? 184px : 168px;
                    border-width: 1px;
                    border-color: self.lit ? #8fd8ff : HveColors.border;
                    border-radius: SkwdTokens.radius-8;
                    background: self.lit ? HveColors.bg-hover : HveColors.bg-card;

