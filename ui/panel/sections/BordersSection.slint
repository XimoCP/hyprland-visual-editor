// HVE 2 — BordersSection (mutating-window R3 pick + R3 tune debounced, two-pane).
//
// Two INDEPENDENT scroll regions that separate functionality:
//   • Pick pane  — PresetCards from scan("borders") → apply_border.
//   • Tune pane  — COLOR-GATED placeholder + 4 GeometrySliders (size1-5,
//     radius0-100, gap_in/out0-30) → 80ms Timer last-wins → apply_geometry
//     compare-then-apply, skip init.
// Wide section → panes side by side; narrow section → panes stacked. Either
// way each pane owns its own ScrollView, so scrolling one never moves the
// other. The keyboard stays the single linear sequence owned by PanelRoot's
// panel-kbd: index < N targets the pick pane, index >= N the tune pane, and
// only the owning pane scroll-follows. ← / → jump one panel at a time
// (menu -> pick -> tune).
//
// Keyboard R11: arrows navigate cards/sliders, Enter/Space activates,
// sliders ±1, icy-cyan #8fd8ff focus.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";
import { PresetCard, GeometrySlider } from "../../components.slint";

// ─── Pick pane: preset cards only. Own ScrollView + own scroll memory. ───
component BordersPickPane inherits Rectangle {
    in property <[string]> titles;
    in property <[string]> descs;
    in property <[string]> tags;
    in property <[string]> files;
    in property <int> active-index: -1;
    in property <int> focused-index: 0;
    in property <bool> has-focus: false;
    in property <int> engaged-slider: -1;
    // True while this pane owns the keyboard cursor → the ScrollView follows
    // focus. False → the user's saved scroll position is preserved.
    in property <bool> follow: false;
    callback apply-border(int, string);

    property <length> saved-scroll-y: 0px;
    background: transparent;
    clip: true;

    ScrollView {
        // ScrollView is a container: it fills the pane Rectangle by default.
        // Scroll follows the keyboard focus: cards pitch 66px (58 + 8), an
        // expanded card above adds 42px.
        property <length> focus-y:
            root.focused-index * 66px
            + (root.active-index >= 0 && root.active-index < root.focused-index ? 42px : 0px)
            + (root.active-index == root.focused-index ? 21px : 0px);
        viewport-y: root.follow ? (root.focused-index >= 0
            ? (0px - max(0px, self.focus-y + 29px - self.height / 2))
            : 0px) : root.saved-scroll-y;
        animate viewport-y { duration: 250ms; easing: ease-out; }
        changed viewport-y => { root.saved-scroll-y = self.viewport-y; }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 8px;

            for i in root.files.length : PresetCard {
                title: root.titles[i];
                desc: root.descs[i];
                tag: root.tags[i];
                accent: #8fd8ff;
                active: i == root.active-index;
                keyboard-focused: i == root.focused-index && root.has-focus && root.engaged-slider < 0;
                index: i;
                // 1:1 legacy: mouse NEVER moves keyboard focus — it only acts.
                hover-moves-focus: false;
                toggled => { root.apply-border(i, root.files[i]); }
            }

            if root.files.length == 0 : Text {
                text: "No border presets found.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}

// ─── Tune pane: color-gated placeholder + 4 geometry sliders. ───
component BordersTunePane inherits Rectangle {
    in property <int> size: 2;
    in property <int> radius: 32;
    in property <int> gap-in: 5;
    in property <int> gap-out: 5;
    // Global keyboard index (pick cards fill 0..split-1, sliders split..split+3).
    in property <int> focused-index: 0;
    in property <int> split: 0;
    in property <bool> has-focus: false;
    in property <int> engaged-slider: -1;
    in property <bool> follow: false;
    callback slider-changed(int, int);

    property <length> saved-scroll-y: 0px;
    // 0..3 = which slider the keyboard cursor sits on (negative = pick pane).
    property <int> local-focus: root.focused-index - root.split;
    background: transparent;
    clip: true;

    ScrollView {
        // Fills the pane Rectangle by default (no explicit height).
        // Tune layer scroll-follow: colour placeholder (~40px) then slider
        // blocks ~88px pitch.
        property <length> focus-y: 40px + root.local-focus * 88px;
        viewport-y: root.follow ? (root.local-focus >= 0
            ? (0px - max(0px, self.focus-y + 48px - self.height / 2))
            : 0px) : root.saved-scroll-y;
        animate viewport-y { duration: 250ms; easing: ease-out; }
        changed viewport-y => { root.saved-scroll-y = self.viewport-y; }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 8px;

            // COLOR_GATE: inert placeholder (must stay inert, no color behavior)
            // COLOR_GATE: needs Engine::apply_border_color + config field — USER DECISION REQUIRED
            Rectangle {
                height: 28px;
                background: transparent;
                border-width: 1px;
                border-color: #8fd8ff.transparentize(0.7);
                border-radius: SkwdTokens.radius-8;
                Text {
                    text: "color — gated (next slice)";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: HveColors.text-muted.transparentize(0.3);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Size 1-5
            size-wrap := Rectangle {
                // Card-like block: lights up on keyboard focus OR mouse
                // hover (lit), reads "grabbed" when engaged. Heights mirror
                // the cards proportionally (250ms bounce).
                property <bool> lit: (root.focused-index == root.split && root.has-focus) || hover-size.has-hover;
                property <bool> grabbed: root.engaged-slider == 0 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-size := TouchArea {
                    width: 100%;
                    height: 100%;
                    // 1:1 legacy: mouse never steals keyboard focus — slider is mouse-direct
                    clicked => { }
                }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 0;
                    focused: size-wrap.lit;
                    label: "Border Thickness";
                    value: root.size;
                    min: 1;
                    max: 5;
                    changed(v) => { root.slider-changed(0, v); }
                }
            }

            // Radius 0-100
            radius-wrap := Rectangle {
                property <bool> lit: (root.focused-index == root.split + 1 && root.has-focus) || hover-radius.has-hover;
                property <bool> grabbed: root.engaged-slider == 1 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-radius := TouchArea {
                    width: 100%;
                    height: 100%;
                    // 1:1 legacy: mouse never steals keyboard focus
                    clicked => { }
                }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 1;
                    focused: radius-wrap.lit;
                    label: "Corner Radius";
                    value: root.radius;
                    min: 0;
                    max: 100;
                    changed(v) => { root.slider-changed(1, v); }
                }
            }

            // Gap In 0-30
            gap-in-wrap := Rectangle {
                property <bool> lit: (root.focused-index == root.split + 2 && root.has-focus) || hover-gap-in.has-hover;
                property <bool> grabbed: root.engaged-slider == 2 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-gap-in := TouchArea {
                    width: 100%;
                    height: 100%;
                    // 1:1 legacy: mouse never steals keyboard focus
                    clicked => { }
                }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 2;
                    focused: gap-in-wrap.lit;
                    label: "Inner Gap";
                    value: root.gap-in;
                    min: 0;
                    max: 30;
                    changed(v) => { root.slider-changed(2, v); }
                }
            }

            // Gap Out 0-30
            gap-out-wrap := Rectangle {
                property <bool> lit: (root.focused-index == root.split + 3 && root.has-focus) || hover-gap-out.has-hover;
                property <bool> grabbed: root.engaged-slider == 3 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-gap-out := TouchArea {
                    width: 100%;
                    height: 100%;
                    // 1:1 legacy: mouse never steals keyboard focus
                    clicked => { }
                }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 3;
                    focused: gap-out-wrap.lit;
                    label: "Outer Gap";
                    value: root.gap-out;
                    min: 0;
                    max: 30;
                    changed(v) => { root.slider-changed(3, v); }
                }
            }

            // Keyboard hint travels with the tune content (bottom of scroll).
            Text {
                text: "↑↓ navigate • ←→ switch panel • Enter apply/engage • ←/→ adjust slider • Esc back";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted.transparentize(0.4);
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

export component BordersSection inherits Rectangle {
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in property <int> active-index: -1;
    // Keyboard state owned by PanelRoot's single panel-kbd FocusScope.
    in property <int> focused-index: 0;
    in property <int> engaged-slider: -1;
    in property <bool> has-focus: false;
    callback apply-border(int, string);

    // Tune layer — 4 geometry values (in-out so Rust snap can write them)
    in-out property <int> geom-size: 2;
    in-out property <int> geom-radius: 32;
    in-out property <int> geom-gap-in: 5;
    in-out property <int> geom-gap-out: 5;
    callback apply-geometry(int, int, int, int);

    background: transparent;
    clip: true;

    // Responsive split driven from the window width (ShellRoot), NOT from
    // this section's own width: reading root.width here would feed the layout
    // solver back into itself (binding loop). Wide → panes side by side;
    // narrow → stacked single column.
    in property <bool> two-col: false;
    property <int> split: root.border-files.length;

    // Tune debounce + skip-init + last-wins (R3)
    property <bool> size-init: false;
    property <bool> radius-init: false;
    property <bool> gap-in-init: false;
    property <bool> gap-out-init: false;
    property <int> pending-size: root.geom-size;
    property <int> pending-radius: root.geom-radius;
    property <int> pending-gap-in: root.geom-gap-in;
    property <int> pending-gap-out: root.geom-gap-out;
    property <int> last-size: root.geom-size;
    property <int> last-radius: root.geom-radius;
    property <int> last-gap-in: root.geom-gap-in;
    property <int> last-gap-out: root.geom-gap-out;
    property <bool> geom-dirty: false;

    geom-timer := Timer {
        interval: 80ms;
        running: root.geom-dirty;
        triggered => {
            if (root.pending-size != root.last-size || root.pending-radius != root.last-radius || root.pending-gap-in != root.last-gap-in || root.pending-gap-out != root.last-gap-out) {
                root.apply-geometry(root.pending-size, root.pending-radius, root.pending-gap-in, root.pending-gap-out);
                root.last-size = root.pending-size;
                root.last-radius = root.pending-radius;
                root.last-gap-in = root.pending-gap-in;
                root.last-gap-out = root.pending-gap-out;
            }
            root.geom-dirty = false;
        }
    }

    // Slider adjust is a domain action, not keyboard handling: PanelRoot's
    // panel-kbd decides when a slider is engaged and calls this with the
    // arrow direction. The 80ms debounce + skip-init + last-wins stay here
    // so the section remains the single owner of its geometry pipeline.
    public function adjust-slider(up: bool) {
        if (root.engaged-slider == 0) {
            let next = up ? min(root.geom-size + 1, 5) : max(root.geom-size - 1, 1);
            if (next != root.geom-size) {
                root.geom-size = next;
                if (!root.size-init) { root.size-init = true; return; }
                root.pending-size = next;
                root.geom-dirty = false;
                root.geom-dirty = true;
                geom-timer.restart();
            }
        } else if (root.engaged-slider == 1) {
            let next = up ? min(root.geom-radius + 1, 100) : max(root.geom-radius - 1, 0);
            if (next != root.geom-radius) {
                root.geom-radius = next;
                if (!root.radius-init) { root.radius-init = true; return; }
                root.pending-radius = next;
                root.geom-dirty = false;
                root.geom-dirty = true;
                geom-timer.restart();
            }
        } else if (root.engaged-slider == 2) {
            let next = up ? min(root.geom-gap-in + 1, 30) : max(root.geom-gap-in - 1, 0);
            if (next != root.geom-gap-in) {
                root.geom-gap-in = next;
                if (!root.gap-in-init) { root.gap-in-init = true; return; }
                root.pending-gap-in = next;
                root.geom-dirty = false;
                root.geom-dirty = true;
                geom-timer.restart();
            }
        } else if (root.engaged-slider == 3) {
            let next = up ? min(root.geom-gap-out + 1, 30) : max(root.geom-gap-out - 1, 0);
            if (next != root.geom-gap-out) {
                root.geom-gap-out = next;
                if (!root.gap-out-init) { root.gap-out-init = true; return; }
                root.pending-gap-out = next;
                root.geom-dirty = false;
                root.geom-dirty = true;
                geom-timer.restart();
            }
        }
    }

    // Mouse-direct slider edits from the tune pane. Same debounce + skip-init
    // + last-wins pipeline as adjust-slider, keyed by slider id (0..3).
    function slider-changed(id: int, v: int) {
        if (id == 0) {
            if (!root.size-init) { root.size-init = true; return; }
            if (v == root.last-size) { return; }
            root.geom-size = v;
            root.pending-size = v;
            root.geom-dirty = false;
            root.geom-dirty = true;
            geom-timer.restart();
        } else if (id == 1) {
            if (!root.radius-init) { root.radius-init = true; return; }
            if (v == root.last-radius) { return; }
            root.geom-radius = v;
            root.pending-radius = v;
            root.geom-dirty = false;
            root.geom-dirty = true;
            geom-timer.restart();
        } else if (id == 2) {
            if (!root.gap-in-init) { root.gap-in-init = true; return; }
            if (v == root.last-gap-in) { return; }
            root.geom-gap-in = v;
            root.pending-gap-in = v;
            root.geom-dirty = false;
            root.geom-dirty = true;
            geom-timer.restart();
        } else if (id == 3) {
            if (!root.gap-out-init) { root.gap-out-init = true; return; }
            if (v == root.last-gap-out) { return; }
            root.geom-gap-out = v;
            root.pending-gap-out = v;
            root.geom-dirty = false;
            root.geom-dirty = true;
            geom-timer.restart();
        }
    }

    // Keep pending/last in sync when Rust snaps sliders (pick→tune one-way)
    changed geom-size => {
        if (!root.geom-dirty) {
            root.pending-size = root.geom-size;
            root.last-size = root.geom-size;
        }
    }
    changed geom-radius => {
        if (!root.geom-dirty) {
            root.pending-radius = root.geom-radius;
            root.last-radius = root.geom-radius;
        }
    }
    changed geom-gap-in => {
        if (!root.geom-dirty) {
            root.pending-gap-in = root.geom-gap-in;
            root.last-gap-in = root.geom-gap-in;
        }
    }
    changed geom-gap-out => {
        if (!root.geom-dirty) {
            root.pending-gap-out = root.geom-gap-out;
            root.last-gap-out = root.geom-gap-out;
        }
    }

    VerticalLayout {
        spacing: 0px;

        // Header fixed
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "Borders";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }
            Text {
                text: "Pick a border style — instantly applied. Adjust thickness, radius and gaps.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }
        }

        // Two independent panes. Wide: side by side. Narrow: stacked.
        if root.two-col : HorizontalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            BordersPickPane {
                horizontal-stretch: 1;
                titles: root.border-titles;
                descs: root.border-descs;
                tags: root.border-tags;
                files: root.border-files;
                active-index: root.active-index;
                focused-index: root.focused-index;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index < root.split;
                apply-border(idx, file) => { root.apply-border(idx, file); }
            }

            Rectangle { width: 1px; background: HveColors.border.transparentize(0.6); }

            BordersTunePane {
                horizontal-stretch: 1;
                size: root.geom-size;
                radius: root.geom-radius;
                gap-in: root.geom-gap-in;
                gap-out: root.geom-gap-out;
                focused-index: root.focused-index;
                split: root.split;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index >= root.split;
                slider-changed(id, v) => { root.slider-changed(id, v); }
            }
        }
        if !root.two-col : VerticalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            BordersPickPane {
                vertical-stretch: 1;
                titles: root.border-titles;
                descs: root.border-descs;
                tags: root.border-tags;
                files: root.border-files;
                active-index: root.active-index;
                focused-index: root.focused-index;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index < root.split;
                apply-border(idx, file) => { root.apply-border(idx, file); }
            }

            Rectangle { height: 1px; background: HveColors.border.transparentize(0.6); }

            BordersTunePane {
                vertical-stretch: 1;
                size: root.geom-size;
                radius: root.geom-radius;
                gap-in: root.geom-gap-in;
                gap-out: root.geom-gap-out;
                focused-index: root.focused-index;
                split: root.split;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index >= root.split;
                slider-changed(id, v) => { root.slider-changed(id, v); }
            }
        }
    }
}
