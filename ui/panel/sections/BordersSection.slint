                            }
                        }
                    }
                }
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // ── Animation leaves ──
            Text {
                text: "Border Animations";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-13;
                font-weight: 600;
                color: HveColors.accent-cyan;
            }

            Text {
                text: "Optional motion on the active border. Each animation turns on by itself; enabling one reveals its speed, curve and style.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // Helper component for animation leaf
            // borderangle leaf (enabled stop highlights the card)
            Rectangle {
                property <bool> lit: root.local-focus == root.idx-a0-en && root.has-focus;
                height: root.anim-borderangle-enabled ? 120px : 56px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Border Angle Animation";
                            color: HveColors.text;
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-13;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 48px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.anim-borderangle-enabled ? HveColors.accent-cyan : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: HveColors.border;

                            Rectangle {
                                x: root.anim-borderangle-enabled ? 26px : 4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: root.anim-borderangle-enabled ? HveColors.bg-dark : HveColors.text-muted;
                                animate x { duration: 150ms; easing: ease-out; }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.anim-changed("borderangle", !root.anim-borderangle-enabled, root.anim-borderangle-speed, root.anim-borderangle-bezier, root.anim-borderangle-style); }
                            }
                        }
                    }

                    if root.anim-borderangle-enabled : Text {
                        text: "Animates the gradient direction around the border.";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        color: HveColors.text-muted;
                        wrap: word-wrap;
                    }

                    if root.anim-borderangle-enabled : Rectangle {
                        property <bool> lit: root.local-focus == root.idx-a0-speed && root.has-focus;
                        property <bool> grabbed: root.engaged-slider == root.idx-a0-speed && root.has-focus;
                        height: 48px;
                        border-width: 1px;
                        border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                        border-radius: SkwdTokens.radius-8;
                        background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-surface;

                        GeometrySlider {
                            width: 100%;
                            y: (parent.height - self.height) / 2;
                            engaged: root.engaged-slider == root.idx-a0-speed;
                            focused: root.local-focus == root.idx-a0-speed && root.has-focus;
                            label: "Speed";
                            value: root.anim-borderangle-speed;
                            min: 5;
                            max: 120;
                            changed(v) => { root.anim-changed("borderangle", root.anim-borderangle-enabled, v, root.anim-borderangle-bezier, root.anim-borderangle-style); }
                        }
                    }
                }
            }

