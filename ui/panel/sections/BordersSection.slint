                            color: HveColors.text;
                            font-family: SkwdTokens.font-body;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        BorderColorSlot {
                            width: 100%;
                            slot-value: root.glow-color-inactive;
                            slot-description: "Glow color for unfocused windows. Tap a swatch to change it.";
                            display-label: root.readable-color(root.glow-color-inactive);
                            editable: true;
                            is-token: root.is-token-color(root.glow-color-inactive);
                            slot-changed(v) => {
