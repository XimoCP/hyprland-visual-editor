// HVE 2 — BordersSection (tune + preset list, two-pane).
//
// Two INDEPENDENT scroll regions:
//   • Tune pane  — size slider (1-5) → 80ms debounce → apply_geometry,
//     angle segmented control (30/45/90), inactive color row, dynamic
//     color slots (2..8) from tune-active-colors model with interactive
//     token swatches, add/remove controls, plus save form
//     (LineEdit + Save button) at the bottom.
//   • List pane  — Built-in presets (apply only) + user presets (apply,
//     rename, delete) via SavedPresetCard. User presets carry a ★ badge.
// Wide section → panes side by side; narrow section → stacked. Each pane owns
// its own ScrollView. Keyboard: single linear sequence owned by PanelRoot's
// panel-kbd; ← / → jump one panel at a time (menu → tune → list).
//
// Keyboard R11: arrows navigate cards/sliders, Enter/Space activates,
// sliders ±1, icy-cyan #8fd8ff focus.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { LineEdit, ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";
import { GeometrySlider } from "../../components.slint";
import { SavedPresetCard } from "SavedPresetCard.slint";
import { HveColorPicker } from "../ColorPicker.slint";

// ─── Compact colour row (R6/R7) ───────────────────────────────────────
// ONE row per non-gradient colour channel — inactive (8), glow colour (9),
// glow inactive (10): 16×16 colour chip + label + a "Custom…" button that
// opens the SHARED picker for that channel.
//
// It replaces the 110px `BorderColorSlot` card. The six token swatches that
// card carried moved into the picker itself (R15), so what is left is a single
// 48px line — 56px while the keyboard focus is on it, matching every other
// compact tune control.
component BorderCompactColorRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value-label: "";
    in property <color> resolved-color: transparent;
    in property <bool> lit: false;
    in property <bool> editing: false;
    callback picker-requested();

    height: self.lit ? 56px : 48px;
    animate height { duration: 250ms; easing: ease-in-out-back; }
    border-width: 1px;
    border-color: self.lit ? #8fd8ff : HveColors.border;
    border-radius: SkwdTokens.radius-8;
    background: self.lit ? HveColors.bg-hover : HveColors.bg-card;
    animate background { duration: 200ms; easing: ease-in-out; }

    HorizontalLayout {
        padding: 12px;
        spacing: 8px;

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: SkwdTokens.radius-4;
            border-width: 1px;
            border-color: HveColors.border;
            background: root.resolved-color;
        }

        Text {
            text: root.label;
            font-family: SkwdTokens.font-body;
            font-size: SkwdTokens.size-13;
            font-weight: 600;
            color: HveColors.text;
            vertical-alignment: center;
        }

        // The current value ("surface_lowest" / "Custom"): the chip says what it
        // looks like, this says what it IS. Grows to keep the button right.
        Text {
            text: root.value-label;
            font-family: SkwdTokens.font-body;
            font-size: SkwdTokens.size-11;
            color: HveColors.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 84px;
            height: 22px;
            border-radius: SkwdTokens.radius-4;
            border-width: 1px;
            border-color: root.editing ? HveColors.accent-cyan : HveColors.border;
            background: root.editing ? HveColors.accent-cyan
                : (custom-ta.has-hover ? HveColors.bg-hover : HveColors.bg-surface);

            Text {
                text: root.editing ? "Editing…" : "Custom…";
                color: root.editing ? HveColors.bg-dark : HveColors.text;
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            custom-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.picker-requested(); }
            }
        }
    }
}

// ─── Tune pane: dynamic color slots + angle + inactive + size + save form. ───
// Rebuilt in U3a: old 4-slider geometry block removed; only size 1-5 kept.
// Dynamic color slots (2..8) rendered from tune-active-colors model.
// Angle segmented control (30/45/90).
// Inactive color row.
// Every control carries a plain-language description (frozen requirement).
component BordersTunePane inherits Rectangle {
    in property <int> size: 2;
    in property <int> focused-index: 0;
    in property <int> split: 0;
    in property <bool> has-focus: false;
    in property <int> engaged-slider: -1;
    in property <bool> follow: false;
    // Tune pane — dynamic (Unit 2)
    in property <[string]> tune-active-colors: [];
    in property <[color]> tune-colors-resolved: [];
    // ── Gradient colour strip (R1/R2) ─────────────────────────────
    // Sub-navigation state, MIRRORING the section's `strip-active-chip` (the
    // instances below bind it two-way): the chip the strip highlights when the
    // strip stop owns the keyboard. PR 3 wires ←/→ to it via `strip-cycle`.
    in-out property <int> strip-active-chip: 0;
    // The shared picker card (the ONE picker for every colour channel) is
    // visible exactly while a channel is being edited (R3/R11). Derived from
    // the single `editing-slot` index the whole pane shares, so the strip, the
    // compact rows and the keyboard all open the same card.
    property <bool> picker-visible: root.editing-slot >= 0;
    // Channel whose custom colour the shared picker is editing, in the same
    // index space as tune-colors-resolved: 0..7 slots, 8 inactive, 9 glow,
    // 10 glow inactive. -1 = picker closed.
    in property <int> editing-slot: -1;
    callback custom-color-preview(int, string);
    // The pane cannot assign its own `in` property, so opening/closing the
    // picker is a request the section fulfils.
    callback request-edit-slot(int);
    callback custom-color-changed(int, string);
    in property <int> tune-color-count: 0;
    in-out property <int> tune-angle: 90;
    in property <string> tune-inactive-color: "";
    // Save form state
    in property <string> error-text: "";
    in-out property <string> preset-name: "";
    callback slider-changed(int, int);
    callback save-preset(string);
    // Slot management callbacks
    callback add-color-slot();
    callback remove-color-slot();
    callback slot-color-changed(int, string);
    // The inactive color is an `in` property here (the section owns the tune
    // state), so a mouse pick has to travel back up as a callback.
    callback inactive-color-changed(string);
    // Glow group
    in property <bool> glow-enabled: false;
    in-out property <int> glow-range: 20;
    in-out property <int> glow-render-power: 4;
    in-out property <string> glow-color: "p:primary";
    in-out property <string> glow-color-inactive: "p:surface_lowest";
    callback glow-changed(bool, int, int, string, string);
    // Animation leaves
    in-out property <bool> anim-borderangle-enabled: false;
    in-out property <int> anim-borderangle-speed: 30;
    in-out property <string> anim-borderangle-bezier: "default";
    in-out property <string> anim-borderangle-style: "";
    in-out property <bool> anim-border-enabled: false;
    in-out property <int> anim-border-speed: 30;
    in-out property <string> anim-border-bezier: "default";
    in-out property <string> anim-border-style: "";
    in-out property <bool> anim-fadeshadow-enabled: false;
    in-out property <int> anim-fadeshadow-speed: 30;
    in-out property <string> anim-fadeshadow-bezier: "default";
    in-out property <string> anim-fadeshadow-style: "";
    in-out property <[string]> anim-curves: [];
    // The gradient angle travels up as a callback because the pane cannot reach
    // the section's notify funnel. Its absence was a real defect: the angle was
    // the one tune value with NO route to Rust, so neither the 30/45/90 buttons
    // nor the arrow cycle could ever change the desktop border.
    callback angle-changed(int);
    // The floating-rule toggle has the same problem as the angle: it moved its
    // own state and never reached Rust, so the mouse path did not apply live
    // (only the keyboard path in `tune-enter` did).
    callback rule-toggled(bool);
    callback anim-changed(string, bool, int, string, string);
    // Bezier/Style rows: a click cycles the value (the section owns the
    // next-value logic, so mouse and keyboard share one implementation).
    callback cycle-anim-part(string, string);
    // Rule toggle
    in-out property <bool> tune-rule-enabled: false;

    // ── Picker keyboard command channel (task 3.7) ────────────────
    // Forwarded straight down to the picker, which owns the actual controls.
    // The picker card itself is `visible`-toggled (never `if`-created) so this
    // element exists for the whole life of the pane and can always be called.
    in property <int> picker-cmd: 0;
    in property <int> picker-cmd-kind: 0;

    property <length> saved-scroll-y: 0px;
    // Tune-local indices (cards-first global minus list split). WHILE COLOURS
    // EXIST: 0=size, 1=angle, 2=inactive, 3=strip, 4=add, 5=remove,
    // 6=glow-enabled (7..10=range, power, color, inactive when on), then per
    // anim leaf enabled (speed, bezier, style when on) x3, rule, save-name,
    // save-button. WITH ZERO COLOURS the strip / add / remove block is not
    // mounted, so it does not exist and everything after `inactive` shifts down
    // by three (`slot-stops` below). Mirrors callbacks::borders_tune_stop_count.
    property <int> local-focus: root.focused-index - root.split;
    property <int> slot-count: clamp(root.tune-color-count, 0, 8);
    // The strip / add / remove controls mount only behind
    // `if root.slot-count > 0` (see the strip and the +/− row below), so with
    // ZERO colours those three stop positions do not exist and every stop
    // after them shifts down by three. Without the shift the keyboard walked
    // three ghost positions that render nothing: at zero colours `strip-cycle`
    // is a no-op, so PanelRoot's strip dispatch swallowed ←/→ on the invisible
    // strip, and Enter fired `add-color-slot` from a `+` that was never
    // mounted (Q2). `slot-stops` is the block's width; the map below derives
    // from it instead of hard-coding 6..10.
    property <int> slot-stops: root.slot-count > 0 ? 3 : 0;
    // Fixed tune-local map (PR 3): the strip is ONE stop, so the slot block is
    // a constant 3 wide while it exists and every stop after it derives from
    // `idx-glow-en` — no `+ slot-count` anywhere. `-1` marks a stop that is
    // not there, so no literal can ever match an absent control. Downstream
    // idx-a*/base-tail/idx-rule/idx-save-* recompute from `base-anim` alone.
    // Mirrors callbacks::borders_tune_stop_count and BordersSection.tune-enter.
    property <int> idx-add: root.slot-stops > 0 ? 4 : -1;
    property <int> idx-remove: root.slot-stops > 0 ? 5 : -1;
    property <int> idx-glow-en: root.slot-stops + 3;
    property <int> idx-glow-range: root.idx-glow-en + 1;
    property <int> idx-glow-power: root.idx-glow-en + 2;
    property <int> idx-glow-color: root.idx-glow-en + 3;
    property <int> idx-glow-inactive: root.idx-glow-en + 4;
    property <int> base-anim: root.idx-glow-en + (root.glow-enabled ? 5 : 1);
    property <int> idx-a0-en: root.base-anim;
    property <int> idx-a0-speed: root.base-anim + 1;
    property <int> idx-a0-bezier: root.base-anim + 2;
    property <int> idx-a0-style: root.base-anim + 3;
    property <int> base-a1: root.base-anim + 1 + (root.anim-borderangle-enabled ? 3 : 0);
    property <int> idx-a1-en: root.base-a1;
    property <int> idx-a1-speed: root.base-a1 + 1;
    property <int> idx-a1-bezier: root.base-a1 + 2;
    property <int> idx-a1-style: root.base-a1 + 3;
    property <int> base-a2: root.base-a1 + 1 + (root.anim-border-enabled ? 3 : 0);
    property <int> idx-a2-en: root.base-a2;
    property <int> idx-a2-speed: root.base-a2 + 1;
    property <int> idx-a2-bezier: root.base-a2 + 2;
    property <int> idx-a2-style: root.base-a2 + 3;
    property <int> base-tail: root.base-a2 + 1 + (root.anim-fadeshadow-enabled ? 3 : 0);
    property <int> idx-rule: root.base-tail;
    property <int> idx-save-name: root.base-tail + 1;
    property <int> idx-save-btn: root.base-tail + 2;

    // Slint has no substring op, so the encoded value ("p:primary", "c:rrggbbaa")
    // is mapped to a readable label explicitly. Raw encodings must never reach
    // the UI: showing "p:surface_lowest" was a real defect (F1).
    function readable-color(v: string) -> string {
        if (v == "p:primary") { return "primary"; }
        if (v == "p:secondary") { return "secondary"; }
        if (v == "p:tertiary") { return "tertiary"; }
        if (v == "p:error") { return "error"; }
        if (v == "p:surface") { return "surface"; }
        if (v == "p:surface_lowest") { return "surface_lowest"; }
        if (v == "") { return "(none)"; }
        return v;
    }
    function is-token-color(v: string) -> bool {
        return v == "p:primary" || v == "p:secondary" || v == "p:tertiary"
            || v == "p:error" || v == "p:surface" || v == "p:surface_lowest";
    }
    // Label for a colour value. A custom value cannot be named (Slint cannot
    // strip the "c:" prefix), and dumping "c:ff8800ff" at the user is noise —
    // the colour chip beside the label is the real information, so the label
    // just says what kind of value it is.
    function value-label(v: string) -> string {
        if (v == "") { return "(none)"; }
        if (root.is-token-color(v)) { return root.readable-color(v); }
        return "Custom";
    }
    // Human name for the channel the picker is editing, so the picker header
    // states exactly which colour it will change.
    function channel-name(idx: int) -> string {
        if (idx >= 0 && idx < root.slot-count) {
            return "gradient colour " + (idx + 1) + " of " + root.slot-count;
        }
        if (idx == 8) { return "the inactive border colour"; }
        if (idx == 9) { return "the glow colour"; }
        if (idx == 10) { return "the inactive glow colour"; }
        return "this colour";
    }
    // The value the picker is editing ("p:primary" / "c:rrggbbaa"), in the same
    // index space as tune-colors-resolved. Drives the token row's selection
    // outline, so the current pick is visible instead of guessed.
    function editing-value() -> string {
        if (root.editing-slot >= 0 && root.editing-slot < root.slot-count) {
            return root.tune-active-colors[root.editing-slot];
        }
        if (root.editing-slot == 8) { return root.tune-inactive-color; }
        if (root.editing-slot == 9) { return root.glow-color; }
        if (root.editing-slot == 10) { return root.glow-color-inactive; }
        return "";
    }
    // A token swatch inside the picker writes the SAME value the old per-slot
    // swatches did. The picker serves every channel, so one function routes the
    // write: gradient slots go to slot-color-changed(i), the three compact rows
    // to the inactive / glow / glow-inactive callbacks (R15).
    function choose-token(idx: int, v: string) {
        if (idx >= 0 && idx < root.slot-count) { root.slot-color-changed(idx, v); return; }
        if (idx == 8) { root.inactive-color-changed(v); return; }
        if (idx == 9) {
            root.glow-changed(root.glow-enabled, root.glow-range, root.glow-render-power, v, root.glow-color-inactive);
            return;
        }
        if (idx == 10) {
            root.glow-changed(root.glow-enabled, root.glow-range, root.glow-render-power, root.glow-color, v);
        }
    }
    background: transparent;
    clip: true;

    changed local-focus => { tune-scroll.follow-focus(); }
    changed editing-slot => { tune-scroll.follow-focus(); }
    changed follow => { tune-scroll.follow-focus(); }

    // The picker anchor (R10) needs the content height the card is ABOUT to
    // have, and at the instant `picker-visible` flips the ScrollView still
    // knows only the CLOSED height — so it clamps away exactly the scroll that
    // would reveal the card, leaving it wherever the old flow happened to be.
    // One zero-interval tick later the new height is known and `follow-focus()`
    // computes the right target. A repeating 0ms timer would spin, hence the
    // one-shot flag.
    property <bool> picker-anchor-pending: false;
    changed picker-visible => { root.picker-anchor-pending = root.picker-visible; }
    Timer {
        interval: 0ms;
        running: root.picker-anchor-pending;
        triggered => {
            root.picker-anchor-pending = false;
            tune-scroll.follow-focus();
        }
    }

    tune-scroll := ScrollView {
        // Linear estimate keeps every stop scrollable: the viewport centers
        // on the focused stop so it is always visible (no dead stops).
        // Clamped to [height - content, 0] so the first and last stops can
        // never scroll into the void, whatever the inventory mix.
        property <length> focus-y: root.local-focus * 96px;
        // IMPERATIVE, not a binding — see the note on the list pane: a wheel
        // writes `viewport-y`, which drops a binding and would leave the tune
        // pane unable to follow the keyboard for the rest of the session.
        // Opening the picker must also SHOW it: the card sits in the flow right
        // above the strip it edits (R3), so anchoring the BLOCK's top edge
        // brings the card and its chips into view together (R10). `viewport-y =
        // 0` was enough while the picker lived at the very top of the flow; it
        // is not any more.
        public function follow-focus() {
            if (root.picker-visible) {
                self.viewport-y = max(self.height - tune-col.height,
                    min(0px, 0px - picker-block.y));
                return;
            }
            if (root.follow && root.local-focus >= 0) {
                self.viewport-y = max(self.height - tune-col.height,
                    min(0px, 0px - max(0px, self.focus-y + 48px - self.height / 2)));
            }
        }
        // NEVER animated. `viewport-y` is the property the wheel writes, so an
        // animation on it makes any tick that lands mid-flight compute its target
        // from the INTERPOLATED value — which drops the travel the previous tick
        // had not finished. Exact beats smooth for a scrollable pane.
        changed viewport-y => { if (root.editing-slot < 0) { root.saved-scroll-y = self.viewport-y; } }
        tune-col := VerticalLayout {
            padding-left: 16px;

            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 8px;

            // ── Size 1-5 ──
            size-wrap := Rectangle {
                property <bool> lit: (root.focused-index == root.split && root.has-focus) || hover-size.has-hover;
                property <bool> grabbed: root.engaged-slider == 0 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-size := TouchArea { width: 100%; height: 100%; clicked => { } }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 0;
                    focused: size-wrap.lit;
                    label: "Border Thickness";
                    value: root.size;
                    min: 1;
                    max: 5;
                    changed(v) => { root.slider-changed(0, v); }
                }
            }

            // ── Description: size ──
            Text {
                text: "Border width in pixels (1 thin, 5 thick).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // ── Angle segmented control (30 / 45 / 90) ──
            angle-wrap := Rectangle {
                property <bool> lit: root.local-focus == 1 && root.has-focus;
                property <bool> grabbed: root.engaged-slider == 1 && root.has-focus;
                height: self.lit ? 96px : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "Gradient Angle";
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 4px;

                        for angle-val in [30, 45, 90] : Rectangle {
                            width: 60px;
                            height: 32px;
                            border-radius: SkwdTokens.radius-4;
                            background: root.tune-angle == angle-val ? HveColors.accent-cyan : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: root.tune-angle == angle-val ? HveColors.accent-cyan : HveColors.border;

                            Text {
                                text: angle-val + "°";
                                color: root.tune-angle == angle-val ? HveColors.bg-dark : HveColors.text-muted;
                                font-family: SkwdTokens.font-body;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                // Was a bare `root.tune-angle = angle-val`, which
                                // moved the segmented control and nothing else —
                                // there was no path from the angle to Rust at all,
                                // so neither the mouse nor the keyboard could ever
                                // apply an angle. Travels up as a callback so the
                                // section can notify in ONE place.
                                clicked => { root.angle-changed(angle-val); }
                            }
                        }
                    }
                }
            }

            // ── Description: angle ──
            Text {
                text: "Direction of the active border gradient (30/45/90 degrees).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // ── Inactive color row (R6) ──
            // A compact single row — chip + label + "Custom…" — instead of the
            // 110px slot card. The token swatches live in the shared picker now.
            BorderCompactColorRow {
                label: "Inactive";
                value-label: root.value-label(root.tune-inactive-color);
                resolved-color: root.tune-colors-resolved[8];
                lit: root.focused-index == root.split + 2 && root.has-focus;
                editing: root.editing-slot == 8;
                picker-requested() => { root.request-edit-slot(8); }
            }

            // ── Description: inactive ──
            Text {
                text: "Color applied to borders of unfocused (inactive) windows.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // ── Dynamic gradient colours: one strip, one stop ──
            if root.slot-count > 0 : Text {
                text: "Active Border Colors (" + root.slot-count + " slots)";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-12;
                font-weight: 600;
                color: HveColors.text-muted;
            }

            // ── Shared picker card + gradient strip (R1/R2/R3/R15) ──
            // ONE picker for every colour channel, IN THE FLOW directly above
            // the strip it edits: the colour and the chip it came from stay in
            // one glance, and closing it (editing-slot = -1) leaves no dead gap
            // behind (R4).
            //
            // `picker-block` stays UNCONDITIONAL on purpose: the scroll helper
            // anchors on its top edge to bring the card and the chips into view
            // together (R10).
            picker-block := VerticalLayout {
                spacing: 8px;

                // The card is ALWAYS mounted and animates its own HEIGHT from
                // 0px (closed) to 380px (open) — the same expand/collapse idiom
                // every other tune control uses (`size-wrap`,
                // `BorderCompactColorRow`). A bare `if picker-visible` CANNOT
                // animate: Slint only tweens a property when it CHANGES on a
                // live element, and an element created by the `if` comes up at
                // its target values (opacity 1, full height) with no "from"
                // frame. Keeping the card mounted is what makes the entry real
                // and the exit possible at all.
                //
                // Entry (R5, 250ms ease-in-out-back): height 0→380 and opacity
                // 0→1. Exit (150ms ease-in): height 380→0 and opacity 1→0,
                // WITHOUT the spec's -8px y-shift. The card is an in-flow
                // layout child, so its `y` is owned by the layout and a y-shift
                // cannot render; the collapse is what moves the strip, and it
                // moves it smoothly instead of jumping. `transform-scale-x/y`
                // (0.95→1.0) is declared for the GPU renderer only — the
                // software renderer used by the headless tests does not
                // implement transforms, so no render assertion depends on it.
                // 380px fits header + token row + HSV area without clipping the
                // picker's own hint line (the 344px it had before the token row
                // moved in here).
                Rectangle {
                    // Closed rest state: no flow space, no ink (R4). The state
                    // below overrides both while the picker is open.
                    height: 0px;
                    opacity: 0.0;
                    transform-scale-x: 0.95;
                    transform-scale-y: 0.95;
                    // R10: the card now GROWS over 250ms, so the single deferred
                    // `follow-focus` tick the old `if` version used would run
                    // while the content is still short, clamp against it and
                    // strand the card mid-pane (measured: card top 444px vs the
                    // pane top 217px). Following on every height step keeps the
                    // card anchored at the top for the whole entry.
                    changed height => {
                        if (root.picker-visible) { tune-scroll.follow-focus(); }
                    }
                    states [
                        picker-shown when root.picker-visible: {
                            height: 380px;
                            opacity: 1.0;
                            transform-scale-x: 1.0;
                            transform-scale-y: 1.0;
                            in {
                                animate height { duration: 250ms; easing: ease-in-out-back; }
                                animate opacity { duration: 250ms; easing: ease-in-out-back; }
                                animate transform-scale-x { duration: 250ms; easing: ease-in-out-back; }
                                animate transform-scale-y { duration: 250ms; easing: ease-in-out-back; }
                            }
                            out {
                                animate height { duration: 150ms; easing: ease-in; }
                                animate opacity { duration: 150ms; easing: ease-in; }
                            }
                        }
                    ]
                    border-width: 1px;
                    border-color: HveColors.accent-cyan;
                    border-radius: SkwdTokens.radius-8;
                    background: HveColors.bg-surface;
                    clip: true;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;

                        // Header: names the channel being edited, so the card is
                        // never ambiguous, plus the Done button (R15.1).
                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "Custom colour — " + root.channel-name(root.editing-slot);
                                font-family: SkwdTokens.font-body;
                                font-size: SkwdTokens.size-13;
                                font-weight: 600;
                                color: HveColors.accent-cyan;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 64px;
                                height: 22px;
                                border-radius: SkwdTokens.radius-4;
                                background: picker-done.has-hover ? HveColors.bg-hover : HveColors.bg-surface;
                                border-width: 1px;
                                border-color: HveColors.border;

                                Text {
                                    text: "Done";
                                    color: HveColors.text;
                                    font-family: SkwdTokens.font-body;
                                    font-size: SkwdTokens.size-11;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                picker-done := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.request-edit-slot(-1); }
                                }
                            }
                        }

                        // Six palette tokens (R15.2): the fast path. They used to
                        // live in every BorderColorSlot card; there is now ONE
                        // picker, so the tokens live in it and apply to whichever
                        // channel it is editing.
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            for token-name in ["primary", "secondary", "tertiary", "error", "surface", "surface_lowest"] : Rectangle {
                                width: 46px;
                                height: 40px;
                                border-radius: SkwdTokens.radius-8;
                                background: token-name == "primary" ? HveColors.token-primary
                                    : token-name == "secondary" ? HveColors.token-secondary
                                    : token-name == "tertiary" ? HveColors.token-tertiary
                                    : token-name == "error" ? HveColors.token-error
                                    : token-name == "surface" ? HveColors.token-surface
                                    : HveColors.token-surface-lowest;
                                // The token the channel already holds is outlined,
                                // so the current pick is readable, not guessed.
                                border-width: 2px;
                                border-color: root.editing-value() == ("p:" + token-name) ? HveColors.accent-cyan : transparent;

                                Text {
                                    text: token-name == "surface_lowest" ? "lowest" : token-name;
                                    color: HveColors.text;
                                    font-family: SkwdTokens.font-body;
                                    font-size: 8px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.choose-token(root.editing-slot, "p:" + token-name); }
                                }
                            }
                        }

                        // HSV custom colour (R15.3). Seeded from the resolved
                        // colour, so opening the picker on a stored custom value
                        // shows THAT colour and not a default.
                        col-picker := HveColorPicker {
                            width: 100%;
                            seed: root.tune-colors-resolved[clamp(root.editing-slot, 0, 10)];
                            // Keyboard command channel from the section (task 3.7).
                            cmd-seq: root.picker-cmd;
                            cmd-kind: root.picker-cmd-kind;
                            // D4: never notify per drag step. `changed` only moves
                            // the local value so the preview follows; `committed`
                            // (pointer up) is what writes the live draft.
                            changed => { root.custom-color-preview(root.editing-slot, col-picker.hex8); }
                            committed => { root.custom-color-changed(root.editing-slot, col-picker.hex8); }
                        }
                    }
                }

                // ── Gradient colour strip (R1/R2) ──
                // ONE horizontal strip of numbered chips — one per gradient slot —
                // replaces the N × BorderColorSlot card stack: the gradient reads
                // as a single row at a glance, and the whole strip is ONE keyboard
                // stop (R8) instead of N.
                if root.slot-count > 0 : HorizontalLayout {
                spacing: 6px;
                alignment: start;

                for i in root.slot-count : Rectangle {
                    property <bool> is-active-chip: i == root.strip-active-chip && root.has-focus;
                    width: 40px;
                    height: 32px;
                    border-radius: SkwdTokens.radius-4;
                    border-width: self.is-active-chip ? 2px : 1px;
                    border-color: self.is-active-chip ? #8fd8ff : HveColors.border;
                    // R2: hover highlight, same ink as every other hoverable
                    // control in the pane.
                    background: self.is-active-chip || chip-ta.has-hover ? HveColors.bg-hover : HveColors.bg-surface;

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;

                        // The resolved colour (token or custom — Rust resolves
                        // both, since Slint cannot parse "#rrggbbaa").
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: SkwdTokens.radius-4;
                            border-width: 1px;
                            border-color: HveColors.border;
                            background: root.tune-colors-resolved[i];
                        }

                        // 1-indexed, matching the slot position: the chip says
                        // WHICH colour this is, the swatch says what it looks
                        // like.
                        Text {
                            text: "" + (i + 1);
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-11;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }

                    chip-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        // A click both selects the chip and opens the shared
                        // picker on it: one picker, always the one you clicked
                        // (R3 — clicking another chip moves the same card).
                        clicked => {
                            root.strip-active-chip = i;
                            root.request-edit-slot(i);
                        }
                    }
                }
            }
            }

            // ── Description: gradient colours ──
            Text {
                text: "←→ select gradient colour, Enter to edit, Esc to close.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // ── Add / Remove slot controls ──
            if root.slot-count > 0 : HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-remove && root.has-focus;
                    width: 36px;
                    height: 28px;
                    border-radius: SkwdTokens.radius-4;
                    background: self.lit ? HveColors.bg-hover : (root.slot-count > 2 && remove-ta.has-hover ? HveColors.bg-hover : HveColors.bg-surface);
                    border-width: 1px;
                    border-color: self.lit ? #8fd8ff : (root.slot-count > 2 ? HveColors.border : HveColors.border.transparentize(0.5));
                    opacity: root.slot-count > 2 ? 1.0 : 0.4;

                    Text {
                        text: "−";
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    remove-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { if (root.slot-count > 2) { root.remove-color-slot(); } }
                    }
                }

                Text {
                    text: root.slot-count + " of 8";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    color: HveColors.text-muted;
                    vertical-alignment: center;
                }

                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-add && root.has-focus;
                    width: 36px;
                    height: 28px;
                    border-radius: SkwdTokens.radius-4;
                    background: self.lit ? HveColors.bg-hover : (root.slot-count < 8 && add-ta.has-hover ? HveColors.bg-hover : HveColors.bg-surface);
                    border-width: 1px;
                    border-color: self.lit ? #8fd8ff : (root.slot-count < 8 ? HveColors.border : HveColors.border.transparentize(0.5));
                    opacity: root.slot-count < 8 ? 1.0 : 0.4;

                    Text {
                        text: "+";
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    add-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { if (root.slot-count < 8) { root.add-color-slot(); } }
                    }
                }
            }

            // ── Description: dynamic slots ──
            if root.slot-count > 0 : Text {
                text: "Each slot is one color in the active border gradient. Order matches the preset file. 2-8 slots supported by Hyprland.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // ── Glow group ──
            if !root.glow-enabled : Rectangle {
                property <bool> lit: root.local-focus == root.idx-glow-en && root.has-focus;
                height: self.lit ? 64px : 56px;
                border-width: 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: space-between;

                    Text {
                        text: "Glow (shadow decoration)";
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-13;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 80px;
                        height: 28px;
                        border-radius: SkwdTokens.radius-4;
                        background: glow-add-ta.has-hover ? HveColors.accent-cyan.transparentize(0.2) : HveColors.accent-cyan;

                        Text {
                            text: "Add";
                            color: HveColors.bg-dark;
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        glow-add-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.glow-changed(true, root.glow-range, root.glow-render-power, root.glow-color, root.glow-color-inactive); }
                        }
                    }
                }
            }

            // ── Description: glow (empty state) ──
            // Task 3.4 requires the addable state to explain itself, not just
            // show a button.
            if !root.glow-enabled : Text {
                text: "This preset has no glow. Add one to give the border a coloured shadow around focused windows.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            if root.glow-enabled : VerticalLayout {
                spacing: 8px;

                // Glow header with remove button (enabled stop)
                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-glow-en && root.has-focus;
                    height: self.lit ? 64px : 56px;
                    border-width: 1px;
                    border-color: self.lit ? #8fd8ff : HveColors.border;
                    border-radius: SkwdTokens.radius-8;
                    background: self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        alignment: space-between;
                        Text {
                            text: "Glow (shadow decoration)";
                            color: HveColors.accent-cyan;
                            font-family: SkwdTokens.font-heading;
                            font-size: SkwdTokens.size-13;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: SkwdTokens.radius-4;
                            background: glow-remove-ta.has-hover ? HveColors.accent-red.transparentize(0.2) : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: HveColors.border;

                        Text {
                            text: "×";
                            color: HveColors.text-muted;
                            font-family: SkwdTokens.font-body;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        glow-remove-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.glow-changed(false, root.glow-range, root.glow-render-power, root.glow-color, root.glow-color-inactive); }
                        }
                        }
                    }
                }

                // Range slider
                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-glow-range && root.has-focus;
                    property <bool> grabbed: root.engaged-slider == root.idx-glow-range && root.has-focus;
                    height: self.lit ? 64px : 56px;
                    border-width: 1px;
                    border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;

                    GeometrySlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == root.idx-glow-range;
                        focused: root.local-focus == root.idx-glow-range && root.has-focus;
                        label: "Range";
                        value: root.glow-range;
                        min: 5;
                        max: 40;
                        changed(v) => { root.glow-changed(root.glow-enabled, v, root.glow-render-power, root.glow-color, root.glow-color-inactive); }
                    }
                }

                Text {
                    text: "How far the shadow extends from the window edge (5 near, 40 far).";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    color: HveColors.text-muted;
                    wrap: word-wrap;
                }

                // Render power slider
                Rectangle {
                    property <bool> lit: root.local-focus == root.idx-glow-power && root.has-focus;
                    property <bool> grabbed: root.engaged-slider == root.idx-glow-power && root.has-focus;
                    height: self.lit ? 64px : 56px;
                    border-width: 1px;
                    border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                    border-radius: SkwdTokens.radius-8;
                    background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;

                    GeometrySlider {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        engaged: root.engaged-slider == root.idx-glow-power;
                        focused: root.local-focus == root.idx-glow-power && root.has-focus;
                        label: "Power";
                        value: root.glow-render-power;
                        min: 1;
                        max: 8;
                        changed(v) => { root.glow-changed(root.glow-enabled, root.glow-range, v, root.glow-color, root.glow-color-inactive); }
                    }
                }

                Text {
                    text: "Shadow intensity (1 subtle, 8 strong).";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    color: HveColors.text-muted;
                    wrap: word-wrap;
                }

                // Glow color — compact row, same pattern as the inactive row (R7).
                BorderCompactColorRow {
                    label: "Glow Color";
                    value-label: root.value-label(root.glow-color);
                    resolved-color: root.tune-colors-resolved[9];
                    lit: root.local-focus == root.idx-glow-color && root.has-focus;
                    editing: root.editing-slot == 9;
                    picker-requested() => { root.request-edit-slot(9); }
                }

                Text {
                    text: "Color of the glow on focused windows. Tap Custom… to change it.";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    color: HveColors.text-muted;
                    wrap: word-wrap;
                }

                // Glow inactive color — compact row (R7).
                BorderCompactColorRow {
                    label: "Inactive Glow";
                    value-label: root.value-label(root.glow-color-inactive);
                    resolved-color: root.tune-colors-resolved[10];
                    lit: root.local-focus == root.idx-glow-inactive && root.has-focus;
                    editing: root.editing-slot == 10;
                    picker-requested() => { root.request-edit-slot(10); }
                }

                Text {
                    text: "Glow color for unfocused windows. Tap Custom… to change it.";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    color: HveColors.text-muted;
                    wrap: word-wrap;
                }
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // ── Animation leaves ──
            Text {
                text: "Border Animations";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-13;
                font-weight: 600;
                color: HveColors.accent-cyan;
            }

            Text {
                text: "Optional motion on the active border. Each animation turns on by itself; enabling one reveals its speed, curve and style.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // Helper component for animation leaf
            // borderangle leaf (enabled stop highlights the card)
            Rectangle {
                property <bool> lit: root.local-focus == root.idx-a0-en && root.has-focus;
                height: root.anim-borderangle-enabled ? 120px : 56px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Border Angle Animation";
                            color: HveColors.text;
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-13;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 48px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.anim-borderangle-enabled ? HveColors.accent-cyan : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: HveColors.border;

                            Rectangle {
                                x: root.anim-borderangle-enabled ? 26px : 4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: root.anim-borderangle-enabled ? HveColors.bg-dark : HveColors.text-muted;
                                animate x { duration: 150ms; easing: ease-out; }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.anim-changed("borderangle", !root.anim-borderangle-enabled, root.anim-borderangle-speed, root.anim-borderangle-bezier, root.anim-borderangle-style); }
                            }
                        }
                    }

                    if root.anim-borderangle-enabled : Text {
                        text: "Animates the gradient direction around the border.";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        color: HveColors.text-muted;
                        wrap: word-wrap;
                    }

                    if root.anim-borderangle-enabled : Rectangle {
                        property <bool> lit: root.local-focus == root.idx-a0-speed && root.has-focus;
                        property <bool> grabbed: root.engaged-slider == root.idx-a0-speed && root.has-focus;
                        height: 48px;
                        border-width: 1px;
                        border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                        border-radius: SkwdTokens.radius-8;
                        background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-surface;

                        GeometrySlider {
                            width: 100%;
                            y: (parent.height - self.height) / 2;
                            engaged: root.engaged-slider == root.idx-a0-speed;
                            focused: root.local-focus == root.idx-a0-speed && root.has-focus;
                            label: "Speed";
                            value: root.anim-borderangle-speed;
                            min: 5;
                            max: 120;
                            changed(v) => { root.anim-changed("borderangle", root.anim-borderangle-enabled, v, root.anim-borderangle-bezier, root.anim-borderangle-style); }
                        }
                    }
                }
            }

            if root.anim-borderangle-enabled : Rectangle {
                property <bool> lit: root.local-focus == root.idx-a0-bezier && root.has-focus;
                property <bool> grabbed: root.engaged-slider == root.idx-a0-bezier && root.has-focus;
                height: 48px;
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: space-between;
                    Text {
                        text: "Bezier: " + root.anim-borderangle-bezier;
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "Curve";
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        vertical-alignment: center;
                    }
                }
                // Mouse path for the curve: the row had no TouchArea, so a click
                // did nothing and only the keyboard could change it.
                curve-a0-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.cycle-anim-part("borderangle", "bezier"); }
                }
            }
            if root.anim-borderangle-enabled : Text {
                text: "Animation curve for the angle sweep (default plus preset curves).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }
            if root.anim-borderangle-enabled : Rectangle {
                property <bool> lit: root.local-focus == root.idx-a0-style && root.has-focus;
                property <bool> grabbed: root.engaged-slider == root.idx-a0-style && root.has-focus;
                height: 48px;
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: space-between;
                    Text {
                        text: root.anim-borderangle-style == "" ? "Style: none" : "Style: " + root.anim-borderangle-style;
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "Style";
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        vertical-alignment: center;
                    }
                }
                style-a0-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.cycle-anim-part("borderangle", "style"); }
                }
            }
            if root.anim-borderangle-enabled : Text {
                text: "Loop style for the angle animation (none or loop).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // border leaf
            Rectangle {
                property <bool> lit: root.local-focus == root.idx-a1-en && root.has-focus;
                height: root.anim-border-enabled ? 120px : 56px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Border Pulse Animation";
                            color: HveColors.text;
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-13;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 48px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.anim-border-enabled ? HveColors.accent-cyan : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: HveColors.border;

                            Rectangle {
                                x: root.anim-border-enabled ? 26px : 4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: root.anim-border-enabled ? HveColors.bg-dark : HveColors.text-muted;
                                animate x { duration: 150ms; easing: ease-out; }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.anim-changed("border", !root.anim-border-enabled, root.anim-border-speed, root.anim-border-bezier, root.anim-border-style); }
                            }
                        }
                    }

                    if root.anim-border-enabled : Text {
                        text: "Pulsing border thickness effect.";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        color: HveColors.text-muted;
                        wrap: word-wrap;
                    }

                    if root.anim-border-enabled : Rectangle {
                        property <bool> lit: root.local-focus == root.idx-a1-speed && root.has-focus;
                        property <bool> grabbed: root.engaged-slider == root.idx-a1-speed && root.has-focus;
                        height: 48px;
                        border-width: 1px;
                        border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                        border-radius: SkwdTokens.radius-8;
                        background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-surface;

                        GeometrySlider {
                            width: 100%;
                            y: (parent.height - self.height) / 2;
                            engaged: root.engaged-slider == root.idx-a1-speed;
                            focused: root.local-focus == root.idx-a1-speed && root.has-focus;
                            label: "Speed";
                            value: root.anim-border-speed;
                            min: 5;
                            max: 120;
                            changed(v) => { root.anim-changed("border", root.anim-border-enabled, v, root.anim-border-bezier, root.anim-border-style); }
                        }
                    }
                }
            }

            if root.anim-border-enabled : Rectangle {
                property <bool> lit: root.local-focus == root.idx-a1-bezier && root.has-focus;
                property <bool> grabbed: root.engaged-slider == root.idx-a1-bezier && root.has-focus;
                height: 48px;
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: space-between;
                    Text {
                        text: "Bezier: " + root.anim-border-bezier;
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "Curve";
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        vertical-alignment: center;
                    }
                }
                curve-a1-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.cycle-anim-part("border", "bezier"); }
                }
            }
            if root.anim-border-enabled : Text {
                text: "Animation curve for the border pulse (default plus preset curves).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }
            if root.anim-border-enabled : Rectangle {
                property <bool> lit: root.local-focus == root.idx-a1-style && root.has-focus;
                property <bool> grabbed: root.engaged-slider == root.idx-a1-style && root.has-focus;
                height: 48px;
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: space-between;
                    Text {
                        text: root.anim-border-style == "" ? "Style: none" : "Style: " + root.anim-border-style;
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "Style";
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        vertical-alignment: center;
                    }
                }
                style-a1-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.cycle-anim-part("border", "style"); }
                }
            }
            if root.anim-border-enabled : Text {
                text: "Loop style for the border pulse (none or loop).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // fadeShadow leaf
            Rectangle {
                property <bool> lit: root.local-focus == root.idx-a2-en && root.has-focus;
                height: root.anim-fadeshadow-enabled ? 120px : 56px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Fade Shadow Animation";
                            color: HveColors.text;
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-13;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 48px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.anim-fadeshadow-enabled ? HveColors.accent-cyan : HveColors.bg-surface;
                            border-width: 1px;
                            border-color: HveColors.border;

                            Rectangle {
                                x: root.anim-fadeshadow-enabled ? 26px : 4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: root.anim-fadeshadow-enabled ? HveColors.bg-dark : HveColors.text-muted;
                                animate x { duration: 150ms; easing: ease-out; }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.anim-changed("fadeShadow", !root.anim-fadeshadow-enabled, root.anim-fadeshadow-speed, root.anim-fadeshadow-bezier, root.anim-fadeshadow-style); }
                            }
                        }
                    }

                    if root.anim-fadeshadow-enabled : Text {
                        text: "Fading shadow pulse on focused windows.";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        color: HveColors.text-muted;
                        wrap: word-wrap;
                    }

                    if root.anim-fadeshadow-enabled : Rectangle {
                        property <bool> lit: root.local-focus == root.idx-a2-speed && root.has-focus;
                        property <bool> grabbed: root.engaged-slider == root.idx-a2-speed && root.has-focus;
                        height: 48px;
                        border-width: 1px;
                        border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                        border-radius: SkwdTokens.radius-8;
                        background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-surface;

                        GeometrySlider {
                            width: 100%;
                            y: (parent.height - self.height) / 2;
                            engaged: root.engaged-slider == root.idx-a2-speed;
                            focused: root.local-focus == root.idx-a2-speed && root.has-focus;
                            label: "Speed";
                            value: root.anim-fadeshadow-speed;
                            min: 5;
                            max: 120;
                            changed(v) => { root.anim-changed("fadeShadow", root.anim-fadeshadow-enabled, v, root.anim-fadeshadow-bezier, root.anim-fadeshadow-style); }
                        }
                    }
                }
            }

            if root.anim-fadeshadow-enabled : Rectangle {
                property <bool> lit: root.local-focus == root.idx-a2-bezier && root.has-focus;
                property <bool> grabbed: root.engaged-slider == root.idx-a2-bezier && root.has-focus;
                height: 48px;
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: space-between;
                    Text {
                        text: "Bezier: " + root.anim-fadeshadow-bezier;
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "Curve";
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        vertical-alignment: center;
                    }
                }
                curve-a2-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.cycle-anim-part("fadeShadow", "bezier"); }
                }
            }
            if root.anim-fadeshadow-enabled : Text {
                text: "Animation curve for the shadow fade (default plus preset curves).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }
            if root.anim-fadeshadow-enabled : Rectangle {
                property <bool> lit: root.local-focus == root.idx-a2-style && root.has-focus;
                property <bool> grabbed: root.engaged-slider == root.idx-a2-style && root.has-focus;
                height: 48px;
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: space-between;
                    Text {
                        text: root.anim-fadeshadow-style == "" ? "Style: none" : "Style: " + root.anim-fadeshadow-style;
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "Style";
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-11;
                        vertical-alignment: center;
                    }
                }
                style-a2-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.cycle-anim-part("fadeShadow", "style"); }
                }
            }
            if root.anim-fadeshadow-enabled : Text {
                text: "Loop style for the shadow fade (none or loop).";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-11;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // ── Rule toggle ──
            rule-wrap := Rectangle {
                property <bool> lit: root.local-focus == root.idx-rule && root.has-focus;
                height: self.lit ? 64px : 56px;
                border-width: 1px;
                border-color: self.lit ? #8fd8ff : HveColors.border;
                border-radius: SkwdTokens.radius-8;
                background: self.lit ? HveColors.bg-hover : HveColors.bg-card;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 8px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;

                        Text {
                            text: "Floating Window Rule";
                            color: HveColors.text;
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-13;
                            font-weight: 600;
                        }

                        Text {
                            text: "Adds noshadow + dim_around rules for floating windows.";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-11;
                            color: HveColors.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        width: 48px;
                        height: 24px;
                        border-radius: 12px;
                        background: root.tune-rule-enabled ? HveColors.accent-cyan : HveColors.bg-surface;
                        border-width: 1px;
                        border-color: HveColors.border;

                        Rectangle {
                            x: root.tune-rule-enabled ? 26px : 4px;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: root.tune-rule-enabled ? HveColors.bg-dark : HveColors.text-muted;
                            animate x { duration: 150ms; easing: ease-out; }
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            // Was a bare local flip: it animated the switch and
                            // never notified, so the rule never reached the live
                            // draft from the mouse.
                            clicked => { root.rule-toggled(!root.tune-rule-enabled); }
                        }
                    }
                }
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // Save form: LineEdit + Save button
            Text {
                text: "Save as Preset";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-14;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }

            HorizontalLayout {
                spacing: SkwdTokens.spacing-8;
                height: 36px;

                save-line-wrap := Rectangle {
                    property <bool> lit: root.local-focus == root.idx-save-name && root.has-focus;
                    horizontal-stretch: 1;
                    height: 36px;
                    background: self.lit ? HveColors.bg-hover : HveColors.bg-card;
                    border-radius: SkwdTokens.radius-8;
                    border-width: save-input.has-focus || self.lit ? 1px : 0px;
                    border-color: #8fd8ff;

                    save-input := LineEdit {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        placeholder-text: "Border preset name…";
                        text <=> root.preset-name;
                        font-size: SkwdTokens.size-13;
                        accepted(text) => {
                            if (text != "") {
                                root.save-preset(text);
                            }
                        }
                    }
                }

                save-btn := Rectangle {
                    property <bool> lit: root.local-focus == root.idx-save-btn && root.has-focus;
                    width: 84px;
                    height: 36px;
                    background: save-ta.has-hover || self.lit ? HveColors.accent-cyan.transparentize(0.2) : HveColors.accent-cyan;
                    border-radius: SkwdTokens.radius-8;
                    border-width: self.lit ? 2px : 0px;
                    border-color: #8fd8ff;

                    Text {
                        text: "Save";
                        color: HveColors.bg-dark;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-13;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    save-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.preset-name != "") {
                                root.save-preset(root.preset-name);
                            }
                        }
                    }
                }
            }

            if root.error-text != "" : Text {
                text: root.error-text;
                color: HveColors.accent-red;
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                wrap: word-wrap;
            }

            // Keyboard hint
            Text {
                text: "↑↓ navigate • ←→ switch panel • Enter apply/engage • arrows ±1 • Esc back";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted.transparentize(0.4);
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

}

// ─── List pane: built-in + user presets. ───
component BordersListPane inherits Rectangle {
    in property <[string]> builtin-names;
    in property <[string]> builtin-tags;
    // Apply values for the built-in cards: the preset FILE (NN_name.lua), not
    // the translated title shown by the card. border.sh resolves presets by
    // file name only, so the title would silently miss.
    in property <[string]> builtin-files;
    in property <[string]> user-names;
    in property <[string]> user-tags;
    in property <int> active-index: -1;
    in property <int> focused-index: 0;
    in property <bool> has-focus: false;
    in property <bool> follow: false;
    callback apply-preset(int, string);
    callback open-rename(string);
    callback open-delete(string);

    property <length> saved-scroll-y: 0px;
    // Split index: built-in cards fill 0..builtin-count-1, user cards fill builtin-count..
    property <int> builtin-count: root.builtin-names.length;
    property <int> total-count: root.builtin-names.length + root.user-names.length;
    background: transparent;
    clip: true;

    // The scroll position is OURS to own.
    //
    // Measured on this pane: with the pointer over the list's padding (no card
    // under it) ten notches one frame apart land exactly on the end. With a card
    // under the pointer the content is ~44px TALLER (the card expands on hover),
    // so the end of the list sits below the clamp: pinned at the end you are
    // suddenly short of it ... the keeper's "no llega al final". Own the target,
    // clamp it against the REAL content height, and stay pinned when the content
    // grows under the pointer.
    property <length> scroll-target: 0px;
    property <length> max-scroll: max(0px, column.height - list-scroll.height);
    // True while the view sits at the end: growth under the pointer (a hover
    // expansion) must not push that end out of reach.
    property <bool> at-end: false;
    function clamp-scroll(v: length) -> length {
        return max(0px - root.max-scroll, min(0px, v));
    }

    changed focused-index => { list-scroll.follow-focus(); }
    changed follow => { list-scroll.follow-focus(); }
    changed max-scroll => {
        if (root.at-end) {
            root.scroll-target = 0px - root.max-scroll;
            list-scroll.viewport-y = root.scroll-target;
        }
    }

    list-scroll := ScrollView {
        property <length> focus-y: root.focused-index * 66px;
        // Viewport control must be IMPERATIVE, never a binding. Slint DROPS a
        // property's binding the moment code assigns it, and the ScrollView
        // assigns `viewport-y` itself whenever the user turns the wheel. With
        // `viewport-y: <expr>` the wheel therefore killed the binding for the
        // rest of the session: the list stopped following the focused preset,
        // so navigating by keyboard no longer brought the lower presets into
        // view ("hay alguno que no se alcanza a ver"). Assigning on the events
        // that should move the pane keeps both paths alive.
        public function follow-focus() {
            if (root.follow && root.focused-index >= 0) {
                root.scroll-target = root.clamp-scroll(0px - max(0px, self.focus-y + 29px - self.height / 2));
                self.viewport-y = root.scroll-target;
            }
        }
        // NEVER animated. `viewport-y` is the property the wheel writes, so an
        // animation on it makes any tick that lands mid-flight compute its target
        // from the INTERPOLATED value — which drops the travel the previous tick
        // had not finished. Exact beats smooth for a scrollable pane.
        changed viewport-y => {
            root.saved-scroll-y = self.viewport-y;
            root.scroll-target = self.viewport-y;
            root.at-end = root.scroll-target <= 0px - root.max-scroll + 1px;
        }
        column := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 8px;

            // Built-in presets header
            if root.builtin-names.length > 0 : Text {
                text: "Built-in";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-12;
                font-weight: 600;
                color: HveColors.text-muted;
            }

            for i in root.builtin-names.length : SavedPresetCard {
                preset-name: root.builtin-names[i];
                apply-value: root.builtin-files[i];
                is-active: i == root.active-index;
                is-user: false;
                keyboard-focused: root.focused-index == i && root.has-focus;
                accent: #8fd8ff;
                index: i;
                apply-preset(idx, name) => { root.apply-preset(idx, name); }
                refocus() => { }
            }

            // User presets header
            if root.user-names.length > 0 : Rectangle { height: 8px; }
            if root.user-names.length > 0 : Text {
                text: "My Border Presets";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-12;
                font-weight: 600;
                color: HveColors.text-muted;
            }

            for i in root.user-names.length : SavedPresetCard {
                preset-name: root.user-names[i];
                is-active: root.builtin-names.length + i == root.active-index;
                is-user: true;
                keyboard-focused: root.focused-index == root.builtin-names.length + i && root.has-focus;
                accent: HveColors.accent-amber;
                index: root.builtin-names.length + i;
                apply-preset(idx, name) => { root.apply-preset(idx, name); }
                open-rename(name) => { root.open-rename(name); }
                open-delete(name) => { root.open-delete(name); }
                refocus() => { }
            }

            // Empty state
            if root.total-count == 0 : Text {
                text: "No border presets found.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}

// ══════════════════════════════════════════════════════════════════════════════
// BordersSection (exported)
// ══════════════════════════════════════════════════════════════════════════════
export component BordersSection inherits Rectangle {
    // Built-in presets
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    // User presets
    in property <[string]> user-preset-names;
    in property <[string]> user-preset-tags;
    // Active selection
    in property <int> active-index: -1;
    // Keyboard state (owned by PanelRoot)
    in property <int> focused-index: 0;
    in property <int> engaged-slider: -1;
    in property <bool> has-focus: false;
    // Save form error
    in property <string> save-error: "";
    in-out property <string> preset-name: "";
    // Callbacks
    callback apply-border(int, string);
    callback save-border-preset(string);
    callback rename-border-preset(string, string);
    callback delete-border-preset(string);
    // Slot management
    callback add-color-slot();
    callback remove-color-slot();

    // Tune layer — 4 geometry values
    in-out property <int> geom-size: 2;
    in-out property <int> geom-radius: 32;
    in-out property <int> geom-gap-in: 5;
    in-out property <int> geom-gap-out: 5;
    callback apply-geometry(int, int, int, int);
    // Tune pane — dynamic (Unit 2)
    in-out property <[string]> tune-active-colors: [];
    in-out property <int> tune-color-count: 0;
    // Channel the shared colour picker is editing (same index space as
    // tune-colors-resolved). -1 = closed. Owned here because the section
    // owns the tune state the picker writes into.
    in-out property <int> editing-slot: -1;
    // Strip sub-navigation state (R9), owned HERE — not in the pane — for the
    // same reason as the picker command channel: the section instantiates the
    // pane twice (two-col / stacked) behind a condition, and Slint forbids
    // reaching into a conditional child, so per-pane state would split in two.
    // Both panes bind this two-way; the click TouchArea and `strip-cycle`
    // write through the binding and the two branches can never disagree.
    // Index of the active chip within the strip (0..tune-n-1). Wraps on ←/→.
    in-out property <int> strip-active-chip: 0;
    // Resolved colours (see MainWindow.tune-colors-resolved).
    in-out property <[color]> tune-colors-resolved: [];
    in-out property <int> tune-angle: 90;
    in-out property <string> tune-inactive-color: "";
    in-out property <string> tune-glow: "";
    in-out property <bool> tune-glow-enabled: false;
    in-out property <int> tune-glow-range: 20;
    in-out property <int> tune-glow-render-power: 4;
    in-out property <string> tune-glow-color: "p:primary";
    in-out property <string> tune-glow-color-inactive: "p:surface_lowest";
    in-out property <string> tune-animations: "";
    in-out property <bool> tune-anim-borderangle-enabled: false;
    in-out property <int> tune-anim-borderangle-speed: 30;
    in-out property <string> tune-anim-borderangle-bezier: "default";
    in-out property <string> tune-anim-borderangle-style: "";
    in-out property <bool> tune-anim-border-enabled: false;
    in-out property <int> tune-anim-border-speed: 30;
    in-out property <string> tune-anim-border-bezier: "default";
    in-out property <string> tune-anim-border-style: "";
    in-out property <bool> tune-anim-fadeshadow-enabled: false;
    in-out property <int> tune-anim-fadeshadow-speed: 30;
    in-out property <string> tune-anim-fadeshadow-bezier: "default";
    in-out property <string> tune-anim-fadeshadow-style: "";
    in-out property <[string]> tune-anim-curves: [];
    in-out property <bool> tune-rule-enabled: false;
    // D4 live-vs-saved: set by every edit below, cleared by Rust on load and
    // after a successful save.
    in-out property <bool> tune-dirty: false;
    callback tune-changed([string], int, string, string, string, bool);

    background: transparent;
    clip: true;

    // Responsive split from window width (ShellRoot), never root.width.
    in property <bool> two-col: false;
    // Cards-first global sequence: 0..list-count-1 cards, then tune stops.
    // split is the tune start; tune-count mirrors
    // callbacks::borders_tune_stop_count (size, angle, inactive, strip,
    // add, remove, glow group, 3 anim leaves, rule, save name + button).
    property <int> list-count: root.border-titles.length + root.user-preset-names.length;
    property <int> split: root.list-count;
    property <int> tune-n: clamp(root.tune-color-count, 0, 8);
    // The section owns the keyboard walk, but the render map lives on the pane
    // (instantiated twice behind conditions), so it cannot read the pane's
    // `idx-*`. It needs only the block width and the first glow stop: the slot
    // block is 3 wide while colours exist and 0 when they do not (the strip /
    // add / remove controls are not mounted), and every glow / anim stop is
    // `idx-glow-en + offset`. Mirrors the pane's map and
    // callbacks::borders_tune_stop_count.
    property <int> slot-stops: root.tune-n > 0 ? 3 : 0;
    property <int> idx-glow-en: root.slot-stops + 3;
    // 10 fixed stops (size, angle, inactive, glow-enable, 3 anim-enable, rule,
    // save-name, save-button) plus the 3 colour-slot stops ONLY while colours
    // exist, then the conditional leaves. Mirrors
    // callbacks::borders_tune_stop_count, which subtracts the same 3.
    out property <int> tune-count: 10 + root.slot-stops
        + (root.tune-glow-enabled ? 4 : 0)
        + (root.tune-anim-borderangle-enabled ? 3 : 0)
        + (root.tune-anim-border-enabled ? 3 : 0)
        + (root.tune-anim-fadeshadow-enabled ? 3 : 0);

    function next-angle(a: int, up: bool) -> int {
        if (up) {
            if (a == 30) { return 45; }
            if (a == 45) { return 90; }
            return 30;
        }
        if (a == 90) { return 45; }
        if (a == 45) { return 30; }
        return 90;
    }
    function next-token(t: string, up: bool) -> string {
        if (up) {
            if (t == "p:primary") { return "p:secondary"; }
            if (t == "p:secondary") { return "p:tertiary"; }
            if (t == "p:tertiary") { return "p:error"; }
            if (t == "p:error") { return "p:surface"; }
            if (t == "p:surface") { return "p:surface_lowest"; }
            return "p:primary";
        }
        if (t == "p:primary") { return "p:surface_lowest"; }
        if (t == "p:surface_lowest") { return "p:surface"; }
        if (t == "p:surface") { return "p:error"; }
        if (t == "p:error") { return "p:tertiary"; }
        if (t == "p:tertiary") { return "p:secondary"; }
        return "p:primary";
    }
    function next-style(s: string, up: bool) -> string {
        if (s == "") { return "loop"; }
        return "";
    }
    function next-bezier(b: string, up: bool) -> string {
        if (root.tune-anim-curves.length == 0) { return "default"; }
        if (up) {
            if (b == "default") { return root.tune-anim-curves[0]; }
            if (root.tune-anim-curves.length > 1 && b == root.tune-anim-curves[0]) { return root.tune-anim-curves[1]; }
            return "default";
        }
        if (b == "default") {
            if (root.tune-anim-curves.length > 1) { return root.tune-anim-curves[1]; }
            return root.tune-anim-curves[0];
        }
        if (b == root.tune-anim-curves[0]) { return "default"; }
        return root.tune-anim-curves[0];
    }
    function rebuild-glow() -> string {
        if (!root.tune-glow-enabled) { return ""; }
        return "enabled:true|range:" + root.tune-glow-range + "|power:" + root.tune-glow-render-power + "|color:" + root.tune-glow-color + "|inactive:" + root.tune-glow-color-inactive + "|ox:0|oy:0";
    }
    function rebuild-anims() -> string {
        return "borderangle|" + (root.tune-anim-borderangle-enabled ? "true" : "false") + "|" + root.tune-anim-borderangle-speed + "|" + root.tune-anim-borderangle-bezier + "|" + root.tune-anim-borderangle-style
            + ",border|" + (root.tune-anim-border-enabled ? "true" : "false") + "|" + root.tune-anim-border-speed + "|" + root.tune-anim-border-bezier + "|" + root.tune-anim-border-style
            + ",fadeShadow|" + (root.tune-anim-fadeshadow-enabled ? "true" : "false") + "|" + root.tune-anim-fadeshadow-speed + "|" + root.tune-anim-fadeshadow-bezier + "|" + root.tune-anim-fadeshadow-style;
    }

    // Write a custom colour into the channel the picker is editing. `commit`
    // false only moves the local value (drag preview); true also pushes the
    // live draft, which D4 forbids doing on every drag step.
    function set-custom(idx: int, hex: string, commit: bool) {
        let v = "c:" + hex;
        if (idx >= 0 && idx < root.tune-n) {
            root.tune-active-colors[idx] = v;
        } else if (idx == 8) {
            root.tune-inactive-color = v;
        } else if (idx == 9) {
            root.tune-glow-color = v;
            root.tune-glow = root.rebuild-glow();
        } else if (idx == 10) {
            root.tune-glow-color-inactive = v;
            root.tune-glow = root.rebuild-glow();
        } else {
            return;
        }
        if (commit) { root.notify-tune-changed(); }
    }

    // Single funnel for every tune edit: marks the working state as unsaved
    // (D4) and pushes the whole tune snapshot to Rust, which applies the live
    // draft. Having one place means an edit can never silently skip the notify.
    // Argument order MUST match the declaration
    // `tune-changed([string], int, string, string, string, bool)`, i.e.
    // (colors, angle, inactive, glow, anims, rule). There is no count slot:
    // slot_count is `colors.length` and is already carried by the model.
    // Passing it here shifted every later argument by one — Rust received the
    // slot count as the angle, the angle as the inactive colour, the inactive
    // colour as the glow and the glow as the animations. Slint's implicit
    // int→string coercion on the angle kept it compiling, which is exactly why
    // no test ever caught it.
    function notify-tune-changed() {
        root.tune-dirty = true;
        root.tune-changed(root.tune-active-colors, root.tune-angle, root.tune-inactive-color, root.tune-glow, root.tune-animations, root.tune-rule-enabled);
    }

    // ── Geometry debounce (R3) — only size slider remains ──
    // The timer applies `geom-size` itself; `last-size` is the "already sent to
    // Rust" marker. Two rules keep this honest:
    //   • `geom-dirty` is raised BEFORE `geom-size` moves, so the
    //     `changed geom-size` handler below can never mistake a user edit for a
    //     Rust snap — and that holds under either eager or deferred handler
    //     scheduling, which is what made the previous pending/last pair silently
    //     never fire.
    //   • `size-init`, which used to swallow the FIRST edit of every session
    //     (set to true and return), is gone. That swallow is what made the very
    //     first arrow press or drag do nothing at all.
    property <int> last-size: root.geom-size;
    property <bool> geom-dirty: false;

    geom-timer := Timer {
        interval: 80ms;
        running: root.geom-dirty;
        triggered => {
            // Unconditional on purpose: `geom-dirty` is raised ONLY by a user
            // edit (arrow or drag) and never by Rust snapping the slider, so if
            // this timer fires there IS something the user changed that has to
            // reach the desktop. The previous `pending-size != last-size`
            // comparison could compare equal (Rust syncs `last-size` from
            // `changed geom-size`) and silently drop the edit — which is the
            // "changing the thickness does nothing" the maintainer reported,
            // alongside a `size-init` flag that swallowed the session's first
            // edit outright.
            //
            // Radius and gaps travel with the size: the tune pane owns the
            // thickness, the section owns the rest of the geometry. Sending
            // literal 0s here (as this used to) wiped the user's rounding and
            // gaps on every thickness change — the Rust handler writes all four
            // values, and the U3 rebuild had already removed the radius/gap
            // controls, so there was no way back from the pane.
            root.apply-geometry(root.geom-size, root.geom-radius, root.geom-gap-in, root.geom-gap-out);
            root.last-size = root.geom-size;
            root.geom-dirty = false;
        }
    }

    // Slider adjust (keyboard arrows) — every slider-like tune stop, clamped.
    // Tune-local engaged index: 0=size, 1=angle, 2=inactive, glow
    // range/power/colors, anim speed/bezier/style. Toggles, actions and the
    // strip are handled by tune-enter, never here.
    public function adjust-slider(up: bool) {
        let e = root.engaged-slider;
        if (e == 0) {
            let next = up ? min(root.geom-size + 1, 5) : max(root.geom-size - 1, 1);
            if (next != root.geom-size) {
                // Dirty BEFORE the value moves — see the debounce note.
                root.geom-dirty = true;
                root.geom-size = next;
                geom-timer.restart();
            }
            return;
        }
        if (e == 1) {
            root.tune-angle = root.next-angle(root.tune-angle, up);
            // The angle used to stop here: it changed the value and never
            // notified, so the arrow cycle was a no-op on the desktop.
            root.notify-tune-changed();
            return;
        }
        if (e == 2) {
            root.tune-inactive-color = root.next-token(root.tune-inactive-color, up);
            root.notify-tune-changed();
            return;
        }
        // No per-slot branch: the strip (index 3) is never engaged, so there is
        // no engaged colour stop to adjust here. (Removed in PR 3; the old
        // `e >= 3 && e < 3 + n` path cycled the palette token of an engaged slot.)
        if (root.tune-glow-enabled) {
            if (e == root.idx-glow-en + 1) {
                let next = up ? min(root.tune-glow-range + 1, 40) : max(root.tune-glow-range - 1, 5);
                if (next != root.tune-glow-range) {
                    root.tune-glow-range = next;
                    root.tune-glow = root.rebuild-glow();
                    root.notify-tune-changed();
                }
                return;
            }
            if (e == root.idx-glow-en + 2) {
                let next = up ? min(root.tune-glow-render-power + 1, 8) : max(root.tune-glow-render-power - 1, 1);
                if (next != root.tune-glow-render-power) {
                    root.tune-glow-render-power = next;
                    root.tune-glow = root.rebuild-glow();
                    root.notify-tune-changed();
                }
                return;
            }
            if (e == root.idx-glow-en + 3) {
                root.tune-glow-color = root.next-token(root.tune-glow-color, up);
                root.tune-glow = root.rebuild-glow();
                root.notify-tune-changed();
                return;
            }
            if (e == root.idx-glow-en + 4) {
                root.tune-glow-color-inactive = root.next-token(root.tune-glow-color-inactive, up);
                root.tune-glow = root.rebuild-glow();
                root.notify-tune-changed();
                return;
            }
        }
        let base = root.idx-glow-en + (root.tune-glow-enabled ? 5 : 1);
        let b1 = base + 1 + (root.tune-anim-borderangle-enabled ? 3 : 0);
        let b2 = b1 + 1 + (root.tune-anim-border-enabled ? 3 : 0);
        if (root.tune-anim-borderangle-enabled) {
            if (e == base + 1) {
                let next = up ? min(root.tune-anim-borderangle-speed + 5, 120) : max(root.tune-anim-borderangle-speed - 5, 5);
                root.tune-anim-borderangle-speed = next;
                root.tune-animations = root.rebuild-anims();
                root.notify-tune-changed();
                return;
            }
            if (e == base + 2) {
                root.tune-anim-borderangle-bezier = root.next-bezier(root.tune-anim-borderangle-bezier, up);
                root.tune-animations = root.rebuild-anims();
                root.notify-tune-changed();
                return;
            }
            if (e == base + 3) {
                root.tune-anim-borderangle-style = root.next-style(root.tune-anim-borderangle-style, up);
                root.tune-animations = root.rebuild-anims();
                root.notify-tune-changed();
                return;
            }
        }
        if (root.tune-anim-border-enabled) {
            if (e == b1 + 1) {
                let next = up ? min(root.tune-anim-border-speed + 5, 120) : max(root.tune-anim-border-speed - 5, 5);
                root.tune-anim-border-speed = next;
                root.tune-animations = root.rebuild-anims();
                root.notify-tune-changed();
                return;
            }
            if (e == b1 + 2) {
                root.tune-anim-border-bezier = root.next-bezier(root.tune-anim-border-bezier, up);
                root.tune-animations = root.rebuild-anims();
                root.notify-tune-changed();
                return;
            }
            if (e == b1 + 3) {
                root.tune-anim-border-style = root.next-style(root.tune-anim-border-style, up);
                root.tune-animations = root.rebuild-anims();
                root.notify-tune-changed();
                return;
            }
        }
        if (root.tune-anim-fadeshadow-enabled) {
            if (e == b2 + 1) {
                let next = up ? min(root.tune-anim-fadeshadow-speed + 5, 120) : max(root.tune-anim-fadeshadow-speed - 5, 5);
                root.tune-anim-fadeshadow-speed = next;
                root.tune-animations = root.rebuild-anims();
                root.notify-tune-changed();
                return;
            }
            if (e == b2 + 2) {
                root.tune-anim-fadeshadow-bezier = root.next-bezier(root.tune-anim-fadeshadow-bezier, up);
                root.tune-animations = root.rebuild-anims();
                root.notify-tune-changed();
                return;
            }
            if (e == b2 + 3) {
                root.tune-anim-fadeshadow-style = root.next-style(root.tune-anim-fadeshadow-style, up);
                root.tune-animations = root.rebuild-anims();
                root.notify-tune-changed();
                return;
            }
        }
    }

    // Enter on a tune stop: 0 = slider-like (PanelRoot engages), 1 = handled
    // here (toggle, add/remove, save). Computed from the live tune-local
    // focused index so hidden stops are never reachable.
    // Tune-local map (the strip is ONE stop, never N). With colours:
    // 0=size, 1=angle, 2=inactive, 3=strip, 4=add, 5=remove, then the glow /
    // anim / rule / save stops. With ZERO colours the strip / add / remove
    // block does not exist (`slot-stops` = 0) and those positions shift down by
    // three: 3=glow-enabled, and so on (`idx-glow-en` below).
    public function tune-enter() -> int {
        let local = root.focused-index - root.list-count;
        // The strip stop is NEVER engaged: Enter opens the picker for the
        // active chip directly (R9). PanelRoot sees the 1 and leaves
        // engaged-slider at -1, so ←/→ keep cycling chips afterwards.
        if (local == 3 && root.tune-n > 0) {
            // Bound at the point of use too (Q1): the count can have shrunk
            // since the ring moved, and an out-of-range chip has no picker to
            // open, so never hand its stale index to `editing-slot`.
            root.editing-slot = clamp(root.strip-active-chip, 0, root.tune-n - 1);
            return 1;
        }
        // A colour stop is a slider-like stop (PanelRoot engages it, arrows
        // cycle the palette). Pressing Enter AGAIN on an already-engaged colour
        // opens the picker, so the custom path is reachable without a mouse.
        // Esc closes it (handled in PanelRoot).
        if (local == 2 && root.engaged-slider == local) { root.editing-slot = 8; return 1; }
        // Channel indices are the pane's fixed 0..7 slots / 8 inactive / 9 glow
        // / 10 glow-inactive space — NOT the tune stop positions, which shift
        // with the slot block. `editing-slot` therefore keeps its literal.
        if (root.tune-glow-enabled && local == root.idx-glow-en + 3 && root.engaged-slider == local) {
            root.editing-slot = 9;
            return 1;
        }
        if (root.tune-glow-enabled && local == root.idx-glow-en + 4 && root.engaged-slider == local) {
            root.editing-slot = 10;
            return 1;
        }
        // Add / remove sit inside the slot block, which exists only while
        // colours do: with zero colours local 4/5 are other controls, so the
        // `tune-n` guards keep the unmounted actions unreachable.
        if (local == 4 && root.tune-n > 0 && root.tune-n < 8) { root.add-color-slot(); return 1; }
        if (local == 5 && root.tune-n > 2) { root.remove-color-slot(); return 1; }
        if (local == root.idx-glow-en) {
            root.tune-glow-enabled = !root.tune-glow-enabled;
            root.tune-glow = root.rebuild-glow();
            root.notify-tune-changed();
            return 1;
        }
        let base = root.idx-glow-en + (root.tune-glow-enabled ? 5 : 1);
        let b1 = base + 1 + (root.tune-anim-borderangle-enabled ? 3 : 0);
        let b2 = b1 + 1 + (root.tune-anim-border-enabled ? 3 : 0);
        let tail = b2 + 1 + (root.tune-anim-fadeshadow-enabled ? 3 : 0);
        if (local == base) {
            root.tune-anim-borderangle-enabled = !root.tune-anim-borderangle-enabled;
            root.tune-animations = root.rebuild-anims();
            root.notify-tune-changed();
            return 1;
        }
        if (local == b1) {
            root.tune-anim-border-enabled = !root.tune-anim-border-enabled;
            root.tune-animations = root.rebuild-anims();
            root.notify-tune-changed();
            return 1;
        }
        if (local == b2) {
            root.tune-anim-fadeshadow-enabled = !root.tune-anim-fadeshadow-enabled;
            root.tune-animations = root.rebuild-anims();
            root.notify-tune-changed();
            return 1;
        }
        if (local == tail) {
            root.tune-rule-enabled = !root.tune-rule-enabled;
            // The rule was the one tune stop that did NOT notify, so flipping
            // it never reached the live draft (D4: everything applies live).
            root.notify-tune-changed();
            return 1;
        }
        if (local == tail + 1) { return 1; }
        if (local == tail + 2) {
            if (root.preset-name != "") { root.save-border-preset(root.preset-name); }
            return 1;
        }
        return 0;
    }

    // ── Picker keyboard entry points (task 3.7) ───────────────────
    // The picker lives INSIDE a pane that is created conditionally (two-col vs
    // stacked), and Slint forbids reaching a conditional child from the
    // component that declares the condition. So the arrows do not call the
    // picker: they bump a small command channel that BOTH pane branches forward
    // down to their picker, and only the mounted branch has a picker to hear it.
    in-out property <int> picker-cmd: 0;       // monotonic sequence
    in-out property <int> picker-cmd-kind: 0;  // 1=up 2=down 3=left 4=right

    public pure function picker-open() -> bool { return root.editing-slot >= 0; }

    public function picker-move(delta: int) {
        if (root.editing-slot < 0) { return; }
        root.picker-cmd-kind = delta > 0 ? 2 : 1;
        root.picker-cmd += 1;
    }

    public function picker-adjust(up: bool) {
        if (root.editing-slot < 0) { return; }
        root.picker-cmd-kind = up ? 4 : 3;
        root.picker-cmd += 1;
    }

    // ── Strip sub-navigation (R9, task 3.2) ──────────────────────────
    // Cycles the active chip within the strip with wrap. PanelRoot calls this
    // when ←/→ lands on the strip stop (tune-local 3); the strip is never
    // engaged, so the arrows always mean "move the chip", never "adjust".
    // Lives on the section — same pattern as picker-move/picker-adjust —
    // because PanelRoot can only call section functions, and the section
    // cannot reach into its conditional pane children.
    public function strip-cycle(delta: int) {
        if (root.tune-n <= 0) { return; }
        root.strip-active-chip = mod(root.strip-active-chip + delta + root.tune-n, root.tune-n);
    }

    // Q1: the slot count is the only thing that can shrink the strip, and it
    // can shrink while the ring sits on a now-gone chip (remove slot, or load
    // a preset with fewer colours). Nothing clamped `strip-active-chip`, so
    // the ring vanished and Enter on the strip still opened the picker for the
    // stale index — a channel every write path then dropped (the label fell
    // back to "this colour", `editing-value` returned "", `choose-token`
    // matched no branch and `set-custom` hit its silent `else { return; }`).
    // Clamp here, where the count changes; `tune-enter` bounds again at the
    // point of use.
    changed tune-color-count => {
        let n = clamp(root.tune-color-count, 0, 8);
        if (root.strip-active-chip >= n) {
            root.strip-active-chip = n > 0 ? n - 1 : 0;
        }
        // A picker left open on a gradient slot that just disappeared must
        // close: indices 8/9/10 are the inactive / glow / glow-inactive
        // channels and are not slot-bound, so only 0..7 are affected.
        if (root.editing-slot >= 0 && root.editing-slot < 8 && root.editing-slot >= n) {
            root.editing-slot = -1;
        }
    }

    // Cycle one animation leaf's bezier or style. Mouse and keyboard share this
    // so the two can never drift apart (the rows had no TouchArea at all, so a
    // mouse user could not change the curve or the loop style).
    function cycle-anim-part(leaf: string, part: string) {
        if (leaf == "borderangle") {
            if (part == "bezier") {
                root.tune-anim-borderangle-bezier = root.next-bezier(root.tune-anim-borderangle-bezier, true);
            } else {
                root.tune-anim-borderangle-style = root.next-style(root.tune-anim-borderangle-style, true);
            }
        } else if (leaf == "border") {
            if (part == "bezier") {
                root.tune-anim-border-bezier = root.next-bezier(root.tune-anim-border-bezier, true);
            } else {
                root.tune-anim-border-style = root.next-style(root.tune-anim-border-style, true);
            }
        } else if (leaf == "fadeShadow") {
            if (part == "bezier") {
                root.tune-anim-fadeshadow-bezier = root.next-bezier(root.tune-anim-fadeshadow-bezier, true);
            } else {
                root.tune-anim-fadeshadow-style = root.next-style(root.tune-anim-fadeshadow-style, true);
            }
        }
        root.tune-animations = root.rebuild-anims();
        root.notify-tune-changed();
    }

    // Mouse-direct slider edits — size only. No first-edit swallow: `last-size`
    // is the guard (see the geometry debounce note).
    function slider-changed(id: int, v: int) {
        if (id == 0) {
            if (v == root.last-size) { return; }
            // Dirty BEFORE the value moves — see the debounce note.
            root.geom-dirty = true;
            root.geom-size = v;
            geom-timer.restart();
        }
    }

    // Rust snapped the slider (startup, a preset pick, or a preset whose own
    // geometry differs). That value is already what the desktop runs, so it
    // becomes the new "sent" marker instead of triggering another apply.
    changed geom-size => { if (!root.geom-dirty) { root.last-size = root.geom-size; } }

    VerticalLayout {
        spacing: 0px;

        // Header fixed
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "Borders";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }
            Text {
                text: "Tune the border, then save it as a preset. Or pick an existing style.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }

            // D4 live-vs-saved: edits apply to the desktop immediately but are
            // NOT persisted until Save. The header is outside the ScrollView on
            // purpose, so this can never scroll out of sight and mislead.
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.tune-dirty ? HveColors.accent-amber : HveColors.accent-cyan;
                }
                Text {
                    text: root.tune-dirty
                        ? "Live preview — unsaved changes"
                        : "Live preview — no unsaved changes";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    font-weight: 600;
                    color: root.tune-dirty ? HveColors.accent-amber : HveColors.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        // Two independent panes. Wide: side by side. Narrow: stacked.
        if root.two-col : HorizontalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            BordersListPane {
                horizontal-stretch: 1;
                builtin-names: root.border-titles;
                builtin-tags: root.border-tags;
                builtin-files: root.border-files;
                user-names: root.user-preset-names;
                user-tags: root.user-preset-tags;
                active-index: root.active-index;
                focused-index: root.focused-index;
                has-focus: root.has-focus;
                // The LIST pane follows only when the focus is on a CARD
                // (focused-index < split). With `>=` it chased the tune
                // pane's focus, so navigating the tune dragged the list.
                follow: root.focused-index < root.split;
                apply-preset(idx, name) => { root.apply-border(idx, name); }
                open-rename(name) => { root.rename-border-preset(name, ""); }
                open-delete(name) => { root.delete-border-preset(name); }
            }

            Rectangle { width: 1px; background: HveColors.border.transparentize(0.6); }

            BordersTunePane {
                horizontal-stretch: 1;
                size: root.geom-size;
                focused-index: root.focused-index;
                picker-cmd: root.picker-cmd;
                picker-cmd-kind: root.picker-cmd-kind;
                split: root.split;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index >= root.split;
                tune-active-colors: root.tune-active-colors;
                tune-colors-resolved: root.tune-colors-resolved;
                editing-slot: root.editing-slot;
                strip-active-chip <=> root.strip-active-chip;
                custom-color-preview(idx, hex) => { root.set-custom(idx, hex, false); }
                custom-color-changed(idx, hex) => { root.set-custom(idx, hex, true); }
                request-edit-slot(idx) => { root.editing-slot = idx; }
                tune-color-count: root.tune-color-count;
                tune-angle: root.tune-angle;
                tune-inactive-color: root.tune-inactive-color;
                error-text: root.save-error;
                preset-name <=> root.preset-name;
                slider-changed(id, v) => { root.slider-changed(id, v); }
                save-preset(name) => { root.save-border-preset(name); }
                add-color-slot => { root.add-color-slot(); }
                remove-color-slot => { root.remove-color-slot(); }
                slot-color-changed(idx, v) => {
                    root.tune-active-colors[idx] = v;
                    root.notify-tune-changed();
                }
                inactive-color-changed(v) => {
                    root.tune-inactive-color = v;
                    root.notify-tune-changed();
                }
                glow-enabled: root.tune-glow-enabled;
                glow-range: root.tune-glow-range;
                glow-render-power: root.tune-glow-render-power;
                glow-color: root.tune-glow-color;
                glow-color-inactive: root.tune-glow-color-inactive;
                glow-changed(enabled, range, power, color, inactive) => {
                    root.tune-glow-enabled = enabled;
                    root.tune-glow-range = range;
                    root.tune-glow-render-power = power;
                    root.tune-glow-color = color;
                    root.tune-glow-color-inactive = inactive;
                    // Rebuild the encoded glow string for the tune-changed callback
                    if enabled {
                        root.tune-glow = "enabled:true|range:" + range + "|power:" + power + "|color:" + color + "|inactive:" + inactive + "|ox:0|oy:0";
                    } else {
                        root.tune-glow = "";
                    }
                    root.notify-tune-changed();
                }
                anim-borderangle-enabled: root.tune-anim-borderangle-enabled;
                anim-borderangle-speed: root.tune-anim-borderangle-speed;
                anim-borderangle-bezier: root.tune-anim-borderangle-bezier;
                anim-borderangle-style: root.tune-anim-borderangle-style;
                anim-border-enabled: root.tune-anim-border-enabled;
                anim-border-speed: root.tune-anim-border-speed;
                anim-border-bezier: root.tune-anim-border-bezier;
                anim-border-style: root.tune-anim-border-style;
                anim-fadeshadow-enabled: root.tune-anim-fadeshadow-enabled;
                anim-fadeshadow-speed: root.tune-anim-fadeshadow-speed;
                anim-fadeshadow-bezier: root.tune-anim-fadeshadow-bezier;
                anim-fadeshadow-style: root.tune-anim-fadeshadow-style;
                anim-curves: root.tune-anim-curves;
                tune-rule-enabled: root.tune-rule-enabled;
                anim-changed(leaf, enabled, speed, bezier, style) => {
                    if leaf == "borderangle" {
                        root.tune-anim-borderangle-enabled = enabled;
                        root.tune-anim-borderangle-speed = speed;
                        root.tune-anim-borderangle-bezier = bezier;
                        root.tune-anim-borderangle-style = style;
                    } else if leaf == "border" {
                        root.tune-anim-border-enabled = enabled;
                        root.tune-anim-border-speed = speed;
                        root.tune-anim-border-bezier = bezier;
                        root.tune-anim-border-style = style;
                    } else if leaf == "fadeShadow" {
                        root.tune-anim-fadeshadow-enabled = enabled;
                        root.tune-anim-fadeshadow-speed = speed;
                        root.tune-anim-fadeshadow-bezier = bezier;
                        root.tune-anim-fadeshadow-style = style;
                    }
                    root.tune-animations = "borderangle|" + (root.tune-anim-borderangle-enabled ? "true" : "false") + "|" + root.tune-anim-borderangle-speed + "|" + root.tune-anim-borderangle-bezier + "|" + root.tune-anim-borderangle-style
                        + ",border|" + (root.tune-anim-border-enabled ? "true" : "false") + "|" + root.tune-anim-border-speed + "|" + root.tune-anim-border-bezier + "|" + root.tune-anim-border-style
                        + ",fadeShadow|" + (root.tune-anim-fadeshadow-enabled ? "true" : "false") + "|" + root.tune-anim-fadeshadow-speed + "|" + root.tune-anim-fadeshadow-bezier + "|" + root.tune-anim-fadeshadow-style;
                    root.notify-tune-changed();
                }
                cycle-anim-part(leaf, part) => { root.cycle-anim-part(leaf, part); }
                angle-changed(v) => {
                    root.tune-angle = v;
                    root.notify-tune-changed();
                }
                rule-toggled(v) => {
                    root.tune-rule-enabled = v;
                    root.notify-tune-changed();
                }
            }
        }
        if !root.two-col : VerticalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            BordersListPane {
                vertical-stretch: 1;
                builtin-names: root.border-titles;
                builtin-tags: root.border-tags;
                builtin-files: root.border-files;
                user-names: root.user-preset-names;
                user-tags: root.user-preset-tags;
                active-index: root.active-index;
                focused-index: root.focused-index;
                has-focus: root.has-focus;
                // The LIST pane follows only when the focus is on a CARD
                // (focused-index < split). With `>=` it chased the tune
                // pane's focus, so navigating the tune dragged the list.
                follow: root.focused-index < root.split;
                apply-preset(idx, name) => { root.apply-border(idx, name); }
                open-rename(name) => { root.rename-border-preset(name, ""); }
                open-delete(name) => { root.delete-border-preset(name); }
            }

            Rectangle { height: 1px; background: HveColors.border.transparentize(0.6); }

            BordersTunePane {
                vertical-stretch: 1;
                size: root.geom-size;
                focused-index: root.focused-index;
                picker-cmd: root.picker-cmd;
                picker-cmd-kind: root.picker-cmd-kind;
                split: root.split;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index >= root.split;
                tune-active-colors: root.tune-active-colors;
                tune-colors-resolved: root.tune-colors-resolved;
                editing-slot: root.editing-slot;
                strip-active-chip <=> root.strip-active-chip;
                custom-color-preview(idx, hex) => { root.set-custom(idx, hex, false); }
                custom-color-changed(idx, hex) => { root.set-custom(idx, hex, true); }
                request-edit-slot(idx) => { root.editing-slot = idx; }
                tune-color-count: root.tune-color-count;
                tune-angle: root.tune-angle;
                tune-inactive-color: root.tune-inactive-color;
                error-text: root.save-error;
                preset-name <=> root.preset-name;
                slider-changed(id, v) => { root.slider-changed(id, v); }
                save-preset(name) => { root.save-border-preset(name); }
                add-color-slot => { root.add-color-slot(); }
                remove-color-slot => { root.remove-color-slot(); }
                slot-color-changed(idx, v) => {
                    root.tune-active-colors[idx] = v;
                    root.notify-tune-changed();
                }
                inactive-color-changed(v) => {
                    root.tune-inactive-color = v;
                    root.notify-tune-changed();
                }
                glow-enabled: root.tune-glow-enabled;
                glow-range: root.tune-glow-range;
                glow-render-power: root.tune-glow-render-power;
                glow-color: root.tune-glow-color;
                glow-color-inactive: root.tune-glow-color-inactive;
                glow-changed(enabled, range, power, color, inactive) => {
                    root.tune-glow-enabled = enabled;
                    root.tune-glow-range = range;
                    root.tune-glow-render-power = power;
                    root.tune-glow-color = color;
                    root.tune-glow-color-inactive = inactive;
                    if enabled {
                        root.tune-glow = "enabled:true|range:" + range + "|power:" + power + "|color:" + color + "|inactive:" + inactive + "|ox:0|oy:0";
                    } else {
                        root.tune-glow = "";
                    }
                    root.notify-tune-changed();
                }
                anim-borderangle-enabled: root.tune-anim-borderangle-enabled;
                anim-borderangle-speed: root.tune-anim-borderangle-speed;
                anim-borderangle-bezier: root.tune-anim-borderangle-bezier;
                anim-borderangle-style: root.tune-anim-borderangle-style;
                anim-border-enabled: root.tune-anim-border-enabled;
                anim-border-speed: root.tune-anim-border-speed;
                anim-border-bezier: root.tune-anim-border-bezier;
                anim-border-style: root.tune-anim-border-style;
                anim-fadeshadow-enabled: root.tune-anim-fadeshadow-enabled;
                anim-fadeshadow-speed: root.tune-anim-fadeshadow-speed;
                anim-fadeshadow-bezier: root.tune-anim-fadeshadow-bezier;
                anim-fadeshadow-style: root.tune-anim-fadeshadow-style;
                anim-curves: root.tune-anim-curves;
                tune-rule-enabled: root.tune-rule-enabled;
                anim-changed(leaf, enabled, speed, bezier, style) => {
                    if leaf == "borderangle" {
                        root.tune-anim-borderangle-enabled = enabled;
                        root.tune-anim-borderangle-speed = speed;
                        root.tune-anim-borderangle-bezier = bezier;
                        root.tune-anim-borderangle-style = style;
                    } else if leaf == "border" {
                        root.tune-anim-border-enabled = enabled;
                        root.tune-anim-border-speed = speed;
                        root.tune-anim-border-bezier = bezier;
                        root.tune-anim-border-style = style;
                    } else if leaf == "fadeShadow" {
                        root.tune-anim-fadeshadow-enabled = enabled;
                        root.tune-anim-fadeshadow-speed = speed;
                        root.tune-anim-fadeshadow-bezier = bezier;
                        root.tune-anim-fadeshadow-style = style;
                    }
                    root.tune-animations = "borderangle|" + (root.tune-anim-borderangle-enabled ? "true" : "false") + "|" + root.tune-anim-borderangle-speed + "|" + root.tune-anim-borderangle-bezier + "|" + root.tune-anim-borderangle-style
                        + ",border|" + (root.tune-anim-border-enabled ? "true" : "false") + "|" + root.tune-anim-border-speed + "|" + root.tune-anim-border-bezier + "|" + root.tune-anim-border-style
                        + ",fadeShadow|" + (root.tune-anim-fadeshadow-enabled ? "true" : "false") + "|" + root.tune-anim-fadeshadow-speed + "|" + root.tune-anim-fadeshadow-bezier + "|" + root.tune-anim-fadeshadow-style;
                    root.notify-tune-changed();
                }
                cycle-anim-part(leaf, part) => { root.cycle-anim-part(leaf, part); }
                angle-changed(v) => {
                    root.tune-angle = v;
                    root.notify-tune-changed();
                }
                rule-toggled(v) => {
                    root.tune-rule-enabled = v;
                    root.notify-tune-changed();
                }
            }
        }
    }
}
