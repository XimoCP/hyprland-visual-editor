// HVE 2 — BordersSection (tune + preset list, two-pane).
//
// Two INDEPENDENT scroll regions:
//   • Tune pane  — 4 GeometrySliders (size 1-5, radius 0-100, gap_in/out
//     0-30) → 80ms debounce → apply_geometry, plus save form (LineEdit +
//     Save button) at the bottom for saving current geometry as a user preset.
//   • List pane  — Built-in presets (apply only) + user presets (apply,
//     rename, delete) via SavedPresetCard. User presets carry a ★ badge.
// Wide section → panes side by side; narrow section → stacked. Each pane owns
// its own ScrollView. Keyboard: single linear sequence owned by PanelRoot's
// panel-kbd; ← / → jump one panel at a time (menu → tune → list).
//
// Keyboard R11: arrows navigate cards/sliders, Enter/Space activates,
// sliders ±1, icy-cyan #8fd8ff focus.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { LineEdit, ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";
import { GeometrySlider } from "../../components.slint";
import { SavedPresetCard } from "SavedPresetCard.slint";

// ─── Tune pane: geometry sliders + save form. ───
component BordersTunePane inherits Rectangle {
    in property <int> size: 2;
    in property <int> radius: 32;
    in property <int> gap-in: 5;
    in property <int> gap-out: 5;
    in property <int> focused-index: 0;
    in property <int> split: 0;
    in property <bool> has-focus: false;
    in property <int> engaged-slider: -1;
    in property <bool> follow: false;
    // Save form state
    in property <string> error-text: "";
    in-out property <string> preset-name: "";
    callback slider-changed(int, int);
    callback save-preset(string);

    property <length> saved-scroll-y: 0px;
    // 0..3 = slider index; 4 = save form (LineEdit)
    property <int> local-focus: root.focused-index - root.split;
    background: transparent;
    clip: true;

    ScrollView {
        property <length> focus-y: local-focus <= 3 ? local-focus * 88px : 3 * 88px + 60px;
        viewport-y: root.follow ? (root.local-focus >= 0
            ? (0px - max(0px, self.focus-y + 48px - self.height / 2))
            : 0px) : root.saved-scroll-y;
        animate viewport-y { duration: 250ms; easing: ease-out; }
        changed viewport-y => { root.saved-scroll-y = self.viewport-y; }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 8px;

            // Size 1-5
            size-wrap := Rectangle {
                property <bool> lit: (root.focused-index == root.split && root.has-focus) || hover-size.has-hover;
                property <bool> grabbed: root.engaged-slider == 0 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-size := TouchArea { width: 100%; height: 100%; clicked => { } }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 0;
                    focused: size-wrap.lit;
                    label: "Border Thickness";
                    value: root.size;
                    min: 1;
                    max: 5;
                    changed(v) => { root.slider-changed(0, v); }
                }
            }

            // Radius 0-100
            radius-wrap := Rectangle {
                property <bool> lit: (root.focused-index == root.split + 1 && root.has-focus) || hover-radius.has-hover;
                property <bool> grabbed: root.engaged-slider == 1 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-radius := TouchArea { width: 100%; height: 100%; clicked => { } }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 1;
                    focused: radius-wrap.lit;
                    label: "Corner Radius";
                    value: root.radius;
                    min: 0;
                    max: 100;
                    changed(v) => { root.slider-changed(1, v); }
                }
            }

            // Gap In 0-30
            gap-in-wrap := Rectangle {
                property <bool> lit: (root.focused-index == root.split + 2 && root.has-focus) || hover-gap-in.has-hover;
                property <bool> grabbed: root.engaged-slider == 2 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-gap-in := TouchArea { width: 100%; height: 100%; clicked => { } }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 2;
                    focused: gap-in-wrap.lit;
                    label: "Inner Gap";
                    value: root.gap-in;
                    min: 0;
                    max: 30;
                    changed(v) => { root.slider-changed(2, v); }
                }
            }

            // Gap Out 0-30
            gap-out-wrap := Rectangle {
                property <bool> lit: (root.focused-index == root.split + 3 && root.has-focus) || hover-gap-out.has-hover;
                property <bool> grabbed: root.engaged-slider == 3 && root.has-focus;
                height: self.lit ? (self.grabbed ? 112px : 96px) : 80px;
                animate height { duration: 250ms; easing: ease-in-out-back; }
                border-width: 1px;
                border-color: self.grabbed ? #ffffff : (self.lit ? #8fd8ff : HveColors.border);
                border-radius: SkwdTokens.radius-8;
                background: self.grabbed || self.lit ? HveColors.bg-hover : HveColors.bg-card;
                animate background { duration: 200ms; easing: ease-in-out; }
                hover-gap-out := TouchArea { width: 100%; height: 100%; clicked => { } }
                GeometrySlider {
                    width: 100%;
                    y: (parent.height - self.height) / 2;
                    engaged: root.engaged-slider == 3;
                    focused: gap-out-wrap.lit;
                    label: "Outer Gap";
                    value: root.gap-out;
                    min: 0;
                    max: 30;
                    changed(v) => { root.slider-changed(3, v); }
                }
            }

            // Separator
            Rectangle { height: 1px; background: HveColors.border; }

            // Save form: LineEdit + Save button
            VerticalLayout { spacing: 8px; }
            Text {
                text: "Save as Preset";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-14;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }

            HorizontalLayout {
                spacing: SkwdTokens.spacing-8;
                height: 36px;

                save-line-wrap := Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    background: HveColors.bg-card;
                    border-radius: SkwdTokens.radius-8;
                    border-width: save-input.has-focus ? 1px : 0px;
                    border-color: #8fd8ff;

                    save-input := LineEdit {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        placeholder-text: "Border preset name…";
                        text <=> root.preset-name;
                        font-size: SkwdTokens.size-13;
                        accepted(text) => {
                            if (text != "") {
                                root.save-preset(text);
                            }
                        }
                    }
                }

                save-btn := Rectangle {
                    width: 84px;
                    height: 36px;
                    background: save-ta.has-hover ? HveColors.accent-cyan.transparentize(0.2) : HveColors.accent-cyan;
                    border-radius: SkwdTokens.radius-8;

                    Text {
                        text: "Save";
                        color: HveColors.bg-dark;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-13;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    save-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.preset-name != "") {
                                root.save-preset(root.preset-name);
                            }
                        }
                    }
                }
            }

            if root.error-text != "" : Text {
                text: root.error-text;
                color: HveColors.accent-red;
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                wrap: word-wrap;
            }

            // Keyboard hint
            Text {
                text: "↑↓ navigate • ←→ switch panel • Enter apply/engage • arrows ±1 • Esc back";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted.transparentize(0.4);
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// ─── List pane: built-in + user presets. ───
component BordersListPane inherits Rectangle {
    in property <[string]> builtin-names;
    in property <[string]> builtin-tags;
    in property <[string]> user-names;
    in property <[string]> user-tags;
    in property <int> active-index: -1;
    in property <int> focused-index: 0;
    in property <bool> has-focus: false;
    in property <bool> follow: false;
    callback apply-preset(int, string);
    callback open-rename(string);
    callback open-delete(string);

    property <length> saved-scroll-y: 0px;
    // Split index: built-in cards fill 0..builtin-count-1, user cards fill builtin-count..
    property <int> builtin-count: root.builtin-names.length;
    property <int> total-count: root.builtin-names.length + root.user-names.length;
    background: transparent;
    clip: true;

    ScrollView {
        property <length> focus-y: root.focused-index * 66px;
        viewport-y: root.follow ? (root.focused-index >= 0
            ? (0px - max(0px, self.focus-y + 29px - self.height / 2))
            : 0px) : root.saved-scroll-y;
        animate viewport-y { duration: 250ms; easing: ease-out; }
        changed viewport-y => { root.saved-scroll-y = self.viewport-y; }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 8px;

            // Built-in presets header
            if root.builtin-names.length > 0 : Text {
                text: "Built-in";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-12;
                font-weight: 600;
                color: HveColors.text-muted;
            }

            for i in root.builtin-names.length : SavedPresetCard {
                preset-name: root.builtin-names[i];
                is-active: i == root.active-index;
                is-user: false;
                keyboard-focused: root.focused-index == i && root.has-focus;
                accent: #8fd8ff;
                index: i;
                apply-preset(idx, name) => { root.apply-preset(idx, name); }
                refocus() => { }
            }

            // User presets header
            if root.user-names.length > 0 : Rectangle { height: 8px; }
            if root.user-names.length > 0 : Text {
                text: "My Border Presets";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-12;
                font-weight: 600;
                color: HveColors.text-muted;
            }

            for i in root.user-names.length : SavedPresetCard {
                preset-name: root.user-names[i];
                is-active: root.builtin-names.length + i == root.active-index;
                is-user: true;
                keyboard-focused: root.focused-index == root.builtin-names.length + i && root.has-focus;
                accent: HveColors.accent-amber;
                index: root.builtin-names.length + i;
                apply-preset(idx, name) => { root.apply-preset(idx, name); }
                open-rename(name) => { root.open-rename(name); }
                open-delete(name) => { root.open-delete(name); }
                refocus() => { }
            }

            // Empty state
            if root.total-count == 0 : Text {
                text: "No border presets found.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}

// ══════════════════════════════════════════════════════════════════════════════
// BordersSection (exported)
// ══════════════════════════════════════════════════════════════════════════════
export component BordersSection inherits Rectangle {
    // Built-in presets
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    // User presets
    in property <[string]> user-preset-names;
    in property <[string]> user-preset-tags;
    // Active selection
    in property <int> active-index: -1;
    // Keyboard state (owned by PanelRoot)
    in property <int> focused-index: 0;
    in property <int> engaged-slider: -1;
    in property <bool> has-focus: false;
    // Save form error
    in property <string> save-error: "";
    in-out property <string> preset-name: "";
    // Callbacks
    callback apply-border(int, string);
    callback save-border-preset(string);
    callback rename-border-preset(string, string);
    callback delete-border-preset(string);

    // Tune layer — 4 geometry values
    in-out property <int> geom-size: 2;
    in-out property <int> geom-radius: 32;
    in-out property <int> geom-gap-in: 5;
    in-out property <int> geom-gap-out: 5;
    callback apply-geometry(int, int, int, int);
    // Tune pane — dynamic (Unit 2)
    in-out property <string> tune-active-colors: "";
    in-out property <int> tune-color-count: 0;
    in-out property <int> tune-angle: 90;
    in-out property <string> tune-inactive-color: "";
    in-out property <string> tune-glow: "";
    in-out property <string> tune-animations: "";
    in-out property <bool> tune-rule-enabled: false;
    callback tune-changed(string, int, string, string, string, bool);

    background: transparent;
    clip: true;

    // Responsive split from window width (ShellRoot), never root.width.
    in property <bool> two-col: false;
    // split: sliders (4) + save form (1) = 5 items in tune pane
    property <int> split: 5;

    // ── Geometry debounce (R3) ──
    property <bool> size-init: false;
    property <bool> radius-init: false;
    property <bool> gap-in-init: false;
    property <bool> gap-out-init: false;
    property <int> pending-size: root.geom-size;
    property <int> pending-radius: root.geom-radius;
    property <int> pending-gap-in: root.geom-gap-in;
    property <int> pending-gap-out: root.geom-gap-out;
    property <int> last-size: root.geom-size;
    property <int> last-radius: root.geom-radius;
    property <int> last-gap-in: root.geom-gap-in;
    property <int> last-gap-out: root.geom-gap-out;
    property <bool> geom-dirty: false;

    geom-timer := Timer {
        interval: 80ms;
        running: root.geom-dirty;
        triggered => {
            if (root.pending-size != root.last-size || root.pending-radius != root.last-radius || root.pending-gap-in != root.last-gap-in || root.pending-gap-out != root.last-gap-out) {
                root.apply-geometry(root.pending-size, root.pending-radius, root.pending-gap-in, root.pending-gap-out);
                root.last-size = root.pending-size;
                root.last-radius = root.pending-radius;
                root.last-gap-in = root.pending-gap-in;
                root.last-gap-out = root.pending-gap-out;
            }
            root.geom-dirty = false;
        }
    }

    // Slider adjust (keyboard arrows)
    public function adjust-slider(up: bool) {
        if (root.engaged-slider == 0) {
            let next = up ? min(root.geom-size + 1, 5) : max(root.geom-size - 1, 1);
            if (next != root.geom-size) {
                root.geom-size = next;
                if (!root.size-init) { root.size-init = true; return; }
                root.pending-size = next;
                root.geom-dirty = false;
                root.geom-dirty = true;
                geom-timer.restart();
            }
        } else if (root.engaged-slider == 1) {
            let next = up ? min(root.geom-radius + 1, 100) : max(root.geom-radius - 1, 0);
            if (next != root.geom-radius) {
                root.geom-radius = next;
                if (!root.radius-init) { root.radius-init = true; return; }
                root.pending-radius = next;
                root.geom-dirty = false;
                root.geom-dirty = true;
                geom-timer.restart();
            }
        } else if (root.engaged-slider == 2) {
            let next = up ? min(root.geom-gap-in + 1, 30) : max(root.geom-gap-in - 1, 0);
            if (next != root.geom-gap-in) {
                root.geom-gap-in = next;
                if (!root.gap-in-init) { root.gap-in-init = true; return; }
                root.pending-gap-in = next;
                root.geom-dirty = false;
                root.geom-dirty = true;
                geom-timer.restart();
            }
        } else if (root.engaged-slider == 3) {
            let next = up ? min(root.geom-gap-out + 1, 30) : max(root.geom-gap-out - 1, 0);
            if (next != root.geom-gap-out) {
                root.geom-gap-out = next;
                if (!root.gap-out-init) { root.gap-out-init = true; return; }
                root.pending-gap-out = next;
                root.geom-dirty = false;
                root.geom-dirty = true;
                geom-timer.restart();
            }
        }
    }

    // Mouse-direct slider edits
    function slider-changed(id: int, v: int) {
        if (id == 0) {
            if (!root.size-init) { root.size-init = true; return; }
            if (v == root.last-size) { return; }
            root.geom-size = v;
            root.pending-size = v;
            root.geom-dirty = false;
            root.geom-dirty = true;
            geom-timer.restart();
        } else if (id == 1) {
            if (!root.radius-init) { root.radius-init = true; return; }
            if (v == root.last-radius) { return; }
            root.geom-radius = v;
            root.pending-radius = v;
            root.geom-dirty = false;
            root.geom-dirty = true;
            geom-timer.restart();
        } else if (id == 2) {
            if (!root.gap-in-init) { root.gap-in-init = true; return; }
            if (v == root.last-gap-in) { return; }
            root.geom-gap-in = v;
            root.pending-gap-in = v;
            root.geom-dirty = false;
            root.geom-dirty = true;
            geom-timer.restart();
        } else if (id == 3) {
            if (!root.gap-out-init) { root.gap-out-init = true; return; }
            if (v == root.last-gap-out) { return; }
            root.geom-gap-out = v;
            root.pending-gap-out = v;
            root.geom-dirty = false;
            root.geom-dirty = true;
            geom-timer.restart();
        }
    }

    // Sync pending/last when Rust snaps sliders
    changed geom-size => { if (!root.geom-dirty) { root.pending-size = root.geom-size; root.last-size = root.geom-size; } }
    changed geom-radius => { if (!root.geom-dirty) { root.pending-radius = root.geom-radius; root.last-radius = root.geom-radius; } }
    changed geom-gap-in => { if (!root.geom-dirty) { root.pending-gap-in = root.geom-gap-in; root.last-gap-in = root.geom-gap-in; } }
    changed geom-gap-out => { if (!root.geom-dirty) { root.pending-gap-out = root.geom-gap-out; root.last-gap-out = root.geom-gap-out; } }

    VerticalLayout {
        spacing: 0px;

        // Header fixed
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "Borders";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
                color: HveColors.accent-cyan;
            }
            Text {
                text: "Adjust geometry, then save as a preset. Or pick an existing style.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-12;
                color: HveColors.text-muted;
                wrap: word-wrap;
            }
        }

        // Two independent panes. Wide: side by side. Narrow: stacked.
        if root.two-col : HorizontalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            BordersTunePane {
                horizontal-stretch: 1;
                size: root.geom-size;
                radius: root.geom-radius;
                gap-in: root.geom-gap-in;
                gap-out: root.geom-gap-out;
                focused-index: root.focused-index;
                split: 0;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index < root.split;
                error-text: root.save-error;
                preset-name <=> root.preset-name;
                slider-changed(id, v) => { root.slider-changed(id, v); }
                save-preset(name) => { root.save-border-preset(name); }
            }

            Rectangle { width: 1px; background: HveColors.border.transparentize(0.6); }

            BordersListPane {
                horizontal-stretch: 1;
                builtin-names: root.border-titles;
                builtin-tags: root.border-tags;
                user-names: root.user-preset-names;
                user-tags: root.user-preset-tags;
                active-index: root.active-index;
                focused-index: root.focused-index - root.split;
                has-focus: root.has-focus;
                follow: root.focused-index >= root.split;
                apply-preset(idx, name) => { root.apply-border(idx, name); }
                open-rename(name) => { root.rename-border-preset(name, ""); }
                open-delete(name) => { root.delete-border-preset(name); }
            }
        }
        if !root.two-col : VerticalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            BordersTunePane {
                vertical-stretch: 1;
                size: root.geom-size;
                radius: root.geom-radius;
                gap-in: root.geom-gap-in;
                gap-out: root.geom-gap-out;
                focused-index: root.focused-index;
                split: 0;
                has-focus: root.has-focus;
                engaged-slider: root.engaged-slider;
                follow: root.focused-index < root.split;
                error-text: root.save-error;
                preset-name <=> root.preset-name;
                slider-changed(id, v) => { root.slider-changed(id, v); }
                save-preset(name) => { root.save-border-preset(name); }
            }

            Rectangle { height: 1px; background: HveColors.border.transparentize(0.6); }

            BordersListPane {
                vertical-stretch: 1;
                builtin-names: root.border-titles;
                builtin-tags: root.border-tags;
                user-names: root.user-preset-names;
                user-tags: root.user-preset-tags;
                active-index: root.active-index;
                focused-index: root.focused-index - root.split;
                has-focus: root.has-focus;
                follow: root.focused-index >= root.split;
                apply-preset(idx, name) => { root.apply-border(idx, name); }
                open-rename(name) => { root.rename-border-preset(name, ""); }
                open-delete(name) => { root.delete-border-preset(name); }
            }
        }
    }
}
