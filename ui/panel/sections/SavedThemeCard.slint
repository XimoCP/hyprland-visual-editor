// HVE 2 — SavedThemeCard (Save classic restore, tranche A).
//
// 1:1 port of ThemeItem from master:ui/modules.slint (lines ~583-732):
// expand 56px ↔ 100px on active/hover/keyboard-focus, active check badge,
// name + saved-at texts, four action IconButtons (apply ▶ green,
// refresh ↻ purple, rename ✎ amber, delete ✕ red) with tooltips,
// background/border/glow animations. Adapted: imports point at the
// panel tree; geometry, colors and timings kept verbatim.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { IconButton, Tooltip } from "../../components.slint";
import { HveColors } from "../../theme.slint";

export component SavedThemeCard inherits Rectangle {
    in property <string> theme-name;
    in property <string> theme-saved-at;
    in property <bool> is-active: false;
    in property <bool> is-busy: false;
    in property <bool> apply-in-progress: false;
    in property <bool> keyboard-focused: false;
    in property <color> accent;
    in property <string> apply-text;
    in property <string> refresh-text;
    in property <string> rename-text;
    in property <string> delete-text;
    in property <int> index: 0;
    callback apply-theme(string);
    callback open-rename(string);
    callback open-delete(string);
    callback open-refresh(string);
    // Keyboard == mouse (D8): a click on the card BODY moves the keyboard
    // cursor to this card, so arrows continue from where the mouse left off.
    // The apply control is still the ▶ button; the body only converges focus.
    callback focus-requested(int);
    callback mouse-trace(string);
    // Re-seeds the panel-kbd FocusScope after a mouse click so the keyboard
    // keeps working without moving focused-index by itself.
    callback refocus();

    property <bool> is-hovered: card-ta.has-hover || apply-ta.has-hover || ref-btn.has-hover || rn-btn.has-hover || del-btn.has-hover;
    property <bool> _expanded: is-active || is-hovered || keyboard-focused;

    height: _expanded ? 100px : 56px;
    border-radius: 10px;
    background: is-active ? HveColors.bg-hover : (is-hovered || keyboard-focused ? HveColors.bg-hover : HveColors.bg-card);
    border-width: is-active ? 3px : (keyboard-focused ? 1.5px : 1px);
    // Keyboard focus uses the R11 icy-cyan so it never blends with the
    // pink active-theme mark; hover keeps the soft accent tint.
    border-color: (is-active && keyboard-focused) ? HveColors.text : (is-active ? accent : (keyboard-focused ? #8fd8ff : (is-hovered ? accent.transparentize(0.6) : HveColors.border)));
    visible: true;

    // 1. Background layer for the card TouchArea (hover events)
    // Body click: trace + move the keyboard cursor to this card (keyboard ==
    // mouse), then re-seed the panel-kbd scope. The card's own apply control
    // (the ▶ button) is untouched.
    card-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.mouse-trace("save-card-body idx=" + root.index); root.focus-requested(root.index); root.refocus(); }
    }

    // 2. Glow and shadows (visuals)
    drop-shadow-blur: is-active ? 12px : 0px;
    drop-shadow-color: is-active ? accent.transparentize(0.8) : transparent;

    animate background { duration: 200ms; easing: ease-in-out; }
    animate border-color { duration: 200ms; easing: ease-in-out; }
    animate drop-shadow-blur { duration: 300ms; easing: ease-out; }
    animate height { duration: 250ms; easing: ease-in-out-back; }

    // 3. Visual content (main layout)
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        // 1. ACTIVE CHECK (leading, vertically centered)
        if is-active : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 8px;
                background: accent;

                Text {
                    text: "✓";
                    color: HveColors.text;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // 2. TEXT (fills leftover space with horizontal-stretch: 1)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.theme-name;
                color: is-active ? accent : HveColors.text;
                font-size: 14px;
                font-weight: is-active ? 700 : 600;
                overflow: elide;
            }

            if root.theme-saved-at != "" : Text {
                text: root.theme-saved-at;
                color: HveColors.text-muted;
                font-size: 11px;
                overflow: elide;
            }
        }

        // 3. ACTION BUTTONS (trailing, vertically centered)
        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 6px;

                // Apply + active state as ONE toggle button, shaped like the rest
                // of the row: the Save card's actions are 32x32 rounded squares
                // (`IconButton`, radius 8), so the toggle is one too. The colour
                // change carries the on/off state, with the check mark as the
                // second cue, instead of the sliding knob of the pill switch.
                // Busy state preserved: dimmed, and the click is ignored.
                apply-switch := Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: root.is-active ? HveColors.accent-green : HveColors.bg-surface;
                    border-width: 1px;
                    border-color: root.is-active ? HveColors.accent-green : HveColors.border;
                    opacity: (root.is-busy || root.apply-in-progress) ? 0.5 : 1.0;
                    animate background { duration: 250ms; easing: ease-in-out; }
                    animate border-color { duration: 250ms; easing: ease-in-out; }
                    animate opacity { duration: 150ms; easing: ease-out; }

                    Text {
                        text: root.is-active ? "✓" : "";
                        color: HveColors.bg-dark;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    apply-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            if (!(root.is-busy || root.apply-in-progress)) {
                                root.apply-theme(root.theme-name);
                                root.refocus();
                            }
                        }
                    }

                    // The apply square is not an IconButton, so it carries the
                    // help explicitly: the same 300ms hover label its three
                    // siblings get, with the apply text the caller already sends.
                    Tooltip {
                        width: 100%;
                        height: 100%;
                        text: root.apply-text;
                        hovered: apply-ta.has-hover;
                    }
                }

                // Reload / Reset
                ref-btn := IconButton {
                    icon: "↻";
                    bg-color: HveColors.accent-purple;
                    hover-bg-color: HveColors.accent-purple.transparentize(0.2);
                    tooltip-text: root.refresh-text;
                    clicked => { root.open-refresh(root.theme-name); root.refocus(); }
                }

                // Rename
                rn-btn := IconButton {
                    icon: "✎";
                    bg-color: HveColors.accent-amber;
                    hover-bg-color: HveColors.accent-amber.transparentize(0.2);
                    tooltip-text: root.rename-text;
                    clicked => { root.open-rename(root.theme-name); root.refocus(); }
                }

                // Delete
                del-btn := IconButton {
                    icon: "✕";
                    bg-color: #f87171;
                    hover-bg-color: #f87171.transparentize(0.2);
                    tooltip-text: root.delete-text;
                    clicked => { root.open-delete(root.theme-name); root.refocus(); }
                }
            }
        }
    }
}
