// HVE 2 — BorderColorSlot (Unit 3b: interactive Follow-theme swatches).
//
// Shows 6 large token swatches (primary, secondary, tertiary, error,
// surface, surface_lowest) with descriptions. Tapping a swatch writes
// the slot value via `slot-changed(string)`. The resolved swatch
// displays the current token color from HveColors.
//
// Token colors are resolved from HveColors directly — that is the
// established pattern (PanelRoot already imports HveColors). No
// 4-layer plumbing needed for palette colors.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../../tokens.slint";
import { HveColors } from "../../theme.slint";

export component BorderColorSlot inherits Rectangle {
    in property <string> slot-value: "";       // "p:primary" or "c:ff8800ff"
    in property <string> slot-description: ""; // human-readable help text
    in property <bool> editable: false;        // true = interactive swatches
    callback slot-changed(string);             // fires when user picks a swatch

    // True when this slot uses a palette token (p:...) vs custom color (c:...)
    in property <bool> is-token: false;
    in property <bool> is-primary: false;
    in property <bool> is-secondary: false;
    in property <bool> is-tertiary: false;
    in property <bool> is-error: false;
    in property <bool> is-surface: false;
    in property <bool> is-surface-lowest: false;
    // Display label for the value
    in property <string> display-label: "";

    height: 110px;
    background: transparent;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;

        // Label: slot name or current value
        Text {
            text: root.display-label != "" ? root.display-label : root.slot-value;
            font-family: SkwdTokens.font-body;
            font-size: SkwdTokens.size-13;
            font-weight: 600;
            color: HveColors.text;
        }

        // 6 interactive token swatches (Follow-theme mode)
        // Compact sizing: the full row (6 swatches + gaps + padding) must fit
        // narrow tune panes so no label clips.
        if root.editable : HorizontalLayout {
            spacing: 6px;
            alignment: start;

            for token-name in ["primary", "secondary", "tertiary", "error", "surface", "surface_lowest"] : Rectangle {
                width: 46px;
                height: 40px;
                border-radius: SkwdTokens.radius-8;
                background: token-name == "primary" ? HveColors.token-primary
                    : token-name == "secondary" ? HveColors.token-secondary
                    : token-name == "tertiary" ? HveColors.token-tertiary
                    : token-name == "error" ? HveColors.token-error
                    : token-name == "surface" ? HveColors.token-surface
                    : HveColors.token-surface-lowest;
                border-width: 2px;
                border-color: (token-name == "primary" && root.is-primary)
                    || (token-name == "secondary" && root.is-secondary)
                    || (token-name == "tertiary" && root.is-tertiary)
                    || (token-name == "error" && root.is-error)
                    || (token-name == "surface" && root.is-surface)
                    || (token-name == "surface_lowest" && root.is-surface-lowest)
                    ? HveColors.accent-cyan : transparent;

                Text {
                    text: token-name == "surface_lowest" ? "lowest" : token-name;
                    color: HveColors.text;
                    font-family: SkwdTokens.font-body;
                    font-size: 8px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.slot-changed("p:" + token-name); }
                }
            }
        }

        // Description
        if root.slot-description != "" : Text {
            text: root.slot-description;
            font-family: SkwdTokens.font-body;
            font-size: SkwdTokens.size-11;
            color: HveColors.text-muted;
            wrap: word-wrap;
        }
    }
}
