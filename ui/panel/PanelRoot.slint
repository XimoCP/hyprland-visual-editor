// HVE 2 — PanelRoot (mutating-window slice 1 + single-FocusScope keyboard).
//
// Root sheet for the panel's 5 internal sections (R2). Keyboard is owned
// by ONE FocusScope (`panel-kbd`) that wraps the content and dispatches by
// `section` — the HVE 1 pattern. Sections are presentational: they render
// state and report actions, they own no FocusScope and no key handling.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";
import { PanelMenu } from "PanelMenu.slint";
import { AboutItem } from "../components.slint";
import { SaveSection } from "sections/SaveSection.slint";
import { BordersSection } from "sections/BordersSection.slint";
import { MotionSection } from "sections/MotionSection.slint";
import { FiltersSection } from "sections/FiltersSection.slint";
import { SystemSection } from "sections/SystemSection.slint";

export component PanelRoot inherits Rectangle {
    in property <int> section: 0;
    // Responsive breakpoint (from ShellRoot, computed from window width):
    // sections with a natural functional seam render as two panes when true.
    in property <bool> two-col: false;
    in property <bool> mutating: false;
    in property <bool> open: false;
    in property <bool> reduced-motion: false;
    in property <string> theme-name: "My Theme";
    in-out property <string> save-input: "";
    in property <string> save-error: "";
    in property <string> save-placeholder: "Theme name…";
    in property <string> save-button-text: "Save";
    in property <string> save-list-title: "My Themes";
    in property <string> save-search-placeholder: "Search themes...";
    in property <string> save-empty-text: "No themes yet.";
    in property <string> save-apply-text: "Apply";
    in property <string> save-refresh-text: "Refresh";
    in property <string> save-rename-text: "Rename";
    in property <string> save-delete-text: "Delete";
    in-out property <string> save-search-query: "";
    in property <string> save-rename-title: "Rename theme";
    in property <string> save-confirm-delete: "Delete theme";
    in property <string> save-confirm-delete-msg: "Are you sure you want to delete";
    in property <string> save-confirm-refresh: "Refresh theme";
    in property <string> save-confirm-refresh-msg: "This will reload the theme with the current configuration. Continue?";
    in property <string> save-overwrite-title: "Overwrite theme";
    in property <string> save-overwrite-msg: "already exists. Overwrite it with the current setup?";
    in property <string> save-cancel-text: "Cancel";
    in-out property <string> save-dialog-mode: "";
    in-out property <string> save-dialog-target: "";
    in property <int> save-focused-index: -1;
    in property <[string]> save-theme-names;
    in property <[string]> save-theme-saved-ats;
    in property <[bool]> save-theme-is-actives;
    in property <int> save-active-index: -1;
    // Borders pick layer (R3) — PresetCards from scan("borders")
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in property <int> border-active-index: -1;
    in-out property <int> border-size: 2;
    in-out property <int> corner-radius: 32;
    in-out property <int> gap-in: 5;
    in-out property <int> gap-out: 5;
    // Border preset state
    in-out property <string> border-preset-name: "";
    in property <string> border-save-error: "";
    in property <[string]> user-border-preset-names;
    in property <[string]> user-border-preset-tags;
    // Tune pane — dynamic (Unit 2)
    in-out property <[string]> tune-active-colors: [];
    in-out property <int> tune-color-count: 0;
    // Resolved colours (see MainWindow.tune-colors-resolved).
    in-out property <[color]> tune-colors-resolved: [];
    in-out property <int> tune-angle: 90;
    in-out property <string> tune-inactive-color: "";
    in-out property <string> tune-glow: "";
    in-out property <bool> tune-glow-enabled: false;
    in-out property <int> tune-glow-range: 20;
    in-out property <int> tune-glow-render-power: 4;
    in-out property <string> tune-glow-color: "p:primary";
    in-out property <string> tune-glow-color-inactive: "p:surface_lowest";
    in-out property <string> tune-animations: "";
    in-out property <bool> tune-anim-borderangle-enabled: false;
    in-out property <int> tune-anim-borderangle-speed: 30;
    in-out property <string> tune-anim-borderangle-bezier: "default";
    in-out property <string> tune-anim-borderangle-style: "";
    in-out property <bool> tune-anim-border-enabled: false;
    in-out property <int> tune-anim-border-speed: 30;
    in-out property <string> tune-anim-border-bezier: "default";
    in-out property <string> tune-anim-border-style: "";
    in-out property <bool> tune-anim-fadeshadow-enabled: false;
    in-out property <int> tune-anim-fadeshadow-speed: 30;
    in-out property <string> tune-anim-fadeshadow-bezier: "default";
    in-out property <string> tune-anim-fadeshadow-style: "";
    in-out property <[string]> tune-anim-curves: [];
    in-out property <bool> tune-rule-enabled: false;
    // D4 live-vs-saved status flag (see MainWindow.tune-dirty).
    in-out property <bool> tune-dirty: false;
    in-out property <int> tune-editing-slot: -1;
    // Animation preset state
    // Motion pick layer (R4) — 19 cards from scan("animations")
    in property <[string]> anim-titles;
    in property <[string]> anim-descs;
    in property <[string]> anim-tags;
    in property <[string]> anim-files;
    in property <int> anim-active-index: -1;
    in-out property <float> bezier-a: 0.25;
    in-out property <float> bezier-b: 0.1;
    in-out property <float> bezier-c: 0.25;
    in-out property <float> bezier-d: 1.0;
    // Animation preset state
    in-out property <string> animation-preset-name: "";
    in property <string> animation-save-error: "";
    in property <[string]> user-animation-preset-names;
    in property <[string]> user-animation-preset-tags;
    // Filters pick layer (R5) — shader cards from scan("shaders")
    in property <[string]> shader-titles;
    in property <[string]> shader-descs;
    in property <[string]> shader-tags;
    in property <[string]> shader-files;
    in property <int> shader-active-index: -1;
    // System (R7) — reuses SettingsPanel rows + toggle_system + About
    in property <bool> system-active: false;
    in property <bool> auto-minimize: true;
    in property <int> minimize-seconds: 5;
    in property <string> language: "en";
    in property <bool> tiling-mode: false;
    in property <bool> autostart: false;
    in property <string> theme: "system";
    in property <bool> restart-required: false;
    in property <string> settings-title: "System";
    in property <string> restart-banner-text: "⚠ Restart required";
    in property <string> restart-button-text: "Restart";
    in property <string> auto-minimize-label: "Auto-minimize";
    in property <string> timer-label: "Timer:";
    in property <string> language-label: "Language";
    in property <string> tiling-label: "Tiling mode";
    in property <string> autostart-label: "Autostart";
    in property <string> theme-label: "Theme";
    in property <string> reset-label: "Reset presets";
    in property <string> about-title: "About HVE";
    in property <string> about-short: "Hyprland Visual Editor makes your desktop truly yours.";
    in property <string> about-full: "HVE is a graphical app to visually manage your Hyprland desktop aesthetics.";
    in property <[AboutItem]> about-items;
    in property <string> tree-label: "Project structure";
    in property <[string]> tree-paths;
    in property <[string]> tree-descs;
    in property <string> tree-path-max: "";
    in property <string> docs-label: "View documentation";
    callback back();
    callback mouse-trace(string);
    callback focus-trace(string);
    callback section-selected(int);
    callback save-nav(int);
    callback save-focus-requested(int);
    in property <int> kbd-preview-index: -1;
    in property <bool> kbd-preview-engaged: false;
    callback save-theme(string);
    callback apply-saved-theme(int);
    callback rename-saved-theme(string, string);
    callback delete-saved-theme(string);
    callback refresh-saved-theme();
    callback overwrite-saved-theme(string);
    callback save-search-changed(string);
    callback apply-border(int, string);
    callback apply-geometry(int, int, int, int);
    callback apply-animation(int, string);
    callback apply-shader(int, string);
    // Border preset CRUD
    callback save-border-preset(string);
    callback rename-border-preset(string, string);
    callback delete-border-preset(string);
    callback tune-changed([string], int, string, string, string, bool);
    // Border slot management
    callback add-color-slot();
    callback remove-color-slot();
    // Animation preset CRUD
    callback save-animation-preset(string);
    callback rename-animation-preset(string, string);
    callback delete-animation-preset(string);
    callback toggle-system(bool);
    callback toggle-auto-minimize(bool);
    callback change-minimize-seconds(int);
    callback change-language(string);
    callback toggle-tiling-mode(bool);
    callback toggle-autostart(bool);
    callback change-theme(string);
    callback reset-presets();
    callback restart-app();
    callback open-docs();

    // ── Single-FocusScope keyboard state ──────────────────────────────
    // Menu cursor: `menu-active` is true only while the rail owns the
    // keyboard cursor. The panel opens in content mode (`false`); Left in
    // a section returns to the menu, Right/Enter/Space re-enters a section.
    property <bool> menu-active: true;
    property <int> menu-focused-index: 0;
    // Per-section focus state owned by PanelRoot; sections receive it as
    // `in` properties. Keyboard never uses these to steal Slint focus.
    in-out property <int> borders-focused-index: 0;
    in-out property <int> borders-engaged-slider: -1;
    // Cards-first Borders sequence: list cards then every tune stop.
    property <int> borders-list-len: root.border-files.length + root.user-border-preset-names.length;
    property <int> borders-total: root.borders-list-len + borders.tune-count;
    in-out property <int> motion-focused-index: 0;
    in-out property <int> motion-engaged-slider: -1;
    in-out property <int> filters-focused-index: 0;
    in-out property <int> system-focused-row: 0;
    in-out property <bool> system-about-expanded: false;
    // Compound-row engagement: when true, ← / → pick an option inside the
    // focused System row (timer / language / theme) instead of jumping
    // panels. Enter engages, Esc (or ↑ / ↓) exits. Same "grabbed" model as
    // the Borders/Motion sliders, keyed on a bool because the cursor only
    // ever moves within the row it was engaged on.
    in-out property <bool> system-option-engaged: false;

    // Maps the Slint 1.17 FocusReason enum to a short --verbose tag.
    function focus-reason-label(reason: FocusReason) -> string {
        if (reason == FocusReason.programmatic) { return "programmatic"; }
        if (reason == FocusReason.tab-navigation) { return "tab-navigation"; }
        if (reason == FocusReason.pointer-click) { return "pointer-click"; }
        if (reason == FocusReason.popup-activation) { return "popup-activation"; }
        if (reason == FocusReason.window-activation) { return "window-activation"; }
        return "unknown";
    }

    // The panel always opens in content mode with the cursor on the active
    // section. Re-opening the same section re-seeds it. `changed section`
    // also covers Rust moving the section directly (menu selection emits
    // section-selected first, so both ends land on the same state).
    init => { root.menu-focused-index = root.section; root.menu-active = false; root.system-option-engaged = false; }
    changed open => {
        if (self.open) {
            root.menu-focused-index = root.section;
            root.menu-active = false;
            root.system-option-engaged = false;
            panel-kbd.focus();
        }
    }
    changed section => {
        root.menu-focused-index = root.section;
        // Rail preview commits the section while the rail keeps the cursor, so
        // a section change coming from the rail must NOT reclaim the keyboard.
        // Only a content-mode change (Rust moving the section directly) does.
        // When the panel closes, `section` resets to 0 (PanelState::Closed has
        // no section), and an unconditional focus() here would steal focus back
        // from shell-kbd — leaving the Gallery keyboard dead.
        if (!root.menu-active) {
            root.system-option-engaged = false;
            if (root.open) { panel-kbd.focus(); }
        }
    }

    background: HveColors.bg-dark;
    // Full-bleed: the panel fills the HVE slot while it is open, so it has no
    // corners of its own to round — rounding them would show the surface
    // behind and read as a card again (see the panel container in shell.slint).
    border-radius: 0;
    clip: true;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // Header
        Rectangle {
            height: 56px;
            background: HveColors.bg-card;
            HorizontalLayout {
                padding-left: SkwdTokens.spacing-16;
                padding-right: SkwdTokens.spacing-16;
                spacing: SkwdTokens.spacing-12;
                alignment: center;
                Text {
                    text: "▸ " + root.theme-name;
                    font-family: SkwdTokens.font-heading;
                    font-size: SkwdTokens.size-16;
                    font-weight: 700;
                    color: HveColors.accent-cyan;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "Esc to return";
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: HveColors.text-muted;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: SkwdTokens.border-1; background: HveColors.border; }

        HorizontalLayout {
            width: 100%;
            height: 100%;
            vertical-stretch: 1;
            spacing: 0px;

            // Left rail — presentational; PanelRoot's panel-kbd drives it.
            menu := PanelMenu {
                width: 160px;
                active-section: root.section;
                reduced-motion: root.reduced-motion;
                menu-active: root.menu-active;
                focused-index: root.menu-focused-index;
                preview-index: root.kbd-preview-index;
                section-selected(section) => {
                    root.section-selected(section);
                    root.menu-focused-index = section;
                    root.menu-active = false;
                }
            }

            Rectangle { width: 1px; background: HveColors.border.transparentize(0.6); }

            // Content area — panel-kbd is the ONE FocusScope for the whole
            // panel (menu + content). It wraps the sections so key events
            // rejected by focusable widgets (e.g. Save's LineEdit) bubble
            // up to it. All keyboard dispatch lives here.
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: HveColors.bg-dark;
                clip: true;
                // While the rail owns the cursor the content steps back, so
                // "I am in the rail" vs "I am in the content" is obvious.
                opacity: root.menu-active ? 0.55 : 1.0;
                animate opacity { duration: 160ms; easing: ease-out; }

                panel-kbd := FocusScope {
                    width: 100%;
                    height: 100%;
                    // Mouse never moves keyboard focus: a click that lands on
                    // a TouchArea must not be consumed to re-grab focus (the
                    // Slint default would eat the first press when this scope
                    // lost focus, e.g. after the Save LineEdit took it). Focus
                    // is seeded programmatically (init / changed open / changed
                    // section).
                    focus-on-click: false;
                    init => { panel-kbd.focus(); }
                    focus-gained(reason) => { root.focus-trace("panel-kbd gained via " + root.focus-reason-label(reason)); }
                    focus-lost(reason) => { root.focus-trace("panel-kbd lost via " + root.focus-reason-label(reason)); }
                    key-pressed(event) => {
                        if (event.text == Key.Tab) { return reject; }

                        // ── Menu mode: the rail owns the keyboard cursor ──
                        if (root.menu-active) {
                            if (event.text == Key.Escape) { root.back(); return accept; }
                            if (event.text == Key.DownArrow) {
                                if (root.menu-focused-index >= 4) { root.menu-focused-index = 0; }
                                else { root.menu-focused-index += 1; }
                                // Live preview: the content follows the rail
                                // cursor without needing Enter.
                                root.section-selected(root.menu-focused-index);
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                if (root.menu-focused-index <= 0) { root.menu-focused-index = 4; }
                                else { root.menu-focused-index -= 1; }
                                root.section-selected(root.menu-focused-index);
                                return accept;
                            }
                            if (event.text == Key.RightArrow || event.text == Key.Return || event.text == Key.Space) {
                                root.section-selected(root.menu-focused-index);
                                root.menu-active = false;
                                // Entering content always lands on the FIRST block, so
                                // Right advances exactly one panel: menu -> A -> B.
                                if (root.menu-focused-index == 1) { root.borders-focused-index = 0; }
                                else if (root.menu-focused-index == 2) { root.motion-focused-index = 0; }
                                else if (root.menu-focused-index == 3) { root.filters-focused-index = 0; }
                                else if (root.menu-focused-index == 4) { root.system-focused-row = 0; root.system-option-engaged = false; }
                                return accept;
                            }
                            return reject;
                        }

                        // ── Content mode: dispatch to the active section ──
                        if (root.section == 0) {
                            // Save: Down/Up → save-nav, Enter → apply, Left → menu
                            if (event.text == Key.Escape) {
                                // An open dialog eats Esc (close dialog only).
                                if (root.save-dialog-mode != "") { root.save-dialog-mode = ""; }
                                else { root.back(); }
                                return accept;
                            }
                            if (event.text == Key.DownArrow) { root.save-nav(1); return accept; }
                            if (event.text == Key.UpArrow) { root.save-nav(-1); return accept; }
                            if (event.text == Key.LeftArrow) { root.menu-active = true; return accept; }
                            if (event.text == Key.Return || event.text == Key.Space) {
                                if (root.save-focused-index >= 0 && root.save-focused-index < root.save-theme-names.length) {
                                    root.apply-saved-theme(root.save-focused-index);
                                }
                                return accept;
                            }
                            return reject;
                        }
                        if (root.section == 1) {
                            // Borders: Down/Up walk cards + EVERY tune stop top to
                            // bottom, then wrap. Return/Space engages slider-like
                            // stops (arrows adjust, clamped); other stops act
                            // at once. Tune order: size, angle, inactive, slots,
                            // add/remove, glow group, 3 anim leaves, rule, save.
                            if (event.text == Key.Escape) {
                                if (root.tune-editing-slot >= 0) { root.tune-editing-slot = -1; }
                                else if (root.borders-engaged-slider >= 0) { root.borders-engaged-slider = -1; }
                                else { root.back(); }
                                return accept;
                            }
                            // Picker open: it owns the arrows (task 3.7). Up/Down
                            // pick one of its four controls (Saturation,
                            // Brightness, Hue, Alpha), Left/Right change it. It is
                            // a sub-mode of an engaged colour stop, so it must be
                            // tested BEFORE the engaged branch below — the stop
                            // stays engaged the whole time the picker is open, and
                            // otherwise the arrows would cycle the palette token
                            // behind the picker instead of the colour being edited.
                            // Esc (above) closes the picker first.
                            if (borders.picker-open()) {
                                if (event.text == Key.DownArrow) { borders.picker-move(1); return accept; }
                                if (event.text == Key.UpArrow) { borders.picker-move(-1); return accept; }
                                if (event.text == Key.RightArrow) { borders.picker-adjust(true); return accept; }
                                if (event.text == Key.LeftArrow) { borders.picker-adjust(false); return accept; }
                                return accept;
                            }
                            if (root.borders-engaged-slider >= 0) {
                                if (event.text == Key.RightArrow) { borders.adjust-slider(true); return accept; }
                                if (event.text == Key.LeftArrow) { borders.adjust-slider(false); return accept; }
                                // ↑/↓ exit the engagement and move (same rule
                                // as the System compound rows); Enter/Space exits.
                                if (event.text == Key.DownArrow) {
                                    root.borders-engaged-slider = -1;
                                    if (root.borders-total > 0) {
                                        if (root.borders-focused-index >= root.borders-total - 1) { root.borders-focused-index = 0; }
                                        else { root.borders-focused-index += 1; }
                                    }
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.borders-engaged-slider = -1;
                                    if (root.borders-total > 0) {
                                        if (root.borders-focused-index <= 0) { root.borders-focused-index = root.borders-total - 1; }
                                        else { root.borders-focused-index -= 1; }
                                    }
                                    return accept;
                                }
                                // Return/Space on an engaged stop does NOT simply
                                // un-engage: for a colour stop the section turns
                                // it into "open the picker". That branch used to
                                // be unreachable, because this line un-engaged
                                // first — which is why the picker could be opened
                                // by mouse only, however often "Enter opens the
                                // picker" was claimed in the task list.
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    if (borders.tune-enter() == 0) { root.borders-engaged-slider = -1; }
                                    return accept;
                                }
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                if (root.borders-total > 0) {
                                    if (root.borders-focused-index >= root.borders-total - 1) { root.borders-focused-index = 0; }
                                    else { root.borders-focused-index += 1; }
                                }
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                if (root.borders-total > 0) {
                                    if (root.borders-focused-index <= 0) { root.borders-focused-index = root.borders-total - 1; }
                                    else { root.borders-focused-index -= 1; }
                                }
                                return accept;
                            }
                            if (event.text == Key.RightArrow) {
                                // Visual order is [rail] [preset list] [tune], which
                                // now agrees with the cards-first index order: right
                                // walks towards the tune block.
                                if (root.borders-list-len > 0 && root.borders-focused-index < root.borders-list-len) {
                                    root.borders-focused-index = root.borders-list-len;
                                }
                                return accept;
                            }
                            if (event.text == Key.LeftArrow) {
                                // Left walks back to the presets, then out to the rail.
                                if (root.borders-list-len > 0 && root.borders-focused-index >= root.borders-list-len) {
                                    root.borders-focused-index = 0;
                                } else {
                                    root.menu-active = true;
                                }
                                return accept;
                            }
                            if (event.text == Key.Return || event.text == Key.Space) {
                                if (root.borders-focused-index < root.borders-list-len) {
                                    if (root.borders-focused-index < root.border-files.length && root.border-files.length > 0) {
                                        root.apply-border(root.borders-focused-index, root.border-files[root.borders-focused-index]);
                                    } else if (root.borders-focused-index >= 0) {
                                        root.apply-border(root.borders-focused-index, root.user-border-preset-names[root.borders-focused-index - root.border-files.length]);
                                    }
                                } else {
                                    if (borders.tune-enter() == 0) {
                                        root.borders-engaged-slider = root.borders-focused-index - root.borders-list-len;
                                    }
                                }
                                return accept;
                            }
                            return reject;
                        }
                        if (root.section == 2) {
                            // Motion: same pattern as Borders with bezier sliders.
                            if (event.text == Key.Escape) {
                                if (root.motion-engaged-slider >= 0) { root.motion-engaged-slider = -1; }
                                else { root.back(); }
                                return accept;
                            }
                            if (root.motion-engaged-slider >= 0) {
                                if (event.text == Key.RightArrow) { motion.adjust-slider(true); return accept; }
                                if (event.text == Key.LeftArrow) { motion.adjust-slider(false); return accept; }
                                // ↑/↓ exit the engagement and move the row (same
                                // rule as the System compound rows); Enter/Space exits.
                                if (event.text == Key.DownArrow) {
                                    root.motion-engaged-slider = -1;
                                    if (root.anim-files.length + 4 > 0) {
                                        if (root.motion-focused-index >= root.anim-files.length + 3) { root.motion-focused-index = 0; }
                                        else { root.motion-focused-index += 1; }
                                    }
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.motion-engaged-slider = -1;
                                    if (root.anim-files.length + 4 > 0) {
                                        if (root.motion-focused-index <= 0) { root.motion-focused-index = root.anim-files.length + 3; }
                                        else { root.motion-focused-index -= 1; }
                                    }
                                    return accept;
                                }
                                if (event.text == Key.Return || event.text == Key.Space) { root.motion-engaged-slider = -1; return accept; }
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                if (root.anim-files.length + 4 > 0) {
                                    if (root.motion-focused-index >= root.anim-files.length + 3) { root.motion-focused-index = 0; }
                                    else { root.motion-focused-index += 1; }
                                }
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                if (root.anim-files.length + 4 > 0) {
                                    if (root.motion-focused-index <= 0) { root.motion-focused-index = root.anim-files.length + 3; }
                                    else { root.motion-focused-index -= 1; }
                                }
                                return accept;
                            }
                            if (event.text == Key.RightArrow) {
                                // Same as Borders: the preset list is the LEFT
                                // pane, so right walks towards the tune block.
                                if (root.anim-files.length > 0 && root.motion-focused-index < root.anim-files.length) {
                                    root.motion-focused-index = root.anim-files.length;
                                }
                                return accept;
                            }
                            if (event.text == Key.LeftArrow) {
                                // Left walks back to the presets, then out to the rail.
                                if (root.anim-files.length > 0 && root.motion-focused-index >= root.anim-files.length) {
                                    root.motion-focused-index = 0;
                                } else {
                                    root.menu-active = true;
                                }
                                return accept;
                            }
                            if (event.text == Key.Return || event.text == Key.Space) {
                                if (root.motion-focused-index < root.anim-files.length) {
                                    if (root.motion-focused-index >= 0 && root.anim-files.length > 0) {
                                        root.apply-animation(root.motion-focused-index, root.anim-files[root.motion-focused-index]);
                                    }
                                } else {
                                    root.motion-engaged-slider = root.motion-focused-index - root.anim-files.length;
                                }
                                return accept;
                            }
                            return reject;
                        }
                        if (root.section == 3) {
                            // Filters: Down/Up walk cards, Enter applies.
                            if (event.text == Key.Escape) { root.back(); return accept; }
                            if (event.text == Key.DownArrow) {
                                if (root.shader-files.length > 0) {
                                    if (root.filters-focused-index >= root.shader-files.length - 1) { root.filters-focused-index = 0; }
                                    else { root.filters-focused-index += 1; }
                                }
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                if (root.shader-files.length > 0) {
                                    if (root.filters-focused-index <= 0) { root.filters-focused-index = root.shader-files.length - 1; }
                                    else { root.filters-focused-index -= 1; }
                                }
                                return accept;
                            }
                            if (event.text == Key.LeftArrow) { root.menu-active = true; return accept; }
                            if (event.text == Key.Return || event.text == Key.Space) {
                                if (root.filters-focused-index >= 0 && root.filters-focused-index < root.shader-files.length) {
                                    root.apply-shader(root.filters-focused-index, root.shader-files[root.filters-focused-index]);
                                }
                                return accept;
                            }
                            return reject;
                        }
                        if (root.section == 4) {
                            // System: Down/Up walk rows, Enter toggles/engages,
                            // Left → menu. Compound rows (timer/language/theme)
                            // engage: then ←/→ pick an option and ↑/↓ or Esc exit.
                            if (event.text == Key.Escape) {
                                if (root.system-option-engaged) { root.system-option-engaged = false; }
                                else { root.back(); }
                                return accept;
                            }
                            if (root.system-option-engaged) {
                                if (event.text == Key.RightArrow) { system.move-option(true); return accept; }
                                if (event.text == Key.LeftArrow) { system.move-option(false); return accept; }
                                if (event.text == Key.DownArrow) {
                                    root.system-option-engaged = false;
                                    if (root.system-focused-row >= (root.restart-required ? 7 : 6)) { root.system-focused-row = 0; }
                                    else { root.system-focused-row += 1; }
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.system-option-engaged = false;
                                    if (root.system-focused-row <= 0) { root.system-focused-row = root.restart-required ? 7 : 6; }
                                    else { root.system-focused-row -= 1; }
                                    return accept;
                                }
                                if (event.text == Key.Return || event.text == Key.Space) { root.system-option-engaged = false; return accept; }
                                return accept;
                            }
                            if (event.text == Key.RightArrow) {
                                // Jump one panel right: settings rows → About block.
                                if (root.system-focused-row < (root.restart-required ? 7 : 6)) {
                                    root.system-focused-row = root.restart-required ? 7 : 6;
                                }
                                return accept;
                            }
                            if (event.text == Key.LeftArrow) {
                                // Jump one panel left: About block → settings rows → menu.
                                root.system-option-engaged = false;
                                if (root.system-focused-row >= (root.restart-required ? 7 : 6)) {
                                    root.system-focused-row = 0;
                                } else {
                                    root.menu-active = true;
                                }
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                if (root.system-focused-row >= (root.restart-required ? 7 : 6)) { root.system-focused-row = 0; }
                                else { root.system-focused-row += 1; }
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                if (root.system-focused-row <= 0) { root.system-focused-row = root.restart-required ? 7 : 6; }
                                else { root.system-focused-row -= 1; }
                                return accept;
                            }
                            if (event.text == Key.Return || event.text == Key.Space) {
                                if (root.system-focused-row == 0) { root.toggle-system(!root.system-active); }
                                else if (root.system-focused-row == 1) { root.toggle-auto-minimize(!root.auto-minimize); }
                                else if (root.system-focused-row == 2) {
                                    // Timer chips: engage and pick with ←/→ (only
                                    // when the chips are actually rendered).
                                    if (root.auto-minimize) { root.system-option-engaged = true; }
                                }
                                else if (root.system-focused-row == 3) { root.system-option-engaged = true; }
                                else if (root.system-focused-row == 4) { root.toggle-autostart(!root.autostart); }
                                else if (root.system-focused-row == 5) { root.system-option-engaged = true; }
                                else if (root.system-focused-row == 6) {
                                    if (root.restart-required) { root.restart-app(); }
                                    else { root.system-about-expanded = !root.system-about-expanded; }
                                }
                                else if (root.system-focused-row == 7) { root.system-about-expanded = !root.system-about-expanded; }
                                return accept;
                            }
                            return reject;
                        }
                        return reject;
                    }

                    save := SaveSection {
                        visible: root.section == 0;
                        width: 100%;
                        height: 100%;
                        two-col: root.two-col;
                        theme-name <=> root.save-input;
                        error-text: root.save-error;
                        placeholder: root.save-placeholder;
                        save-label: root.save-button-text;
                        list-title: root.save-list-title;
                        search-placeholder: root.save-search-placeholder;
                        empty-text: root.save-empty-text;
                        apply-text: root.save-apply-text;
                        refresh-text: root.save-refresh-text;
                        rename-text: root.save-rename-text;
                        delete-text: root.save-delete-text;
                        search-query <=> root.save-search-query;
                        dialog-mode <=> root.save-dialog-mode;
                        dialog-target <=> root.save-dialog-target;
                        focused-index: root.save-focused-index;
                        has-focus: panel-kbd.has-focus && !root.menu-active;
                        rename-title: root.save-rename-title;
                        confirm-delete: root.save-confirm-delete;
                        confirm-delete-msg: root.save-confirm-delete-msg;
                        confirm-refresh: root.save-confirm-refresh;
                        confirm-refresh-msg: root.save-confirm-refresh-msg;
                        overwrite-title: root.save-overwrite-title;
                        overwrite-msg: root.save-overwrite-msg;
                        cancel-text: root.save-cancel-text;
                        saved-names: root.save-theme-names;
                        saved-ats: root.save-theme-saved-ats;
                        saved-actives: root.save-theme-is-actives;
                        saved-active-index: root.save-active-index;
                        save-theme(name) => { root.save-theme(name); }
                        apply-saved-theme(idx) => { root.apply-saved-theme(idx); }
                        rename-theme(old, new) => { root.rename-saved-theme(old, new); }
                        delete-theme(name) => { root.delete-saved-theme(name); }
                        refresh-theme() => { root.refresh-saved-theme(); }
                        overwrite-theme(name) => { root.overwrite-saved-theme(name); }
                        search-query-changed(q) => { root.save-search-changed(q); }
                        save-nav(d) => { root.save-nav(d); }
                        mouse-trace(reason) => { root.mouse-trace(reason); }
                        focus-requested(idx) => { root.save-focus-requested(idx); }
                    }
                    borders := BordersSection {
                        visible: root.section == 1;
                        width: 100%;
                        height: 100%;
                        two-col: root.two-col;
                        border-titles: root.border-titles;
                        border-descs: root.border-descs;
                        border-tags: root.border-tags;
                        border-files: root.border-files;
                        active-index: root.border-active-index;
                        focused-index: root.kbd-preview-index >= 0 ? root.kbd-preview-index : root.borders-focused-index;
                        engaged-slider: root.kbd-preview-engaged ? (root.kbd-preview-index >= root.border-files.length + root.user-border-preset-names.length ? root.kbd-preview-index - root.border-files.length - root.user-border-preset-names.length : 0) : root.borders-engaged-slider;
                        has-focus: (panel-kbd.has-focus && !root.menu-active) || root.kbd-preview-index >= 0;
                        geom-size <=> root.border-size;
                        geom-radius <=> root.corner-radius;
                        geom-gap-in <=> root.gap-in;
                        geom-gap-out <=> root.gap-out;
                        apply-border(idx, file) => { root.apply-border(idx, file); }
                        apply-geometry(size, radius, gap-in, gap-out) => { root.apply-geometry(size, radius, gap-in, gap-out); }
                        save-border-preset(name) => { root.save-border-preset(name); }
                        rename-border-preset(old, new) => { root.rename-border-preset(old, new); }
                        delete-border-preset(name) => { root.delete-border-preset(name); }
                        save-error: root.border-save-error;
                        preset-name <=> root.border-preset-name;
                        user-preset-names: root.user-border-preset-names;
                        user-preset-tags: root.user-border-preset-tags;
                        tune-active-colors <=> root.tune-active-colors;
                        tune-color-count <=> root.tune-color-count;
                        tune-colors-resolved <=> root.tune-colors-resolved;
                        tune-angle <=> root.tune-angle;
                        tune-inactive-color <=> root.tune-inactive-color;
                        tune-glow <=> root.tune-glow;
                        tune-glow-enabled <=> root.tune-glow-enabled;
                        tune-glow-range <=> root.tune-glow-range;
                        tune-glow-render-power <=> root.tune-glow-render-power;
                        tune-glow-color <=> root.tune-glow-color;
                        tune-glow-color-inactive <=> root.tune-glow-color-inactive;
                        tune-animations <=> root.tune-animations;
                        tune-anim-borderangle-enabled <=> root.tune-anim-borderangle-enabled;
                        tune-anim-borderangle-speed <=> root.tune-anim-borderangle-speed;
                        tune-anim-borderangle-bezier <=> root.tune-anim-borderangle-bezier;
                        tune-anim-borderangle-style <=> root.tune-anim-borderangle-style;
                        tune-anim-border-enabled <=> root.tune-anim-border-enabled;
                        tune-anim-border-speed <=> root.tune-anim-border-speed;
                        tune-anim-border-bezier <=> root.tune-anim-border-bezier;
                        tune-anim-border-style <=> root.tune-anim-border-style;
                        tune-anim-fadeshadow-enabled <=> root.tune-anim-fadeshadow-enabled;
                        tune-anim-fadeshadow-speed <=> root.tune-anim-fadeshadow-speed;
                        tune-anim-fadeshadow-bezier <=> root.tune-anim-fadeshadow-bezier;
                        tune-anim-fadeshadow-style <=> root.tune-anim-fadeshadow-style;
                        tune-anim-curves <=> root.tune-anim-curves;
                        tune-rule-enabled <=> root.tune-rule-enabled;
                        tune-dirty <=> root.tune-dirty;
                        editing-slot <=> root.tune-editing-slot;
                        tune-changed(colors, angle, inactive, glow, anims, rule) => { root.tune-changed(colors, angle, inactive, glow, anims, rule); }
                        add-color-slot => { root.add-color-slot(); }
                        remove-color-slot => { root.remove-color-slot(); }
                    }
                    motion := MotionSection {
                        visible: root.section == 2;
                        width: 100%;
                        height: 100%;
                        two-col: root.two-col;
                        anim-titles: root.anim-titles;
                        anim-descs: root.anim-descs;
                        anim-tags: root.anim-tags;
                        anim-files: root.anim-files;
                        active-index: root.anim-active-index;
                        focused-index: root.kbd-preview-index >= 0 ? root.kbd-preview-index : root.motion-focused-index;
                        engaged-slider: root.kbd-preview-engaged ? root.kbd-preview-index : root.motion-engaged-slider;
                        has-focus: (panel-kbd.has-focus && !root.menu-active) || root.kbd-preview-index >= 0;
                        bezier-a <=> root.bezier-a;
                        bezier-b <=> root.bezier-b;
                        bezier-c <=> root.bezier-c;
                        bezier-d <=> root.bezier-d;
                        apply-animation(idx, file) => { root.apply-animation(idx, file); }
                        save-animation-preset(name) => { root.save-animation-preset(name); }
                        rename-animation-preset(old, new) => { root.rename-animation-preset(old, new); }
                        delete-animation-preset(name) => { root.delete-animation-preset(name); }
                        save-error: root.animation-save-error;
                        preset-name <=> root.animation-preset-name;
                        user-preset-names: root.user-animation-preset-names;
                        user-preset-tags: root.user-animation-preset-tags;
                    }
                    filters := FiltersSection {
                        visible: root.section == 3;
                        width: 100%;
                        height: 100%;
                        shader-titles: root.shader-titles;
                        shader-descs: root.shader-descs;
                        shader-tags: root.shader-tags;
                        shader-files: root.shader-files;
                        active-index: root.shader-active-index;
                        focused-index: root.kbd-preview-index >= 0 ? root.kbd-preview-index : root.filters-focused-index;
                        has-focus: (panel-kbd.has-focus && !root.menu-active) || root.kbd-preview-index >= 0;
                        apply-shader(idx, file) => { root.apply-shader(idx, file); }
                    }
                    system := SystemSection {
                        visible: root.section == 4;
                        width: 100%;
                        height: 100%;
                        two-col: root.two-col;
                        system-active: root.system-active;
                        auto-minimize: root.auto-minimize;
                        minimize-seconds: root.minimize-seconds;
                        language: root.language;
                        tiling-mode: root.tiling-mode;
                        autostart: root.autostart;
                        theme: root.theme;
                        restart-required: root.restart-required;
                        settings-title: root.settings-title;
                        restart-banner-text: root.restart-banner-text;
                        restart-button-text: root.restart-button-text;
                        auto-minimize-label: root.auto-minimize-label;
                        timer-label: root.timer-label;
                        language-label: root.language-label;
                        tiling-label: root.tiling-label;
                        autostart-label: root.autostart-label;
                        theme-label: root.theme-label;
                        reset-label: root.reset-label;
                        about-title: root.about-title;
                        about-short: root.about-short;
                        about-full: root.about-full;
                        about-items: root.about-items;
                        tree-label: root.tree-label;
                        tree-paths: root.tree-paths;
                        tree-descs: root.tree-descs;
                        tree-path-max: root.tree-path-max;
                        docs-label: root.docs-label;
                        focused-row: root.system-focused-row;
                        option-engaged: root.system-option-engaged;
                        has-focus: panel-kbd.has-focus && !root.menu-active;
                        about-expanded <=> root.system-about-expanded;
                        toggle-system(v) => { root.toggle-system(v); }
                        toggle-auto-minimize(v) => { root.toggle-auto-minimize(v); }
                        change-minimize-seconds(v) => { root.change-minimize-seconds(v); }
                        change-language(v) => { root.change-language(v); }
                        toggle-tiling-mode(v) => { root.toggle-tiling-mode(v); }
                        toggle-autostart(v) => { root.toggle-autostart(v); }
                        change-theme(v) => { root.change-theme(v); }
                        reset-presets => { root.reset-presets(); }
                        restart-app => { root.restart-app(); }
                        open-docs => { root.open-docs(); }
                    }
                    if root.section != 0 && root.section != 1 && root.section != 2 && root.section != 3 && root.section != 4 : VerticalLayout {
                        width: 100%;
                        height: 100%;
                        alignment: center;
                        spacing: SkwdTokens.spacing-12;
                        Text {
                            text: ["Save","Borders","Motion","Filters","System"][root.section];
                            font-family: SkwdTokens.font-heading;
                            font-size: SkwdTokens.size-24;
                            color: HveColors.accent-cyan;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Section placeholder — slice 1 skeleton";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            color: HveColors.text-muted;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            height: 40px;
                            width: 160px;
                            background: HveColors.accent-cyan.transparentize(0.85);
                            border-radius: SkwdTokens.radius-8;
                            horizontal-stretch: 0;
                            x: (parent.width - self.width) / 2;
                            Text {
                                text: "Back to Gallery";
                                font-family: SkwdTokens.font-body;
                                font-size: SkwdTokens.size-13;
                                color: HveColors.accent-cyan;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.back(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
