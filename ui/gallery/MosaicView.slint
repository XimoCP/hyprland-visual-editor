// HVE 2 — MosaicView (theme-gallery PR3 3.7-3.8; masonry spans in PR5).
//
// Pinterest-adapted span mosaic: modules of 5 cards on a 6col × 2row grid
// (base cell 160px → module 960×320), slot 0 square 2×2, slots 1-4 rects
// 2×1. GridLayout cannot express computed spans (compile-time constants
// only), so every card gets manual x/y/width/height from index arithmetic —
// the same technique as SliceCarousel's manual-x row. Dual-stripe infinite
// scroll, kinetic 0.90 (16ms), staggered reveal per cellKey unchanged.
// Translated from skwd-wall Mosaic (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { MosaicCell } from "MosaicCell.slint";
import { GalleryCardData } from "ThemeCardDelegate.slint";

export component MosaicView inherits Rectangle {
    in property <length> scroll-offset: 0px;
    in property <length> viewport-w: 1500px;
    // Real card data (gallery-immersive-redesign 4.8): cards drive the
    // masonry repeaters; out-of-range indices yield default (empty) images.
    in property <[GalleryCardData]> cards;
    in property <int> item-count: 0;
    callback cell-clicked(int);
    callback cell-flip(int);

    width: 1500px;
    height: 800px;
    clip: true;
    background: SkwdTokens.surface;

    // ── Masonry geometry (PR5): pure fns MIRROR mosaic.rs::mosaic_* ──
    // slot tables — keep both sides in parity. Numbers: base cell 160,
    // module 6cols × 2rows = 960×320, colspan constant 2. NOTE: `/` is
    // FLOAT division in Slint, so the module index uses Math.floor and the
    // slot is derived without `%`.
    pure function slot-of(idx: int) -> int {
        idx - Math.floor(idx / 5) * 5
    }
    pure function slot-col(slot: int) -> length {
        if (slot <= 0) { return 0px; }
        if (slot == 1 || slot == 3) { return 320px; }
        return 640px;
    }
    pure function card-x(idx: int) -> length {
        Math.floor(idx / 5) * 960px + self.slot-col(self.slot-of(idx))
    }
    pure function card-y(idx: int) -> length {
        self.slot-of(idx) >= 3 ? 160px : 0px
    }
    // Square slot 0 → rowspan 2 (320), rect slots → 160. Width is constant:
    // colspan 2 × 160 = 320 for every slot.
    pure function card-h(slot: int) -> length { slot == 0 ? 320px : 160px }

    // Masonry strip height = 2 rows × 160, vertically centered in the stage.
    property <length> strip-h: 320px;

    // kinetic 0.90 state driven by Rust tick every 16ms; Slint mirrors offset with 16ms timer
    property <length> stripe-a-x: - root.scroll-offset;
    property <length> stripe-b-x: - root.scroll-offset + root.viewport-w;
    animate stripe-a-x { duration: 16ms; easing: linear; }
    animate stripe-b-x { duration: 16ms; easing: linear; }

    // dual-stripe tiling for infinite horizontal scroll (spec R2.3):
    // stripe A hosts the gallery masonry; stripe B repeats it one viewport
    // to the right as the tiling continuation (same mechanism as before).
    stripe-a := Rectangle {
        x: root.stripe-a-x;
        y: (parent.height - root.strip-h) / 2;
        width: root.viewport-w;
        height: root.strip-h;
        for card[idx] in root.cards : MosaicCell {
            x: root.card-x(idx);
            y: root.card-y(idx);
            width: 320px; // colspan 2 × base cell 160 (mosaic.rs MOSAIC_SLOT_COLSPAN)
            height: root.card-h(root.slot-of(idx));
            cell-key: idx;
            reveal-delay: (idx - Math.floor(idx / 15) * 15) * 40ms; // mirrors reveal_delay_for 600ms wrap
            image-alpha: 1.0;
            cloud-opacity: 1.0;
            thumb: card.thumb;
            clicked => { root.cell-clicked(idx); }
            flip-requested => { root.cell-flip(idx); }
        }
    }

    stripe-b := Rectangle {
        x: root.stripe-b-x;
        y: (parent.height - root.strip-h) / 2;
        width: root.viewport-w;
        height: root.strip-h;
        for card[idx] in root.cards : MosaicCell {
            x: root.card-x(idx);
            y: root.card-y(idx);
            width: 320px;
            height: root.card-h(root.slot-of(idx));
            cell-key: idx;
            reveal-delay: (idx - Math.floor(idx / 15) * 15) * 40ms;
            image-alpha: 1.0;
            cloud-opacity: 1.0;
            thumb: card.thumb;
            clicked => { root.cell-clicked(idx); }
            flip-requested => { root.cell-flip(idx); }
        }
    }

    // 16ms kinetic timer placeholder (velocity *=0.90 handled in Rust; Slint just animates)
    // Chrome switch cross-fade 200ms handled by parent GalleryChrome opacity transition.
}
