// HVE 2 — MosaicView (Mosaic final scheme: paginated Pinterest band).
//
// The Rust page model (mosaic.rs::MosaicPages) is the source of truth for
// pagination; this view renders ONLY the current page's tiles (the wall
// covers the stage). A page flip is a curtain: each incoming tile is wiped
// clean by an opaque cover panel (scale-x, staggered ~50ms/column,
// ~300ms/tile). reduced-motion swaps the curtain for a plain crossfade.
// Clone-fill is pure model repetition in Rust — never touches disk; each
// tile carries its REAL theme index (real-index) so clicks report it.
// Translated from skwd-wall Mosaic (MIT, © liixini).

import { MosaicCell } from "MosaicCell.slint";
import { GalleryCardData } from "ThemeCardDelegate.slint";
import { SkwdTokens } from "../tokens.slint";

export struct MosaicTileData {
    x: length,
    y: length,
    w: length,
    h: length,
    // Real theme index this tile maps to (clone-fill safe: displayed % real).
    real-index: int,
    // Curtain stagger for this tile (ms) — derived from its column.
    delay-ms: int,
}

export component MosaicView inherits Rectangle {
    in property <length> viewport-w: 1500px;
    // Real card data; out-of-range real indices can't happen (clamped in Rust).
    in property <[GalleryCardData]> cards;
    // Current page's paint-ready geometry (Rust-computed justified_layout).
    in property <[MosaicTileData]> tiles;
    // Tramo 9: frozen outgoing tiles (under layer for curtain sweep).
    in property <[MosaicTileData]> under-tiles;
    // Pagination mirrors (Rust source of truth).
    in property <int> current-page: 0;
    in property <int> total-pages: 1;
    in property <[int]> page-numbers;
    in property <bool> reduced-motion: false;
    callback cell-clicked(int);
    callback cell-flip(int);
    // +1 next / −1 previous, once per wheel gesture (mirrors SliceCarousel).
    callback page-step(int);

    width: 1500px;
    height: 800px;
    clip: true;
    // Immersive presentation: the live desktop shows through; no opaque
    // surface may be painted here (the curtain cover is temporary + local).
    background: transparent;

    // Page-flip token bumped whenever current-page changes → drives the
    // per-tile curtain. Bumped by Rust on every successful flip.
    in-out property <int> flip-token: 0;
    changed current-page => { root.flip-token += 1; }

    // Curtain phase-driven wipe (D4): single parent phase 0→1 drives per-cell covers.
    // reduced-motion keeps the legacy page-alpha crossfade instead.
    in-out property <float> curtain-phase: 1.0;
    property <int> curtain-total-ms: 600;
    property <bool> curtain-running: false;
    curtain-timer := Timer {
        interval: 16ms;
        running: root.curtain-running;
        triggered => {
            root.curtain-phase = Math.min(1.0, root.curtain-phase + 0.027);
            if (root.curtain-phase >= 1.0) {
                root.curtain-running = false;
            }
        }
    }

    // Outgoing page crossfade (reduced-motion only).
    in-out property <float> page-alpha: 1.0;
    property <duration> page-fade-duration: 0ms;
    animate page-alpha {
        duration: root.page-fade-duration;
        easing: cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    page-fade-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => { root.page-alpha = 1.0; }
    }
    changed flip-token => {
        if (root.reduced-motion) {
            root.curtain-running = false;
            root.curtain-phase = 1.0;
            root.page-fade-duration = SkwdTokens.mosaic-page-fade;
            root.page-alpha = 0.35;
            page-fade-timer.restart();
        } else {
            root.page-alpha = 1.0;
            root.curtain-phase = 0.0;
            root.curtain-running = true;
        }
    }

    // ── Wheel (mirrors SliceCarousel): arm a debounce Timer, commit one
    // ±1 step per idle gesture. down/right = next, up/left = previous. ──
    // DECLARATION ORDER MATTERS: this TouchArea must be declared BEFORE the
    // page tiles so the cells paint (and hit-test) ABOVE it — a full-stage
    // TouchArea declared last steals has-hover from every cell and the
    // hover lift/brighten never fires (SliceCarousel parity).
    property <int> wheel-dir: 0;
    wheel-debounce := Timer {
        interval: 400ms;
        running: root.wheel-dir != 0;
        triggered => {
            root.page-step(root.wheel-dir);
            root.wheel-dir = 0;
        }
    }
    wheel-zone := TouchArea {
        width: 100%;
        height: 100%;
        scroll-event(event) => {
            let d = event.delta-x + event.delta-y;
            if (d != 0) {
                root.wheel-dir = d < 0 ? 1 : -1;
                wheel-debounce.restart();
            }
            accept
        }
    }

    // ── Under-layer (Tramo 9): frozen copy of the outgoing page.
    // Painted below the page so the curtain sweep reveals the incoming
    // image over a static copy of what was there before.  Zero image
    // copies — each under-tile resolves its image via root.cards[real-index]
    // (same binding pattern as live tiles).  Only visible when non-empty.
    Rectangle {
        visible: root.under-tiles.length > 0 && root.curtain-phase < 1.0 && !root.reduced-motion;
        width: 100%;
        height: 100%;
        clip: true;
        opacity: 1.0;
        for t[idx] in root.under-tiles : MosaicCell {
            x: t.x;
            y: t.y;
            width: t.w;
            height: t.h;
            cell-key: idx;
            reveal-delay: 0ms;
            image-alpha: 1.0;
            cloud-opacity: 1.0;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            flip-token: root.flip-token;
            reduced-motion: root.reduced-motion;
            delay-ms: t.delay-ms;
            curtain-phase: root.curtain-phase;
            curtain-total-ms: root.curtain-total-ms;
            // Under-tiles are frozen — no curtain animation, always fully revealed.
            curtain-progress: 1.0;
            clicked => { root.cell-clicked(t.real-index); }
            flip-requested => { root.cell-flip(t.real-index); }
        }
    }

    // ── Current page tiles ──
    page := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
        opacity: root.page-alpha;
        for t[idx] in root.tiles : MosaicCell {
            x: t.x;
            y: t.y;
            width: t.w;
            height: t.h;
            cell-key: idx;
            reveal-delay: t.delay-ms * 1ms;
            image-alpha: 1.0;
            cloud-opacity: 1.0;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            flip-token: root.flip-token;
            reduced-motion: root.reduced-motion;
            delay-ms: t.delay-ms;
            curtain-phase: root.curtain-phase;
            curtain-total-ms: root.curtain-total-ms;
            clicked => { root.cell-clicked(t.real-index); }
            flip-requested => { root.cell-flip(t.real-index); }
        }
    }

    // ── Pagination UI: bottom-center row of page numbers ──
    // Visible only when total-pages > 1; current page highlighted.
    // Click-to-jump is optional stretch — not wired this unit (display only).
    pagination := Rectangle {
        visible: root.total-pages > 1;
        width: 100%;
        height: 28px;
        y: parent.height - self.height - 12px;
        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            for n[idx] in root.page-numbers : Text {
                text: "\{n}";
                color: (n - 1) == root.current-page ? SkwdTokens.primary : SkwdTokens.outline;
                font-size: SkwdTokens.size-13;
                font-weight: (n - 1) == root.current-page ? 700 : 400;
            }
        }
    }
}
