// HVE 2 — MosaicView (justified-rows rewrite, gallery-immersive-redesign).
//
// Google Photos / Flickr style photo wall: Rust computes the FULL tile
// geometry as a `tiles` model (mosaic.rs::justified_layout — Slint
// GridLayout cannot compute spans and bindings cannot know per-image
// aspects), so this view only paints: each MosaicCell sits at its final
// centered stage coordinates, edge-to-edge with a thin uniform gutter,
// every tile shaped like its image (no crop, no letterbox). Dual-stripe
// infinite scroll, kinetic 0.90 (16ms), staggered reveal per cellKey
// unchanged.
// Translated from skwd-wall Mosaic (MIT, © liixini).

import { MosaicCell } from "MosaicCell.slint";
import { GalleryCardData } from "ThemeCardDelegate.slint";

export struct MosaicTileData {
    x: length,
    y: length,
    w: length,
    h: length,
}

export component MosaicView inherits Rectangle {
    in property <length> scroll-offset: 0px;
    in property <length> viewport-w: 1500px;
    // Real card data (gallery-immersive-redesign 4.8): out-of-range card
    // indices in the repeater below yield default (empty) images.
    in property <[GalleryCardData]> cards;
    // Paint-ready geometry computed by Rust (justified_layout); same row
    // order as `cards` so idx maps 1:1.
    in property <[MosaicTileData]> tiles;
    in property <int> item-count: 0;
    callback cell-clicked(int);
    callback cell-flip(int);

    width: 1500px;
    height: 800px;
    clip: true;
    // Immersive presentation (like Slice): the live desktop shows through.
    // GalleryRoot is transparent and the backdrop scrim sits BEHIND this
    // stage, so no opaque surface may be painted here.
    background: transparent;

    // kinetic 0.90 state driven by Rust tick every 16ms; Slint mirrors offset with 16ms timer
    property <length> stripe-a-x: - root.scroll-offset;
    property <length> stripe-b-x: - root.scroll-offset + root.viewport-w;
    animate stripe-a-x { duration: 16ms; easing: linear; }
    animate stripe-b-x { duration: 16ms; easing: linear; }

    // dual-stripe tiling for infinite horizontal scroll (spec R2.3):
    // stripe A hosts the justified block (tiles already carry the stage
    // centering offsets); stripe B repeats it one viewport to the right
    // as the tiling continuation. Full-height stripes: y placement comes
    // from the tiles themselves.
    stripe-a := Rectangle {
        x: root.stripe-a-x;
        y: 0;
        width: root.viewport-w;
        height: 100%;
        for t[idx] in root.tiles : MosaicCell {
            x: t.x;
            y: t.y;
            width: t.w;
            height: t.h;
            cell-key: idx;
            reveal-delay: (idx - Math.floor(idx / 15) * 15) * 40ms; // mirrors reveal_delay_for 600ms wrap
            image-alpha: 1.0;
            cloud-opacity: 1.0;
            thumb: root.cards[idx].thumb;
            hero: root.cards[idx].hero;
            clicked => { root.cell-clicked(idx); }
            flip-requested => { root.cell-flip(idx); }
        }
    }

    stripe-b := Rectangle {
        x: root.stripe-b-x;
        y: 0;
        width: root.viewport-w;
        height: 100%;
        for t[idx] in root.tiles : MosaicCell {
            x: t.x;
            y: t.y;
            width: t.w;
            height: t.h;
            cell-key: idx;
            reveal-delay: (idx - Math.floor(idx / 15) * 15) * 40ms;
            image-alpha: 1.0;
            cloud-opacity: 1.0;
            thumb: root.cards[idx].thumb;
            hero: root.cards[idx].hero;
            clicked => { root.cell-clicked(idx); }
            flip-requested => { root.cell-flip(idx); }
        }
    }

    // 16ms kinetic timer placeholder (velocity *=0.90 handled in Rust; Slint just animates)
    // Chrome switch cross-fade 200ms handled by parent GalleryChrome opacity transition.
}
