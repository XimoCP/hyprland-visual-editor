// HVE 2 — FilterBar (gallery-immersive-redesign PR4.1, design D7).
//
// Floating top-center style selector translated 1:1 from skwd-wall
// (MIT, © liixini): the bar hides behind an INVISIBLE 24px hover-reveal
// strip pinned to the top edge; entering the strip slides the bar down
// (250ms) and leaving it arms a 250ms auto-hide Timer. Top margin 24
// (flush with strip to eliminate 6px dead zone), max width parent − 20
// (spec: Floating FilterBar Chrome).
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";

// One skewed style pill (task 4.2 / spec Floating FilterBar Chrome):
// parallelogram Path skewed 10px like the slice shear, h24, active filled
// primary. Fill cross-fades 200ms (legacy S6 cadence).
component SkewPill inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> reduced-motion: false;
    callback selected();

    width: pill-label.preferred-width + 2 * pad + 10px;
    height: 24px;
    background: transparent;

    property <length> pad: 12px;
    property <float> wn: self.width / 1px;
    property <float> sn: 10px / 1px; // pill skew (spec)

    // Parallelogram face: top edge shifted right by the 10px skew.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: parent.wn;
        viewbox-height: 24;
        fill: root.active ? SkwdTokens.primary : SkwdTokens.surface-container.transparentize(0.35);
        stroke: root.active ? SkwdTokens.primary : SkwdTokens.outline.transparentize(0.4);
        stroke-width: 1px;
        animate fill { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }
        animate stroke { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }
        MoveTo { x: sn; y: 0; }
        LineTo { x: wn; y: 0; }
        LineTo { x: wn - sn; y: 24; }
        LineTo { x: 0; y: 24; }
        Close { }
    }

    pill-label := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.active ? SkwdTokens.surface : SkwdTokens.primary;
        font-size: SkwdTokens.size-11;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

export component FilterBar inherits Rectangle {
    // ── State ──
    in property <int> current-style: 0; // 0 Slice, 2 Mosaic (Hex removed #632)
    in property <bool> reduced-motion: false;
    callback style-selected(int);

    // Overlay chrome paints nothing itself.
    background: transparent;

    // Reveal state: true = bar expanded below the strip.
    property <bool> revealed: false;
    // Pointer is over the bar body — keeps it open and disarms the timer.
    property <bool> bar-hover: false;

    // ── Auto-hide (design D7 / spec Auto-hide scenario): declarative
    // one-shot Timer — runs only while revealed and neither strip nor bar
    // is hovered, hiding after 250ms. Entering strip/bar cancels via the
    // binding (running → false) so no explicit stop/restart is needed.
    // Fixes regression where event-driven restart never armed, leaving the
    // bar stuck visible.
    hide-timer := Timer {
        interval: 250ms;
        running: root.revealed && !strip.has-hover && !bar-touch.has-hover;
        triggered => {
            root.revealed = false;
        }
    }

    // ── Invisible 24px reveal strip: always active across the full top
    // edge. The top 24px is empty backdrop (design D7 risk note), so the
    // strip cannot steal clicks from anything else. TouchArea exposes
    // hover via has-hover (no entered/exited callbacks in Slint 1.17). ──
    strip := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 24px;
        changed has-hover => {
            if (self.has-hover) {
                root.revealed = true;
            }
        }
    }

    // ── Bar body: flush at y=24 when revealed (no 6px dead zone between
    // strip 0-24 and bar 30-...), centered, max width parent − 20.
    // Hidden state parks it under the top edge (clip-safe slide-up);
    // reveal slides it to y=24 over 250ms (spec Hover reveal scenario,
    // adjusted from 30 to 24 for contiguous hover). ──
    bar := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.revealed ? 24px : -self.height;
        width: min(parent.width - 20px, self.pill-pad * 2 + pills.width);
        height: pills.height;
        border-radius: SkwdTokens.radius-8;
        background: SkwdTokens.surface-container.transparentize(0.15);
        clip: true;
        animate y {
            duration: root.reduced-motion ? 0ms : SkwdTokens.anim-250;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        // Horizontal padding around the pill cascade.
        property <length> pill-pad: 12px;

        bar-touch := TouchArea {
            width: 100%;
            height: 100%;
            changed has-hover => {
                root.bar-hover = self.has-hover;
            }
        }

        // ── Pills (task 4.2): skewed parallelogram pills, h24, cascaded
        // with a −10px vertical overlap (step = 24 − 10 = 14px). Exactly
        // Slice + Mosaic — Hex removed per decision #632. Manual x/y
        // placement: layouts cannot express the negative vertical overlap.
        // Style indices keep the legacy numbering (0 Slice / 2 Mosaic). ──
        pills := Rectangle {
            x: parent.pill-pad;
            y: 0;
            width: slice-pill.width + mosaic-pill.width - 10px;
            height: 24px + 14px;

            slice-pill := SkewPill {
                x: 0;
                y: 0;
                label: "Slice";
                active: root.current-style == 0;
                reduced-motion: root.reduced-motion;
                selected => { root.style-selected(0); }
            }
            mosaic-pill := SkewPill {
                x: slice-pill.width;
                y: 14px;
                label: "Mosaic";
                active: root.current-style == 2;
                reduced-motion: root.reduced-motion;
                selected => { root.style-selected(2); }
            }
        }
    }
}
