// HVE 2 — FilterBar (gallery-immersive-redesign PR4.1, HF5 rework).
//
// Top-center style selector. Since HF5 the bar is driven by an explicit
// `open` state OWNED by the parent: a ChromeButton arrow above the
// carousel toggles it and picking a style closes it. The invisible
// hover-reveal strip, the 250ms auto-hide Timer and the diagonal pill
// cascade are gone — the bar slides from behind the top edge to its open
// position just below the toggle arrow (250ms OutCubic) and parks hidden
// when closed. Max width parent − 20 (spec: Floating FilterBar Chrome).
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";

// One skewed style pill (task 4.2 / spec Floating FilterBar Chrome):
// parallelogram Path skewed 10px like the slice shear; active filled
// primary. Fill cross-fades 200ms (legacy S6 cadence). HF5 sizing for
// hit comfort: height 32, font 13, 16px horizontal padding.
component SkewPill inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> reduced-motion: false;
    callback selected();

    width: pill-label.preferred-width + 2 * pad + 10px;
    height: 32px;
    background: transparent;

    property <length> pad: 16px;
    property <float> wn: self.width / 1px;
    property <float> hn: self.height / 1px;
    property <float> sn: 10px / 1px; // pill skew (spec)

    // Parallelogram face: top edge shifted right by the 10px skew.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: parent.wn;
        viewbox-height: parent.hn;
        fill: root.active ? SkwdTokens.primary : SkwdTokens.surface-container.transparentize(0.35);
        stroke: root.active ? SkwdTokens.primary : SkwdTokens.outline.transparentize(0.4);
        stroke-width: 1px;
        animate fill { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }
        animate stroke { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }
        MoveTo { x: sn; y: 0; }
        LineTo { x: wn; y: 0; }
        LineTo { x: wn - sn; y: hn; }
        LineTo { x: 0; y: hn; }
        Close { }
    }

    pill-label := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.active ? SkwdTokens.surface : SkwdTokens.primary;
        font-size: SkwdTokens.size-13;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

export component FilterBar inherits Rectangle {
    // ── State ──
    in property <int> current-style: 0; // 0 Slice, 2 Mosaic (Hex removed #632)
    // Explicit menu state (HF5): owned by the parent — the chrome arrow
    // flips it on click, picking a style closes it. No hover strip, no
    // auto-hide timer.
    in property <bool> open: false;
    in property <bool> reduced-motion: false;
    callback style-selected(int);

    // Overlay chrome paints nothing itself.
    background: transparent;

    // ── Bar body: parks hidden behind the top edge when closed (clip-safe
    // slide), slides to y42 — just below the 36px toggle arrow — over
    // 250ms OutCubic. Horizontally centered, max width parent − 20; the
    // width hugs the pill row through its preferred-width constraint. ──
    bar := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.open ? 42px : -self.height;
        width: min(parent.width - 20px, pills.preferred-width);
        height: 32px;
        border-radius: SkwdTokens.radius-8;
        background: SkwdTokens.surface-container.transparentize(0.15);
        clip: true;
        animate y {
            duration: root.reduced-motion ? 0ms : SkwdTokens.anim-250;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        // Horizontal padding around the pills.
        property <length> pill-pad: 16px;

        // ── Pills (HF5): SIDE BY SIDE in a HorizontalLayout — the diagonal
        // cascade with its −10px overlap is gone. Exactly Slice + Mosaic —
        // Hex removed per decision #632; style indices keep the legacy
        // numbering (0 Slice / 2 Mosaic). ~6px gap between pills. ──
        pills := HorizontalLayout {
            padding-left: parent.pill-pad;
            padding-right: parent.pill-pad;
            spacing: 6px;

            slice-pill := SkewPill {
                label: "Slice";
                active: root.current-style == 0;
                reduced-motion: root.reduced-motion;
                selected => { root.style-selected(0); }
            }
            mosaic-pill := SkewPill {
                label: "Mosaic";
                active: root.current-style == 2;
                reduced-motion: root.reduced-motion;
                selected => { root.style-selected(2); }
            }
        }
    }
}
