// HVE — FilterBar (gallery-immersive-redesign PR4.1, HF5 rework).
//
// Top-center style selector. Since HF5 the bar is driven by an explicit
// `open` state OWNED by the parent: a ChromeButton arrow above the
// carousel toggles it and picking a style closes it. The invisible
// hover-reveal strip, the 250ms auto-hide Timer and the diagonal pill
// cascade are gone — the bar slides from behind the top edge to its open
// position just below the toggle arrow (250ms OutCubic) and parks hidden
// when closed. Max width parent − 20 (spec: Floating FilterBar Chrome).
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";
// The five section words are panel chrome (PanelMenu reads the same global),
// so the pills follow the language instead of spelling English literals.
import { PanelText } from "../panel/panel_text.slint";

// One skewed style pill (task 4.2 / spec Floating FilterBar Chrome):
// parallelogram Path skewed 10px like the slice shear; active filled
// primary. Fill cross-fades 200ms (legacy S6 cadence). HF5 sizing for
// hit comfort: height 32, font 13, 16px horizontal padding.
component SkewPill inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> reduced-motion: false;
    in property <bool> key-focused: false;
    callback selected();

    width: pill-label.preferred-width + 2 * pad + 10px;
    height: 32px;
    background: transparent;

    property <length> pad: 16px;
    property <float> wn: self.width / 1px;
    property <float> hn: self.height / 1px;
    property <float> sn: 10px / 1px; // pill skew (spec)

    // Parallelogram face: top edge shifted right by the 10px skew.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: parent.wn;
        viewbox-height: parent.hn;
        fill: root.active ? HveColors.accent-cyan : HveColors.bg-card.transparentize(0.35);
        stroke: root.key-focused ? #8fd8ff : (root.active ? HveColors.accent-cyan : HveColors.border.transparentize(0.4));
        stroke-width: root.key-focused ? 1.5px : 1px;
        animate fill { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }
        animate stroke { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }
        MoveTo { x: sn; y: 0; }
        LineTo { x: wn; y: 0; }
        LineTo { x: wn - sn; y: hn; }
        LineTo { x: 0; y: hn; }
        Close { }
    }

    pill-label := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.active ? HveColors.bg-dark : HveColors.accent-cyan;
        font-size: SkwdTokens.size-13;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200; }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

export component FilterBar inherits Rectangle {
    // ── State ──
    in property <int> current-style: 0; // 0 Slice, 2 Mosaic (Hex removed #632)
    // Explicit menu state (HF5): owned by the parent — the chrome arrow
    // flips it on click, picking a style closes it. No hover strip, no
    // auto-hide timer.
    in property <bool> open: false;
    in property <bool> reduced-motion: false;
    callback style-selected(int);
    // Mutating-window dropdown (R9): 5 section pills
    in property <int> panel-section: 0;
    callback panel-section-selected(int);
    callback escape-pressed();

    // Overlay chrome paints nothing itself.
    background: transparent;

    // ── Bar body: parks hidden behind the top edge when closed (clip-safe
    // slide), slides to y42 — just below the 36px toggle arrow — over
    // 250ms OutCubic. Horizontally centered, max width parent − 20; the
    // width hugs the pill row through its preferred-width constraint.
    // Mutating-window extends height to two rows + divider (pick before tune).
    bar := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.open ? 42px : -self.height;
        width: min(parent.width - 20px, pills-wrapper.preferred-width);
        height: pills-wrapper.preferred-height + 16px;
        border-radius: SkwdTokens.radius-8;
        background: HveColors.bg-card.transparentize(0.15);
        clip: true;
        animate y {
            duration: root.reduced-motion ? 0ms : SkwdTokens.anim-250;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        // Horizontal padding around the pills.
        property <length> pill-pad: 16px;

        // Keyboard focus scope BEHIND pills so pill TouchAreas sit on top
        // and receive clicks; empty bar space still focuses the scope.
        // Arrow/Enter navigation (R9 keyboard-reachable, R11 no trap).
        focus-scope := FocusScope {
            width: 100%;
            height: 100%;
            property <int> key-focused-pill: -1;
            key-pressed(event) => {
                if (!self.has-focus) {
                    return reject;
                }
                if (event.text == Key.Tab) {
                    return reject;
                }
                if (event.text == Key.Escape) {
                    // First Esc clears pill focus, second Esc (or no pill focused) must close menu/gallery — forward to shell
                    if (self.key-focused-pill != -1) {
                        self.key-focused-pill = -1;
                        return accept;
                    }
                    if (root.open) {
                        // Menu open: request close, don't swallow the next Esc
                        root.escape-pressed();
                        return accept;
                    }
                    // Menu already closed or never opened: let Shell handle hide/close
                    root.escape-pressed();
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    if (self.key-focused-pill == -1) {
                        self.key-focused-pill = 0;
                    } else if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                        self.key-focused-pill = self.key-focused-pill == 0 ? 6 : self.key-focused-pill - 1;
                    } else {
                        self.key-focused-pill = self.key-focused-pill == 6 ? 0 : self.key-focused-pill + 1;
                    }
                    return accept;
                }
                if (event.text == Key.Return || event.text == Key.Space) {
                    if (self.key-focused-pill == 0) {
                        root.style-selected(0);
                    } else if (self.key-focused-pill == 1) {
                        root.style-selected(2);
                    } else if (self.key-focused-pill >= 2 && self.key-focused-pill <= 6) {
                        root.panel-section-selected(self.key-focused-pill - 2);
                    }
                    self.key-focused-pill = -1;
                    return accept;
                }
                return reject;
            }
        }

        pills-wrapper := VerticalLayout {
            padding: 8px;
            spacing: 8px;
            alignment: start;

            // ── Top row: gallery style pills (pick layer) ──
            pills := HorizontalLayout {
                padding-left: bar.pill-pad;
                padding-right: bar.pill-pad;
                spacing: 6px;

                slice-pill := SkewPill {
                    label: "Slice";
                    active: root.current-style == 0;
                    reduced-motion: root.reduced-motion;
                    key-focused: focus-scope.has-focus && focus-scope.key-focused-pill == 0;
                    selected => { root.style-selected(0); }
                }
                mosaic-pill := SkewPill {
                    label: "Mosaic";
                    active: root.current-style == 2;
                    reduced-motion: root.reduced-motion;
                    key-focused: focus-scope.has-focus && focus-scope.key-focused-pill == 1;
                    selected => { root.style-selected(2); }
                }
            }

            // Divider between gallery style and panel sections
            Rectangle {
                height: 1px;
                background: HveColors.border.transparentize(0.6);
            }

            // ── Bottom row: 5 panel section pills + divider semantics (R9) ──
            // Keyboard FocusScope (icy-cyan #8fd8ff focus border) — Tab order pick-before-tune (R11)
            panel-pills := HorizontalLayout {
                padding-left: bar.pill-pad;
                padding-right: bar.pill-pad;
                spacing: 6px;

                // Wrapping FocusScope for keyboard navigation (R9 keyboard-reachable)
                save-pill := SkewPill {
                    label: PanelText.nav-save;
                    active: root.panel-section == 0;
                    reduced-motion: root.reduced-motion;
                    key-focused: focus-scope.has-focus && focus-scope.key-focused-pill == 2;
                    selected => { root.panel-section-selected(0); }
                }
                borders-pill := SkewPill {
                    label: PanelText.nav-borders;
                    active: root.panel-section == 1;
                    reduced-motion: root.reduced-motion;
                    key-focused: focus-scope.has-focus && focus-scope.key-focused-pill == 3;
                    selected => { root.panel-section-selected(1); }
                }
                motion-pill := SkewPill {
                    label: PanelText.nav-motion;
                    active: root.panel-section == 2;
                    reduced-motion: root.reduced-motion;
                    key-focused: focus-scope.has-focus && focus-scope.key-focused-pill == 4;
                    selected => { root.panel-section-selected(2); }
                }
                filters-pill := SkewPill {
                    label: PanelText.nav-filters;
                    active: root.panel-section == 3;
                    reduced-motion: root.reduced-motion;
                    key-focused: focus-scope.has-focus && focus-scope.key-focused-pill == 5;
                    selected => { root.panel-section-selected(3); }
                }
                system-pill := SkewPill {
                    label: PanelText.nav-system;
                    active: root.panel-section == 4;
                    reduced-motion: root.reduced-motion;
                    key-focused: focus-scope.has-focus && focus-scope.key-focused-pill == 6;
                    selected => { root.panel-section-selected(4); }
                }
            }
        }

        // Icy-cyan focus border when any pill has keyboard focus (R11)
        // Visual focus indicator: #8fd8ff 1px outline when focused (merged with above radius)
        border-width: focus-scope.has-focus ? 1px : 0px;
        border-color: #8fd8ff;
    }
}
