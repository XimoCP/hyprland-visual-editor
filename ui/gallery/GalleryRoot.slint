// HVE 2 — GalleryRoot (theme-gallery PR4.5 + behind-drawers).
//
// Dos cajones que nacen DETRÁS del Slider/Mosaic y se despliegan
// verticalmente: arriba para Settings, abajo para Slider/Mosaic.
// La tira (Slice/Mosaic) pinta POR ENCIMA de los cajones (declaración
// antes que stage), así que al estar cerrados quedan escondidos detrás
// del carrusel y al abrirse se deslizan fuera del borde de la banda
// central (scaled-h). Dos ChromeButton arriba/abajo los disparan; arriba
// ya no mueve el carrusel, abajo tampoco — left/right siguen moviendo.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";
import { ChromeButton } from "ChromeButton.slint";
import { GalleryChrome } from "GalleryChrome.slint";
import { GalleryCardData } from "ThemeCardDelegate.slint";
import { SliceCarousel, SliceTileData } from "SliceCarousel.slint";
import { MosaicView, MosaicTileData } from "MosaicView.slint";

// Reused pill — mismo look que FilterBar (paralelogramo 10px sesgo).
component SkewPill inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> reduced-motion: false;
    in property <bool> key-focused: false;
    callback selected();

    width: pill-label.preferred-width + 2 * pad + 10px;
    height: 32px;
    background: transparent;

    property <length> pad: 16px;
    property <float> wn: self.width / 1px;
    property <float> hn: self.height / 1px;
    property <float> sn: 10px / 1px;

    // Hover lift — mismo lenguaje que Slice/Mosaic (1.03 + brillo)
    property <bool> has-hover: touch.has-hover;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: parent.wn;
        viewbox-height: parent.hn;
        // Todos mismo color en reposo; al hover o con foco se rellena con primary
        fill: (root.active || root.has-hover || root.key-focused) ? HveColors.accent-cyan : HveColors.bg-card.transparentize(0.35);
        stroke: root.key-focused ? #8fd8ff : ((root.active || root.has-hover || root.key-focused) ? HveColors.accent-cyan : HveColors.border.transparentize(0.4));
        stroke-width: root.key-focused ? 1.5px : 1px;
        animate fill { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-150; }
        animate stroke { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-150; }
        MoveTo { x: sn; y: 0; }
        LineTo { x: wn; y: 0; }
        LineTo { x: wn - sn; y: hn; }
        LineTo { x: 0; y: hn; }
        Close { }
    }

    pill-label := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: (root.active || root.has-hover || root.key-focused) ? HveColors.bg-dark : HveColors.accent-cyan;
        font-size: SkwdTokens.size-13;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: root.reduced-motion ? 0ms : SkwdTokens.anim-150; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

export component GalleryRoot inherits Rectangle {
    in property <int> current-style: 0;
    in property <int> focused-index: 0;
    in property <[GalleryCardData]> cards;
    in property <[SliceTileData]> slice-tiles;
    in property <float> slice-focus-pos: 0.0;
    in property <int> slice-delta-base: 0;
    in property <bool> slice-rebasing: false;
    in property <[MosaicTileData]> mosaic-tiles;
    in property <[MosaicTileData]> mosaic-under-tiles;
    in property <int> mosaic-current-page: 0;
    in property <int> mosaic-total-pages: 1;
    in property <[int]> mosaic-page-numbers;
    in property <bool> empty: false;
    in property <string> empty-text: "No themes yet. Save your current setup as a theme.";
    in property <string> mit-link: "https://github.com/liixini/skwd-wall";
    in property <bool> reduced-motion: false;
    in property <bool> docking: false;
    in property <int> panel-section: 0;
    in property <float> backdrop-alpha: 0.0;

    callback style-selected(int);
    callback panel-section-selected(int);
    callback card-clicked(int);
    callback card-right-clicked(int);
    callback wheel-step(int);
    callback mosaic-page-step(int);
    callback mit-opened();
    callback escape-pressed();
    callback stage-geometry-changed(length, length);

    background: transparent;

    property <bool> opened: false;
    init => { self.opened = true; }

    // ── Dos cajones detrás del carrusel ──
    // Local UI state — no necesita Rust para abrir/cerrar, pero se
    // expone como in-out por si el teclado (Up/Down) lo quiere togglear
    // desde callbacks.rs. Por defecto cerrados (escondidos detrás).
    in-out property <bool> top-menu-open: false;
    in-out property <bool> bottom-menu-open: false;
    // Compat: FilterBar viejo usaba style-menu-open — lo mantenemos como
    // alias a bottom para no romper bindings externos si quedara alguno.
    property <bool> style-menu-open: root.bottom-menu-open;

    // Foco de teclado dentro de cada cajón — loop y primer pill resaltado
    property <int> top-focused: 0;
    property <int> bottom-focused: 0;

    // Scaled band height (misma fórmula que SliceCarousel) para calcular
    // el borde superior/inferior de la banda central donde se esconde.
    property <float> scaled-h: (root.width / 1px < 100.0 ? 924.0 : Math.min(924.0, root.width / 1px * 0.58)) * 520.0 / 924.0;

    changed top-menu-open => {
        if (root.top-menu-open) {
            root.top-focused = 0;
            gallery-keys.focus();
        }
    }
    changed bottom-menu-open => {
        if (root.bottom-menu-open) {
            root.bottom-focused = 0;
            gallery-keys.focus();
        }
    }

    property <int> shown-style: root.current-style;
    switch-timer := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            root.shown-style = root.current-style;
            self.running = false;
        }
    }
    changed current-style => {
        if (root.shown-style != root.current-style) { switch-timer.restart(); }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: black;
        opacity: opened ? root.backdrop-alpha : 0.0;
        animate opacity { duration: SkwdTokens.anim-300; }
    }

    // ── Cajón superior: Settings (Sale DETRÁS en Slider, delante en Mosaic) ──
    // Slider (style 0): este cajón de atrás crea el efecto "sale de detrás" (stage lo tapa).
    // Mosaic (style 2): este cajón queda tapado por la grilla, por eso se usa el duplicado de frente.
    top-drawer := Rectangle {
        visible: root.current-style == 0;
        x: (parent.width - self.width) / 2;
        y: root.top-menu-open ? (parent.height / 2 - root.scaled-h * 1px / 2 - self.height - 12px) : -self.height;
        width: Math.min(parent.width - 32px, top-pills-wrapper.preferred-width);
        height: top-pills-wrapper.preferred-height;
        background: HveColors.bg-card.transparentize(0.15);
        border-radius: SkwdTokens.radius-8;
        clip: true;
        drop-shadow-blur: root.top-menu-open ? 16px : 0px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: root.top-menu-open ? 8px : 0px;
        animate y {
            duration: root.reduced-motion ? 0ms : 250ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        animate drop-shadow-blur {
            duration: root.reduced-motion ? 0ms : 250ms;
        }
        animate drop-shadow-offset-y {
            duration: root.reduced-motion ? 0ms : 250ms;
        }

        top-pills-wrapper := HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: center;

            SkewPill {
                label: "Save";
                active: false;
                key-focused: root.top-focused == 0 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(0); }
            }
            SkewPill {
                label: "Borders";
                active: false;
                key-focused: root.top-focused == 1 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(1); }
            }
            SkewPill {
                label: "Motion";
                active: false;
                key-focused: root.top-focused == 2 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(2); }
            }
            SkewPill {
                label: "Filters";
                active: false;
                key-focused: root.top-focused == 3 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(3); }
            }
            SkewPill {
                label: "System";
                active: false;
                key-focused: root.top-focused == 4 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(4); }
            }
        }
    }

    // ── Cajón inferior: Slider / Mosaic ──
    bottom-drawer := Rectangle {
        visible: root.current-style == 0;
        x: (parent.width - self.width) / 2;
        y: root.bottom-menu-open ? (parent.height / 2 + root.scaled-h * 1px / 2 + 12px) : parent.height;
        width: Math.min(parent.width - 32px, bottom-pills-wrapper.preferred-width);
        height: bottom-pills-wrapper.preferred-height;
        background: HveColors.bg-card.transparentize(0.15);
        border-radius: SkwdTokens.radius-8;
        clip: true;
        drop-shadow-blur: root.bottom-menu-open ? 16px : 0px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 8px;
        animate y {
            duration: root.reduced-motion ? 0ms : 250ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        animate drop-shadow-blur {
            duration: root.reduced-motion ? 0ms : 250ms;
        }

        bottom-pills-wrapper := HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: center;

            SkewPill {
                label: "Slider";
                active: false;
                key-focused: root.bottom-focused == 0 && root.bottom-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.bottom-menu-open = false; root.style-selected(0); }
            }
            SkewPill {
                label: "Mosaic";
                active: false;
                key-focused: root.bottom-focused == 1 && root.bottom-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.bottom-menu-open = false; root.style-selected(2); }
            }
        }
    }

    // ── Teclado cuando un cajón está abierto: Left/Right navega con loop, Enter activa y cierra ──
    gallery-keys := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.top-menu-open || root.bottom-menu-open;
        key-pressed(event) => {
            if (!root.top-menu-open && !root.bottom-menu-open) {
                return reject;
            }
            if (event.text == Key.Escape) {
                if (root.top-menu-open) { root.top-menu-open = false; return accept; }
                if (root.bottom-menu-open) { root.bottom-menu-open = false; return accept; }
                return reject;
            }
            // ↑/↓ cierran el cajón abierto (sin necesitar Esc) y permiten toggle cruzado
            if (event.text == Key.UpArrow) {
                if (root.top-menu-open) { root.top-menu-open = false; return accept; }
                if (root.bottom-menu-open) { root.bottom-menu-open = false; root.top-menu-open = true; return accept; }
            }
            if (event.text == Key.DownArrow) {
                if (root.bottom-menu-open) { root.bottom-menu-open = false; return accept; }
                if (root.top-menu-open) { root.top-menu-open = false; root.bottom-menu-open = true; return accept; }
            }
            if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                if (root.top-menu-open) {
                    if (event.text == Key.LeftArrow) {
                        root.top-focused = root.top-focused == 0 ? 4 : root.top-focused - 1;
                    } else {
                        root.top-focused = root.top-focused == 4 ? 0 : root.top-focused + 1;
                    }
                    return accept;
                }
                if (root.bottom-menu-open) {
                    if (event.text == Key.LeftArrow) {
                        root.bottom-focused = root.bottom-focused == 0 ? 1 : 0;
                    } else {
                        root.bottom-focused = root.bottom-focused == 1 ? 0 : 1;
                    }
                    return accept;
                }
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                if (root.top-menu-open) {
                    if (root.top-focused == 0) { root.top-menu-open = false; root.panel-section-selected(0); }
                    else if (root.top-focused == 1) { root.top-menu-open = false; root.panel-section-selected(1); }
                    else if (root.top-focused == 2) { root.top-menu-open = false; root.panel-section-selected(2); }
                    else if (root.top-focused == 3) { root.top-menu-open = false; root.panel-section-selected(3); }
                    else if (root.top-focused == 4) { root.top-menu-open = false; root.panel-section-selected(4); }
                    return accept;
                }
                if (root.bottom-menu-open) {
                    if (root.bottom-focused == 0) { root.bottom-menu-open = false; root.style-selected(0); }
                    else { root.bottom-menu-open = false; root.style-selected(2); }
                    return accept;
                }
            }
            return reject;
        }
    }

    // ── Stage: pinta POR ENCIMA de los cajones (declarado después) ──
    stage := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
        changed width => { root.stage-geometry-changed(self.width, self.height); }
        changed height => { root.stage-geometry-changed(self.width, self.height); }
        opacity: root.shown-style == root.current-style ? 1.0 : 0.0;
        animate opacity {
            duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        if root.shown-style == 0 : SliceCarousel {
            width: 100%;
            height: 100%;
            stage-width: stage.width;
            cards: root.cards;
            tiles: root.slice-tiles;
            focus-pos: root.slice-focus-pos;
            rebasing: root.slice-rebasing;
            reduced-motion: root.reduced-motion;
            docking: root.docking;
            delta-base: root.slice-delta-base;
            card-clicked(i) => { root.card-clicked(i); }
            card-right-clicked(i) => { root.card-right-clicked(i); }
            wheel-step(dir) => { root.wheel-step(dir); }
        }

        if root.shown-style == 2 : MosaicView {
            width: 100%;
            height: 100%;
            viewport-w: self.width;
            cards: root.cards;
            tiles: root.mosaic-tiles;
            under-tiles: root.mosaic-under-tiles;
            current-page: root.mosaic-current-page;
            total-pages: root.mosaic-total-pages;
            page-numbers: root.mosaic-page-numbers;
            reduced-motion: root.reduced-motion;
            cell-clicked(idx) => {
                if (idx < root.cards.length) { root.card-clicked(idx); }
            }
            cell-flip(idx) => {
                if (idx < root.cards.length) { root.card-right-clicked(idx); }
            }
            page-step(dir) => { root.mosaic-page-step(dir); }
        }
    }

    // ── Duplicados al FRENTE solo para Mosaic — pintan por encima de la grilla y no se tapan ──
    top-drawer-front := Rectangle {
        visible: root.current-style == 2;
        x: (parent.width - self.width) / 2;
        y: root.top-menu-open ? (parent.height / 2 - root.scaled-h * 1px / 2 - self.height - 12px) : -self.height;
        width: Math.min(parent.width - 32px, top-pills-wrapper-front.preferred-width);
        height: top-pills-wrapper-front.preferred-height;
        background: HveColors.bg-card.transparentize(0.15);
        border-radius: SkwdTokens.radius-8;
        clip: true;
        drop-shadow-blur: root.top-menu-open ? 16px : 0px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: root.top-menu-open ? 8px : 0px;
        animate y {
            duration: root.reduced-motion ? 0ms : 250ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        animate drop-shadow-blur {
            duration: root.reduced-motion ? 0ms : 250ms;
        }
        animate drop-shadow-offset-y {
            duration: root.reduced-motion ? 0ms : 250ms;
        }

        top-pills-wrapper-front := HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: center;

            SkewPill {
                label: "Save";
                active: false;
                key-focused: root.top-focused == 0 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(0); }
            }
            SkewPill {
                label: "Borders";
                active: false;
                key-focused: root.top-focused == 1 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(1); }
            }
            SkewPill {
                label: "Motion";
                active: false;
                key-focused: root.top-focused == 2 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(2); }
            }
            SkewPill {
                label: "Filters";
                active: false;
                key-focused: root.top-focused == 3 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(3); }
            }
            SkewPill {
                label: "System";
                active: false;
                key-focused: root.top-focused == 4 && root.top-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.top-menu-open = false; root.panel-section-selected(4); }
            }
        }
    }

    bottom-drawer-front := Rectangle {
        visible: root.current-style == 2;
        x: (parent.width - self.width) / 2;
        y: root.bottom-menu-open ? (parent.height / 2 + root.scaled-h * 1px / 2 + 12px) : parent.height;
        width: Math.min(parent.width - 32px, bottom-pills-wrapper-front.preferred-width);
        height: bottom-pills-wrapper-front.preferred-height;
        background: HveColors.bg-card.transparentize(0.15);
        border-radius: SkwdTokens.radius-8;
        clip: true;
        drop-shadow-blur: root.bottom-menu-open ? 16px : 0px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 8px;
        animate y {
            duration: root.reduced-motion ? 0ms : 250ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        animate drop-shadow-blur {
            duration: root.reduced-motion ? 0ms : 250ms;
        }

        bottom-pills-wrapper-front := HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: center;

            SkewPill {
                label: "Slider";
                active: false;
                key-focused: root.bottom-focused == 0 && root.bottom-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.bottom-menu-open = false; root.style-selected(0); }
            }
            SkewPill {
                label: "Mosaic";
                active: false;
                key-focused: root.bottom-focused == 1 && root.bottom-menu-open;
                reduced-motion: root.reduced-motion;
                selected => { root.bottom-menu-open = false; root.style-selected(2); }
            }
        }
    }

    GalleryChrome {
        width: 100%;
        height: 100%;
        reduced-motion: root.reduced-motion;
        mit-link: root.mit-link;
        mit-opened => { root.mit-opened(); }
    }

    // ── Flecha superior: despliega Settings hacia ARRIBA ──
    top-arrow := ChromeButton {
        x: (parent.width - self.width) / 2;
        y: 2px;
        open: root.top-menu-open;
        closed-glyph: "▴";
        open-glyph: "▾";
        reduced-motion: root.reduced-motion;
        toggled => {
            root.top-menu-open = !root.top-menu-open;
            if (root.top-menu-open) { root.bottom-menu-open = false; }
        }
    }

    // ── Flecha inferior: despliega Slider/Mosaic hacia ABAJO ──
    bottom-arrow := ChromeButton {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 2px;
        open: root.bottom-menu-open;
        closed-glyph: "▾";
        open-glyph: "▴";
        reduced-motion: root.reduced-motion;
        toggled => {
            root.bottom-menu-open = !root.bottom-menu-open;
            if (root.bottom-menu-open) { root.top-menu-open = false; }
        }
    }

    // Esc cierra cajones primero, luego delega al shell
    // (GalleryChrome ya maneja Escape del panel, esto es para los drawers).
    // Se expone vía FilterBar compat pero aquí lo hacemos directo:
    // si alguno está abierto, Escape lo cierra y no propaga hide.
    // El shell ya tiene su handler de Escape global, así que este es
    // solo para no perder el cajón sin cerrar.
}
