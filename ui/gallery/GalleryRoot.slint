// HVE 2 — GalleryRoot (theme-gallery PR4.5 visible wiring).
//
// Swaps the active presentation view: Slice (parallelogram carousel) or
// Mosaic (Voronoi stripes) — Hexagon removed per decision #632. Chrome
// (empty banner + MIT pill) and FilterBar float as overlays on top; the
// backdrop scrim sits below everything. Pure UI assembly — navigation
// state stays in Rust (nav-shell D8): clicks and keys are reported
// upward through callbacks and Rust mirrors style/focus back through
// the in-properties below.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { FilterBar } from "FilterBar.slint";
import { ChromeButton } from "ChromeButton.slint";
import { GalleryChrome } from "GalleryChrome.slint";
import { GalleryCardData } from "ThemeCardDelegate.slint";
import { SliceCarousel, SliceTileData } from "SliceCarousel.slint";
import { MosaicView, MosaicTileData } from "MosaicView.slint";

export component GalleryRoot inherits Rectangle {
    // ── State mirrors (written by Rust, read-only here) ──
    in property <int> current-style: 0; // 0 Slice, 1 Hexagon, 2 Mosaic
    in property <int> focused-index: 0;
    in property <[GalleryCardData]> cards;
    // V2 virtualized single-strip tiles (Rust strip_feed, window + spare).
    in property <[SliceTileData]> slice-tiles;
    in property <length> slice-strip-offset: 0px;
    in property <bool> slice-rebasing: false;
    // Justified-rows Mosaic tile geometry (Rust-computed model).
    in property <[MosaicTileData]> mosaic-tiles;
    // Mosaic pagination mirrors (Rust page model is the source of truth).
    in property <int> mosaic-current-page: 0;
    in property <int> mosaic-total-pages: 1;
    in property <[int]> mosaic-page-numbers;
    in property <bool> empty: false;
    in property <string> empty-text: "No themes yet. Save your current setup as a theme.";
    in property <string> mit-link: "https://github.com/liixini/skwd-wall";
    in property <bool> reduced-motion: false;
    // Backdrop scrim level (skwd selectorBackdropOpacity/100; default 0
    // keeps the live desktop fully visible behind the cards).
    in property <float> backdrop-alpha: 0.0;

    // ── Events reported to Rust ──
    callback style-selected(int);
    callback card-clicked(int);
    callback card-right-clicked(int);
    callback wheel-step(int); // debounced ±1 gesture from SliceCarousel
    callback mosaic-page-step(int); // debounced ±1 gesture from MosaicView wheel
    callback mit-opened();    // D10 pill → Rust opens mit-link (xdg-open)
    // Stage geometry events (logical lengths): Rust recomputes the mosaic
    // tiles model from these instead of reading the startup window size.
    callback stage-geometry-changed(length, length);

    // Immersive presentation (gallery-immersive-redesign 1.8): the root
    // stops painting an opaque surface — HVE runs fullscreen over the live
    // desktop during a gallery session (skwd transparent layer-shell).
    background: transparent;

    // ── Backdrop scrim: fullscreen black Rect fading in on open ──
    // skwd: alpha = selectorBackdropOpacity/100 (default 0 → NO dim),
    // fade 300ms (animMedium). Flipped after mount so the fade always
    // plays from 0 on open.
    property <bool> opened: false;
    init => { self.opened = true; }

    // ── Style menu state (HF5): UI-side toggle for the FilterBar chrome.
    // The arrow button flips it; picking a style closes it. Pure UI
    // concern — Rust stays the source of truth for WHICH style is active. ──
    property <bool> style-menu-open: false;

    // ── Stage cross-fade (task 4.3 / spec S6): the presentation views are
    // keyed to a UI-side display mirror (`shown-style`) that lags the
    // Rust-owned style by one 200ms fade-out, then commits and fades the
    // new view back in. The mirror always converges to the Rust truth, so
    // state ownership never desyncs (PR2 parity convention); switching
    // preserves the focused card (Rust clamps, never resets). ──
    property <int> shown-style: root.current-style;
    switch-timer := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            root.shown-style = root.current-style;
            self.running = false;
        }
    }
    changed current-style => {
        if (root.shown-style != root.current-style) { switch-timer.restart(); }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: black;
        opacity: opened ? root.backdrop-alpha : 0.0;
        animate opacity { duration: SkwdTokens.anim-300; }
    }

    // ── Stage: exactly one presentation view mounted at a time. Fills the
    // whole window; chrome/filterbar float above it (paint = declaration
    // order). Opacity follows the shown-style convergence described above. ──
    stage := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
        // Slint-driven stage dims (Slint 1.17 `changed` callbacks): any
        // layout/resize re-reports the CURRENT logical size. Recomputing
        // the tiles model never writes back to width/height → no loop.
        changed width => { root.stage-geometry-changed(self.width, self.height); }
        changed height => { root.stage-geometry-changed(self.width, self.height); }
        opacity: root.shown-style == root.current-style ? 1.0 : 0.0;
        animate opacity {
            duration: root.reduced-motion ? 0ms : SkwdTokens.anim-200;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        // Style 0 — Slice: infinite wall (S2). Focused dead-center expanded,
        // collapsed slats zero-gap both sides edge-to-edge via clones; stage
        // width changes re-render via stage-geometry-changed (shared).
        if root.shown-style == 0 : SliceCarousel {
            width: 100%;
            height: 100%;
            cards: root.cards;
            tiles: root.slice-tiles;
            strip-offset: root.slice-strip-offset;
            rebasing: root.slice-rebasing;
            card-clicked(i) => { root.card-clicked(i); }
            card-right-clicked(i) => { root.card-right-clicked(i); }
            wheel-step(dir) => { root.wheel-step(dir); }
        }

        // Style 2 — Mosaic: paginated Pinterest band (Mosaic final scheme).
        // Renders only the current page; Rust owns the page model and the
        // curtain + pagination are driven by the mirrors below. Clicks map
        // onto real themes via the tile's real-index (clone-fill safe).
        // Style 1 (Hexagon) removed per decision #632.
        if root.shown-style == 2 : MosaicView {
            width: 100%;
            height: 100%;
            viewport-w: self.width;
            cards: root.cards;
            tiles: root.mosaic-tiles;
            current-page: root.mosaic-current-page;
            total-pages: root.mosaic-total-pages;
            page-numbers: root.mosaic-page-numbers;
            reduced-motion: root.reduced-motion;
            cell-clicked(idx) => {
                if (idx < root.cards.length) { root.card-clicked(idx); }
            }
            cell-flip(idx) => {
                if (idx < root.cards.length) { root.card-right-clicked(idx); }
            }
            page-step(dir) => { root.mosaic-page-step(dir); }
        }
    }

    // ── Chrome overlay (task 4.4): empty banner + bottom-right MIT pill.
    // Transparent — paints nothing itself. Declared AFTER the stage so
    // it paints above it; FilterBar stays topmost. ──
    GalleryChrome {
        width: 100%;
        height: 100%;
        reduced-motion: root.reduced-motion;
        mit-link: root.mit-link;
        mit-opened => { root.mit-opened(); }
    }

    // ── FilterBar (gallery-immersive-redesign 4.1, HF5): top-center style
    // menu, shown only while style-menu-open; a pick closes it. ──
    FilterBar {
        width: 100%;
        height: 100%;
        current-style: root.current-style;
        open: root.style-menu-open;
        reduced-motion: root.reduced-motion;
        style-selected(style) => {
            root.style-menu-open = false;
            root.style-selected(style);
        }
    }

    // ── Chrome arrow (HF5): click-toggles the style menu; the chevron
    // flips with the state. Top-center, above the carousel, clear of the
    // bar's open position (y42) so neither steals clicks from the other. ──
    ChromeButton {
        x: (parent.width - self.width) / 2;
        y: 2px;
        open: root.style-menu-open;
        reduced-motion: root.reduced-motion;
        toggled => { root.style-menu-open = !root.style-menu-open; }
    }
}
