// HVE — Theme trust warning (W2, odd/tasks/theme-package-trust.md).
//
// The consent gate in front of BOTH theme-apply paths (gallery card and
// panel Save list): a package that carries shell hooks or Lua presets is
// not applied in silence. The warning names what the package carries,
// what it can do, and asks the keeper to continue only if he trusts
// where the theme came from. Nothing is filtered or rewritten: Continue
// applies the package exactly as an ungated apply would, Cancel changes
// nothing.
//
// Honest limit, stated IN the copy (and pinned by test): this is a
// CONSENT GATE, not a sandbox. Confirming lets the package's code run
// with the keeper's own permissions, and the copy must never be worded
// as if HVE prevented that.
//
// W2c: Continue is no longer a one-shot. The acceptance is REMEMBERED for
// exactly the content shown, so the warning does not come back until the
// package changes — and the copy says so. One state is the exception and
// says the opposite: a package part of which could not be INSPECTED is
// never remembered (HVE does not record what it could not read), so
// `acceptance-remembered` is false there and the copy promises nothing.
//
// The component takes the keyboard when it opens: its own observer on
// `open` focuses `trust-kbd`, the gate's FocusScope, so the modal owns
// every key while it is up (Left/Right/Tab move the cursor between
// Cancel and Continue, Return/Space activate it, Escape declines).
// When it closes, `ui/shell.slint` hands the keyboard back — never
// leaving focus on this hidden scope.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { ScrollView } from "std-widgets.slint";
import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";

export component TrustWarning inherits Rectangle {
    // What the detector reported, formatted by Rust as display lines.
    in property <string> theme-name: "";
    in property <[string]> hook-lines: [];
    in property <[string]> preset-lines: [];
    // W2c: whether Continue will remember this acceptance. False when part
    // of the package could not be inspected — HVE records nothing it could
    // not read, so the copy must not promise a silence it will not keep.
    in property <bool> acceptance-remembered: true;
    // The gate's open flag (bound from `trust-warning-open`) and the
    // app's reduced-motion flag: the fade is 0ms when motion is off.
    in property <bool> open: false;
    in property <bool> reduced-motion: false;
    // Continue applies the held theme; Cancel (and Escape) declines it.
    callback confirmed();
    callback cancelled();

    // Keyboard cursor over the two buttons: 0 = Cancel, 1 = Continue.
    // It starts (and resets) on Cancel, so a stray Enter can never
    // grant consent — Continue must be asked for deliberately.
    property <int> focused-button: 0;

    // A hidden gate is out of the render tree AND out of hit-testing, so
    // it can never swallow a click while closed.
    visible: root.open;
    opacity: root.open ? 1.0 : 0.0;
    animate opacity {
        duration: root.reduced-motion ? 0ms : SkwdTokens.anim-150;
        easing: cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    // The gate OWNS the keyboard while it is up: opening focuses the
    // scope below (programmatic, never from a click), and the cursor
    // always starts on Cancel. Closing does nothing here — the shell
    // gives the keyboard back to its previous owner (`ui/shell.slint`).
    changed open => {
        if (root.open) {
            root.focused-button = 0;
            trust-kbd.focus();
        }
    }

    width: 100%;
    height: 100%;
    // Dim scrim, same family as the shared dialogs but stronger: the gate
    // is modal, so the surface behind must read as inactive.
    background: #000000a6;

    // The scrim absorbs every click and declines — clicking outside the
    // card cancels. It is declared BEFORE the card, so the card and its
    // controls sit in front of it.
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: default;
        clicked => { root.cancelled(); }
    }

    card := Rectangle {
        width: Math.min(parent.width - 48px, 620px);
        height: Math.min(parent.height - 32px, 640px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: SkwdTokens.radius-12;
        background: HveColors.bg-surface;
        border-width: 1px;
        border-color: HveColors.accent-amber.transparentize(0.45);
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;
        clip: true;

        // The card absorbs clicks too: only the two buttons act. A
        // TouchArea ignores a wheel it has no handler for, so the list
        // below still scrolls.
        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: default;
        }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;

            Text {
                text: "This theme carries code";
                font-family: SkwdTokens.font-heading;
                font-size: SkwdTokens.size-18;
                font-weight: 700;
                color: HveColors.accent-amber;
            }

            Text {
                text: "\"" + root.theme-name + "\" carries the content below. HVE installs it unchanged when the theme is applied — nothing is removed or rewritten.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-13;
                color: HveColors.text;
                wrap: word-wrap;
            }

            // The carriers themselves, straight from the report. Scrolls
            // when a package carries more than fits; the buttons below
            // stay outside it and are always reachable.
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    // Pack the carriers at the top (repo convention, see
                    // SaveSection): without it the slack is spread between
                    // the lines and the list reads as unrelated blocks.
                    alignment: start;
                    spacing: 12px;

                    if (root.hook-lines.length > 0) : VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Shell hooks (" + root.hook-lines.length + ")";
                            font-family: SkwdTokens.font-heading;
                            font-size: SkwdTokens.size-13;
                            font-weight: 700;
                            color: HveColors.accent-amber;
                        }
                        Text {
                            text: "Commands this theme's provider runs on its own events (start, wallpaper change, colour change, shutdown).";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            color: HveColors.text-muted;
                            wrap: word-wrap;
                        }
                        for line in root.hook-lines : Text {
                            text: line;
                            font-family: SkwdTokens.font-mono;
                            font-size: SkwdTokens.size-12;
                            color: HveColors.text;
                            wrap: word-wrap;
                        }
                    }

                    if (root.preset-lines.length > 0) : VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Lua presets (" + root.preset-lines.length + ")";
                            font-family: SkwdTokens.font-heading;
                            font-size: SkwdTokens.size-13;
                            font-weight: 700;
                            color: HveColors.accent-amber;
                        }
                        Text {
                            text: "Files copied into your preset store and read by Hyprland when it assembles the overlay.";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            color: HveColors.text-muted;
                            wrap: word-wrap;
                        }
                        for line in root.preset-lines : Text {
                            text: line;
                            font-family: SkwdTokens.font-mono;
                            font-size: SkwdTokens.size-12;
                            color: HveColors.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Text {
                text: root.acceptance-remembered
                    ? "Only continue if you trust where this theme came from. The commands and scripts above run with your own permissions — the same access you have in a terminal. Continuing remembers this acceptance for this theme: HVE will not ask again while the content above stays exactly as it is, and it asks again as soon as any of it changes."
                    : "Only continue if you trust where this theme came from. The commands and scripts above run with your own permissions — the same access you have in a terminal. Part of this package could not be read, so this decision is NOT remembered: HVE asks again the next time you apply this theme.";
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-13;
                color: HveColors.text;
                wrap: word-wrap;
            }

            // The honest limit, deliberately hard to miss: consent is not
            // containment. HVE filters nothing and blocks nothing.
            Rectangle {
                border-radius: SkwdTokens.radius-8;
                background: HveColors.bg-card;
                border-width: 1px;
                border-color: HveColors.accent-amber.transparentize(0.55);

                VerticalLayout {
                    padding: 10px;
                    Text {
                        text: "This is a consent gate, not a sandbox: HVE does not filter, block or isolate any of it. If you continue, this theme's code runs as you.";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        color: HveColors.accent-amber;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: 6px;
                    // Icy keyboard ring, the same signal every keyboard
                    // cursor in this app paints (drawers, FilterBar).
                    property <bool> key-focused: trust-kbd.has-focus && root.focused-button == 0;
                    background: trust-cancel.has-hover ? HveColors.bg-hover : HveColors.bg-card;
                    border-width: self.key-focused ? 1.5px : 1px;
                    border-color: self.key-focused ? #8fd8ff : HveColors.border;
                    Text {
                        text: "Cancel";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        font-weight: 600;
                        color: HveColors.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    trust-cancel := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.cancelled(); }
                    }
                }

                Rectangle {
                    width: 112px;
                    height: 32px;
                    border-radius: 6px;
                    // Same ring on the primary button; border-width 0 at
                    // rest keeps the resting look byte-for-byte unchanged.
                    property <bool> key-focused: trust-kbd.has-focus && root.focused-button == 1;
                    background: trust-continue.has-hover
                        ? HveColors.accent-amber
                        : HveColors.accent-amber.transparentize(0.2);
                    border-width: self.key-focused ? 1.5px : 0px;
                    border-color: #8fd8ff;
                    Text {
                        text: "Continue";
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        font-weight: 700;
                        color: HveColors.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    trust-continue := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.confirmed(); }
                    }
                }
            }
        }
    }

    // ── Keyboard (W2b): the modal owns every key while it is up ──
    // Focused from the `open` observer above when the gate opens, handed
    // back by ui/shell.slint when it closes. Left/Right move the cursor
    // between Cancel and Continue, Tab is ACCEPTED (a rejected Tab would
    // walk focus out of the modal — it toggles the two stops instead),
    // Return/Space activate the focused button, Escape declines. The
    // icy ring on the focused button is the same keyboard cursor signal
    // the drawers and the FilterBar paint.
    trust-kbd := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-click: false;
        enabled: root.open;
        key-pressed(event) => {
            if (!root.open) { return reject; }
            if (event.text == Key.Escape) { root.cancelled(); return accept; }
            if (event.text == Key.LeftArrow) { root.focused-button = 0; return accept; }
            if (event.text == Key.RightArrow) { root.focused-button = 1; return accept; }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                root.focused-button = root.focused-button == 0 ? 1 : 0;
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                if (root.focused-button == 1) { root.confirmed(); }
                else { root.cancelled(); }
                return accept;
            }
            return reject;
        }
    }
}
