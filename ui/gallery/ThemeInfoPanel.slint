// HVE — ThemeInfoPanel (the theme info face, INSIDE the Slider card).
//
// The face the Slider shows on right-click / the `i` key. It is a slanted
// parallelogram in the card's own shape family, drawn INSIDE the theme's card
// and covering only ONE THIRD of it, so the theme's image stays visible and
// nothing floats over the window.
//
// The shear is derived from the panel's own height with the card's exact ratio
// (35px of shear per 520px of height), so the panel's slanted edges come out
// PARALLEL to the card's at any scale, with no extra plumbing.
//
// Layout note: the block's height is the layout's natural height and it is
// centred in the panel. A VerticalLayout inside a fixed-height parent would
// stretch its children across the whole face — that is the "floating rows" bug
// this avoids.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";

export struct ThemeInfoRow {
    label: string,
    value: string,
}

export struct ThemeInfoData {
    name: string,
    saved-at: string,
    providers: [string],
    swatches: [color],
    rows: [ThemeInfoRow],
}

export component ThemeInfoPanel inherits Rectangle {
    in property <ThemeInfoData> info;
    in property <bool> open: false;
    in property <bool> reduced-motion: false;

    width: 100%;
    height: 100%;
    background: transparent;

    // ── Geometry: one third of the face, full height, sheared with the card's
    // own ratio so the panel is parallel to the theme it sits in. Anchored to
    // the RIGHT edge of the card. ──
    property <float> hn: root.height / 1px;
    property <float> boxW: root.width / 1px;
    property <float> skn: root.hn * 35.0 / 520.0;
    property <float> wn: root.boxW / 3.0;
    property <float> padn: 18.0;
    property <float> pn: 4.0; // stroke room, same trick as the card
    property <float> slant: Math.sqrt(root.skn * root.skn + root.hn * root.hn);
    property <float> rn: Math.max(0.0, Math.min(
        SkwdTokens.radius-12 / 1px,
        root.wn / 2 - 1,
        root.hn / 2 - 1));
    property <float> box-wn: root.wn + root.skn;

    // The panel itself, anchored to the card's right edge. Closed it has NO
    // width and waits a little PAST the right edge, where the card's own clip
    // hides it, so opening it slides out of the card's right edge and unfolds,
    // and closing it contracts back into that same edge. `clip` is what makes
    // the contraction read: the content keeps its place and is revealed/cut
    // away by the panel's own edge instead of reflowing.
    property <length> panel-x: root.open
        ? (root.boxW - root.box-wn) * 1px
        : (root.boxW + 24.0) * 1px;
    property <length> panel-w: root.open ? root.box-wn * 1px : 0px;
    body := Rectangle {
        width: root.panel-w;
        height: 100%;
        x: root.panel-x;
        clip: true;
        opacity: root.open ? 1.0 : 0.0;
        animate x {
            duration: root.reduced-motion ? 0ms : 320ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        animate width {
            duration: root.reduced-motion ? 0ms : 320ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        animate opacity { duration: root.reduced-motion ? 0ms : 220ms; }

        // Rounded parallelogram, same command list as the card's own face
        // (vertices (shear,0)(shear+w,0)(w,h)(0,h), QuadTo at the slanted
        // corners), so the two shapes can never read as different families.
        face := Path {
            x: -root.pn * 1px;
            y: -root.pn * 1px;
            width: root.box-wn * 1px + 2 * root.pn * 1px;
            height: root.height + 2 * root.pn * 1px;
            viewbox-x: -root.pn;
            viewbox-y: -root.pn;
            viewbox-width: root.box-wn + 2 * root.pn;
            viewbox-height: root.hn + 2 * root.pn;
            fill: HveColors.bg-card.transparentize(0.25);
            stroke: HveColors.border;
            stroke-width: SkwdTokens.border-1;

            MoveTo { x: root.skn + root.rn; y: 0; }
            LineTo { x: root.skn + root.wn - root.rn; y: 0; }
            QuadraticTo {
                control-x: root.skn + root.wn;
                control-y: 0;
                x: root.skn + root.wn - root.skn * root.rn / root.slant;
                y: root.hn * root.rn / root.slant;
            }
            LineTo {
                x: root.wn + root.skn * root.rn / root.slant;
                y: root.hn - root.hn * root.rn / root.slant;
            }
            QuadraticTo {
                control-x: root.wn;
                control-y: root.hn;
                x: root.wn - root.rn;
                y: root.hn;
            }
            LineTo { x: root.rn; y: root.hn; }
            QuadraticTo {
                control-x: 0;
                control-y: root.hn;
                x: root.skn * root.rn / root.slant;
                y: root.hn - root.hn * root.rn / root.slant;
            }
            LineTo {
                x: root.skn - root.skn * root.rn / root.slant;
                y: root.hn * root.rn / root.slant;
            }
            QuadraticTo {
                control-x: root.skn;
                control-y: 0;
                x: root.skn + root.rn;
                y: 0;
            }
            Close { }
        }

        // Content inside the panel's slant-safe box: inset by the shear on the
        // left and by the padding on the right, so no line crosses a slanted
        // edge at any height.
        content := Rectangle {
            x: (root.skn + root.padn) * 1px;
            width: (root.wn - root.skn - 2.0 * root.padn) * 1px;
            height: content-layout.preferred-height;
            y: (parent.height - self.height) / 2;
            background: transparent;

            content-layout := VerticalLayout {
                spacing: SkwdTokens.spacing-8;

                Text {
                    text: root.info.name == "" ? "Theme information" : root.info.name;
                    color: HveColors.accent-cyan;
                    font-family: SkwdTokens.font-heading;
                    font-size: SkwdTokens.size-16;
                    font-weight: 700;
                    overflow: elide;
                }

                if root.info.saved-at != "" : Text {
                    text: "Saved " + root.info.saved-at;
                    color: HveColors.text-muted;
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    overflow: elide;
                }

                // Color swatches straight from the theme's own palette record.
                if root.info.swatches.length > 0 : HorizontalLayout {
                    spacing: SkwdTokens.spacing-8;
                    alignment: start;
                    for c in root.info.swatches : Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: SkwdTokens.radius-20;
                        background: c;
                        border-width: SkwdTokens.border-1;
                        border-color: HveColors.border.transparentize(0.5);
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // One line per fact: label on the left, value on the right.
                for r in root.info.rows : HorizontalLayout {
                    spacing: SkwdTokens.spacing-4;
                    Text {
                        text: r.label;
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: r.value;
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-12;
                        font-weight: 600;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if root.info.providers.length > 0 : HorizontalLayout {
                    spacing: SkwdTokens.spacing-4;
                    alignment: start;
                    for p in root.info.providers : Rectangle {
                        height: 20px;
                        width: provider-text.preferred-width + 16px;
                        border-radius: SkwdTokens.radius-4;
                        background: HveColors.bg-dark.transparentize(0.2);
                        border-width: SkwdTokens.border-1;
                        border-color: HveColors.border;
                        provider-text := Text {
                            text: p;
                            color: HveColors.text-muted;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}
