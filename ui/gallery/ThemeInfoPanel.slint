// HVE 2 — ThemeInfoPanel (the theme info face, INSIDE the Slider card).
//
// The face the Slider shows on right-click / the `i` key. It is drawn INSIDE
// the theme's own card, in the card's slant-safe box, so the theme's image
// contains it: nothing floats over the window and the carousel around it is
// untouched.
//
// It slides out from the card's own left edge (the clipped face box hides it
// while it is out of place), and it keeps the layout of the first version of
// this panel: title, saved date, palette swatches, one line per fact and the
// provider chips, all in one vertical block.
//
// Layout note: the block's height is the layout's natural height and it is
// centred in the face. A VerticalLayout inside a fixed-height parent would
// stretch its children across the whole face — that is the "floating rows" bug
// this avoids.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";

export struct ThemeInfoRow {
    label: string,
    value: string,
}

export struct ThemeInfoData {
    name: string,
    saved-at: string,
    providers: [string],
    swatches: [color],
    rows: [ThemeInfoRow],
}

export component ThemeInfoPanel inherits Rectangle {
    in property <ThemeInfoData> info;
    in property <bool> open: false;
    in property <bool> reduced-motion: false;

    width: 100%;
    height: 100%;
    background: transparent;

    // The face itself: opaque card surface. Closed it sits one full face to the
    // left, where the card's own clip hides it, so opening it slides out of the
    // card instead of appearing on top of it.
    body := Rectangle {
        width: 100%;
        height: 100%;
        background: HveColors.bg-card;
        x: root.open ? 0px : -root.width;
        opacity: root.open ? 1.0 : 0.0;
        animate x {
            duration: root.reduced-motion ? 0ms : 320ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        animate opacity { duration: root.reduced-motion ? 0ms : 220ms; }

        content := Rectangle {
            x: SkwdTokens.spacing-20;
            width: parent.width - 2 * SkwdTokens.spacing-20;
            height: content-layout.preferred-height;
            y: (parent.height - self.height) / 2;
            background: transparent;

            content-layout := VerticalLayout {
                spacing: SkwdTokens.spacing-8;

                Text {
                    text: root.info.name == "" ? "Theme information" : root.info.name;
                    color: HveColors.accent-cyan;
                    font-family: SkwdTokens.font-heading;
                    font-size: SkwdTokens.size-18;
                    font-weight: 700;
                    overflow: elide;
                }

                if root.info.saved-at != "" : Text {
                    text: "Saved " + root.info.saved-at;
                    color: HveColors.text-muted;
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-11;
                    overflow: elide;
                }

                // Color swatches straight from the theme's own palette record.
                if root.info.swatches.length > 0 : HorizontalLayout {
                    spacing: SkwdTokens.spacing-8;
                    alignment: start;
                    for c in root.info.swatches : Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: SkwdTokens.radius-20;
                        background: c;
                        border-width: SkwdTokens.border-1;
                        border-color: HveColors.border.transparentize(0.5);
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // One line per fact: label on the left, value on the right —
                // the layout of the first version of this panel.
                for r in root.info.rows : HorizontalLayout {
                    spacing: SkwdTokens.spacing-8;
                    Text {
                        text: r.label;
                        color: HveColors.text-muted;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-13;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: r.value;
                        color: HveColors.text;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-13;
                        font-weight: 600;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if root.info.providers.length > 0 : HorizontalLayout {
                    spacing: SkwdTokens.spacing-4;
                    alignment: start;
                    for p in root.info.providers : Rectangle {
                        height: 20px;
                        width: provider-text.preferred-width + 16px;
                        border-radius: SkwdTokens.radius-4;
                        background: HveColors.bg-dark.transparentize(0.2);
                        border-width: SkwdTokens.border-1;
                        border-color: HveColors.border;
                        provider-text := Text {
                            text: p;
                            color: HveColors.text-muted;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}
