// HVE — GalleryChrome (gallery-immersive-redesign PR4.4).
//
// Transparent chrome OVERLAY over the fullscreen gallery backdrop. The
// permanent toolbar and MIT footer were dismantled per spec (Floating
// FilterBar Chrome / design D10): style selection moved to FilterBar,
// attribution lives in a discrete bottom-right pill that opens mit-link.
// Keeps the preserved S18 empty-state banner.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";

export component GalleryChrome inherits Rectangle {
    // S18 empty state
    in property <bool> empty: false;
    in property <string> empty-text: "No themes yet. Save your current setup as a theme.";
    // R7/D10 MIT pill
    in property <string> mit-link: "https://github.com/liixini/skwd-wall";
    in property <bool> reduced-motion: false;
    callback mit-opened();

    // Overlay chrome paints nothing itself (live desktop stays visible).
    background: transparent;

    // ── S18 Empty state illustration + message (preserved requirement):
    // centered over the backdrop while the stage is empty. ──
    if root.empty : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width - 80px;
        height: 28px;
        background: HveColors.bg-dark.transparentize(0.5);
        border-radius: SkwdTokens.radius-8;
        Text {
            text: root.empty-text;
            color: HveColors.text-muted;
            font-size: SkwdTokens.size-11;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    // ── D10 MIT credit pill: bottom-right over the backdrop, 9px text at
    // outline @0.6 opacity; click reports mit-opened (Rust opens the link
    // via xdg-open with a constant argv). ──
    mit-pill := Rectangle {
        x: parent.width - self.width - SkwdTokens.spacing-16;
        y: parent.height - self.height - SkwdTokens.spacing-12;
        width: mit-text.preferred-width + 2 * SkwdTokens.spacing-8;
        height: 16px;
        border-radius: SkwdTokens.radius-8;
        background: #000000.transparentize(0.7);

        mit-text := Text {
            width: parent.width;
            height: parent.height;
            text: "skwd-wall (MIT, © liixini)";
            color: HveColors.text-muted.transparentize(0.6);
            font-size: 9px;
            font-family: SkwdTokens.font-body;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.mit-opened(); }
        }
    }
}
