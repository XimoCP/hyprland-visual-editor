// HVE 2 — MosaicCell (justified-rows rewrite, gallery-immersive-redesign).
//
// Full-bleed photo tile: the parent sets width/height from the Rust
// justified-rows model (mosaic.rs::justified_layout), whose aspects come
// from the display-aspect pattern ("real Pinterest") — tiles are
// INTENTIONALLY varied shapes, so each image fills its tile edge-to-edge
// with `image-fit: cover` (centered crop, user-approved). No frame, no
// focus stroke: images sit edge-to-edge separated only by the uniform
// gutter. Hero-preferred gating + shimmer + 200ms fade kept from 4.8/HF5.
// Translated from skwd-wall Mosaic (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";

export component MosaicCell inherits Rectangle {
    in property <string> card-name: "";
    in property <image> thumb;
    // Aspect-true hero decode (HF5): preferred over the thumb so tiles
    // show the large CONTAIN decode instead of a small portrait artifact.
    in property <image> hero;

    in property <float> cloud-opacity: 1.0; // driven by Rust cloud 0.55/1.05 smoothstep
    in property <int> cell-key: 0;
    in property <duration> reveal-delay: 0ms;
    // ── Curtain (Mosaic final scheme) — phase-driven wipe (D4) ──
    // Bumped by the parent on every page flip; drives the wipe cover.
    in property <int> flip-token: 0;
    // When true, skip the curtain (plain crossfade instead).
    in property <bool> reduced-motion: false;
    // Column stagger for this tile's curtain (ms).
    in property <int> delay-ms: 0;
    // Phase-driven curtain: parent animates 0→1, per-cell pure math cover.
    in property <float> curtain-phase: 1.0;
    in property <int> curtain-total-ms: 600;
    // Local progress: 0 → 1 as the sweep passes this tile.  Exposed so the
    // parent can force 1.0 for frozen under-tiles (no curtain animation).
    in-out property <float> curtain-progress: Math.max(0.0, Math.min(1.0, (root.curtain-phase * root.curtain-total-ms - root.delay-ms) / 300.0));
    // stagger alpha: 0 → 1 after reveal-delay
    in-out property <float> image-alpha: 1.0;
    animate image-alpha { duration: 250ms; easing: ease-in-out; delay: root.reveal-delay; }

    callback clicked();
    callback flip-requested();

    // ── Hover focus feedback (approved design): hovered tiles grow ~3%
    // from their center and brighten slightly — combined lift+brighten
    // reads as premium where a border alone feels rigid and illumination
    // alone is lost on dark photos. `transform-scale` affects RENDERING
    // only, so tile geometry, neighbor gutters and hit-testing never move;
    // reuses the EXISTING touch area's has-hover instead of stacking a
    // second TouchArea over it (click/right-click stay identical).
    // Clipping: MosaicView must keep clip:true for infinite-scroll tiling,
    // so only tiles within a few px of a stage edge lose that sliver of
    // growth behind the screen bounds — interior tiles lift freely into
    // the gutter. ──
    out property <bool> has-hover: touch.has-hover;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: root.has-hover ? SkwdTokens.gallery-card-hover-scale : 1.0;
    animate transform-scale { duration: SkwdTokens.anim-150; easing: ease-in-out; }

    clip: true;
    border-radius: 0px;

    // Background only ever shows through while the shimmer runs; once an
    // image lands it covers 100% of the tile.
    // Background hidden while this tile's sweep hasn't completed: the frozen
    // outgoing page (under layer) must show through un-swept regions so the
    // incoming wallpaper reads as a layer covering it (Tramo 9 effect).
    background: root.curtain-active && root.curtain-progress < 1.0
        ? Colors.transparent
        : HveColors.bg-card;
    opacity: root.cloud-opacity;
    animate opacity { duration: 200ms; easing: ease-out; }

    // ── Image pipeline (gallery-immersive-redesign 4.8 + HF5): prefer
    // the hero (≤1600×900 CONTAIN, aspect-true) and fall back to the
    // thumb until a hero lands — same gating pattern as SliceDelegate.
    // Shimmer runs until an effective image arrives, then a 200ms
    // OutCubic fade-in plays under the staggered reveal alpha. NO
    // source-clip here: it crops in SOURCE coordinates and would cut a
    // top-left sliver out of either artifact. ──
    property <image> effective-image: root.hero.width > 0 ? root.hero : root.thumb;
    property <bool> has-image: root.effective-image.width > 0;
    property <bool> shimmer-high: false;
    shimmer-timer := Timer {
        interval: 700ms;
        running: !parent.has-image;
        triggered => { parent.shimmer-high = !parent.shimmer-high; }
    }

    // Full-bleed effective image with staggered reveal — cover fit fills
    // each intentionally-varied tile edge-to-edge with a centered crop.
    // Hidden during curtain sweep so the wipe over the under-layer is clean.
    Image {
        width: 100%;
        height: 100%;
        source: root.effective-image;
        image-fit: cover;
        visible: root.has-image && root.content-visible;
        opacity: (root.has-image && root.content-visible ? 1.0 : 0.0) * root.image-alpha;
        // NO fade during the curtain: the cover vanishes at progress 1.0 and
        // the main image must take over INSTANTLY (same source + fit) or the
        // tile dips dark mid-flip (the seamless hard cut of Tramo 9).
        animate opacity {
            duration: root.curtain-active ? 0ms : SkwdTokens.anim-200;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        accessible-role: none;
    }

    shimmer := Rectangle {
        background: #000000;
        // Shimmer visible only when no image AND not during curtain sweep
        // (curtain cover replaces shimmer during the wipe).
        opacity: root.curtain-active ? 0.0
            : (root.has-image ? 0.0
                : (root.shimmer-high ? 0.06 : 0.16) * root.image-alpha);
        animate opacity {
            duration: root.has-image ? SkwdTokens.anim-200 : 600ms;
            easing: ease-in-out;
        }
    }

    // Brightness lift (approved design): thin white veil over the visible
    // photo only — empty/loading tiles keep the plain shimmer. Painted
    // under the label so the name stays crisp. Scales with the tile via
    // the root transform.
    hover-brighten := Rectangle {
        width: 100%;
        height: 100%;
        background: #ffffff;
        opacity: root.has-image && root.has-hover ? SkwdTokens.gallery-card-hover-brighten : 0.0;
        animate opacity { duration: SkwdTokens.anim-150; easing: ease-in-out; }
    }

    // ── Curtain cover (Tramo 9): growing clip sweeps LEFT→RIGHT, revealing
    // the incoming tile's hero over the outgoing under-layer.  The hero is
    // full-bleed inside the clip so its crop is STABLE (no per-frame zoom).
    // Content (image + name) stays hidden until progress reaches 1.0 so the
    // sweep reads as a clean wipe over the under-layer.
    property <bool> curtain-active: !root.reduced-motion && root.curtain-phase < 1.0;

    // Growing clip that reveals the incoming image from left to right.
    // The hero is sized to the full tile so its crop never changes during
    // the sweep (no zoom, no dim, no re-crop).  The un-swept region stays
    // transparent — the frozen under-layer (outgoing page) shows through.
    curtain-cover := Rectangle {
        visible: root.curtain-active && root.curtain-progress < 1.0;
        x: 0;
        width: root.width * root.curtain-progress;
        height: 100%;
        clip: true;
        Image {
            width: root.width;
            height: root.height;
            source: root.effective-image;
            image-fit: cover;
            accessible-role: none;
        }
    }

    // ── Image pipeline (gallery-immersive-redesign 4.8 + HF5): prefer
    // the hero (≤1600×900 CONTAIN, aspect-true) and fall back to the
    // thumb until a hero lands — same gating pattern as SliceDelegate.
    // Shimmer runs until an effective image arrives, then a 200ms
    // OutCubic fade-in plays under the staggered reveal alpha. NO
    // source-clip here: it crops in SOURCE coordinates and would cut a
    // top-left sliver out of either artifact.
    //
    // Content stays hidden while the curtain sweep hasn't reached this tile
    // (progress < 1.0) so the wipe over the under-layer is clean.
    property <bool> content-visible: root.curtain-phase >= 1.0 || root.curtain-progress >= 1.0;

    Text {
        visible: root.content-visible;
        text: root.card-name;
        color: HveColors.accent-cyan;
        font-size: SkwdTokens.size-11;
        overflow: elide;
        x: SkwdTokens.spacing-8;
        y: parent.height - 20px;
        width: parent.width - 2 * SkwdTokens.spacing-8;
        height: 16px;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.flip-requested();
            }
        }
    }
}
