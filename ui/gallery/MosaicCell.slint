// HVE 2 — MosaicCell (justified-rows rewrite, gallery-immersive-redesign).
//
// Full-bleed photo tile: the parent sets width/height from the Rust
// justified-rows model (mosaic.rs::justified_layout), whose aspects come
// from the display-aspect pattern ("real Pinterest") — tiles are
// INTENTIONALLY varied shapes, so each image fills its tile edge-to-edge
// with `image-fit: cover` (centered crop, user-approved). No frame, no
// focus stroke: images sit edge-to-edge separated only by the uniform
// gutter. Hero-preferred gating + shimmer + 200ms fade kept from 4.8/HF5.
// Translated from skwd-wall Mosaic (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";

export component MosaicCell inherits Rectangle {
    in property <string> card-name: "";
    in property <image> thumb;
    // Aspect-true hero decode (HF5): preferred over the thumb so tiles
    // show the large CONTAIN decode instead of a small portrait artifact.
    in property <image> hero;

    in property <float> cloud-opacity: 1.0; // driven by Rust cloud 0.55/1.05 smoothstep
    in property <int> cell-key: 0;
    in property <duration> reveal-delay: 0ms;
    // stagger alpha: 0 → 1 after reveal-delay
    in-out property <float> image-alpha: 1.0;
    animate image-alpha { duration: 250ms; easing: ease-in-out; delay: root.reveal-delay; }

    callback clicked();
    callback flip-requested();

    clip: true;
    border-radius: SkwdTokens.radius-8;
    // Background only ever shows through while the shimmer runs; once an
    // image lands it covers 100% of the tile.
    background: SkwdTokens.surface-container;
    opacity: root.cloud-opacity;
    animate opacity { duration: 200ms; easing: ease-out; }

    // ── Image pipeline (gallery-immersive-redesign 4.8 + HF5): prefer
    // the hero (≤1600×900 CONTAIN, aspect-true) and fall back to the
    // thumb until a hero lands — same gating pattern as SliceDelegate.
    // Shimmer runs until an effective image arrives, then a 200ms
    // OutCubic fade-in plays under the staggered reveal alpha. NO
    // source-clip here: it crops in SOURCE coordinates and would cut a
    // top-left sliver out of either artifact. ──
    property <image> effective-image: root.hero.width > 0 ? root.hero : root.thumb;
    property <bool> has-image: root.effective-image.width > 0;
    property <bool> shimmer-high: false;
    shimmer-timer := Timer {
        interval: 700ms;
        running: !parent.has-image;
        triggered => { parent.shimmer-high = !parent.shimmer-high; }
    }

    // Full-bleed effective image with staggered reveal — cover fit fills
    // each intentionally-varied tile edge-to-edge with a centered crop.
    Image {
        width: 100%;
        height: 100%;
        source: root.effective-image;
        image-fit: cover;
        visible: root.has-image;
        opacity: (root.has-image ? 1.0 : 0.0) * root.image-alpha;
        animate opacity {
            duration: SkwdTokens.anim-200;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        accessible-role: none;
    }

    shimmer := Rectangle {
        background: #000000;
        opacity: root.has-image ? 0.0
            : (root.shimmer-high ? 0.06 : 0.16) * root.image-alpha;
        animate opacity {
            duration: root.has-image ? SkwdTokens.anim-200 : 600ms;
            easing: ease-in-out;
        }
    }

    Text {
        text: root.card-name;
        color: SkwdTokens.primary;
        font-size: SkwdTokens.size-11;
        overflow: elide;
        x: SkwdTokens.spacing-8;
        y: parent.height - 20px;
        width: parent.width - 2 * SkwdTokens.spacing-8;
        height: 16px;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.flip-requested();
            }
        }
    }
}
