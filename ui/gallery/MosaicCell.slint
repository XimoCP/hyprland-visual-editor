// HVE 2 — MosaicCell (theme-gallery PR3 3.7; relaxed for masonry in PR5).
//
// Voronoi shard cell: polygon Path, kinetic scroll handled by parent,
// cloud opacity inner 0.55 outer 1.05, staggered reveal per cellKey.
// Translated from skwd-wall Mosaic (MIT, © liixini).
//
// PR5 (masonry span mosaic): the cell no longer fixes its own size — the
// parent sets width/height per slot geometry (mosaic.rs::mosaic_card_rect).
// The bbox-quad Path adapts via a pixel viewbox so it renders at both
// square (2·base × 2·base) and rect (2·base × base) slots with the same
// 6px inset. Images use image-fit contain centered: the FULL wallpaper is
// always visible (letterboxing on mismatched aspects is intended, never
// cropped).

import { SkwdTokens } from "../tokens.slint";

export component MosaicCell inherits Rectangle {
    in property <string> card-name: "";
    in property <color> accent: SkwdTokens.fallback-accent;
    in property <image> thumb;
    // Aspect-true hero decode (HF5): preferred over the 400×720 portrait
    // thumb so landscape masonry slots letterbox instead of shrinking a
    // cover-crop into a tiny centered image with giant side bands.
    in property <image> hero;
    // polygon vertices as flat arrays approximated via bbox quad (Voronoi shard)
    in property <length> vert-x0: 0px;
    in property <length> vert-y0: 0px;
    in property <length> vert-x1: 0px;
    in property <length> vert-y1: 0px;
    in property <length> vert-x2: 0px;
    in property <length> vert-y2: 0px;
    in property <length> vert-x3: 0px;
    in property <length> vert-y3: 0px;

    in property <float> cloud-opacity: 1.0; // driven by Rust cloud 0.55/1.05 smoothstep
    in property <bool> is-focused: false;
    in property <int> cell-key: 0;
    in property <duration> reveal-delay: 0ms;
    // stagger alpha: 0 → 1 after reveal-delay
    in-out property <float> image-alpha: 1.0;
    animate image-alpha { duration: 250ms; easing: ease-in-out; delay: root.reveal-delay; }

    callback clicked();
    callback flip-requested();

    // Size is parent-driven (masonry slot geometry, PR5). Cell edge in px
    // feeds the Path viewbox so the shard quad scales with any slot size.
    property <float> px-w: self.width / 1px;
    property <float> px-h: self.height / 1px;
    clip: true;
    border-radius: SkwdTokens.radius-8;
    background: SkwdTokens.surface-container;
    opacity: root.cloud-opacity;
    animate opacity { duration: 200ms; easing: ease-out; }

    // shard gap 6px via Path stroke gap visual — inset adapts to cell size
    cell-path := Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.px-w;
        viewbox-height: root.px-h;
        fill: SkwdTokens.surface;
        stroke: root.is-focused ? root.accent : transparent;
        stroke-width: root.is-focused ? 2px : 0px;
        MoveTo { x: 6; y: 6; }
        LineTo { x: root.px-w - 6; y: 6; }
        LineTo { x: root.px-w - 6; y: root.px-h - 6; }
        LineTo { x: 6; y: root.px-h - 6; }
        Close { }
    }

    // ── Image pipeline (gallery-immersive-redesign 4.8 + HF5): prefer
    // the hero (≤1600×900 CONTAIN, aspect-true) and fall back to the
    // thumb until a hero lands — same gating pattern as SliceDelegate.
    // Shimmer runs until an effective image arrives, then a 200ms
    // OutCubic fade-in plays under the staggered reveal alpha. NO
    // source-clip here: it crops in SOURCE coordinates and would cut a
    // top-left sliver out of either artifact. ──
    property <image> effective-image: root.hero.width > 0 ? root.hero : root.thumb;
    property <bool> has-image: root.effective-image.width > 0;
    property <bool> shimmer-high: false;
    shimmer-timer := Timer {
        interval: 700ms;
        running: !parent.has-image;
        triggered => { parent.shimmer-high = !parent.shimmer-high; }
    }

    // effective image with staggered reveal — contain centered: full
    // wallpaper visible (letterbox bands on aspect mismatch are intended)
    Image {
        width: 100%;
        height: 100%;
        source: root.effective-image;
        image-fit: contain;
        visible: root.has-image;
        opacity: (root.has-image ? 1.0 : 0.0) * root.image-alpha;
        animate opacity {
            duration: SkwdTokens.anim-200;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        accessible-role: none;
    }

    shimmer := Rectangle {
        background: #000000;
        opacity: root.has-image ? 0.0
            : (root.shimmer-high ? 0.06 : 0.16) * root.image-alpha;
        animate opacity {
            duration: root.has-image ? SkwdTokens.anim-200 : 600ms;
            easing: ease-in-out;
        }
    }

    // cloud opacity overlay hint (kinetic scroll)
    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        // focus ring already via stroke
    }

    Text {
        text: root.card-name;
        color: SkwdTokens.primary;
        font-size: SkwdTokens.size-11;
        overflow: elide;
        x: SkwdTokens.spacing-8;
        y: parent.height - 20px;
        width: parent.width - 2 * SkwdTokens.spacing-8;
        height: 16px;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.flip-requested();
            }
        }
    }
}
