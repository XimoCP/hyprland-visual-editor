// HVE — SliceDelegate (gallery-immersive-redesign PR2.6 + S4b baked).
//
// Parallelogram carousel card with skwd-wall exact geometry: collapsed
// 135 ↔ expanded 924 × 520 tall, spacing handled by SliceCarousel (−30
// overlap), 35px X-shear drawn as one rounded Path (design D3), radius 0
// default, 350ms OutCubic expand. S4b: tip-to-tip baked parallelogram-alpha
// images (slat-image / slat-expanded-image) — NO clip, alpha IS mask —
// border stroke painted ABOVE image so 2px icy cyan reads unmistakably.
// Dim lightened (0/0.08/0.16) and edge fade softened, shadows trimmed so
// 24px gaps read as background. Shimmer adapts to baked presence.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { HveColors } from "../theme.slint";
import { ThemeInfoPanel, ThemeInfoData } from "ThemeInfoPanel.slint";

// Shared rounded-parallelogram geometry (design D3/D4): ONE command list
// reused by the projected shadow and the face so both shapes can never
// desync. Viewbox mirrors the stroke-room contract from PR2.HF2 (pad per
// side, origin shifted, scale 1:1).
component SliceShape inherits Path {
    in property <float> wn;  // card width (unitless px)
    in property <float> hn;  // card height (520)
    in property <float> sn;  // skew shear (35)
    in property <float> rn;  // clamped corner radius
    in property <float> pn;  // stroke-room pad

    property <float> slant: Math.sqrt(self.sn * self.sn + self.hn * self.hn);

    viewbox-x: -pn;
    viewbox-y: -pn;
    viewbox-width: wn + sn + 2 * pn;
    viewbox-height: hn + 2 * pn;

    MoveTo { x: sn + rn; y: 0; }
    LineTo { x: sn + wn - rn; y: 0; }
    QuadraticTo { control-x: sn + wn; control-y: 0;
             x: sn + wn - sn * rn / slant; y: hn * rn / slant; }
    LineTo { x: wn + sn * rn / slant; y: hn - hn * rn / slant; }
    QuadraticTo { control-x: wn; control-y: hn;
             x: wn - rn; y: hn; }
    LineTo { x: rn; y: hn; }
    QuadraticTo { control-x: 0; control-y: hn;
             x: sn * rn / slant; y: hn - hn * rn / slant; }
    LineTo { x: sn - sn * rn / slant; y: hn * rn / slant; }
    QuadraticTo { control-x: sn; control-y: 0;
             x: sn + rn; y: 0; }
    Close { }
}

export component SliceDelegate inherits Rectangle {
    // ── Props ──
    in property <string> card-name: "Theme";
    in property <bool> is-current: false;
    in property <bool> is-hovered: false;
    in property <bool> is-flipped: false;
    // Theme info face (right-click / `i`): the data, whether it is open, and
    // which card it belongs to. The face renders only on the card it was
    // opened for, so navigating away can never show another theme's facts.
    in property <ThemeInfoData> info;
    in property <bool> info-open: false;
    in property <int> info-index: -1;
    in property <int> card-index: -1;
    in property <bool> reduced-motion: false;
    // True only on the card the info face belongs to. ONE source of truth for
    // the face's open state, its input gating and the layers it must hide.
    property <bool> info-shown: root.info-open && root.card-index == root.info-index;
    in property <color> accent: HveColors.accent-cyan;
    in property <image> thumb;
    // Tuck animation: 0 = normal gallery, 1 = hidden behind center (driven by SliceCarousel staggered tuck)
    in property <float> tuck: 0.0;
    // Aspect-true hero decode (HF5): large CONTAIN fit ≤1600×900 shown on
    // the expanded card instead of the stretched portrait thumb.
    in property <image> hero;
    // S4b baked parallelogram variants — tip-to-tip, no internal padding.
    // Collapsed bbox 146×520, expanded 959×520, alpha IS mask.
    in property <image> slat-image;
    in property <image> slat-expanded-image;
    in property <bool> has-video: false;
    // Depth-cue edge fade (design D4): computed by SliceCarousel from the
    // slice.rs-mirrored normDist curve; 1.0 = fully opaque.
    in property <float> fade-opacity: 1.0;
    // Fluid stage width propagated from GalleryRoot → SliceCarousel.
    in property <length> stage-width: 1920px;
    // V6 focus-flow: signed fractional distance from the traveling focus
    // (d = delta − frac). Drives position AND width through the closed-form
    // slot geometry (parity with slice.rs slot_width/slot_center, unit
    // tested) — the card grows about the traveling focus while neighbors
    // reflow, no per-instance animation state, retargets are exact.
    in property <float> slot-d: 0.0;
    // Coherent motion driver: live travel (focus-frac) from SliceCarousel.
    // ±1 during a step, 0 when settled — lets every card lean INTO the
    // movement direction and gives ALL tabs visible motion.
    in property <float> travel: 0.0;

    // Fluid scaled geometry: expanded = min(924, stage * 0.58) preserves the
    // skwd-wall ratios at every size (collapsed 0.146·expanded, height
    // 0.562·expanded, skew 0.0378·expanded, gap 24·scale). Large stages
    // (≥ ~1593) return the exact skwd values.
    property <float> stage-wn: root.stage-width / 1px;
    property <float> expanded-wn: root.stage-wn < 100.0 ? 924.0 : Math.min(924.0, root.stage-wn * 0.58);
    property <float> collapsed-wn: root.expanded-wn * 135.0 / 924.0;
    property <float> height-wn: root.expanded-wn * 520.0 / 924.0;
    property <float> skew-wn: root.expanded-wn * 35.0 / 924.0;
    property <float> gap-wn: root.expanded-wn * 24.0 / 924.0;
    property <float> ad: Math.abs(root.slot-d);
    property <float> expand-p: Math.max(0.0, Math.min(1.0, 1.0 - root.ad));
    property <float> width-wn: root.collapsed-wn + (root.expanded-wn - root.collapsed-wn) * root.expand-p;
    property <float> center-wn: (root.expanded-wn + root.collapsed-wn) / 2.0 * root.slot-d
        - (root.expanded-wn - root.collapsed-wn) / 2.0
        * (root.slot-d < 0 ? -1.0 : 1.0) * Math.max(root.ad - 1.0, 0.0);
    property <float> left-wn: root.center-wn - root.width-wn / 2.0;
    // Directional nudge: every card shifts a few px WITH the global travel,
    // strongest for collapsed slats (1−p → 1) and zero at the expanded center.
    // Makes motion coherent: sliding right pushes the whole strip left, sliding
    // left pushes right — the carousel visibly "breathes" in the travel direction.
    property <float> dir-nudge-wn: root.travel * 8.0 * (1.0 - root.expand-p);
    // Directional skew lean: collapsed cards tilt 4px into the wind, center stays straight.
    property <float> dir-skew-wn: root.travel * 4.0 * (1.0 - root.expand-p);
    // Continuous scale: collapsed 0.97 → expanded 1.0, so EVERY tab visibly
    // pulses as it approaches/leaves the center (not only the focused pair).
    property <float> motion-scale: 0.97 + 0.03 * root.expand-p;

    // Edge fade dissolves whole cards (image + shadow + dim) toward the
    // stage edges; 200ms matches the skwd depth-cue cadence.
    // When tucking (settings dock), side cards slide behind the central window (strip center).
    property <float> tucked-center-wn: -root.width-wn / 2.0;
    property <float> tuck-opacity: root.is-current ? 1.0 : (1.0 - root.tuck);
    opacity: root.fade-opacity * root.tuck-opacity;
    animate opacity { duration: SkwdTokens.anim-200; }

    // ── Motion scale (all tabs) + hover lift (approved design) ──
    // Every card now has continuous motion: collapsed 0.97 → expanded 1.0
    // driven by expand-p (visible on ALL visible slats), PLUS the hover 1.03
    // lift on top. Combined scale keeps the carousel alive even on distant
    // tabs, while the center still pops. transform-scale is render-only.
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    property <float> hover-lift: root.has-hover ? SkwdTokens.gallery-card-hover-scale : 1.0;
    transform-scale: root.motion-scale * self.hover-lift;
    animate transform-scale { duration: SkwdTokens.anim-150; easing: ease-in-out; }

    callback clicked();
    callback right-clicked();
    callback flipped();
    callback info-close();

    // ── Geometry: width and x come from the focus-flow formula above (V6).
    // The drawn face is a parallelogram whose top edge shifts right by the
    // 35px shear, so the Path bounding box is (face-width + skew) wide. S3
    // separated slats: the face is INSET within the slot by the air gap,
    // interpolated continuously with the expansion so the inset melts away
    // as the card grows (face = width − gap·(1−p), inset = gap/2·(1−p)).
    // V6.1: x is NOT independently animated — it tracks the single source
    // of truth `focus-pos` (already 350ms OutCubic) so every tab moves in
    // perfect lockstep. `dir-nudge` adds the coherent wind offset.
    // Skew also leans into travel direction for directional coherence.
    property <length> skew: (root.skew-wn + root.dir-skew-wn) * 1px;
    width: root.width-wn * 1px;
    height: root.height-wn * 1px;
    // When tucked, non-current cards slide behind center (x → center)
    property <float> tucked-x-wn: root.tucked-center-wn;
    x: root.is-current ? (root.left-wn + root.dir-nudge-wn) * 1px : (root.left-wn * (1.0 - root.tuck) + root.tucked-x-wn * root.tuck + root.dir-nudge-wn) * 1px;

    // S3 face inset, continuous with expansion (scaled gap).
    property <length> face-width: root.width - root.gap-wn * 1px * (1.0 - root.expand-p);
    property <length> face-inset: root.gap-wn * 1px / 2.0 * (1.0 - root.expand-p);
    property <float> faceWn: root.face-width / 1px;

    // Viewbox numbers (unitless): face spans (width + skew) × height.
    // wn retained for hit-test parity; shape geometry uses faceWn.
    property <float> wn: root.width / 1px;
    property <float> hn: root.height-wn;               // scaled 520·scale
    property <float> sn: root.skew-wn + root.dir-skew-wn; // leans into travel
    property <float> slant: Math.sqrt(sn * sn + hn * hn); // ≈ 521.18 at scale 1
    property <float> scale: root.expanded-wn / 924.0;
    // Corner radius clamped to half of the shortest adjacent edge minus 1
    // (skwd roundCorners clamp). Token default 0px → sharp parallelogram.
    // S3: clamp against the visible face width (faceWn) so the inset slat
    // and the full-width expanded card share the same radius logic.
    property <float> rn: Math.max(0.0, Math.min(
        SkwdTokens.gallery-slice-radius / 1px,
        faceWn / 2 - 1,
        slant / 2 - 1));

    // ── Face: rounded parallelogram Path (vertices (35,0)(35+w,0)(w,h)(0,h),
    // QuadTo rounding at each slant corner; r=0 degenerates to straight). ──
    // PR2.HF2: Slint clips a Path's paint to its own geometry box, so a
    // stroke centered on the shape border lost its outer half (1.5px of the
    // focused w3) wherever an edge coincided with the box. The box now grows
    // by a uniform stroke-room pad per side; the origin moves to -pad and the
    // viewbox shifts to -p so every vertex maps back to its exact original
    // position (scale stays 1:1) — same card, same place, full border.
    property <length> pad: 4px * root.scale; // scaled stroke-room (> 1.5px at any scale)
    property <float> pn: root.pad / 1px;

    // ── Projected shadow (design D4 / S4b trim): identical shapes
    // declared FIRST so they paint below the face; core current x4/y10
    // α0.35 / rest x2/y5 α0.18 preserves skwd identity. S4b trims collapsed
    // outward spread via tokens so the 24px air gap reads clean. Three
    // diffuse halos simulate Gaussian falloff — each step further and
    // fainter, so the hard Path edge reads as soft blur. All layers 200ms
    // and fade together via root fade-opacity. Order: faintest → strongest
    // → face. Scaled: offsets ride root.scale so shadows shrink with cards
    // and never clip the 24·scale gap. ──
    shadow-soft3 := SliceShape {
        x: -root.pad + root.face-inset + (root.is-current ? 12px * root.scale : SkwdTokens.gallery-slice-shadow-c4-x * root.scale);
        y: -root.pad + (root.is-current ? 24px * root.scale : SkwdTokens.gallery-slice-shadow-c4-y * root.scale);
        width: root.face-width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.faceWn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.03 : 0.015;
        animate opacity { duration: SkwdTokens.anim-200; }
        animate x { duration: SkwdTokens.anim-200; }
        animate y { duration: SkwdTokens.anim-200; }
    }
    shadow-soft2 := SliceShape {
        x: -root.pad + root.face-inset + (root.is-current ? 9px * root.scale : SkwdTokens.gallery-slice-shadow-c3-x * root.scale);
        y: -root.pad + (root.is-current ? 19px * root.scale : SkwdTokens.gallery-slice-shadow-c3-y * root.scale);
        width: root.face-width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.faceWn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.06 : 0.03;
        animate opacity { duration: SkwdTokens.anim-200; }
        animate x { duration: SkwdTokens.anim-200; }
        animate y { duration: SkwdTokens.anim-200; }
    }
    shadow-soft := SliceShape {
        x: -root.pad + root.face-inset + (root.is-current ? 6px * root.scale : SkwdTokens.gallery-slice-shadow-c2-x * root.scale);
        y: -root.pad + (root.is-current ? 14px * root.scale : SkwdTokens.gallery-slice-shadow-c2-y * root.scale);
        width: root.face-width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.faceWn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.15 : 0.08;
        animate opacity { duration: SkwdTokens.anim-200; }
        animate x { duration: SkwdTokens.anim-200; }
        animate y { duration: SkwdTokens.anim-200; }
    }
    shadow := SliceShape {
        x: -root.pad + root.face-inset + (root.is-current ? 4px * root.scale : SkwdTokens.gallery-slice-shadow-c1-x * root.scale);
        y: -root.pad + (root.is-current ? 10px * root.scale : SkwdTokens.gallery-slice-shadow-c1-y * root.scale);
        width: root.face-width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.faceWn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.35 : 0.18;
        animate opacity { duration: SkwdTokens.anim-200; }
        animate x { duration: SkwdTokens.anim-200; }
        animate y { duration: SkwdTokens.anim-200; }
    }

    // ── Baked image layers (V6 skwd window-reveal): skwd-wall renders ONE
    // image per card and lets the animating box reveal more/less of it; the
    // mask follows the box live. Slint 1.17 has no live mask, so the
    // parallelogram is baked into the alpha — which used to force an
    // instant source swap: the collapsed bake (146px) cover-fitted into the
    // still-wide box zoomed ~6.6× ("giant image that squeezes down").
    // Instead BOTH bakes render at natural 1:1 scale, horizontally centered
    // in the animating face box (both are height-fit at 520 and center-
    // cropped, so the collapsed bake IS the center strip of the expanded
    // one — pixel-aligned content):
    //   * expanded bake: world-pinned content window; the box grows/shrinks
    //     around it WITHOUT any zoom (skwd expand/contract feel);
    //   * collapsed bake on top: identical content, so it only matters at
    //     box≈146 where its baked slant mask owns the corners (expanded
    //     hidden there via the reveal driver);
    //   * legacy cover fallback when the expanded bake is missing.
    // Settled states are pixel-identical to the approved S4b look. ──
    property <bool> has-expanded-baked: root.slat-expanded-image.width > 0;
    property <bool> has-baked: root.slat-image.width > 0;
    // Baked bboxes = drawn bbox (face-width + skew): collapsed 146, expanded 959 at scale 1, scaled thereafter.
    property <float> collapsed-bbox-wn: root.collapsed-wn - root.gap-wn + root.skew-wn;
    property <float> expanded-bbox-wn: root.expanded-wn + root.skew-wn;
    // Reveal driver: 0 while the box is at the collapsed bbox (collapsed
    // mask owns the corners), 1 past ~14% of the bbox travel — rides the
    // live width so both directions stay symmetric with no extra timing.
    property <float> reveal-window: Math.max(1.0, (root.expanded-bbox-wn - root.collapsed-bbox-wn) * 0.14);
    property <float> expanded-reveal: Math.max(0.0, Math.min(1.0,
        ((root.face-width + root.skew) / 1px - root.collapsed-bbox-wn) / root.reveal-window));

    // Shimmer while a card has no baked image yet (bakes are produced fully
    // decoded in memory, so there is no decode preheat delay — the image
    // shows the moment it exists).
    property <bool> shimmer-high: false;
    shimmer-timer := Timer {
        interval: 700ms;
        running: !root.has-baked;
        triggered => { root.shimmer-high = !root.shimmer-high; }
    }

    if !is-flipped : Rectangle {
        x: root.face-inset;
        y: 0;
        width: root.face-width + root.skew;
        height: root.height;
        clip: true;

        // Shimmer backdrop while waiting for baked image.
        shimmer-bg := Rectangle {
            width: 100%;
            height: 100%;
            background: SkwdTokens.surface;
            opacity: root.has-baked ? 0.0 : 1.0;
            animate opacity { duration: SkwdTokens.anim-200; }
            Rectangle {
                background: #000000;
                opacity: root.has-baked ? 0.0 : (root.shimmer-high ? 0.06 : 0.16);
                animate opacity { duration: 600ms; easing: ease-in-out; }
                Text {
                    text: "◇";
                    color: accent.transparentize(0.4);
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Legacy fallback (expanded bake missing): single cover image —
        // transient path while a theme's expanded bake is still cooking.
        if !root.has-expanded-baked : Image {
            width: 100%;
            height: 100%;
            source: root.slat-image;
            image-fit: cover;
            visible: root.has-baked;
            opacity: root.has-baked ? 1.0 : 0.0;
            animate opacity {
                duration: SkwdTokens.anim-200;
                easing: cubic-bezier(0.215, 0.61, 0.355, 1);
            }
            accessible-role: none;
        }

        // Expanded bake: natural 959×520, centered — world-pinned window.
        if root.has-expanded-baked : Image {
            width: root.expanded-bbox-wn * 1px;
            height: SkwdTokens.gallery-slice-h;
            x: (parent.width - self.width) / 2;
            source: root.slat-expanded-image;
            visible: root.has-baked && root.expanded-reveal > 0.0;
            opacity: root.has-baked ? root.expanded-reveal : 0.0;
            animate opacity { duration: 100ms; }
            accessible-role: none;
        }

        // Collapsed bake: natural 146×520, centered on top — its slant mask
        // owns the corners near the collapsed bbox; crossfades OUT as the
        // box grows (16:9 sources bake the two variants at slightly
        // different scales, so both layers must swap via fade, never stack
        // at full opacity).
        if root.has-expanded-baked : Image {
            width: root.collapsed-bbox-wn * 1px;
            height: SkwdTokens.gallery-slice-h;
            x: (parent.width - self.width) / 2;
            source: root.slat-image;
            visible: root.has-baked && root.expanded-reveal < 1.0;
            opacity: root.has-baked ? (1.0 - root.expanded-reveal) : 0.0;
            animate opacity { duration: 100ms; }
            accessible-role: none;
        }

        // Video overlay (Timer 100-300ms, release on blur S16/17)
        // Only on current card with has-video — sits above the baked image
        // but below the label scrim. Preserve original placement.
        if root.is-current && root.has-video : Rectangle {
            width: 36px;
            height: 24px;
            x: parent.width - self.width - SkwdTokens.spacing-8;
            y: SkwdTokens.spacing-8;
            border-radius: SkwdTokens.radius-4;
            background: #000000.transparentize(0.3);
            Text {
                text: "▶";
                color: #ffffff;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            opacity: root.info-shown ? 0.0 : (video-playing ? 1.0 : 0.6);
            animate opacity { duration: 150ms; easing: ease-in-out; }
        }

        // Bottom label — overlayed over the baked image (edge-to-edge).
        // Constrained to the slant-safe zone [skew .. width] so the bar
        // never crosses the slanted card edges. Semi-transparent scrim
        // keeps text legible on bright wallpapers.
        label-scrim := Rectangle {
            x: root.skew;
            y: parent.height - 28px;
            width: root.face-width - root.skew;
            height: 28px;
            // The face is translucent, so the theme's own label would ghost
            // through the sheet while it is open: it fades out with the slide
            // (opacity, not `visible`, so the frame at t=0 still matches the
            // closed one — the face must not pop in).
            opacity: root.info-shown ? 0.0 : 1.0;
            animate opacity { duration: root.reduced-motion ? 0ms : 200ms; }
            background: #000000.transparentize(0.45);
            Text {
                text: root.card-name;
                color: #ffffff;
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-14;
                font-weight: 600;
                overflow: elide;
                x: SkwdTokens.spacing-8;
                width: parent.width - 2 * SkwdTokens.spacing-8;
                height: 100%;
                vertical-alignment: center;
            }
        }

        // ── Theme info face, INSIDE the card and inside this clipped box, so
        // the theme's own image contains it: closed it sits one face to the
        // left (hidden by the clip) and opening it slides out from the card's
        // left edge. It lives here — not gated on `is-current` — because the
        // element must already exist for the open transition to animate; only
        // the card its index names ever opens it. ──
        ThemeInfoPanel {
            x: 0px;
            width: root.face-width + root.skew;
            height: 100%;
            info: root.info;
            open: root.info-shown;
            reduced-motion: root.reduced-motion;
        }
    }

    // Back face rides in the same slant-safe mask box (S3 inset).
    if is-flipped : Rectangle {
        clip: true;
        x: root.face-inset + root.skew;
        width: root.face-width - root.skew;
        height: 100%;

        VerticalLayout {
            padding: SkwdTokens.spacing-12;
            spacing: SkwdTokens.spacing-8;
            opacity: is-flipped ? 1.0 : 0.0;
            animate opacity { duration: 400ms; easing: cubic-bezier(0.455, 0.03, 0.515, 0.955); }

            Text {
                text: root.card-name + " — details";
                color: HveColors.accent-cyan;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
            }
            Text {
                text: "VIEW  RETAG  DELETE  STEAM";
                color: HveColors.text-muted;
                font-size: SkwdTokens.size-13;
            }
        }
    }

    // ── Dim overlay (S4b tune: 0 / 0.08 / 0.16 via tokens) — black veil
    // over the baked image, painted ABOVE image but BELOW border so border
    // stays crisp. Same SliceShape geometry. ──
    dim := SliceShape {
        x: -root.pad + root.face-inset;
        y: -root.pad;
        width: root.face-width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.faceWn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.0 : (root.has-hover ? SkwdTokens.gallery-slice-dim-hover : SkwdTokens.gallery-slice-dim-idle);
        animate opacity { duration: SkwdTokens.anim-200; }
    }

    // ── Hover brighten (approved design): thin white veil over the
    // parallelogram face, completing the lift+brighten focus cue. Gated to
    // the FRONT face with a decoded baked image — empty/loading or flipped
    // cards skip the veil (shimmer/metadata stay neutral). Painted above
    // the dim layer so the net effect brightens even idle-dimmed cards.
    // S3 inset. Border paints above this so brighten never washes border. ──
    hover-brighten := SliceShape {
        x: -root.pad + root.face-inset;
        y: -root.pad;
        width: root.face-width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.faceWn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #ffffff;
        opacity: !root.is-flipped && !root.info-shown && root.has-baked && root.has-hover
            ? SkwdTokens.gallery-card-hover-brighten : 0.0;
        animate opacity { duration: SkwdTokens.anim-150; easing: ease-in-out; }
    }

    // ── Focus glow (S3): icy cyan outer halo behind the 2px border.
    // Expanded only, soft outer glow so the border reads unmistakable
    // even under distance-tiered paint. Tokenized width/opacity.
    // Painted ABOVE image/dim/brighten, BELOW border. ──
    focus-glow := SliceShape {
        x: -root.pad + root.face-inset;
        y: -root.pad;
        width: root.face-width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.faceWn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: transparent;
        stroke: SkwdTokens.gallery-slice-focus-border-color;
        stroke-width: SkwdTokens.gallery-slice-focus-glow-width;
        opacity: root.is-current ? SkwdTokens.gallery-slice-focus-glow-opacity : 0.0;
        animate opacity { duration: SkwdTokens.anim-200; }
    }

    // ── Border on top (S4b): stroke-only outline ABOVE the baked image
    // so the full 2px icy cyan traces the parallelogram unmistakably.
    // Fill transparent — only stroke paints. Hover/idle use existing subtle
    // strokes; current uses icy cyan 2px. Stroke-room pad keeps outer half
    // uncut. ──
    border-top := SliceShape {
        x: -root.pad + root.face-inset;
        y: -root.pad;
        width: root.face-width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.faceWn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: transparent;
        stroke: root.is-current ? SkwdTokens.gallery-slice-focus-border-color
            : root.has-hover ? HveColors.accent-cyan.transparentize(0.6)
            : #000000.transparentize(0.4);
        stroke-width: root.is-current ? SkwdTokens.border-2 : 1px;
        animate stroke { duration: SkwdTokens.anim-200; }
        animate stroke-width { duration: SkwdTokens.anim-200; }
    }

    // ── Video Timer 100-300ms (default 200): Timer triggered → playing ──
    // Spec S16: start after 100-300ms when card becomes current; S17: release on blur.
    property <bool> video-playing: false;
    property <duration> video-delay: 200ms;
    // Clamp logic lives in Rust SliceView::video_delay_ms; Slint uses the bound value.
    video-timer := Timer {
        interval: root.video-delay;
        running: root.is-current && root.has-video && !root.video-playing;
        triggered => {
            root.video-playing = true;
        }
    }
    // Release on blur: when is-current becomes false, reset playing
    states [
        blurred when !root.is-current : {
            video-playing: false;
        }
    ]
    // Also stop timer when flipped (back face shows metadata, not preview)
    out property <bool> has-hover: touch.has-hover;
    // Hover routing for the three-layer paint order (design D4): the
    // carousel lifts the hovered card one layer above idle siblings.
    changed has-hover => { root.hovered(self.has-hover); }
    callback hovered(bool);

    // ── Hit-test mask non-rect (parallelogram) ──
    // TouchArea covers the bounding rect, but we gate clicks with
    // point_in_parallelogram math (same as SliceView::point_in_parallelogram
    // Rust side, skew 28). Points outside the slanted shape are rejected.
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        // Non-rect containment S3 inset: face is centered within the
        // slot (face-inset = gap/2 for collapsed, 0 for expanded).
        property <bool> is-inside-shape: {
            if (self.mouse-x < 0px || self.mouse-y < 0px || self.mouse-x > root.width || self.mouse-y > root.height) {
                false
            } else {
                let t = self.mouse-y / root.height;
                let left = root.face-inset + root.skew * (1 - t);
                let right = left + (root.face-width - root.skew);
                self.mouse-x >= left && self.mouse-x <= right
            }
        }

        clicked => {
            if (self.is-inside-shape) {
                // With the info face open, a click on it is a read action, not
                // an apply: the face is a panel, not a button.
                if (!root.info-shown) {
                    root.clicked();
                }
            }
        }

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                if (self.is-inside-shape) {
                    // Right-click inside the open face closes it (the toggle);
                    // anywhere else it is the request that opens it.
                    if (root.info-shown) {
                        root.info-close();
                    } else {
                        root.right-clicked();
                        root.flipped();
                    }
                }
            }
        }
    }

    // ── Theme info face is drawn INSIDE the card's clipped face box (see
    // above); its input is handled by this card's own TouchArea so the face
    // never needs a second hit area stacked over the carousel. ──
}
