// HVE 2 — SliceDelegate (gallery-immersive-redesign PR2.6).
//
// Parallelogram carousel card with skwd-wall exact geometry: collapsed
// 135 ↔ expanded 924 × 520 tall, spacing handled by SliceCarousel (−30
// overlap), 35px X-shear drawn as one rounded Path (design D3), radius 0
// default, 350ms OutCubic expand. Border per the skwd-wall contract was
// restored in PR2.HF (Path stroke: focused primary w3 / hover primary@40%
// w1 / idle black@60% w1) and given stroke-room in PR2.HF2 so the border
// renders uncut on all four edges. Flip stays a crossfade until the real two-phase
// squeeze lands (PR5). Shadow/dim remain PR3 depth cues.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";

// Shared rounded-parallelogram geometry (design D3/D4): ONE command list
// reused by the projected shadow and the face so both shapes can never
// desync. Viewbox mirrors the stroke-room contract from PR2.HF2 (pad per
// side, origin shifted, scale 1:1).
component SliceShape inherits Path {
    in property <float> wn;  // card width (unitless px)
    in property <float> hn;  // card height (520)
    in property <float> sn;  // skew shear (35)
    in property <float> rn;  // clamped corner radius
    in property <float> pn;  // stroke-room pad

    property <float> slant: Math.sqrt(self.sn * self.sn + self.hn * self.hn);

    viewbox-x: -pn;
    viewbox-y: -pn;
    viewbox-width: wn + sn + 2 * pn;
    viewbox-height: hn + 2 * pn;

    MoveTo { x: sn + rn; y: 0; }
    LineTo { x: sn + wn - rn; y: 0; }
    QuadraticTo { control-x: sn + wn; control-y: 0;
             x: sn + wn - sn * rn / slant; y: hn * rn / slant; }
    LineTo { x: wn + sn * rn / slant; y: hn - hn * rn / slant; }
    QuadraticTo { control-x: wn; control-y: hn;
             x: wn - rn; y: hn; }
    LineTo { x: rn; y: hn; }
    QuadraticTo { control-x: 0; control-y: hn;
             x: sn * rn / slant; y: hn - hn * rn / slant; }
    LineTo { x: sn - sn * rn / slant; y: hn * rn / slant; }
    QuadraticTo { control-x: sn; control-y: 0;
             x: sn + rn; y: 0; }
    Close { }
}

export component SliceDelegate inherits Rectangle {
    // ── Props ──
    in property <string> card-name: "Theme";
    in property <bool> is-current: false;
    in property <bool> is-hovered: false;
    in property <bool> is-flipped: false;
    in property <color> accent: SkwdTokens.fallback-accent;
    in property <image> thumb;
    // Aspect-true hero decode (HF5): large CONTAIN fit ≤1600×900 shown on
    // the expanded card instead of the stretched portrait thumb.
    in property <image> hero;
    in property <bool> has-video: false;
    // Depth-cue edge fade (design D4): computed by SliceCarousel from the
    // slice.rs-mirrored normDist curve; 1.0 = fully opaque.
    in property <float> fade-opacity: 1.0;

    // Edge fade dissolves whole cards (image + shadow + dim) toward the
    // stage edges; 200ms matches the skwd depth-cue cadence.
    opacity: root.fade-opacity;
    animate opacity { duration: SkwdTokens.anim-200; }

    // ── Hover focus feedback (approved design): hovered cards grow ~3%
    // from their visual center and brighten slightly — combined
    // lift+brighten reads as premium where a border alone feels rigid and
    // illumination alone is lost on dark images. Reuses the EXISTING touch
    // area's has-hover (declared below) so clicks, right-click flip and
    // the non-rect hit gate stay untouched. transform-scale affects
    // RENDERING only: layout box and hit regions never move. Exit snaps
    // back instantly like the stroke/dim cues because the carousel swaps
    // hover visibility between paint-pass copies. Stage clips stay required
    // (cards travel beyond both edges); only cards within a few px of a
    // window edge lose that sliver of growth behind screen bounds. ──
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: root.has-hover ? SkwdTokens.gallery-card-hover-scale : 1.0;
    animate transform-scale { duration: SkwdTokens.anim-150; easing: ease-in-out; }

    callback clicked();
    callback right-clicked();
    callback flipped();

    // ── Geometry (design D3): card spans width × 520; the drawn face is a
    // parallelogram whose top edge shifts right by the 35px shear, so the
    // Path bounding box is (width + skew) wide. ──
    property <length> skew: SkwdTokens.gallery-slice-skew-offset; // 35px X-shear
    width: is-current ? SkwdTokens.gallery-slice-expanded-w : SkwdTokens.gallery-slice-w;
    height: SkwdTokens.gallery-slice-h;
    animate width {
        duration: SkwdTokens.anim-expand;
        easing: cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    // Viewbox numbers (unitless): face spans (width + skew) × height.
    property <float> wn: root.width / 1px;
    property <float> hn: root.height / 1px;               // 520
    property <float> sn: root.skew / 1px;                 // 35
    property <float> slant: Math.sqrt(sn * sn + hn * hn); // ≈ 521.18
    // Corner radius clamped to half of the shortest adjacent edge minus 1
    // (skwd roundCorners clamp). Token default 0px → sharp parallelogram.
    property <float> rn: Math.max(0.0, Math.min(
        SkwdTokens.gallery-slice-radius / 1px,
        wn / 2 - 1,
        slant / 2 - 1));

    // ── Face: rounded parallelogram Path (vertices (35,0)(35+w,0)(w,h)(0,h),
    // QuadTo rounding at each slant corner; r=0 degenerates to straight). ──
    // PR2.HF2: Slint clips a Path's paint to its own geometry box, so a
    // stroke centered on the shape border lost its outer half (1.5px of the
    // focused w3) wherever an edge coincided with the box. The box now grows
    // by a uniform stroke-room pad per side; the origin moves to -pad and the
    // viewbox shifts to -p so every vertex maps back to its exact original
    // position (scale stays 1:1) — same card, same place, full border.
    property <length> pad: 4px; // > focused stroke half-width (1.5px)
    property <float> pn: root.pad / 1px;

    // ── Projected shadow (design D4 / skwd exact): identical shapes
    // declared FIRST so they paint below the face; core (skwd baseline)
    // current x4/y10 α0.35 / rest x2/y5 α0.18 preserves skwd identity.
    // Three diffuse halos simulate a Gaussian falloff — each step further
    // (+2, +5, +8px beyond core) and fainter, so the hard Path edge reads
    // as a soft blur. All layers 200ms and fade together via root
    // fade-opacity. Outermost +24px stays inside the centered stage viewport
    // (SliceCarousel clip:true line 30, ~500px margin), so no ancestor
    // clip:false is needed. Order: faintest → strongest → face. ──
    shadow-soft3 := SliceShape {
        x: -root.pad + (root.is-current ? 12px : 7px);
        y: -root.pad + (root.is-current ? 24px : 16px);
        width: root.width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.wn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.03 : 0.015;
        animate opacity { duration: SkwdTokens.anim-200; }
        animate x { duration: SkwdTokens.anim-200; }
        animate y { duration: SkwdTokens.anim-200; }
    }
    shadow-soft2 := SliceShape {
        x: -root.pad + (root.is-current ? 9px : 5px);
        y: -root.pad + (root.is-current ? 19px : 12px);
        width: root.width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.wn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.06 : 0.03;
        animate opacity { duration: SkwdTokens.anim-200; }
        animate x { duration: SkwdTokens.anim-200; }
        animate y { duration: SkwdTokens.anim-200; }
    }
    shadow-soft := SliceShape {
        x: -root.pad + (root.is-current ? 6px : 3px);
        y: -root.pad + (root.is-current ? 14px : 8px);
        width: root.width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.wn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.15 : 0.08;
        animate opacity { duration: SkwdTokens.anim-200; }
        animate x { duration: SkwdTokens.anim-200; }
        animate y { duration: SkwdTokens.anim-200; }
    }
    shadow := SliceShape {
        x: -root.pad + (root.is-current ? 4px : 2px);
        y: -root.pad + (root.is-current ? 10px : 5px);
        width: root.width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.wn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.35 : 0.18;
        animate opacity { duration: SkwdTokens.anim-200; }
        animate x { duration: SkwdTokens.anim-200; }
        animate y { duration: SkwdTokens.anim-200; }
    }

    // ── Focus glow (S2): subtle outer halo behind the bright border.
    // Primary 6px stroke at low opacity, only on expanded (is-current), gives
    // the light/cyan glowing outline from the reference while reusing the
    // existing SkwdTokens.primary token and its 200ms cadence.
    focus-glow := SliceShape {
        x: -root.pad;
        y: -root.pad;
        width: root.width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.wn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: transparent;
        stroke: SkwdTokens.primary;
        stroke-width: 6px;
        opacity: root.is-current ? 0.22 : 0.0;
        animate opacity { duration: SkwdTokens.anim-200; }
    }

    // ── Face: same geometry, painted above the shadow; border per the
    // skwd-wall contract restored in PR2.HF/HF2 — current primary w3 /
    // hover primary@40% w1 / idle black@60% w1, now at the skwd 200ms
    // glow cadence (task 3.6): strokes cross-fade as state changes on a
    // live instance (e.g. hover glow-in on the hovered layer copy). ──
    face := SliceShape {
        x: -root.pad;
        y: -root.pad;
        width: root.width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.wn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: root.is-flipped ? SkwdTokens.surface-container : SkwdTokens.surface;
        stroke: root.is-current ? SkwdTokens.primary
            : root.has-hover ? SkwdTokens.primary.transparentize(0.6)
            : #000000.transparentize(0.4);
        stroke-width: root.is-current ? 3px : 1px;
        animate stroke { duration: SkwdTokens.anim-200; }
        animate stroke-width { duration: SkwdTokens.anim-200; }
    }

    // ── Face mask container (design D3): clip:true box covering the FULL
    // parallelogram bounding box [0 .. width+skew]. The wallpaper Image
    // fills this box edge-to-edge and the two outside-face corners are
    // masked by the slant-mask Path below (rectangular clips cannot follow
    // the slant) so the image reads as clipped BY the card, not floating
    // over it. Labels stay inside the slant-safe zone [skew .. width]. ──
    if !is-flipped : Rectangle {
        clip: true;
        x: 0px;
        width: root.width + root.skew;
        height: 100%;

        // ── Full-bleed wallpaper (edge-to-edge cover, center crop).
        // Single effective-image (hero → thumb) mirrors MosaicCell; no
        // source-clip — source-clip crops in SOURCE coordinates and would
        // slice the ≤1600×900 hero incorrectly. Plain cover on a
        // full-bounds Image is enough; cropping is accepted (same as
        // Mosaic). The Image spans 100% × 100% of the face mask so both
        // expanded (924) and collapsed (135) cards fill width without
        // side padding or letterboxing. Shimmer + 120ms preheat gate
        // kept from PR2.HF.c; `fill` remains banned (stretch).
        image-layer := Rectangle {
            width: 100%;
            height: 100%;
            clip: true;
            background: SkwdTokens.surface;
            opacity: is-flipped ? 0.0 : 1.0;
            animate opacity { duration: 400ms; easing: cubic-bezier(0.455, 0.03, 0.515, 0.955); }

            property <bool> preheat-done: false;
            // Effective image: hero when available on the expanded card,
            // otherwise thumb fallback — same gating as MosaicCell.
            property <image> effective-image: root.hero.width > 0 && root.is-current ? root.hero : root.thumb;
            property <bool> has-image: self.preheat-done && self.effective-image.width > 0;

            preheat-timer := Timer {
                interval: 120ms;
                running: !parent.preheat-done;
                triggered => {
                    parent.preheat-done = true;
                    self.running = false;
                }
            }

            // Shimmer: accent-tinted veil pulsing while waiting (Timer-driven
            // phase alternation; stops once the effective image arrives).
            property <bool> shimmer-high: false;
            shimmer-timer := Timer {
                interval: 700ms;
                running: !parent.has-image;
                triggered => { parent.shimmer-high = !parent.shimmer-high; }
            }

            shimmer := Rectangle {
                background: #000000;
                opacity: parent.has-image ? 0.0
                    : (parent.shimmer-high ? 0.06 : 0.16);
                animate opacity { duration: 600ms; easing: ease-in-out; }
                Text {
                    text: "◇";
                    color: accent.transparentize(0.4);
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Edge-to-edge cover — spans full bounds, no source-clip,
            // no letterboxing, center crop on overflow.
            cover-image := Image {
                width: 100%;
                height: 100%;
                source: parent.effective-image;
                image-fit: cover;
                visible: parent.has-image;
                opacity: parent.has-image ? 1.0 : 0.0;
                animate opacity {
                    duration: SkwdTokens.anim-200;
                    easing: cubic-bezier(0.215, 0.61, 0.355, 1);
                }
                accessible-role: none;
            }

            // Slant masks: the clip box is rectangular but the card is a
            // parallelogram, so the two outside-face corners of the bounding
            // box get covered with triangles filled exactly like the face
            // (surface). One Path, two contours, 1:1 viewbox mapping.
            slant-mask := Path {
                x: 0;
                y: 0;
                width: root.width + root.skew;
                height: 100%;
                viewbox-width: root.wn + root.sn;
                viewbox-height: root.hn;
                fill: SkwdTokens.surface;
                MoveTo { x: 0; y: 0; }
                LineTo { x: root.sn; y: 0; }
                LineTo { x: 0; y: root.hn; }
                Close { }
                MoveTo { x: root.wn; y: 0; }
                LineTo { x: root.wn + root.sn; y: 0; }
                LineTo { x: root.wn; y: root.hn; }
                Close { }
            }

            // Video overlay (Timer 100-300ms, release on blur S16/17)
            // Only on current card with has-video — sits above the
            // full-bleed cover but below the label scrim.
            if root.is-current && root.has-video : Rectangle {
                width: 36px;
                height: 24px;
                x: parent.width - self.width - SkwdTokens.spacing-8;
                y: SkwdTokens.spacing-8;
                border-radius: SkwdTokens.radius-4;
                background: #000000.transparentize(0.3);
                Text {
                    text: "▶";
                    color: #ffffff;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                opacity: video-playing ? 1.0 : 0.6;
                animate opacity { duration: 150ms; easing: ease-in-out; }
            }
        }

        // Bottom label — overlayed over the full-bleed image (not in a
        // padded VerticalLayout) so the wallpaper stays edge-to-edge.
        // Constrained to the slant-safe zone [skew .. width] so the bar
        // never crosses the slanted card edges. Semi-transparent scrim
        // keeps text legible on bright wallpapers.
        label-scrim := Rectangle {
            x: root.skew;
            y: parent.height - 28px;
            width: root.width - root.skew;
            height: 28px;
            background: #000000.transparentize(0.45);
            Text {
                text: root.card-name;
                color: #ffffff;
                font-family: SkwdTokens.font-body;
                font-size: SkwdTokens.size-14;
                font-weight: 600;
                overflow: elide;
                x: SkwdTokens.spacing-8;
                width: parent.width - 2 * SkwdTokens.spacing-8;
                height: 100%;
                vertical-alignment: center;
            }
        }
    }

    // Back face rides in the same slant-safe mask box (metadata sheet
    // becomes functional in PR5).
    if is-flipped : Rectangle {
        clip: true;
        x: root.skew;
        width: root.width - root.skew;
        height: 100%;

        VerticalLayout {
            padding: SkwdTokens.spacing-12;
            spacing: SkwdTokens.spacing-8;
            opacity: is-flipped ? 1.0 : 0.0;
            animate opacity { duration: 400ms; easing: cubic-bezier(0.455, 0.03, 0.515, 0.955); }

            Text {
                text: root.card-name + " — details";
                color: SkwdTokens.primary;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
            }
            Text {
                text: "VIEW  RETAG  DELETE  STEAM";
                color: SkwdTokens.outline;
                font-size: SkwdTokens.size-11;
            }
        }
    }

    // ── Dim overlay (design D4 / skwd DimOverlay): black alpha 0 current /
    // 0.15 hover / 0.4 idle, 200ms — mirrors slice.rs::dim_level ∘
    // card_state (current wins over hover). Same SliceShape geometry,
    // painted ABOVE the front/back containers so the whole face dims
    // uniformly; edge fade on the root dissolves it at the stage edges. ──
    dim := SliceShape {
        x: -root.pad;
        y: -root.pad;
        width: root.width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.wn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #000000;
        opacity: root.is-current ? 0.0 : (root.has-hover ? 0.15 : 0.4);
        animate opacity { duration: SkwdTokens.anim-200; }
    }

    // ── Hover brighten (approved design): thin white veil over the
    // parallelogram face, completing the lift+brighten focus cue. Gated to
    // the FRONT face with a decoded image — empty/loading or flipped cards
    // skip the veil (shimmer/metadata stay neutral). Painted above the dim
    // layer so the net effect brightens even idle-dimmed cards. ──
    hover-brighten := SliceShape {
        x: -root.pad;
        y: -root.pad;
        width: root.width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        wn: root.wn; hn: root.hn; sn: root.sn; rn: root.rn; pn: root.pn;
        fill: #ffffff;
        opacity: !root.is-flipped && (root.thumb.width > 0 || root.hero.width > 0) && root.has-hover
            ? SkwdTokens.gallery-card-hover-brighten : 0.0;
        animate opacity { duration: SkwdTokens.anim-150; easing: ease-in-out; }
    }

    // ── Video Timer 100-300ms (default 200): Timer triggered → playing ──
    // Spec S16: start after 100-300ms when card becomes current; S17: release on blur.
    property <bool> video-playing: false;
    property <duration> video-delay: 200ms;
    // Clamp logic lives in Rust SliceView::video_delay_ms; Slint uses the bound value.
    video-timer := Timer {
        interval: root.video-delay;
        running: root.is-current && root.has-video && !root.video-playing;
        triggered => {
            root.video-playing = true;
        }
    }
    // Release on blur: when is-current becomes false, reset playing
    states [
        blurred when !root.is-current : {
            video-playing: false;
        }
    ]
    // Also stop timer when flipped (back face shows metadata, not preview)
    out property <bool> has-hover: touch.has-hover;
    // Hover routing for the three-layer paint order (design D4): the
    // carousel lifts the hovered card one layer above idle siblings.
    changed has-hover => { root.hovered(self.has-hover); }
    callback hovered(bool);

    // ── Hit-test mask non-rect (parallelogram) ──
    // TouchArea covers the bounding rect, but we gate clicks with
    // point_in_parallelogram math (same as SliceView::point_in_parallelogram
    // Rust side, skew 28). Points outside the slanted shape are rejected.
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        // Non-rect containment: left lerp skew..0, right = left + (w - skew)
        property <bool> is-inside-shape: {
            if (self.mouse-x < 0px || self.mouse-y < 0px || self.mouse-x > root.width || self.mouse-y > root.height) {
                false
            } else {
                // skew * (1 - y/h), h may be 0 during init — guard
                let t = self.mouse-y / root.height;
                let left = root.skew * (1 - t);
                let right = left + (root.width - root.skew);
                self.mouse-x >= left && self.mouse-x <= right
            }
        }

        clicked => {
            if (self.is-inside-shape) {
                root.clicked();
            }
        }

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                if (self.is-inside-shape) {
                    root.right-clicked();
                    root.flipped();
                }
            }
        }
    }
}
