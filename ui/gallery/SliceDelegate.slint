// HVE 2 — SliceDelegate (gallery-immersive-redesign PR2.6).
//
// Parallelogram carousel card with skwd-wall exact geometry: collapsed
// 135 ↔ expanded 924 × 520 tall, spacing handled by SliceCarousel (−30
// overlap), 35px X-shear drawn as one rounded Path (design D3), radius 0
// default, 350ms OutCubic expand. Border per the skwd-wall contract was
// restored in PR2.HF (Path stroke: focused primary w3 / hover primary@40%
// w1 / idle black@60% w1) and given stroke-room in PR2.HF2 so the border
// renders uncut on all four edges. Flip stays a crossfade until the real two-phase
// squeeze lands (PR5). Shadow/dim remain PR3 depth cues.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";

export component SliceDelegate inherits Rectangle {
    // ── Props ──
    in property <string> card-name: "Theme";
    in property <bool> is-current: false;
    in property <bool> is-hovered: false;
    in property <bool> is-flipped: false;
    in property <color> accent: SkwdTokens.fallback-accent;
    in property <image> thumb;
    in property <bool> has-video: false;

    callback clicked();
    callback right-clicked();
    callback flipped();

    // ── Geometry (design D3): card spans width × 520; the drawn face is a
    // parallelogram whose top edge shifts right by the 35px shear, so the
    // Path bounding box is (width + skew) wide. ──
    property <length> skew: SkwdTokens.gallery-slice-skew-offset; // 35px X-shear
    width: is-current ? SkwdTokens.gallery-slice-expanded-w : SkwdTokens.gallery-slice-w;
    height: SkwdTokens.gallery-slice-h;
    animate width {
        duration: SkwdTokens.anim-expand;
        easing: cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    // Viewbox numbers (unitless): face spans (width + skew) × height.
    property <float> wn: root.width / 1px;
    property <float> hn: root.height / 1px;               // 520
    property <float> sn: root.skew / 1px;                 // 35
    property <float> slant: Math.sqrt(sn * sn + hn * hn); // ≈ 521.18
    // Corner radius clamped to half of the shortest adjacent edge minus 1
    // (skwd roundCorners clamp). Token default 0px → sharp parallelogram.
    property <float> rn: Math.max(0.0, Math.min(
        SkwdTokens.gallery-slice-radius / 1px,
        wn / 2 - 1,
        slant / 2 - 1));

    // ── Face: rounded parallelogram Path (vertices (35,0)(35+w,0)(w,h)(0,h),
    // QuadTo rounding at each slant corner; r=0 degenerates to straight). ──
    // PR2.HF2: Slint clips a Path's paint to its own geometry box, so a
    // stroke centered on the shape border lost its outer half (1.5px of the
    // focused w3) wherever an edge coincided with the box. The box now grows
    // by a uniform stroke-room pad per side; the origin moves to -pad and the
    // viewbox shifts to -p so every vertex maps back to its exact original
    // position (scale stays 1:1) — same card, same place, full border.
    property <length> pad: 4px; // > focused stroke half-width (1.5px)
    property <float> pn: root.pad / 1px;
    face := Path {
        x: -root.pad;
        y: -root.pad;
        width: root.width + root.skew + 2 * root.pad;
        height: root.height + 2 * root.pad;
        viewbox-x: -root.pn;
        viewbox-y: -root.pn;
        viewbox-width: root.wn + root.sn + 2 * root.pn;
        viewbox-height: root.hn + 2 * root.pn;
        fill: root.is-flipped ? SkwdTokens.surface-container : SkwdTokens.surface;
        // skwd-wall border contract (PR2.HF regression 1): the PR2.6/2.7
        // refactor left this Path fill-only; borders live on the Path stroke.
        stroke: root.is-current ? SkwdTokens.primary
            : root.has-hover ? SkwdTokens.primary.transparentize(0.6)
            : #000000.transparentize(0.4);
        stroke-width: root.is-current ? 3px : 1px;

        MoveTo { x: sn + rn; y: 0; }
        LineTo { x: sn + wn - rn; y: 0; }
        QuadraticTo { control-x: sn + wn; control-y: 0;
                 x: sn + wn - sn * rn / slant; y: hn * rn / slant; }
        LineTo { x: wn + sn * rn / slant; y: hn - hn * rn / slant; }
        QuadraticTo { control-x: wn; control-y: hn;
                 x: wn - rn; y: hn; }
        LineTo { x: rn; y: hn; }
        QuadraticTo { control-x: 0; control-y: hn;
                 x: sn * rn / slant; y: hn - hn * rn / slant; }
        LineTo { x: sn - sn * rn / slant; y: hn * rn / slant; }
        QuadraticTo { control-x: sn; control-y: 0;
                 x: sn + rn; y: 0; }
        Close { }
    }

    // ── Face mask container (design D3): clip:true box inset to the
    // parallelogram's horizontal safe zone [skew .. width], so the wallpaper
    // Image and labels clear both slant edges while painting OVER the same
    // Path fill surface (visible behind the transparent container). True
    // pixel-exact bitmap masking lands in PR4: thumbs.rs bakes the
    // parallelogram alpha into the cached PNGs (design D8).
    if !is-flipped : Rectangle {
        clip: true;
        x: root.skew;
        width: root.width - root.skew;
        height: 100%;

        VerticalLayout {
            padding: SkwdTokens.spacing-8;
            spacing: SkwdTokens.spacing-8;
            opacity: is-flipped ? 0.0 : 1.0;
            animate opacity { duration: 400ms; easing: cubic-bezier(0.455, 0.03, 0.515, 0.955); }

        // ── Thumbnail with preheat 120ms, sourceSize 400x720, cache async (R8) ──
        // Slint Image has no explicit cache/async flag; we document the intent
        // and use source-clip to cap decoded size (400x720) — matching QML
        // sourceSize behavior. Preheat delays thumb visibility by 120ms.
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            border-radius: SkwdTokens.radius-8;
            background: SkwdTokens.surface;

            // Preheat timer: 120ms before loading full thumb (R8). Runs even
            // while hidden: the focused overlay copy (PR2.HF) must have its
            // thumb warm before the first focus, or it would flash the
            // placeholder on every focus change.
            property <bool> preheat-done: false;
            preheat-timer := Timer {
                interval: 120ms;
                running: !preheat-done;
                triggered => {
                    preheat-done = true;
                    self.running = false;
                }
            }

            // Thumb image capped to 400×720 via source-clip (R8)
            if preheat-done : Image {
                width: 100%;
                height: 100%;
                source: root.thumb;
                image-fit: cover;
                // Cap decoded size (Slint source-clip in image pixels)
                source-clip-width: 400;
                source-clip-height: 720;
                // cache + asynchronous are implicit in Slint's image cache;
                // no duplicate property needed — R8 satisfied by lifecycle.
                accessible-role: none;
            }
            if !preheat-done : Rectangle {
                background: accent.transparentize(0.9);
                Text {
                    text: "◇";
                    color: accent;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Video overlay (Timer 100-300ms, release on blur S16/17)
            // Only on current card with has-video.
            if root.is-current && root.has-video : Rectangle {
                width: 36px;
                height: 24px;
                x: parent.width - self.width - SkwdTokens.spacing-8;
                y: SkwdTokens.spacing-8;
                border-radius: SkwdTokens.radius-4;
                background: #000000.transparentize(0.3);
                Text {
                    text: "▶";
                    color: #ffffff;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                // Active playing indicator driven by Timer below
                opacity: video-playing ? 1.0 : 0.6;
                animate opacity { duration: 150ms; easing: ease-in-out; }
            }
        }

        Text {
            text: root.card-name;
            color: SkwdTokens.primary;
            font-family: SkwdTokens.font-body;
            font-size: SkwdTokens.size-14;
            font-weight: 600;
            overflow: elide;
        }
        }
    }

    // Back face rides in the same slant-safe mask box (metadata sheet
    // becomes functional in PR5).
    if is-flipped : Rectangle {
        clip: true;
        x: root.skew;
        width: root.width - root.skew;
        height: 100%;

        VerticalLayout {
            padding: SkwdTokens.spacing-12;
            spacing: SkwdTokens.spacing-8;
            opacity: is-flipped ? 1.0 : 0.0;
            animate opacity { duration: 400ms; easing: cubic-bezier(0.455, 0.03, 0.515, 0.955); }

            Text {
                text: root.card-name + " — details";
                color: SkwdTokens.primary;
                font-size: SkwdTokens.size-16;
                font-weight: 700;
            }
            Text {
                text: "VIEW  RETAG  DELETE  STEAM";
                color: SkwdTokens.outline;
                font-size: SkwdTokens.size-11;
            }
        }
    }

    // ── Video Timer 100-300ms (default 200): Timer triggered → playing ──
    // Spec S16: start after 100-300ms when card becomes current; S17: release on blur.
    property <bool> video-playing: false;
    property <duration> video-delay: 200ms;
    // Clamp logic lives in Rust SliceView::video_delay_ms; Slint uses the bound value.
    video-timer := Timer {
        interval: root.video-delay;
        running: root.is-current && root.has-video && !root.video-playing;
        triggered => {
            root.video-playing = true;
        }
    }
    // Release on blur: when is-current becomes false, reset playing
    states [
        blurred when !root.is-current : {
            video-playing: false;
        }
    ]
    // Also stop timer when flipped (back face shows metadata, not preview)
    out property <bool> has-hover: touch.has-hover;

    // ── Hit-test mask non-rect (parallelogram) ──
    // TouchArea covers the bounding rect, but we gate clicks with
    // point_in_parallelogram math (same as SliceView::point_in_parallelogram
    // Rust side, skew 28). Points outside the slanted shape are rejected.
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        // Non-rect containment: left lerp skew..0, right = left + (w - skew)
        property <bool> is-inside-shape: {
            if (self.mouse-x < 0px || self.mouse-y < 0px || self.mouse-x > root.width || self.mouse-y > root.height) {
                false
            } else {
                // skew * (1 - y/h), h may be 0 during init — guard
                let t = self.mouse-y / root.height;
                let left = root.skew * (1 - t);
                let right = left + (root.width - root.skew);
                self.mouse-x >= left && self.mouse-x <= right
            }
        }

        clicked => {
            if (self.is-inside-shape) {
                root.clicked();
            }
        }

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                if (self.is-inside-shape) {
                    root.right-clicked();
                    root.flipped();
                }
            }
        }
    }
}
