// HVE 2 — SliceCarousel (S2 infinite wall + S4b baked).
//
// Infinite carousel wall: focused card dead-center expanded (924), collapsed
// slats 135 contiguous zero-gap on both sides filling edge-to-edge via clones.
// Ring math is in Rust (slice::ring_visible_slots); this file CONSUMES it —
// no cum_offset/snap_x reinvention. Stage width changes re-render via the
// shared stage-geometry callback (mosaic plumbing). Clicks route REAL index.
//
// 3-pass paint: idle distance-tiered (far→near) + hovered + expanded topmost.
// Brief x animate (350ms OutCubic) avoids flash on step; wheel debounce Timer
// stays outside the for-repeater (Slint 1.17 panic). Edge fade via per-tile
// fade from Rust (skwd fullZone curve, S4b softened min 0.55). Focus border
// via SkwdTokens icy cyan + glow. S4b: baked slat images flow through.
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { GalleryCardData } from "ThemeCardDelegate.slint";
import { SliceDelegate } from "SliceDelegate.slint";

export struct SliceTileData {
    x: length,
    w: length,
    real-index: int,
    is-expanded: bool,
    fade: float,
    dist: int,
}

export component SliceCarousel inherits Rectangle {
    in property <[GalleryCardData]> cards;
    in property <[SliceTileData]> tiles;

    callback card-clicked(int);
    callback card-right-clicked(int);
    callback wheel-step(int); // +1 next / −1 previous, once per gesture

    // Hovered tile index (−1 = none); feeds hovered paint layer.
    in-out property <int> hovered-tile: -1;

    clip: true;
    background: transparent;

    // ── Wheel (design D5): same debounce as mosaic — arm then commit 1 step.
    property <int> wheel-dir: 0;
    wheel-debounce := Timer {
        interval: 400ms;
        running: root.wheel-dir != 0;
        triggered => {
            root.wheel-step(root.wheel-dir);
            root.wheel-dir = 0;
        }
    }
    wheel-zone := TouchArea {
        width: 100%;
        height: 100%;
        scroll-event(event) => {
            let d = event.delta-x + event.delta-y;
            if (d != 0) {
                root.wheel-dir = d < 0 ? 1 : -1;
                wheel-debounce.restart();
            }
            accept
        }
    }

    // Stage content — vertically centers the 520 band; tiles positioned absolute x.
    content := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        // Band vertical center
        band := Rectangle {
            y: (parent.height - SkwdTokens.gallery-slice-h) / 2;
            height: SkwdTokens.gallery-slice-h;
            width: 100%;
            clip: false;

            // Idle far (dist >=5) behind
            for t[idx] in root.tiles : SliceDelegate {
                visible: !t.is-expanded && t.dist >= 5 && idx != root.hovered-tile;
                x: t.x;
                y: 0;
                fade-opacity: t.fade;
                card-name: root.cards[t.real-index].name;
                is-current: t.is-expanded;
                accent: root.cards[t.real-index].accent;
                thumb: root.cards[t.real-index].thumb;
                hero: root.cards[t.real-index].hero;
                slat-image: root.cards[t.real-index].slat-image;
                slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
                animate x { duration: SkwdTokens.anim-expand; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                clicked => { root.card-clicked(t.real-index); }
                right-clicked => { root.card-right-clicked(t.real-index); }
                hovered(h) => { root.hovered-tile = h ? idx : -1; }
            }
            for t[idx] in root.tiles : SliceDelegate {
                visible: !t.is-expanded && t.dist == 4 && idx != root.hovered-tile;
                x: t.x;
                y: 0;
                fade-opacity: t.fade;
                card-name: root.cards[t.real-index].name;
                is-current: t.is-expanded;
                accent: root.cards[t.real-index].accent;
                thumb: root.cards[t.real-index].thumb;
                hero: root.cards[t.real-index].hero;
                slat-image: root.cards[t.real-index].slat-image;
                slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
                animate x { duration: SkwdTokens.anim-expand; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                clicked => { root.card-clicked(t.real-index); }
                right-clicked => { root.card-right-clicked(t.real-index); }
                hovered(h) => { root.hovered-tile = h ? idx : -1; }
            }
            for t[idx] in root.tiles : SliceDelegate {
                visible: !t.is-expanded && t.dist == 3 && idx != root.hovered-tile;
                x: t.x;
                y: 0;
                fade-opacity: t.fade;
                card-name: root.cards[t.real-index].name;
                is-current: t.is-expanded;
                accent: root.cards[t.real-index].accent;
                thumb: root.cards[t.real-index].thumb;
                hero: root.cards[t.real-index].hero;
                slat-image: root.cards[t.real-index].slat-image;
                slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
                animate x { duration: SkwdTokens.anim-expand; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                clicked => { root.card-clicked(t.real-index); }
                right-clicked => { root.card-right-clicked(t.real-index); }
                hovered(h) => { root.hovered-tile = h ? idx : -1; }
            }
            for t[idx] in root.tiles : SliceDelegate {
                visible: !t.is-expanded && t.dist == 2 && idx != root.hovered-tile;
                x: t.x;
                y: 0;
                fade-opacity: t.fade;
                card-name: root.cards[t.real-index].name;
                is-current: t.is-expanded;
                accent: root.cards[t.real-index].accent;
                thumb: root.cards[t.real-index].thumb;
                hero: root.cards[t.real-index].hero;
                slat-image: root.cards[t.real-index].slat-image;
                slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
                animate x { duration: SkwdTokens.anim-expand; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                clicked => { root.card-clicked(t.real-index); }
                right-clicked => { root.card-right-clicked(t.real-index); }
                hovered(h) => { root.hovered-tile = h ? idx : -1; }
            }
            for t[idx] in root.tiles : SliceDelegate {
                visible: !t.is-expanded && t.dist == 1 && idx != root.hovered-tile;
                x: t.x;
                y: 0;
                fade-opacity: t.fade;
                card-name: root.cards[t.real-index].name;
                is-current: t.is-expanded;
                accent: root.cards[t.real-index].accent;
                thumb: root.cards[t.real-index].thumb;
                hero: root.cards[t.real-index].hero;
                slat-image: root.cards[t.real-index].slat-image;
                slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
                animate x { duration: SkwdTokens.anim-expand; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                clicked => { root.card-clicked(t.real-index); }
                right-clicked => { root.card-right-clicked(t.real-index); }
                hovered(h) => { root.hovered-tile = h ? idx : -1; }
            }
            // Hovered collapsed one layer above idle
            for t[idx] in root.tiles : SliceDelegate {
                visible: !t.is-expanded && idx == root.hovered-tile;
                x: t.x;
                y: 0;
                fade-opacity: t.fade;
                card-name: root.cards[t.real-index].name;
                is-current: t.is-expanded;
                accent: root.cards[t.real-index].accent;
                thumb: root.cards[t.real-index].thumb;
                hero: root.cards[t.real-index].hero;
                slat-image: root.cards[t.real-index].slat-image;
                slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
                animate x { duration: SkwdTokens.anim-expand; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                clicked => { root.card-clicked(t.real-index); }
                right-clicked => { root.card-right-clicked(t.real-index); }
                hovered(h) => { root.hovered-tile = h ? idx : -1; }
            }
            // Expanded centered on top
            for t[idx] in root.tiles : SliceDelegate {
                visible: t.is-expanded;
                x: t.x;
                y: 0;
                fade-opacity: t.fade;
                card-name: root.cards[t.real-index].name;
                is-current: t.is-expanded;
                accent: root.cards[t.real-index].accent;
                thumb: root.cards[t.real-index].thumb;
                hero: root.cards[t.real-index].hero;
                slat-image: root.cards[t.real-index].slat-image;
                slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
                animate x { duration: SkwdTokens.anim-expand; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                clicked => { root.card-clicked(t.real-index); }
                right-clicked => { root.card-right-clicked(t.real-index); }
                hovered(h) => { root.hovered-tile = h ? idx : -1; }
            }
        }
    }
}
