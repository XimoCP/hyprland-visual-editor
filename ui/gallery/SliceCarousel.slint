// HVE 2 — SliceCarousel (V6 focus-flow + S4b baked).
//
// skwd-wall mechanics translated to Slint 1.17: ONE continuous focus
// position `focus-pos` (a fractional card index, animated 350ms OutCubic
// with mid-flight retargeting — Slint restarts the tween from the displayed
// value, the QML StrictlyEnforceRange + highlightMoveDuration analog) drives
// EVERY slot's position AND width through the closed-form focus-flow
// geometry of src/shell/gallery/views/slice.rs (slot_width/slot_center,
// token-driven here). The focused card grows about the traveling focus
// while neighbors reflow gap-free; per-step model relabels are visual
// no-ops (geometry depends only on d = delta − frac). The strip container
// itself NEVER moves — cards flow around the fixed stage center. Wheel
// debounce Timer stays OUTSIDE the for-repeater (Slint 1.17 panic) at
// 150ms so rapid wheel chains unit glides; keys stay direct. Edge fade via
// per-tile fade, border on top, dim/fade tokens, gaps, hover — approved
// look. Distant idle clicks snap-focus (fluid multi-slot glide needs the
// two-width cumulative layout — follow-up).
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { GalleryCardData } from "ThemeCardDelegate.slint";
import { SliceDelegate } from "SliceDelegate.slint";

export struct SliceTileData {
    delta: int,
    real-index: int,
    is-expanded: bool,
    fade: float,
    dist: int,
}

export component SliceCarousel inherits Rectangle {
    in property <[GalleryCardData]> cards;
    in property <[SliceTileData]> tiles;
    in property <length> stage-width: 1920px;
    // Fluid scale: stage-width drives delegates; strip centers vertically
    // via scaled height (520·scale at stage 1092 ≈ 358 vs 520 at 1920).
    property <float> scaled-h: (root.stage-width / 1px < 100.0 ? 924.0 : Math.min(924.0, root.stage-width / 1px * 0.58)) * 520.0 / 924.0;
    // V6 focus-flow state — ONE animated scalar (fractional card index,
    // UNWRAPPED: …−1, 0, 1… 12, 13… — the real focused index is its wrap
    // modulo the theme count). `delta-base` mirrors the virtual focused
    // slot the model deltas are labeled against; frac = focus-pos −
    // delta-base stays within ±1 across ring seams.
    in-out property <float> focus-pos: 0.0;
    in property <int> delta-base: 0;
    in property <bool> rebasing: false;
    in property <bool> reduced-motion: false;
    // Docking: when true, side tabs tuck behind center (outer → inner) before central morph
    in property <bool> docking: false;
    property <float> tuck-progress: root.docking ? 1.0 : 0.0;
    animate tuck-progress { duration: root.reduced-motion ? 0ms : 500ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
    property <float> focus-frac: root.focus-pos - root.delta-base;
    // Directional driver: raw frac (±1 during a step, 0 settled). The
    // position is driven per-frame by the Rust reel spring (slice_reel.rs —
    // ported from skwd-wall), so no Slint animate here: an attached tween
    // would fight the per-frame writes and restart on every retarget.
    property <float> travel: root.focus-frac;

    callback card-clicked(int);
    callback card-right-clicked(int);
    callback wheel-step(int); // +1 next / −1 previous, once per gesture

    // Hovered tile index (−1 = none); feeds hovered paint layer.
    in-out property <int> hovered-tile: -1;

    clip: true;
    background: transparent;

    // ── Wheel (V5 chained): 150ms debounce (SkwdTokens.gallery-slice-
    // wheel-debounce) so rapid wheel retargets mid-glide; keys stay direct.
    // Timer lives OUTSIDE for-repeater (Slint 1.17 panic). Each trigger
    // commits ONE ±1 step; mid-flight steps chain via focus-pos retarget.
    property <int> wheel-dir: 0;
    wheel-debounce := Timer {
        interval: SkwdTokens.gallery-slice-wheel-debounce;
        running: root.wheel-dir != 0;
        triggered => {
            root.wheel-step(root.wheel-dir);
            root.wheel-dir = 0;
        }
    }
    // Solo la banda central captura rueda — así los cajones arriba/abajo
    // (detrás del stage pero fuera de la banda) siguen siendo clicables.
    wheel-zone := TouchArea {
        y: (parent.height - root.scaled-h * 1px) / 2;
        height: root.scaled-h * 1px;
        width: 100%;
        scroll-event(event) => {
            let d = event.delta-x + event.delta-y;
            if (d != 0) {
                root.wheel-dir = d < 0 ? 1 : -1;
                wheel-debounce.restart();
            }
            accept
        }
    }

    // ── Static stage-center anchor: cards flow around this point; the
    // container itself never animates (V6: positions live in the
    // delegates). ──
    strip := Rectangle {
        x: parent.width / 2;
        y: (parent.height - root.scaled-h * 1px) / 2;
        height: root.scaled-h * 1px;
        width: 0px;
        clip: false;

        // Paint order = declaration order (design D4): idle tiered by
        // distance from focused (skwd-wall z: 50 - |index - current|),
        // nearest idle on top, hovered, then current on top. 8 passes.
        // Is-current comes from each row's is-expanded flag (styling only —
        // geometry comes from the focus-flow formula, so pass swaps are
        // seamless). Visibility is SLOT-based: dist tiers + !is-expanded;
        // the top pass renders only the expanded slot. Never filter by
        // real-index — with ring clones, theme identity != slot identity.
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && t.dist >= 5 && idx != root.hovered-tile;
            slot-d: t.delta - root.focus-frac;
            travel: root.travel;
            stage-width: root.stage-width;
            fade-opacity: t.fade;
            tuck: t.is-expanded ? 0.0 : Math.max(0.0, Math.min(1.0, (root.tuck-progress - (5 - Math.min(t.dist, 5)) * 0.10) / 0.30));
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && t.dist == 4 && idx != root.hovered-tile;
            slot-d: t.delta - root.focus-frac;
            travel: root.travel;
            stage-width: root.stage-width;
            fade-opacity: t.fade;
            tuck: t.is-expanded ? 0.0 : Math.max(0.0, Math.min(1.0, (root.tuck-progress - (5 - Math.min(t.dist, 5)) * 0.10) / 0.30));
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && t.dist == 3 && idx != root.hovered-tile;
            slot-d: t.delta - root.focus-frac;
            travel: root.travel;
            stage-width: root.stage-width;
            fade-opacity: t.fade;
            tuck: t.is-expanded ? 0.0 : Math.max(0.0, Math.min(1.0, (root.tuck-progress - (5 - Math.min(t.dist, 5)) * 0.10) / 0.30));
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && t.dist == 2 && idx != root.hovered-tile;
            slot-d: t.delta - root.focus-frac;
            travel: root.travel;
            stage-width: root.stage-width;
            fade-opacity: t.fade;
            tuck: t.is-expanded ? 0.0 : Math.max(0.0, Math.min(1.0, (root.tuck-progress - (5 - Math.min(t.dist, 5)) * 0.10) / 0.30));
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && (t.dist == 1 || t.dist == 0) && idx != root.hovered-tile;
            slot-d: t.delta - root.focus-frac;
            travel: root.travel;
            stage-width: root.stage-width;
            fade-opacity: t.fade;
            tuck: t.is-expanded ? 0.0 : Math.max(0.0, Math.min(1.0, (root.tuck-progress - (5 - Math.min(t.dist, 5)) * 0.10) / 0.30));
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && idx == root.hovered-tile;
            slot-d: t.delta - root.focus-frac;
            travel: root.travel;
            stage-width: root.stage-width;
            fade-opacity: t.fade;
            tuck: t.is-expanded ? 0.0 : Math.max(0.0, Math.min(1.0, (root.tuck-progress - (5 - Math.min(t.dist, 5)) * 0.10) / 0.30));
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: t.is-expanded;
            tuck: 0.0;
            slot-d: t.delta - root.focus-frac;
            travel: root.travel;
            stage-width: root.stage-width;
            fade-opacity: t.fade;
            card-name: root.cards[t.real-index].name;
            is-current: true;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
    }
}
