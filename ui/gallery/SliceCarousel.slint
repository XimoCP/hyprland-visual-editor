// HVE 2 — SliceCarousel (V3 directional fluid + S4b baked).
//
// Single moving strip with silent rebase (valid in Slint 1.17 via
// expression animation duration). Container carries ALL delegates at
// RELATIVE positions (center=0, expanded at -462, collapsed step 135 =
// 111 face + 12+12 air, zero-gap ring contiguous; visual gap 24 is
// inset inside the 135 slot). Strip animates x by -delta*135 (350ms
// OutCubic); is-current flips at slide start via focused-index so
// widths animate in place; positions stay frozen during slide; at
// settle (350ms Timer) Rust rebuilds the model for the new focus
// (identical relative layout, self-similar) and snaps strip back
// with rebasing=true (0ms, invisible). Wheel debounce Timer stays
// OUTSIDE the for-repeater (Slint 1.17 panic). Edge fade via per-tile
// fade, border on top, dim/fade tokens, gaps, hover — approved look.
// Click on distant card slides the whole distance in one tween via
// shortest ring delta. Rapid steps coalesced by existing 400ms wheel
// debounce (simplest robust choice — documented in slice.rs).
//
// MIT credit: visual language translated from skwd-wall (MIT, © liixini).

import { SkwdTokens } from "../tokens.slint";
import { GalleryCardData } from "ThemeCardDelegate.slint";
import { SliceDelegate } from "SliceDelegate.slint";

export struct SliceTileData {
    x: length,
    w: length,
    real-index: int,
    is-expanded: bool,
    fade: float,
    dist: int,
}

export component SliceCarousel inherits Rectangle {
    in property <[GalleryCardData]> cards;
    in property <[SliceTileData]> tiles;
    // V3 strip animation state — driven from Rust (strip-offset animates,
    // rebasing disables animation for the snap-back). Tiles x are RELATIVE
    // to stage center (center=0).
    in property <length> strip-offset: 0px;
    in property <bool> rebasing: false;
    // Focused index drives is-current (flips at slide start, widths animate
    // in place while x positions stay frozen; at settle tiles rebuild).
    in property <int> focused-index: 0;

    callback card-clicked(int);
    callback card-right-clicked(int);
    callback wheel-step(int); // +1 next / −1 previous, once per gesture

    // Hovered tile index (−1 = none); feeds hovered paint layer.
    in-out property <int> hovered-tile: -1;

    clip: true;
    background: transparent;

    // ── Wheel (design D5): same debounce as mosaic — arm then commit 1 step.
    property <int> wheel-dir: 0;
    wheel-debounce := Timer {
        interval: 400ms;
        running: root.wheel-dir != 0;
        triggered => {
            root.wheel-step(root.wheel-dir);
            root.wheel-dir = 0;
        }
    }
    wheel-zone := TouchArea {
        width: 100%;
        height: 100%;
        scroll-event(event) => {
            let d = event.delta-x + event.delta-y;
            if (d != 0) {
                root.wheel-dir = d < 0 ? 1 : -1;
                wheel-debounce.restart();
            }
            accept
        }
    }

    // ── Single animated strip: ONE x animates (350ms OutCubic), all
    // delegates inside at fixed strip-local x = t.x (relative to stage
    // center). Center of strip is at parent.width/2 + strip-offset.
    strip := Rectangle {
        // Positioned at stage center + animated offset
        x: (parent.width / 2) + root.strip-offset;
        y: (parent.height - SkwdTokens.gallery-slice-h) / 2;
        height: SkwdTokens.gallery-slice-h;
        width: 0px;
        clip: false;
        animate x {
            duration: root.rebasing ? 0ms : SkwdTokens.anim-expand;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        // Paint order = declaration order (design D4): idle tiered by
        // distance from focused (skwd-wall z: 50 - |index - current|),
        // nearest idle on top, hovered, then current on top. 8 passes.
        // Is-current comes from each row's is-expanded flag (Rust flips the
        // two affected rows at slide start, width animates in place).
        // Visibility is SLOT-based: dist tiers + !is-expanded; the top pass
        // renders only the expanded slot. Never filter by real-index — with
        // ring clones, theme identity != slot identity.
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && t.dist >= 5 && idx != root.hovered-tile;
            x: t.x;
            y: 0;
            fade-opacity: t.fade;
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && t.dist == 4 && idx != root.hovered-tile;
            x: t.x;
            y: 0;
            fade-opacity: t.fade;
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && t.dist == 3 && idx != root.hovered-tile;
            x: t.x;
            y: 0;
            fade-opacity: t.fade;
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && t.dist == 2 && idx != root.hovered-tile;
            x: t.x;
            y: 0;
            fade-opacity: t.fade;
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && (t.dist == 1 || t.dist == 0) && idx != root.hovered-tile;
            x: t.x;
            y: 0;
            fade-opacity: t.fade;
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: !t.is-expanded && idx == root.hovered-tile;
            x: t.x;
            y: 0;
            fade-opacity: t.fade;
            card-name: root.cards[t.real-index].name;
            is-current: t.is-expanded;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
        for t[idx] in root.tiles : SliceDelegate {
            visible: t.is-expanded;
            x: t.x;
            y: 0;
            fade-opacity: t.fade;
            card-name: root.cards[t.real-index].name;
            is-current: true;
            accent: root.cards[t.real-index].accent;
            thumb: root.cards[t.real-index].thumb;
            hero: root.cards[t.real-index].hero;
            slat-image: root.cards[t.real-index].slat-image;
            slat-expanded-image: root.cards[t.real-index].slat-expanded-image;
            clicked => { root.card-clicked(t.real-index); }
            right-clicked => { root.card-right-clicked(t.real-index); }
            hovered(h) => { root.hovered-tile = h ? idx : -1; }
        }
    }
}
