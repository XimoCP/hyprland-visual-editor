import { ScrollView } from "std-widgets.slint";
import { HveColors } from "./theme.slint";
import { PresetCard, SectionHeader, GeometrySlider, WelcomeCard, ActivationCard, ExpandableCard } from "./components.slint";

// ─── HOME MODULE ────────────────────────────────────────────────────
export component HomeModule inherits ScrollView {
    in property <bool> system-active: false;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <string> activation-title;
    in property <string> activation-active-text;
    in property <string> activation-inactive-text;
    in property <string> feature-title;
    in property <string> feature-desc;
    in property <string> how-title;
    in property <string> how-desc;
    callback toggle-system(bool);

    // ─ Accordion state: which card is expanded (0=none, 1=features, 2=architecture) ──
    in-out property <int> expanded-index: 0;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        SectionHeader {
            title: root.header-title;
            subtitle: root.header-subtitle;
            accent: HveColors.accent-cyan;
        }

        ActivationCard {
            card-title: root.activation-title;
            active-text: root.activation-active-text;
            inactive-text: root.activation-inactive-text;
            active: root.system-active;
            toggled(v) => { root.toggle-system(v); }
        }

        ExpandableCard {
            card-title: root.feature-title;
            icon-text: "★";
            accent: HveColors.accent-amber;
            short-desc: "Hyprland Visual Editor es la evolución estética de tu escritorio.";
            full-desc: "✨ Animaciones fluidas — cambiá entre estilos en milisegundos.\n🎨 Bordes inteligentes — gradientes dinámicos reactivos.\n🕶️ Shaders en tiempo real — filtros GLSL post-procesado.\n🛡️ No destructivo — nunca toca tu config principal. Sandbox seguro.";
            expanded: root.expanded-index == 1;
            hovered => { root.expanded-index = 1; }
        }

        ExpandableCard {
            card-title: root.how-title;
            icon-text: "⚙";
            accent: HveColors.accent-purple;
            short-desc: "Descubrí cómo HVE funciona por dentro.";
            full-desc: "① Detección de entorno — identifica formato Lua vs Conf\n② Ensamblado atómico — fusiona módulos activos en un archivo maestro\n③ Hot Reload — aplica cambios al instante vía hyprctl\n④ Guardian Shield — limpia todo al desactivar, sin errores en Hyprland";
            expanded: root.expanded-index == 2;
            hovered => { root.expanded-index = 2; }
        }
    }
}

// ─── ANIMATIONS MODULE ──────────────────────────────────────────────
export component AnimationsModule inherits ScrollView {
    in property <[string]> anim-titles;
    in property <[string]> anim-descs;
    in property <[string]> anim-tags;
    in property <[string]> anim-files;
    in property <int> active-index: -1;
    in property <string> header-title;
    in property <string> header-subtitle;
    callback anim-toggled(int, string);

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        SectionHeader {
            title: root.header-title;
            subtitle: root.header-subtitle;
            accent: HveColors.accent-amber;
        }

        for i in root.anim-titles.length: PresetCard {
            title: root.anim-titles[i];
            desc: root.anim-descs[i];
            tag: root.anim-tags[i];
            accent: HveColors.accent-amber;
            active: root.active-index == i;
            toggled(v) => { root.anim-toggled(i, root.anim-files[i]); }
        }
    }
}

// ─── BORDERS MODULE ─────────────────────────────────────────────────
export component BordersModule inherits ScrollView {
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in property <int> active-index: -1;
    in property <int> border-size: 2;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <string> geometry-label;
    callback border-toggled(int, string);
    callback geometry-changed(int);

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        SectionHeader {
            title: root.header-title;
            subtitle: root.header-subtitle;
            accent: HveColors.accent-green;
        }

        GeometrySlider {
            label: root.geometry-label;
            value: root.border-size;
            changed(v) => { root.geometry-changed(v); }
        }

        for i in root.border-titles.length: PresetCard {
            title: root.border-titles[i];
            desc: root.border-descs[i];
            tag: root.border-tags[i];
            accent: HveColors.accent-green;
            active: root.active-index == i;
            toggled(v) => { root.border-toggled(i, root.border-files[i]); }
        }
    }
}

// ─── SHADERS MODULE ─────────────────────────────────────────────────
export component ShadersModule inherits ScrollView {
    in property <[string]> shader-titles;
    in property <[string]> shader-descs;
    in property <[string]> shader-tags;
    in property <[string]> shader-files;
    in property <int> active-index: -1;
    in property <string> header-title;
    in property <string> header-subtitle;
    callback shader-toggled(int, string);

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        SectionHeader {
            title: root.header-title;
            subtitle: root.header-subtitle;
            accent: HveColors.accent-purple;
        }

        for i in root.shader-titles.length: PresetCard {
            title: root.shader-titles[i];
            desc: root.shader-descs[i];
            tag: root.shader-tags[i];
            accent: HveColors.accent-purple;
            active: root.active-index == i;
            toggled(v) => { root.shader-toggled(i, root.shader-files[i]); }
        }
    }
}
