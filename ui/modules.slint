import { ScrollView, LineEdit } from "std-widgets.slint";
import { HveColors } from "./theme.slint";
import {
    PresetCard,
    SectionHeader,
    GeometrySlider,
    WelcomeCard,
    ActivationCard,
    AccordionCard,
    NavCard,
    AboutItem,
} from "./components.slint";

// ─── HOME MODULE ────────────────────────────────────────────────────
export component HomeModule inherits ScrollView {
    in property <bool> system-active: false;
    in property <[string]> anim-titles;
    in property <[string]> border-titles;
    in property <[string]> shader-titles;
    in property <int> active-anim-index: -1;
    in property <int> active-border-index: -1;
    in property <int> active-shader-index: -1;
    in property <string> activation-title;
    in property <string> activation-active-text;
    in property <string> activation-inactive-text;
    // ── i18n: translated labels ──
    in property <string> status-active;
    in property <string> status-inactive;
    in property <string> nav-animations;
    in property <string> nav-borders;
    in property <string> nav-shaders;
    in property <string> count-styles;
    in property <string> count-filters;
    in property <string> active-config-title;
    in property <string> active-anim-label;
    in property <string> active-border-label;
    in property <string> active-shader-label;
    in property <string> none-anim;
    in property <string> none-border;
    in property <string> none-shader;
    in property <string> about-title;
    in property <string> about-short;
    in property <string> about-full;
    in property <[AboutItem]> about-items: [];
    callback toggle-system(bool);
    callback navigate-to(int);

    // Scroll suave al expandir el acordeón: viewport-y animado
    // + desplazamiento relativo para evitar el clamping pre-layout
    animate viewport-y {
        duration: 250ms;
        easing: ease-in-out;
    }

    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 24px;
        padding-bottom: 16px;
        spacing: 14px;
        alignment: start;

        // ── Status Card ──
        Rectangle {
            border-radius: 14px;
            background: root.system-active ? HveColors.bg-card : HveColors.bg-surface;
            border-width: 2px;
            border-color: root.system-active ? HveColors.accent-green : HveColors.accent-red;
            drop-shadow-blur: root.system-active ? 16px : 0px;
            drop-shadow-color: root.system-active ? HveColors.accent-green.transparentize(0.85) : transparent;

            animate background { duration: 300ms; }
            animate border-color { duration: 300ms; }
            animate drop-shadow-blur {
                duration: 400ms;
                easing: ease-out;
            }

            HorizontalLayout {
                padding: 24px;
                spacing: 20px;

                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 14px;
                    background: root.system-active ? HveColors.accent-green.transparentize(0.8) : HveColors.accent-red.transparentize(0.85);
                    animate background { duration: 300ms; }

                    Text {
                        text: root.system-active ? "ON" : "OFF";
                        font-size: 20px;
                        font-weight: 700;
                        color: root.system-active ? HveColors.accent-green : HveColors.accent-red;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.system-active ? root.status-active : root.status-inactive;
                        font-size: 18px;
                        font-weight: 700;
                        color: HveColors.text;
                    }

                    Text {
                        text: root.system-active ? root.activation-active-text : root.activation-inactive-text;
                        font-size: 12px;
                        color: HveColors.text-muted;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    width: 56px;
                    alignment: center;

                    Rectangle {
                        width: 56px;
                        height: 30px;
                        border-radius: 15px;
                        background: root.system-active ? HveColors.accent-green : HveColors.border;
                        animate background { duration: 300ms; }

                        TouchArea {
                            clicked => { root.toggle-system(!root.system-active); }
                        }

                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: HveColors.text;
                            x: root.system-active ? parent.width - self.width - 3px : 3px;
                            y: 3px;
                            animate x {
                                duration: 400ms;
                                easing: ease-in-out-back;
                            }
                        }
                    }
                }
            }
        }

        // ── Quick Nav Cards ──
        HorizontalLayout {
            spacing: 12px;

            NavCard {
                icon-text: "▶";
                label: root.nav-animations;
                count-text: root.anim-titles.length + root.count-styles;
                accent: HveColors.accent-amber;
                clicked => { root.navigate-to(1); }
            }

            NavCard {
                icon-text: "□";
                label: root.nav-borders;
                count-text: root.border-titles.length + root.count-styles;
                accent: HveColors.accent-green;
                clicked => { root.navigate-to(2); }
            }

            NavCard {
                icon-text: "◇";
                label: root.nav-shaders;
                count-text: root.shader-titles.length + root.count-filters;
                accent: HveColors.accent-purple;
                clicked => { root.navigate-to(3); }
            }
        }

        // ── Active Configuration ──
        if root.system-active: Rectangle {
            border-radius: 10px;
            background: HveColors.bg-card;
            border-width: 1px;
            border-color: HveColors.border;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                Text {
                    text: root.active-config-title;
                    font-size: 13px;
                    font-weight: 600;
                    color: HveColors.text-muted;
                }

                // ── Animación status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-amber.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-anim-index >= 0 ? HveColors.accent-amber : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-anim-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-anim-index >= 0 ? root.anim-titles[root.active-anim-index] : root.none-anim;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Borde status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-green.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-border-index >= 0 ? HveColors.accent-green : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-border-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-border-index >= 0 ? root.border-titles[root.active-border-index] : root.none-border;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Shader status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-purple.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-shader-index >= 0 ? HveColors.accent-purple : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-shader-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-shader-index >= 0 ? root.shader-titles[root.active-shader-index] : root.none-shader;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── About ──
        acerca := AccordionCard {
            card-title: root.about-title;
            icon-text: "💡";
            accent: HveColors.accent-cyan;
            border: HveColors.border;
            short-desc: root.about-short;
            full-desc: root.about-full;
            about-items: root.about-items;
            toggled => {
                acerca.expanded = !acerca.expanded;
                if acerca.expanded {
                    root.viewport-y = root.viewport-y - 140px;
                } else {
                    root.viewport-y = 0px;
                }
            }
        }
    }
}

// ─── ANIMATIONS MODULE ──────────────────────────────────────────────
export component AnimationsModule inherits Rectangle {
    in property <[string]> anim-titles;
    in property <[string]> anim-descs;
    in property <[string]> anim-tags;
    in property <[string]> anim-files;
    in property <int> active-index: -1;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <int> focused-index: -1;
    in property <bool> is-active: false;
    callback focus-requested(int);
    callback anim-toggled(int, string);

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px - 123px)) : 0px;
        animate viewport-y { duration: 400ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-amber;
            }

            for i in root.anim-titles.length: PresetCard {
                title: root.anim-titles[i];
                desc: root.anim-descs[i];
                tag: root.anim-tags[i];
                accent: HveColors.accent-amber;
                active: root.active-index == i;
                index: i;
                keyboard-focused: root.is-active && root.focused-index == i;
                toggled => { root.anim-toggled(i, root.anim-files[i]); }
                focus-requested(idx) => {
                    if (root.is-active) {
                        root.focus-requested(idx);
                    }
                }
            }
        }
    }
}

// ─── BORDERS MODULE ─────────────────────────────────────────────────
export component BordersModule inherits Rectangle {
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in property <int> active-index: -1;
    in property <int> border-size: 2;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <string> geometry-label;
    in property <int> focused-index: -1;
    in property <bool> is-active: false;
    callback focus-requested(int);
    callback border-toggled(int, string);
    callback geometry-changed(int);

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px - 123px)) : 0px;
        animate viewport-y { duration: 400ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-green;
            }

            GeometrySlider {
                label: root.geometry-label;
                value: root.border-size;
                changed(v) => { root.geometry-changed(v); }
            }

            for i in root.border-titles.length: PresetCard {
                title: root.border-titles[i];
                desc: root.border-descs[i];
                tag: root.border-tags[i];
                accent: HveColors.accent-green;
                active: root.active-index == i;
                index: i;
                keyboard-focused: root.is-active && root.focused-index == i;
                toggled => { root.border-toggled(i, root.border-files[i]); }
                focus-requested(idx) => {
                    if (root.is-active) {
                        root.focus-requested(idx);
                    }
                }
            }
        }
    }
}

// ─── SHADERS MODULE ─────────────────────────────────────────────────
export component ShadersModule inherits Rectangle {
    in property <[string]> shader-titles;
    in property <[string]> shader-descs;
    in property <[string]> shader-tags;
    in property <[string]> shader-files;
    in property <int> active-index: -1;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <int> focused-index: -1;
    in property <bool> is-active: false;
    callback focus-requested(int);
    callback shader-toggled(int, string);

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px - 123px)) : 0px;
        animate viewport-y { duration: 400ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-purple;
            }

            for i in root.shader-titles.length: PresetCard {
                title: root.shader-titles[i];
                desc: root.shader-descs[i];
                tag: root.shader-tags[i];
                accent: HveColors.accent-purple;
                active: root.active-index == i;
                index: i;
                keyboard-focused: root.is-active && root.focused-index == i;
                toggled => { root.shader-toggled(i, root.shader-files[i]); }
                focus-requested(idx) => {
                    if (root.is-active) {
                        root.focus-requested(idx);
                    }
                }
            }
        }
    }
}

// ─── THEMES MODULE ──────────────────────────────────────────────────
export component ThemesModule inherits Rectangle {
    in property <[string]> theme-names;
    in property <[string]> theme-saved-ats;
    in property <[bool]> theme-is-actives;
    in property <bool> is-busy: false;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <string> save-placeholder;
    in property <string> save-button;
    in property <string> search-placeholder;
    in property <string> empty-text;
    in property <string> apply-text;
    in property <string> rename-text;
    in property <string> delete-text;
    in property <string> cancel-text;
    in property <string> confirm-delete;
    in property <string> confirm-delete-msg;
    in property <string> rename-title;
    in property <string> include-label;
    in property <string> provider-noctalia;
    in property <string> provider-hve-presets;
    in property <string> action-overwrite;
    in-out property <bool> include-noctalia: true;
    in-out property <bool> include-hve-presets: true;
    callback save-theme(string);
    callback apply-theme(string);
    callback delete-theme(string);
    callback rename-theme(string, string);
    callback overwrite-theme(string);

    in-out property <string> dialog-mode: "";
    in-out property <string> dialog-target: "";
    in-out property <string> rename-input: "";
    in-out property <string> error-text: "";
    in-out property <string> search-query: "";

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-purple;
            }

            Rectangle {
                height: 48px;
                border-radius: 10px;
                background: HveColors.bg-card;
                border-width: 1px;
                border-color: HveColors.border;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;

                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: root.save-placeholder;
                        font-size: 13px;
                        text <=> root.rename-input;
                    }

                    Rectangle {
                        width: 80px;
                        height: 32px;
                        border-radius: 6px;
                        background: sb-ta.has-hover ? HveColors.accent-purple.transparentize(0.2) : HveColors.accent-purple;
                        animate background { duration: 150ms; }

                        Text {
                            text: root.save-button;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        sb-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.error-text = "";
                                if (root.rename-input != "") {
                                    root.save-theme(root.rename-input);
                                    root.rename-input = "";
                                }
                            }
                        }
                    }
                }
            }

            Text {
                text: root.error-text;
                color: HveColors.accent-red;
                font-size: 11px;
                visible: root.error-text != "";
            }

            Text {
                text: root.include-label;
                color: HveColors.text-muted;
                font-size: 11px;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: 8px;

                Rectangle {
                    width: 120px;
                    height: 28px;
                    border-radius: 6px;
                    background: root.include-noctalia ? HveColors.accent-purple.transparentize(0.85) : HveColors.bg-surface;
                    border-width: 1px;
                    border-color: root.include-noctalia ? HveColors.accent-purple.transparentize(0.5) : HveColors.border;
                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    HorizontalLayout {
                        spacing: 6px;
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.include-noctalia ? HveColors.accent-purple : HveColors.text-muted;
                        }

                        Text {
                            text: root.provider-noctalia;
                            color: root.include-noctalia ? HveColors.text : HveColors.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.include-noctalia = !root.include-noctalia; }
                    }
                }

                Rectangle {
                    width: 120px;
                    height: 28px;
                    border-radius: 6px;
                    background: root.include-hve-presets ? HveColors.accent-purple.transparentize(0.85) : HveColors.bg-surface;
                    border-width: 1px;
                    border-color: root.include-hve-presets ? HveColors.accent-purple.transparentize(0.5) : HveColors.border;
                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    HorizontalLayout {
                        spacing: 6px;
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.include-hve-presets ? HveColors.accent-purple : HveColors.text-muted;
                        }

                        Text {
                            text: root.provider-hve-presets;
                            color: root.include-hve-presets ? HveColors.text : HveColors.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.include-hve-presets = !root.include-hve-presets; }
                    }
                }
            }

            Rectangle {
                height: 36px;
                border-radius: 8px;
                background: HveColors.bg-card;
                border-width: 1px;
                border-color: HveColors.border;
                visible: root.theme-names.length > 0;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "⌕";
                        color: HveColors.text-muted;
                        font-size: 14px;
                    }

                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: root.search-placeholder;
                        font-size: 12px;
                        text <=> root.search-query;
                    }
                }
            }

            Rectangle {
                height: 120px;
                visible: root.theme-names.length == 0;

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "◈";
                        color: HveColors.text-muted;
                        font-size: 32px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.empty-text;
                        color: HveColors.text-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            for i in root.theme-names.length: Rectangle {
                height: 56px;
                border-radius: 10px;
                background: root.theme-is-actives[i] ? HveColors.bg-hover : HveColors.bg-card;
                border-width: root.theme-is-actives[i] ? 2px : 1px;
                border-color: root.theme-is-actives[i] ? HveColors.accent-purple : HveColors.border;
                visible: true;
                animate background { duration: 200ms; }
                animate border-color { duration: 200ms; }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 10px;

                    Rectangle {
                        width: root.theme-is-actives[i] ? 24px : 0px;
                        height: 24px;
                        border-radius: 12px;
                        background: HveColors.accent-purple;
                        visible: root.theme-is-actives[i];
                        opacity: root.theme-is-actives[i] ? 1 : 0;
                        animate width { duration: 200ms; easing: ease-in-out-back; }
                        animate opacity { duration: 200ms; }

                        Text {
                            text: "✓";
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: root.theme-names[i];
                            color: root.theme-is-actives[i] ? HveColors.accent-purple : HveColors.text;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.theme-saved-ats[i];
                            color: HveColors.text-muted;
                            font-size: 10px;
                            visible: root.theme-saved-ats[i] != "";
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 70px;
                        height: 30px;
                        border-radius: 6px;
                        background: apply-ta.has-hover ? HveColors.accent-green : HveColors.accent-green.transparentize(0.8);
                        animate background { duration: 150ms; }

                        Text {
                            text: root.apply-text;
                            color: HveColors.accent-green;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        apply-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                if (!root.is-busy) {
                                    root.apply-theme(root.theme-names[i]);
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 6px;
                        background: ov-ta.has-hover ? HveColors.bg-hover : transparent;
                        animate background { duration: 150ms; }

                        Text {
                            text: "↻";
                            color: HveColors.text-muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        ov-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.overwrite-theme(root.theme-names[i]); }
                        }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 6px;
                        background: rn-ta.has-hover ? HveColors.bg-hover : transparent;
                        animate background { duration: 150ms; }

                        Text {
                            text: "✎";
                            color: HveColors.text-muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        rn-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.rename-input = root.theme-names[i];
                                root.dialog-target = root.theme-names[i];
                                root.dialog-mode = "rename";
                            }
                        }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 6px;
                        background: del-ta.has-hover ? HveColors.accent-red.transparentize(0.8) : transparent;
                        animate background { duration: 150ms; }

                        Text {
                            text: "✕";
                            color: del-ta.has-hover ? HveColors.accent-red : HveColors.text-muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        del-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.dialog-target = root.theme-names[i];
                                root.dialog-mode = "delete";
                            }
                        }
                    }
                }
            }
        }
    }

    if root.dialog-mode == "rename": Rectangle {
        width: 100%;
        height: 100%;
        background: #00000060;

        Rectangle {
            width: 300px;
            height: 180px;
            border-radius: 12px;
            background: HveColors.bg-surface;
            border-width: 1px;
            border-color: HveColors.border;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            drop-shadow-blur: 20px;
            drop-shadow-color: #00000060;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.rename-title;
                    color: HveColors.text;
                    font-size: 15px;
                    font-weight: 700;
                }

                LineEdit {
                    height: 32px;
                    placeholder-text: root.save-placeholder;
                    font-size: 13px;
                    text <=> root.rename-input;
                }

                Text {
                    text: root.error-text;
                    color: HveColors.accent-red;
                    font-size: 11px;
                    visible: root.error-text != "";
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: cancel-rn.has-hover ? HveColors.bg-hover : HveColors.bg-card;
                        border-width: 1px;
                        border-color: HveColors.border;

                        Text {
                            text: root.cancel-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-rn := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.dialog-mode = "";
                                root.error-text = "";
                            }
                        }
                    }

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: apply-rn.has-hover ? HveColors.accent-purple.transparentize(0.2) : HveColors.accent-purple;

                        Text {
                            text: root.rename-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        apply-rn := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                if (root.rename-input != "" && root.rename-input != root.dialog-target) {
                                    root.rename-theme(root.dialog-target, root.rename-input);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.dialog-mode == "delete": Rectangle {
        width: 100%;
        height: 100%;
        background: #00000060;

        Rectangle {
            width: 300px;
            height: 160px;
            border-radius: 12px;
            background: HveColors.bg-surface;
            border-width: 1px;
            border-color: HveColors.border;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            drop-shadow-blur: 20px;
            drop-shadow-color: #00000060;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.confirm-delete;
                    color: HveColors.accent-red;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: root.confirm-delete-msg + " \"" + root.dialog-target + "\"?";
                    color: HveColors.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: cancel-del.has-hover ? HveColors.bg-hover : HveColors.bg-card;
                        border-width: 1px;
                        border-color: HveColors.border;

                        Text {
                            text: root.cancel-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-del := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.dialog-mode = "";
                                root.error-text = "";
                            }
                        }
                    }

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: apply-del.has-hover ? HveColors.accent-red : HveColors.accent-red.transparentize(0.2);

                        Text {
                            text: root.delete-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        apply-del := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.delete-theme(root.dialog-target);
                                root.dialog-mode = "";
                                root.error-text = "";
                            }
                        }
                    }
                }
            }
        }
    }
}
