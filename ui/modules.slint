import { ScrollView } from "std-widgets.slint";
import { HveColors } from "./theme.slint";
import {
    PresetCard,
    SectionHeader,
    GeometrySlider,
    WelcomeCard,
    ActivationCard,
    AccordionCard,
    NavCard,
    AboutItem,
} from "./components.slint";

// ─── HOME MODULE ────────────────────────────────────────────────────
export component HomeModule inherits ScrollView {
    in property <bool> system-active: false;
    in property <[string]> anim-titles;
    in property <[string]> border-titles;
    in property <[string]> shader-titles;
    in property <int> active-anim-index: -1;
    in property <int> active-border-index: -1;
    in property <int> active-shader-index: -1;
    in property <string> activation-title;
    in property <string> activation-active-text;
    in property <string> activation-inactive-text;
    // ── i18n: translated labels ──
    in property <string> status-active;
    in property <string> status-inactive;
    in property <string> nav-animations;
    in property <string> nav-borders;
    in property <string> nav-shaders;
    in property <string> count-styles;
    in property <string> count-filters;
    in property <string> active-config-title;
    in property <string> active-anim-label;
    in property <string> active-border-label;
    in property <string> active-shader-label;
    in property <string> none-anim;
    in property <string> none-border;
    in property <string> none-shader;
    in property <string> about-title;
    in property <string> about-short;
    in property <string> about-full;
    in property <[AboutItem]> about-items: [];
    callback toggle-system(bool);
    callback navigate-to(int);

    // Scroll suave al expandir el acordeón: viewport-y animado
    // + desplazamiento relativo para evitar el clamping pre-layout
    animate viewport-y {
        duration: 250ms;
        easing: ease-in-out;
    }

    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 24px;
        padding-bottom: 16px;
        spacing: 14px;
        alignment: start;

        // ── Status Card ──
        Rectangle {
            border-radius: 14px;
            background: root.system-active ? HveColors.bg-card : HveColors.bg-surface;
            border-width: 2px;
            border-color: root.system-active ? HveColors.accent-green : HveColors.accent-red;
            drop-shadow-blur: root.system-active ? 16px : 0px;
            drop-shadow-color: root.system-active ? HveColors.accent-green.transparentize(0.85) : transparent;

            animate background { duration: 300ms; }
            animate border-color { duration: 300ms; }
            animate drop-shadow-blur {
                duration: 400ms;
                easing: ease-out;
            }

            HorizontalLayout {
                padding: 24px;
                spacing: 20px;

                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 14px;
                    background: root.system-active ? HveColors.accent-green.transparentize(0.8) : HveColors.accent-red.transparentize(0.85);
                    animate background { duration: 300ms; }

                    Text {
                        text: root.system-active ? "ON" : "OFF";
                        font-size: 20px;
                        font-weight: 700;
                        color: root.system-active ? HveColors.accent-green : HveColors.accent-red;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.system-active ? root.status-active : root.status-inactive;
                        font-size: 18px;
                        font-weight: 700;
                        color: HveColors.text;
                    }

                    Text {
                        text: root.system-active ? root.activation-active-text : root.activation-inactive-text;
                        font-size: 12px;
                        color: HveColors.text-muted;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    width: 56px;
                    alignment: center;

                    Rectangle {
                        width: 56px;
                        height: 30px;
                        border-radius: 15px;
                        background: root.system-active ? HveColors.accent-green : HveColors.border;
                        animate background { duration: 300ms; }

                        TouchArea {
                            clicked => { root.toggle-system(!root.system-active); }
                        }

                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: HveColors.text;
                            x: root.system-active ? parent.width - self.width - 3px : 3px;
                            y: 3px;
                            animate x {
                                duration: 400ms;
                                easing: ease-in-out-back;
                            }
                        }
                    }
                }
            }
        }

        // ── Quick Nav Cards ──
        HorizontalLayout {
            spacing: 12px;

            NavCard {
                icon-text: "▶";
                label: root.nav-animations;
                count-text: root.anim-titles.length + root.count-styles;
                accent: HveColors.accent-amber;
                clicked => { root.navigate-to(1); }
            }

            NavCard {
                icon-text: "□";
                label: root.nav-borders;
                count-text: root.border-titles.length + root.count-styles;
                accent: HveColors.accent-green;
                clicked => { root.navigate-to(2); }
            }

            NavCard {
                icon-text: "◇";
                label: root.nav-shaders;
                count-text: root.shader-titles.length + root.count-filters;
                accent: HveColors.accent-purple;
                clicked => { root.navigate-to(3); }
            }
        }

        // ── Active Configuration ──
        if root.system-active: Rectangle {
            border-radius: 10px;
            background: HveColors.bg-card;
            border-width: 1px;
            border-color: HveColors.border;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                Text {
                    text: root.active-config-title;
                    font-size: 13px;
                    font-weight: 600;
                    color: HveColors.text-muted;
                }

                // ── Animación status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-amber.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-anim-index >= 0 ? HveColors.accent-amber : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-anim-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-anim-index >= 0 ? root.anim-titles[root.active-anim-index] : root.none-anim;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Borde status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-green.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-border-index >= 0 ? HveColors.accent-green : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-border-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-border-index >= 0 ? root.border-titles[root.active-border-index] : root.none-border;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Shader status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-purple.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-shader-index >= 0 ? HveColors.accent-purple : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-shader-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-shader-index >= 0 ? root.shader-titles[root.active-shader-index] : root.none-shader;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── About ──
        acerca := AccordionCard {
            card-title: root.about-title;
            icon-text: "💡";
            accent: HveColors.accent-cyan;
            border: HveColors.border;
            short-desc: root.about-short;
            full-desc: root.about-full;
            about-items: root.about-items;
            toggled => {
                acerca.expanded = !acerca.expanded;
                if acerca.expanded {
                    root.viewport-y = root.viewport-y - 140px;
                } else {
                    root.viewport-y = 0px;
                }
            }
        }
    }
}

// ─── ANIMATIONS MODULE ──────────────────────────────────────────────
export component AnimationsModule inherits Rectangle {
    in property <[string]> anim-titles;
    in property <[string]> anim-descs;
    in property <[string]> anim-tags;
    in property <[string]> anim-files;
    in property <int> active-index: -1;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <int> focused-index: -1;
    in property <bool> is-active: false;
    callback focus-requested(int);
    callback anim-toggled(int, string);

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px - 123px)) : 0px;
        animate viewport-y { duration: 400ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-amber;
            }

            for i in root.anim-titles.length: PresetCard {
                title: root.anim-titles[i];
                desc: root.anim-descs[i];
                tag: root.anim-tags[i];
                accent: HveColors.accent-amber;
                active: root.active-index == i;
                index: i;
                keyboard-focused: root.is-active && root.focused-index == i;
                toggled => { root.anim-toggled(i, root.anim-files[i]); }
                focus-requested(idx) => {
                    if (root.is-active) {
                        root.focus-requested(idx);
                    }
                }
            }
        }
    }
}

// ─── BORDERS MODULE ─────────────────────────────────────────────────
export component BordersModule inherits Rectangle {
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in property <int> active-index: -1;
    in property <int> border-size: 2;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <string> geometry-label;
    in property <int> focused-index: -1;
    in property <bool> is-active: false;
    callback focus-requested(int);
    callback border-toggled(int, string);
    callback geometry-changed(int);

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px - 123px)) : 0px;
        animate viewport-y { duration: 400ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-green;
            }

            GeometrySlider {
                label: root.geometry-label;
                value: root.border-size;
                changed(v) => { root.geometry-changed(v); }
            }

            for i in root.border-titles.length: PresetCard {
                title: root.border-titles[i];
                desc: root.border-descs[i];
                tag: root.border-tags[i];
                accent: HveColors.accent-green;
                active: root.active-index == i;
                index: i;
                keyboard-focused: root.is-active && root.focused-index == i;
                toggled => { root.border-toggled(i, root.border-files[i]); }
                focus-requested(idx) => {
                    if (root.is-active) {
                        root.focus-requested(idx);
                    }
                }
            }
        }
    }
}

// ─── SHADERS MODULE ─────────────────────────────────────────────────
export component ShadersModule inherits Rectangle {
    in property <[string]> shader-titles;
    in property <[string]> shader-descs;
    in property <[string]> shader-tags;
    in property <[string]> shader-files;
    in property <int> active-index: -1;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <int> focused-index: -1;
    in property <bool> is-active: false;
    callback focus-requested(int);
    callback shader-toggled(int, string);

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px - 123px)) : 0px;
        animate viewport-y { duration: 400ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-purple;
            }

            for i in root.shader-titles.length: PresetCard {
                title: root.shader-titles[i];
                desc: root.shader-descs[i];
                tag: root.shader-tags[i];
                accent: HveColors.accent-purple;
                active: root.active-index == i;
                index: i;
                keyboard-focused: root.is-active && root.focused-index == i;
                toggled => { root.shader-toggled(i, root.shader-files[i]); }
                focus-requested(idx) => {
                    if (root.is-active) {
                        root.focus-requested(idx);
                    }
                }
            }
        }
    }
}
