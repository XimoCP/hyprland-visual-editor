import { ScrollView, LineEdit } from "std-widgets.slint";
import { HveColors } from "./theme.slint";
import {
    PresetCard,
    SectionHeader,
    GeometrySlider,
    WelcomeCard,
    ActivationCard,
    AccordionCard,
    NavCard,
    AboutItem,
    IconButton,
} from "./components.slint";

// ─── HOME MODULE ────────────────────────────────────────────────────
export component HomeModule inherits ScrollView {
    in property <bool> system-active: false;
    in property <[string]> anim-titles;
    in property <[string]> border-titles;
    in property <[string]> shader-titles;
    in property <int> active-anim-index: -1;
    in property <int> active-border-index: -1;
    in property <int> active-shader-index: -1;
    in property <string> activation-title;
    in property <string> activation-active-text;
    in property <string> activation-inactive-text;
    // ── i18n: translated labels ──
    in property <string> status-active;
    in property <string> status-inactive;
    in property <string> nav-animations;
    in property <string> nav-borders;
    in property <string> nav-shaders;
    in property <string> count-styles;
    in property <string> count-filters;
    in property <string> active-config-title;
    in property <string> active-anim-label;
    in property <string> active-border-label;
    in property <string> active-shader-label;
    in property <string> active-theme-label;
    in property <string> none-anim;
    in property <string> none-border;
    in property <string> none-shader;
    in property <string> none-theme;
    in property <string> active-theme-name;
    in property <string> about-title;
    in property <string> about-short;
    in property <string> about-full;
    in property <[AboutItem]> about-items: [];
    in property <string> about-tree-label;
    in property <[string]> about-tree-paths;
    in property <[string]> about-tree-descs;
    in property <string> about-tree-path-max;
    in property <string> about-docs-label;
    in-out property <bool> about-scroll-pending: false;
    callback toggle-system(bool);
    callback navigate-to(int);
    callback open-docs();

    // Scroll suave al expandir el acordeón: viewport-y animado
    // + desplazamiento relativo para evitar el clamping pre-layout
    animate viewport-y {
        duration: 250ms;
        easing: ease-in-out;
    }

    // Al expandir, esperamos un tick (layout ya recalculado) y scrolleamos
    // hasta que el acordeón quede en la parte superior del área visible.
    ab-timer := Timer {
        interval: 20ms;
        running: root.about-scroll-pending;
        triggered => {
            root.about-scroll-pending = false;
            root.viewport-y = -acerca.y + 24px;
        }
    }

    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 24px;
        padding-bottom: 16px;
        spacing: 14px;
        alignment: start;

        // ── Status Card ──
        Rectangle {
            border-radius: 14px;
            background: root.system-active ? HveColors.bg-card : HveColors.bg-surface;
            border-width: 2px;
            border-color: root.system-active ? HveColors.accent-green : HveColors.accent-red;
            drop-shadow-blur: root.system-active ? 16px : 0px;
            drop-shadow-color: root.system-active ? HveColors.accent-green.transparentize(0.85) : transparent;

            animate background { duration: 300ms; }
            animate border-color { duration: 300ms; }
            animate drop-shadow-blur {
                duration: 400ms;
                easing: ease-out;
            }

            HorizontalLayout {
                padding: 24px;
                spacing: 20px;

                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 14px;
                    background: root.system-active ? HveColors.accent-green.transparentize(0.8) : HveColors.accent-red.transparentize(0.85);
                    animate background { duration: 300ms; }

                    Text {
                        text: root.system-active ? "ON" : "OFF";
                        font-size: 20px;
                        font-weight: 700;
                        color: root.system-active ? HveColors.accent-green : HveColors.accent-red;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.system-active ? root.status-active : root.status-inactive;
                        font-size: 18px;
                        font-weight: 700;
                        color: HveColors.text;
                    }

                    Text {
                        text: root.system-active ? root.activation-active-text : root.activation-inactive-text;
                        font-size: 12px;
                        color: HveColors.text-muted;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    width: 56px;
                    alignment: center;

                    Rectangle {
                        width: 56px;
                        height: 30px;
                        border-radius: 15px;
                        background: root.system-active ? HveColors.accent-green : HveColors.border;
                        animate background { duration: 300ms; }

                        TouchArea {
                            clicked => { root.toggle-system(!root.system-active); }
                        }

                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: HveColors.text;
                            x: root.system-active ? parent.width - self.width - 3px : 3px;
                            y: 3px;
                            animate x {
                                duration: 400ms;
                                easing: ease-in-out-back;
                            }
                        }
                    }
                }
            }
        }

        // ── Quick Nav Cards ──
        HorizontalLayout {
            spacing: 12px;

            NavCard {
                icon-text: "▶";
                label: root.nav-animations;
                count-text: root.anim-titles.length + root.count-styles;
                accent: HveColors.accent-amber;
                clicked => { root.navigate-to(1); }
            }

            NavCard {
                icon-text: "□";
                label: root.nav-borders;
                count-text: root.border-titles.length + root.count-styles;
                accent: HveColors.accent-green;
                clicked => { root.navigate-to(2); }
            }

            NavCard {
                icon-text: "◇";
                label: root.nav-shaders;
                count-text: root.shader-titles.length + root.count-filters;
                accent: HveColors.accent-purple;
                clicked => { root.navigate-to(3); }
            }
        }

        // ── Active Configuration ──
        if root.system-active: Rectangle {
            border-radius: 10px;
            background: HveColors.bg-card;
            border-width: 1px;
            border-color: HveColors.border;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                Text {
                    text: root.active-config-title;
                    font-size: 13px;
                    font-weight: 600;
                    color: HveColors.text-muted;
                }

                // ── Animación status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-amber.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-anim-index >= 0 ? HveColors.accent-amber : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-anim-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-anim-index >= 0 ? root.anim-titles[root.active-anim-index] : root.none-anim;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Borde status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-green.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-border-index >= 0 ? HveColors.accent-green : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-border-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-border-index >= 0 ? root.border-titles[root.active-border-index] : root.none-border;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Shader status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-purple.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-shader-index >= 0 ? HveColors.accent-purple : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-shader-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-shader-index >= 0 ? root.shader-titles[root.active-shader-index] : root.none-shader;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Theme status ──
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: HveColors.accent-cyan.transparentize(0.85);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-theme-name != "" ? HveColors.accent-cyan : HveColors.text-muted;
                            }
                        }
                        Text {
                            text: root.active-theme-label;
                            font-size: 12px;
                            color: HveColors.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.active-theme-name != "" ? root.active-theme-name : root.none-theme;
                            font-size: 12px;
                            font-weight: 600;
                            color: HveColors.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── About ──
        acerca := AccordionCard {
            card-title: root.about-title;
            icon-text: "💡";
            accent: HveColors.accent-cyan;
            border: HveColors.border;
            short-desc: root.about-short;
            full-desc: root.about-full;
            about-items: root.about-items;
            tree-label: root.about-tree-label;
            tree-paths: root.about-tree-paths;
            tree-descs: root.about-tree-descs;
            tree-path-max: root.about-tree-path-max;
            docs-label: root.about-docs-label;
            toggled => {
                acerca.expanded = !acerca.expanded;
                if acerca.expanded {
                    root.about-scroll-pending = true;
                } else {
                    root.about-scroll-pending = false;
                    root.viewport-y = 0px;
                }
            }
            open-docs => {
                root.open-docs();
            }
        }
    }
}

// ─── ANIMATIONS MODULE ──────────────────────────────────────────────
export component AnimationsModule inherits Rectangle {
    in property <[string]> anim-titles;
    in property <[string]> anim-descs;
    in property <[string]> anim-tags;
    in property <[string]> anim-files;
    in property <int> active-index: -1;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <int> focused-index: -1;
    in property <bool> is-active: false;
    in property <bool> fast-expand: false;
    callback focus-requested(int);
    callback anim-toggled(int, string);

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px + 152px - self.height / 2 + (root.active-index >= 0 && root.active-index < root.focused-index ? 42px : 0px) + ((root.active-index == root.focused-index || root.is-active) ? 21px : 0px))) : 0px;
        animate viewport-y { duration: root.fast-expand ? 140ms : 250ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-amber;
            }

            for i in root.anim-titles.length: PresetCard {
                title: root.anim-titles[i];
                desc: root.anim-descs[i];
                tag: root.anim-tags[i];
                accent: HveColors.accent-amber;
                active: root.active-index == i;
                index: i;
                keyboard-focused: root.is-active && root.focused-index == i;
                fast-expand: root.fast-expand;
                toggled => { root.anim-toggled(i, root.anim-files[i]); }
                focus-requested(idx) => {
                    if (root.is-active) {
                        root.focus-requested(idx);
                    }
                }
            }
        }
    }
}

// ─── BORDERS MODULE ─────────────────────────────────────────────────
export component BordersModule inherits Rectangle {
    in property <[string]> border-titles;
    in property <[string]> border-descs;
    in property <[string]> border-tags;
    in property <[string]> border-files;
    in property <int> active-index: -1;
    in property <int> border-size: 2;
    in property <int> corner-radius: 32;
    in property <int> gap-in: 5;
    in property <int> gap-out: 5;
    in property <string> gap-in-label;
    in property <string> gap-out-label;
    in property <string> border-radius-label;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <string> geometry-label;
    in property <int> focused-index: -1;
    in property <bool> is-active: false;
    in property <bool> fast-expand: false;
    callback focus-requested(int);
    callback border-toggled(int, string);
    callback geometry-changed(int);
    callback geometry-radius-changed(int);
    callback geometry-gaps-in-changed(int);
    callback geometry-gaps-out-changed(int);

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px + 244px - self.height / 2 + (root.active-index >= 0 && root.active-index < root.focused-index ? 42px : 0px) + ((root.active-index == root.focused-index || root.is-active) ? 21px : 0px))) : 0px;
        animate viewport-y { duration: root.fast-expand ? 140ms : 250ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-green;
            }

            GeometrySlider {
                label: root.geometry-label;
                value: root.border-size;
                changed(v) => { root.geometry-changed(v); }
            }

            GeometrySlider {
                label: root.border-radius-label;
                value: root.corner-radius;
                min: 0;
                max: 100;
                changed(v) => { root.geometry-radius-changed(v); }
            }

            GeometrySlider {
                label: root.gap-in-label;
                value: root.gap-in;
                min: 0;
                max: 30;
                changed(v) => { root.geometry-gaps-in-changed(v); }
            }

            GeometrySlider {
                label: root.gap-out-label;
                value: root.gap-out;
                min: 0;
                max: 30;
                changed(v) => { root.geometry-gaps-out-changed(v); }
            }

            for i in root.border-titles.length: PresetCard {
                title: root.border-titles[i];
                desc: root.border-descs[i];
                tag: root.border-tags[i];
                accent: HveColors.accent-green;
                active: root.active-index == i;
                index: i;
                keyboard-focused: root.is-active && root.focused-index == i;
                fast-expand: root.fast-expand;
                toggled => { root.border-toggled(i, root.border-files[i]); }
                focus-requested(idx) => {
                    if (root.is-active) {
                        root.focus-requested(idx);
                    }
                }
            }
        }
    }
}

// ─── SHADERS MODULE ─────────────────────────────────────────────────
export component ShadersModule inherits Rectangle {
    in property <[string]> shader-titles;
    in property <[string]> shader-descs;
    in property <[string]> shader-tags;
    in property <[string]> shader-files;
    in property <int> active-index: -1;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <int> focused-index: -1;
    in property <bool> is-active: false;
    in property <bool> fast-expand: false;
    callback focus-requested(int);
    callback shader-toggled(int, string);

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px + 152px - self.height / 2 + (root.active-index >= 0 && root.active-index < root.focused-index ? 42px : 0px) + ((root.active-index == root.focused-index || root.is-active) ? 21px : 0px))) : 0px;
        animate viewport-y { duration: root.fast-expand ? 140ms : 250ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-purple;
            }

            for i in root.shader-titles.length: PresetCard {
                title: root.shader-titles[i];
                desc: root.shader-descs[i];
                tag: root.shader-tags[i];
                accent: HveColors.accent-purple;
                active: root.active-index == i;
                index: i;
                keyboard-focused: root.is-active && root.focused-index == i;
                fast-expand: root.fast-expand;
                toggled => { root.shader-toggled(i, root.shader-files[i]); }
                focus-requested(idx) => {
                    if (root.is-active) {
                        root.focus-requested(idx);
                    }
                }
            }
        }
    }
}

// ─── THEME ITEM ─────────────────────────────────────────────────────
export component ThemeItem inherits Rectangle {
    in property <string> theme-name;
    in property <string> theme-saved-at;
    in property <bool> is-active: false;
    in property <bool> is-busy: false;
    in property <bool> apply-in-progress: false;
    in property <bool> keyboard-focused: false;
    in property <bool> fast-expand: false;
    in property <color> accent;
    in property <string> apply-text;
    in property <int> index: 0;
    callback apply-theme(string);
    callback overwrite-theme(string);
    callback open-rename(string);
    callback open-delete(string);
    callback open-refresh(string);
    callback focus-requested(int);
    callback refresh-themes();

    property <bool> is-hovered: card-ta.has-hover || apply-btn.has-hover || ref-btn.has-hover || rn-btn.has-hover || del-btn.has-hover;
    property <bool> _expanded: is-active || is-hovered || keyboard-focused;

    height: _expanded ? 100px : 56px;
    border-radius: 10px;
    background: is-active ? HveColors.bg-hover : (is-hovered || keyboard-focused ? HveColors.bg-hover : HveColors.bg-card);
    border-width: is-active ? 3px : (keyboard-focused ? 1.5px : 1px);
    border-color: (is-active && keyboard-focused) ? HveColors.text : (is-active ? accent : ((is-hovered || keyboard-focused) ? (keyboard-focused ? accent : accent.transparentize(0.6)) : HveColors.border));
    visible: true;

    // 1. Capa de fondo para el TouchArea de la tarjeta (Eventos de hover/click)
    card-ta := TouchArea {
        width: 100%;
        height: 100%;
    }


    // 2. Glow y sombras (Visuales)
    drop-shadow-blur: is-active ? 12px : 0px;
    drop-shadow-color: is-active ? accent.transparentize(0.8) : transparent;

    animate background { duration: 200ms; easing: ease-in-out; }
    animate border-color { duration: 200ms; easing: ease-in-out; }
    animate drop-shadow-blur { duration: 300ms; easing: ease-out; }
    animate height { duration: fast-expand ? 120ms : 250ms; easing: ease-in-out-back; }

    // 3. Contenido Visual (El layout principal)
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;


        // 1. CHECK DE ACTIVO (Pegado al principio y centrado verticalmente)
        if is-active : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 8px;
                background: accent;

                Text {
                    text: "✓";
                    color: HveColors.text;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // 2. TEXTO (Ocupa todo el espacio sobrante con horizontal-stretch: 1)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center; // Centra verticalmente los textos
            spacing: 2px;

            Text {
                text: root.theme-name;
                color: is-active ? accent : HveColors.text;
                font-size: 14px;
                font-weight: is-active ? 700 : 600;
                overflow: elide;
            }

            if root.theme-saved-at != "" : Text {
                text: root.theme-saved-at;
                color: HveColors.text-muted;
                font-size: 11px;
                overflow: elide;
            }
        }

        // 3. BOTONES DE ACCIÓN (Pegados al final y centrados verticalmente)
        VerticalLayout {
            alignment: center; // Asegura centrado Y independientemente de la altura de la tarjeta

            HorizontalLayout {
                spacing: 6px;

                // Aplicar
                apply-btn := IconButton {
                    icon: "▶";
                    bg-color: HveColors.accent-green;
                    tooltip-text: "Apply theme";
                    disabled: root.is-busy || root.apply-in-progress;
                    clicked => {
                        root.apply-theme(root.theme-name);
                    }
                }

                // Recargar / Resetear
                ref-btn := IconButton {
                    icon: "↻";
                    bg-color: HveColors.accent-purple;
                    hover-bg-color: HveColors.accent-purple.transparentize(0.2);
                    tooltip-text: "Refresh";
                    clicked => { root.open-refresh(root.theme-name); }
                }

                // Renombrar
                rn-btn := IconButton {
                    icon: "✎";
                    bg-color: HveColors.accent-amber;
                    hover-bg-color: HveColors.accent-amber.transparentize(0.2);
                    tooltip-text: "Renombrar";
                    clicked => { root.open-rename(root.theme-name); }
                }

                // Borrar
                del-btn := IconButton {
                    icon: "✕";
                    bg-color: #f87171;
                    hover-bg-color: #f87171.transparentize(0.2);
                    tooltip-text: "Eliminar";
                    clicked => { root.open-delete(root.theme-name); }
                }
            }
        }
    }
}

// ─── THEMES MODULE ──────────────────────────────────────────────────
export component ThemesModule inherits Rectangle {
    in property <[string]> theme-names;
    in property <[string]> theme-saved-ats;
    in property <[bool]> theme-is-actives;

    in property <bool> is-busy: false;
    in property <string> header-title;
    in property <string> header-subtitle;
    in property <string> save-placeholder;
    in property <string> save-button;
    in property <string> search-placeholder;
    in property <string> empty-text;
    in property <string> apply-text;
    in property <string> rename-text;
    in property <string> delete-text;
    in property <string> refresh-text;
    in property <string> cancel-text;
    in property <string> confirm-delete;
    in property <string> confirm-delete-msg;
    in property <string> confirm-refresh;
    in property <string> confirm-refresh-msg;
    in property <string> rename-title;
    in property <int> focused-index: -1;
    in property <int> active-index: -1;
    in property <bool> is-active: false;
    in property <bool> fast-expand: false;
    callback focus-requested(int);
    callback save-theme(string);
    callback apply-theme(string);
    callback delete-theme(string);
    callback rename-theme(string, string);
    callback overwrite-theme(string);
    callback refresh-themes();
    callback search-query-changed(string);

    in-out property <string> dialog-mode: "";
    in-out property <string> dialog-target: "";
    in-out property <string> rename-input: "";
    in-out property <string> error-text: "";
    in-out property <string> search-query: "";
    in-out property <bool> apply-in-progress: false;

    ScrollView {
        vertical-stretch: 1;
        viewport-y: root.focused-index >= 0 ? (0px - max(0px, root.focused-index * 70px + 371px - self.height / 2 + (root.active-index >= 0 && root.active-index < root.focused-index ? 42px : 0px) + ((root.active-index == root.focused-index || root.is-active) ? 21px : 0px))) : 0px;
        animate viewport-y { duration: root.fast-expand ? 140ms : 250ms; easing: ease-out; }

        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            alignment: start; // <--- VITAL: Mantiene los elementos apilados arriba de forma fluida

            SectionHeader {
                title: root.header-title;
                subtitle: root.header-subtitle;
                accent: HveColors.accent-pink;
            }

            // ── Save Section ──
            Text {
                text: "Guardar Estado Actual";
                color: HveColors.text-muted;
                font-size: 12px;
                font-weight: 600;
            }

            Rectangle {
                height: 48px;
                border-radius: 10px;
                background: HveColors.bg-card;
                border-width: 1px;
                border-color: HveColors.border;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;

                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: root.save-placeholder;
                        font-size: 13px;
                        text <=> root.rename-input;
                    }

                    Rectangle {
                        width: 80px;
                        height: 32px;
                        border-radius: 6px;
                        background: sb-ta.has-hover ? HveColors.accent-pink.transparentize(0.2) : HveColors.accent-pink;
                        animate background { duration: 150ms; }

                        Text {
                            text: root.save-button;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        sb-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.error-text = "";
                                if (root.rename-input != "") {
                                    root.save-theme(root.rename-input);
                                    root.rename-input = "";
                                }
                            }
                        }
                    }
                }
            }

            if (root.error-text != "") : Text {
                text: root.error-text;
                color: HveColors.accent-red;
                font-size: 11px;
            }

            // ── Divider ──
            Rectangle {
                height: 1px;
                background: HveColors.border;
                vertical-stretch: 0;
            }

            Rectangle {
                width: 100%;
                height: 8px;
                visible: true;
            }

            // ── Theme List Section ──
            Text {
                text: "Mis Temas";
                color: HveColors.text-muted;
                font-size: 12px;
                font-weight: 600;
            }

            // ── Buscador con el mismo padding interno que el bloque de guardar ──
            if (root.theme-names.length > 0) : Rectangle {
                height: 48px;
                border-radius: 10px;
                background: HveColors.bg-card;
                border-width: 1px;
                border-color: HveColors.border;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;

                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: root.search-placeholder;
                        font-size: 12px;
                        text <=> root.search-query;
                        edited => { root.search-query-changed(root.search-query); }
                    }
                }
            }

            // ── Mensaje de estado vacío ──
            if (root.theme-names.length == 0) : Rectangle {
                height: 120px;

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "◈";
                        color: HveColors.text-muted;
                        font-size: 32px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.empty-text;
                        color: HveColors.text-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // ── Lista de temas ──
            for i in root.theme-names.length: ThemeItem {
                theme-name: root.theme-names[i];
                theme-saved-at: root.theme-saved-ats[i];
                is-active: root.theme-is-actives[i];
                is-busy: root.is-busy;
                apply-in-progress: root.apply-in-progress;
                keyboard-focused: root.is-active && root.focused-index == i;
                fast-expand: root.fast-expand;
                accent: HveColors.accent-pink;
                apply-text: root.apply-text;
                apply-theme(v) => {
                    root.apply-in-progress = true;
                    root.apply-theme(v);
                    root.apply-in-progress = false;
                }
                overwrite-theme(v) => { root.overwrite-theme(v); }
                refresh-themes => { root.refresh-themes(); }
                open-rename(name) => {
                    root.rename-input = name;
                    root.dialog-target = name;
                    root.dialog-mode = "rename";
                }
                open-delete(name) => {
                    root.dialog-target = name;
                    root.dialog-mode = "delete";
                }
                open-refresh(name) => {
                    root.dialog-target = name;
                    root.dialog-mode = "refresh";
                }
                focus-requested(idx) => { root.focus-requested(idx); }
                index: i;
            }
        }
    }

    // ── Diálogo de Rename ──
    if root.dialog-mode == "rename": Rectangle {
        width: 100%;
        height: 100%;
        background: #00000060;

        Rectangle {
            width: 300px;
            height: 180px;
            border-radius: 12px;
            background: HveColors.bg-surface;
            border-width: 1px;
            border-color: HveColors.border;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            drop-shadow-blur: 20px;
            drop-shadow-color: #00000060;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.rename-title;
                    color: HveColors.text;
                    font-size: 15px;
                    font-weight: 700;
                }

                LineEdit {
                    height: 32px;
                    placeholder-text: root.save-placeholder;
                    font-size: 13px;
                    text <=> root.rename-input;
                }

                if (root.error-text != "") : Text {
                    text: root.error-text;
                    color: HveColors.accent-red;
                    font-size: 11px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: cancel-rn.has-hover ? HveColors.bg-hover : HveColors.bg-card;
                        border-width: 1px;
                        border-color: HveColors.border;

                        Text {
                            text: root.cancel-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-rn := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.dialog-mode = "";
                                root.error-text = "";
                            }
                        }
                    }

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: apply-rn.has-hover ? HveColors.accent-pink.transparentize(0.2) : HveColors.accent-pink;

                        Text {
                            text: root.rename-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        apply-rn := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                if (root.rename-input != "" && root.rename-input != root.dialog-target) {
                                    root.rename-theme(root.dialog-target, root.rename-input);
                                }
                                root.dialog-mode = "";
                                root.error-text = "";
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Diálogo de Delete ──
    if root.dialog-mode == "delete": Rectangle {
        width: 100%;
        height: 100%;
        background: #00000060;

        Rectangle {
            width: 300px;
            height: 160px;
            border-radius: 12px;
            background: HveColors.bg-surface;
            border-width: 1px;
            border-color: HveColors.border;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            drop-shadow-blur: 20px;
            drop-shadow-color: #00000060;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.confirm-delete;
                    color: HveColors.accent-red;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: root.confirm-delete-msg + " \"" + root.dialog-target + "\"?";
                    color: HveColors.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: cancel-del.has-hover ? HveColors.bg-hover : HveColors.bg-card;
                        border-width: 1px;
                        border-color: HveColors.border;

                        Text {
                            text: root.cancel-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-del := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.dialog-mode = "";
                                root.error-text = "";
                            }
                        }
                    }

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: apply-del.has-hover ? HveColors.accent-red : HveColors.accent-red.transparentize(0.2);

                        Text {
                            text: root.delete-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        apply-del := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.delete-theme(root.dialog-target);
                                root.dialog-mode = "";
                                root.error-text = "";
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Diálogo de Refresh ──
    if root.dialog-mode == "refresh": Rectangle {
        width: 100%;
        height: 100%;
        background: #00000060;

        Rectangle {
            width: 300px;
            height: 160px;
            border-radius: 12px;
            background: HveColors.bg-surface;
            border-width: 1px;
            border-color: HveColors.border;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            drop-shadow-blur: 20px;
            drop-shadow-color: #00000060;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.confirm-refresh;
                    color: HveColors.accent-purple;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: root.confirm-refresh-msg;
                    color: HveColors.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: cancel-rf.has-hover ? HveColors.bg-hover : HveColors.bg-card;
                        border-width: 1px;
                        border-color: HveColors.border;

                        Text {
                            text: root.cancel-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-rf := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.dialog-mode = "";
                                root.error-text = "";
                            }
                        }
                    }

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        background: apply-rf.has-hover ? HveColors.accent-purple : HveColors.accent-purple.transparentize(0.2);

                        Text {
                            text: root.refresh-text;
                            color: HveColors.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        apply-rf := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.refresh-themes();
                                root.dialog-mode = "";
                                root.error-text = "";
                            }
                        }
                    }
                }
            }
        }
    }
}
