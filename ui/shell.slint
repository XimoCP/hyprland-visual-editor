// HVE 2 — Shell chrome (trunk, delivery 3/5).
//
// MIT credit: visual language, geometry and tokens are translated from
// skwd-wall (MIT, © liixini, https://github.com/liixini/skwd-wall).
// No GPL code (hyprmod) is used.

import { SkwdTokens } from "tokens.slint";
import { HveColors } from "theme.slint";
import { GalleryRoot } from "gallery/GalleryRoot.slint";
import { GalleryCardData } from "gallery/ThemeCardDelegate.slint";
import { MosaicTileData } from "gallery/MosaicView.slint";
import { SliceTileData } from "gallery/SliceCarousel.slint";
import { PanelRoot } from "panel/PanelRoot.slint";
import { AboutItem } from "components.slint";
// Re-export the token singleton so consumers of this compilation unit (and
// delivery 4's ui/main.slint) can read it under its own name from Rust.
export { SkwdTokens }
export { GalleryCardData }

// Placeholder body shown inside the slot area while a screen is mounted.
// Real slot views (gallery/workshop) replace it in modules 2 and 4.
component SlotPlaceholder inherits Rectangle {
    in property <string> placeholder-text;
    in property <color> accent;

    background: HveColors.bg-card;
    border-radius: SkwdTokens.radius-12;

    Text {
        text: placeholder-text;
        font-family: SkwdTokens.font-body;
        font-size: SkwdTokens.size-14;
        color: accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ─── ShellRoot — the navigation shell chrome (design D1, D8) ───────────
// The trunk chrome ui/main.slint mounts in delivery 4: a root layout with a
// slot area where mounted screens render (`if`+enum replaces the QML Loader,
// design D3), branding/status placeholders and KeyBindings that emit
// navigation callbacks. The UI is a read-only view of the Rust NavState
// (nav-shell spec R1): it mirrors `mounted-screen`/`expanded`/`focused-card`
// but never mutates navigation state itself — input is reported through the
// callbacks below and Rust maps them to NavCommand (design D8: keyboard ==
// mouse). The animated `set_size` Timer lands in delivery 4 (design D4);
// this file only exposes the state that timer drives.
export component ShellRoot inherits Rectangle {
    // ── State mirrors (written by Rust, read by the UI) ──
    in-out property <int> mounted-screen: 0;   // 0 = Home (base), 1 = Gallery, 2 = Workshop
    in-out property <bool> expanded: false;    // ExpansionState mirror; drives set_size in delivery 4
    in-out property <int> focused-card: 0;     // keyboard focus on Home (0 = Gallery, 1 = Workshop)

    // ── Chrome strings — i18n `shell.*` keys (nav-shell spec R5) ──
    // Default values are the English fallbacks; main.rs overwrites them
    // from tr.rs at startup.
    in property <string> brand-text: "HVE";
    in property <string> brand-subtitle: "Hyprland Visual Editor";
    in property <image> logo-image;
    in property <string> status-text: "Ready";
    in property <string> back-hint: "Esc hides";

    // ── Slot-area placeholder strings (i18n) ──
    // The real gallery/workshop slot views land in modules 2/4; until then
    // these placeholders describe the slot. Rust sets them from `shell.*`
    // i18n keys at startup.
    in property <string> slot-home-hint: "Home — theme cards land in module 2";
    in property <string> slot-gallery-hint: "Gallery slot — module 2";
    in property <string> slot-workshop-hint: "Workshop slot — module 4";

    // ── Navigation callbacks (wired to NavCommand in delivery 4) ──
    callback card-activated(screen: int);  // mouse click or Return on the focused card
    callback back-activated();             // Escape hides/minimizes window (tray hide)
    callback nav-move(direction: string);  // arrows: "up" | "down" | "left" | "right"

    // ── Gallery wiring (PR4.5 + V3 strip) ──
    in property <int> gallery-style: 0;
    in property <int> gallery-focused: 0;
    in property <[GalleryCardData]> gallery-cards;
    // Two behind-drawers: top (Settings) slides from behind upward, bottom (Slider/Mosaic) downward
    in-out property <bool> gallery-top-open: false;
    in-out property <bool> gallery-bottom-open: false;
    // V3 relative strip tiles (center=0) + strip-offset/rebasing for fluid slide.
    in property <[SliceTileData]> gallery-slice-tiles;
    in property <float> gallery-slice-focus-pos: 0.0;
    in property <int> gallery-slice-delta-base: 0;
    in property <bool> gallery-slice-rebasing: false;
    in property <[MosaicTileData]> gallery-mosaic-tiles;
    // Tramo 9: frozen outgoing tiles (under layer for curtain sweep).
    in property <[MosaicTileData]> gallery-mosaic-under-tiles;
    // Mosaic pagination mirrors (Rust page model is the source of truth).
    in property <int> gallery-mosaic-current-page: 0;
    in property <int> gallery-mosaic-total-pages: 1;
    in property <[int]> gallery-mosaic-page-numbers;
    in property <bool> gallery-empty: false;
    in property <string> gallery-empty-text: "No themes yet. Save your current setup as a theme.";
    in property <string> gallery-mit-footer: "Visual language translated from skwd-wall (MIT, © liixini) https://github.com/liixini/skwd-wall";
    in property <string> gallery-mit-link: "https://github.com/liixini/skwd-wall";
    in property <bool> gallery-reduced-motion: false;
    callback gallery-style-selected(int);
    callback gallery-card-clicked(int);
    callback gallery-card-right-clicked(int);
    callback gallery-wheel-step(int);
    callback gallery-mosaic-page-step(int);
    callback gallery-mit-open();
    // Stage geometry events from GalleryRoot (logical lengths).
    callback gallery-stage-geometry-changed(length, length);

    // ── Mutating panel (slice 1 skeleton + slice 2 Save + slice 3 Borders pick + slice 5 Motion) ──
    in property <int> panel-section: 0;
    in property <bool> is-mutating: false;
    in property <bool> is-panel-open: false;
    in-out property <string> panel-save-input: "";
    in property <string> panel-save-error: "";
    in property <string> panel-save-placeholder: "Theme name…";
    in property <string> panel-save-button-text: "Save";
    // Borders pick layer (R3) — PresetCards from scan("borders")
    in property <[string]> panel-border-titles;
    in property <[string]> panel-border-descs;
    in property <[string]> panel-border-tags;
    in property <[string]> panel-border-files;
    in property <int> panel-border-active-index: -1;
    in-out property <int> panel-border-size: 2;
    in-out property <int> panel-corner-radius: 32;
    in-out property <int> panel-gap-in: 5;
    in-out property <int> panel-gap-out: 5;
    // Motion pick layer (R4) — 19 cards from scan("animations")
    in property <[string]> panel-anim-titles;
    in property <[string]> panel-anim-descs;
    in property <[string]> panel-anim-tags;
    in property <[string]> panel-anim-files;
    in property <int> panel-anim-active-index: -1;
    in-out property <float> panel-bezier-a: 0.25;
    in-out property <float> panel-bezier-b: 0.1;
    in-out property <float> panel-bezier-c: 0.25;
    in-out property <float> panel-bezier-d: 1.0;
    // Filters pick layer (R5) — shader cards from scan("shaders")
    in property <[string]> panel-shader-titles;
    in property <[string]> panel-shader-descs;
    in property <[string]> panel-shader-tags;
    in property <[string]> panel-shader-files;
    in property <int> panel-shader-active-index: -1;
    // System (R7) — reuses SettingsPanel rows + toggle_system + About
    in property <bool> panel-system-active: false;
    in property <bool> panel-auto-minimize: true;
    in property <int> panel-minimize-seconds: 5;
    in property <string> panel-language: "en";
    in property <bool> panel-tiling-mode: false;
    in property <bool> panel-keybinds-mode: false;
    in property <bool> panel-autostart: false;
    in property <string> panel-theme: "system";
    in property <bool> panel-restart-required: false;
    in property <string> panel-settings-title: "System";
    in property <string> panel-restart-banner-text: "⚠ Restart required";
    in property <string> panel-restart-button-text: "Restart";
    in property <string> panel-auto-minimize-label: "Auto-minimize";
    in property <string> panel-timer-label: "Timer:";
    in property <string> panel-language-label: "Language";
    in property <string> panel-tiling-label: "Tiling mode";
    in property <string> panel-autostart-label: "Autostart";
    in property <string> panel-theme-label: "Theme";
    in property <string> panel-reset-label: "Reset presets";
    in property <string> panel-keybinds-label: "Keyboard shortcuts";
    in property <string> panel-about-title: "About HVE";
    in property <string> panel-about-short: "Hyprland Visual Editor makes your desktop truly yours.";
    in property <string> panel-about-full: "HVE is a graphical app to visually manage your Hyprland desktop aesthetics.";
    in property <[AboutItem]> panel-about-items;
    in property <string> panel-tree-label: "Project structure";
    in property <[string]> panel-tree-paths;
    in property <[string]> panel-tree-descs;
    in property <string> panel-tree-path-max: "";
    in property <string> panel-docs-label: "View documentation";
    callback panel-back();
    callback panel-section-selected(int);
    callback panel-save-theme(string);
    callback panel-apply-border(int, string);
    callback panel-apply-geometry(int, int, int, int);
    callback panel-apply-animation(int, string);
    callback panel-apply-shader(int, string);
    callback panel-toggle-system(bool);
    callback panel-toggle-auto-minimize(bool);
    callback panel-change-minimize-seconds(int);
    callback panel-change-language(string);
    callback panel-toggle-tiling-mode(bool);
    callback panel-toggle-keybinds(bool);
    callback panel-toggle-autostart(bool);
    callback panel-change-theme(string);
    callback panel-reset-presets();
    callback panel-restart-app();
    callback panel-open-docs();

    // Gallery mounts over the LIVE DESKTOP (gallery-immersive-redesign 1.8):
    // while Gallery holds the screen the shell root must not paint either —
    // an opaque surface fill here would cover MainWindow's transparent
    // window backdrop and the alpha-0 GalleryRoot backdrop (hotfix PR1.2).
    background: root.mounted-screen == 1 ? transparent : HveColors.bg-dark;
    forward-focus: shell-kbd;

    // Keep keyboard focus across window mutations (hotfix PR1.2):
    // `forward-focus` only seeds focus when the window is CREATED. When a
    // screen mounts (e.g. Gallery at startup) and the compositor mutates the
    // window to fullscreen, the FocusScope loses the internal focus and keys
    // go dead until a mouse click. Re-seed on init and on every mount change;
    // `changed` callbacks fire queued on the next event-loop tick, i.e. after
    // the newly mounted subtree settled.
    init => { shell-kbd.focus(); }
    changed mounted-screen => { shell-kbd.focus(); }
    changed gallery-top-open => { if (!root.gallery-top-open && !root.gallery-bottom-open && !root.is-panel-open && !root.is-mutating) { shell-kbd.focus(); } }
    changed gallery-bottom-open => { if (!root.gallery-top-open && !root.gallery-bottom-open && !root.is-panel-open && !root.is-mutating) { shell-kbd.focus(); } }
    changed is-panel-open => { if (!root.is-panel-open && !root.is-mutating && !root.gallery-top-open && !root.gallery-bottom-open) { shell-kbd.focus(); } }
    changed is-mutating => { if (!root.is-panel-open && !root.is-mutating && !root.gallery-top-open && !root.gallery-bottom-open) { shell-kbd.focus(); } }

    VerticalLayout {
        // ── Chrome top bar: branding + status placeholders ──
        Rectangle {
            height: 56px;
            background: HveColors.bg-card;

            HorizontalLayout {
                padding-left: SkwdTokens.spacing-16;
                padding-right: SkwdTokens.spacing-16;
                spacing: SkwdTokens.spacing-8;

                // Branding: SVG entrelazado (cambia con tema) + subtitle con mayúsculas coloreadas
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: root.logo-image;
                            width: 72px;
                            height: 28px;
                            image-fit: contain;
                            horizontal-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 0;
                        Text {
                            text: "H";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            font-weight: 700;
                            color: HveColors.accent-amber;
                        }
                        Text {
                            text: "yprland ";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            color: HveColors.text-muted;
                        }
                        Text {
                            text: "V";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            font-weight: 700;
                            color: HveColors.accent-purple;
                        }
                        Text {
                            text: "isual ";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            color: HveColors.text-muted;
                        }
                        Text {
                            text: "E";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            font-weight: 700;
                            color: HveColors.accent-green;
                        }
                        Text {
                            text: "ditor";
                            font-family: SkwdTokens.font-body;
                            font-size: SkwdTokens.size-12;
                            color: HveColors.text-muted;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Status area placeholder
                Text {
                    text: root.status-text;
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: HveColors.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        // Separator between chrome and the slot area
        Rectangle { height: SkwdTokens.border-1; background: HveColors.border; }

        // ── Slot area: the mounted screen renders here. `if`+enum replaces
        //    the QML Loader (design D3); the gallery/workshop slot views land
        //    in modules 2/4 — these are placeholders. Mutating-window overlays
        //    GalleryRoot and PanelRoot crossfading (350ms morph, 200ms stagger)
        //    when is-mutating/is-panel-open (R1).
        Rectangle {
            vertical-stretch: 1;
            // Gallery mounts over the LIVE DESKTOP (gallery-immersive-redesign 1.8): the slot area must not paint under it.
            background: root.mounted-screen == 1 ? transparent : HveColors.bg-dark;
            opacity: root.expanded ? 1.0 : 0.6;
            // OutCubic (skwd default `Behavior` curve, design D4): not a
            // SkwdTokens property — Slint 1.17 cannot expose `easing` through
            // the public API, so the token value is inlined here (see the
            // "Animation" section comment in tokens.slint).
            animate opacity { duration: SkwdTokens.anim-expand; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
            clip: true;

            if root.mounted-screen == 0 : Rectangle {
                // Home — the base screen; cards land in module 2 (gallery).
                width: 100%;
                height: 100%;
                Text {
                    text: root.slot-home-hint;
                        font-family: SkwdTokens.font-body;
                        font-size: SkwdTokens.size-14;
                        color: HveColors.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            if root.mounted-screen == 1 : Rectangle {
                width: 100%;
                height: 100%;

                // Choreographed dock: tuck 500ms → tiny pause → stretch grow to 80%
                gallery-layer := GalleryRoot {
                    width: 100%;
                    height: 100%;
                    // Keep visible during tuck; fade background after tuck+pause so central stretch is clean
                    opacity: root.is-panel-open ? 0.0 : 1.0;
                    animate opacity { duration: root.gallery-reduced-motion ? 0ms : 320ms; delay: root.gallery-reduced-motion ? 0ms : (root.is-panel-open ? 620ms : 0ms); easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                    docking: root.is-panel-open || root.is-mutating;
                    current-style: root.gallery-style;
                    panel-section: root.panel-section;
                    focused-index: root.gallery-focused;
                    cards: root.gallery-cards;
                    slice-tiles: root.gallery-slice-tiles;
                    slice-focus-pos: root.gallery-slice-focus-pos;
                    slice-delta-base: root.gallery-slice-delta-base;
                    slice-rebasing: root.gallery-slice-rebasing;
                    mosaic-tiles: root.gallery-mosaic-tiles;
                    mosaic-under-tiles: root.gallery-mosaic-under-tiles;
                    mosaic-current-page: root.gallery-mosaic-current-page;
                    mosaic-total-pages: root.gallery-mosaic-total-pages;
                    mosaic-page-numbers: root.gallery-mosaic-page-numbers;
                    empty: root.gallery-empty;
                    empty-text: root.gallery-empty-text;
                    mit-link: root.gallery-mit-link;
                    reduced-motion: root.gallery-reduced-motion;
                    top-menu-open <=> root.gallery-top-open;
                    bottom-menu-open <=> root.gallery-bottom-open;
                    style-selected(style) => { root.gallery-style-selected(style); }
                    panel-section-selected(section) => { root.panel-section-selected(section); }
                    card-clicked(idx) => { root.gallery-card-clicked(idx); }
                    card-right-clicked(idx) => { root.gallery-card-right-clicked(idx); }
                    wheel-step(dir) => { root.gallery-wheel-step(dir); }
                    mosaic-page-step(dir) => { root.gallery-mosaic-page-step(dir); }
                    mit-opened => { root.gallery-mit-open(); }
                    stage-geometry-changed(w, h) => { root.gallery-stage-geometry-changed(w, h); }
                    escape-pressed => {
                        if (root.is-mutating || root.is-panel-open) {
                            root.panel-back();
                        } else {
                            root.back-activated();
                        }
                    }
                }

                if root.is-panel-open || root.is-mutating : Rectangle {
                    // Central window expand: same Slider window expands from center with bounce — after tuck+pause
                    // Tuck 500ms + pause 140ms = 640ms delay, then natural expand
                    width: 80%;
                    height: 80%;
                    x: parent.width * 0.10;
                    y: parent.height * 0.10;
                    border-radius: 16px;
                    clip: true;
                    drop-shadow-blur: 32px;
                    drop-shadow-color: #000000a0;
                    drop-shadow-offset-y: 20px;
                    opacity: root.is-panel-open ? 1.0 : 0.0;
                    animate opacity { duration: root.gallery-reduced-motion ? 0ms : 300ms; delay: root.gallery-reduced-motion ? 0ms : 640ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
                    // Natural expand: start at central size (~0.62) → 1.0 with soft overshoot, centered
                    property <float> wow-scale: root.is-panel-open ? 1.0 : 0.62;
                    transform-scale: self.wow-scale;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    animate wow-scale { duration: root.gallery-reduced-motion ? 0ms : 560ms; delay: root.gallery-reduced-motion ? 0ms : 640ms; easing: cubic-bezier(0.22, 1.08, 0.36, 1); }

                    panel-morph := PanelRoot {
                    width: 100%;
                    height: 100%;
                    opacity: 1.0;
                    section: root.panel-section;
                    open: root.is-panel-open;
                    mutating: root.is-mutating;
                    reduced-motion: root.gallery-reduced-motion;
                    save-input <=> root.panel-save-input;
                    save-error: root.panel-save-error;
                    save-placeholder: root.panel-save-placeholder;
                    save-button-text: root.panel-save-button-text;
                    border-titles: root.panel-border-titles;
                    border-descs: root.panel-border-descs;
                    border-tags: root.panel-border-tags;
                    border-files: root.panel-border-files;
                    border-active-index: root.panel-border-active-index;
                    border-size <=> root.panel-border-size;
                    corner-radius <=> root.panel-corner-radius;
                    gap-in <=> root.panel-gap-in;
                    gap-out <=> root.panel-gap-out;
                    anim-titles: root.panel-anim-titles;
                    anim-descs: root.panel-anim-descs;
                    anim-tags: root.panel-anim-tags;
                    anim-files: root.panel-anim-files;
                    anim-active-index: root.panel-anim-active-index;
                    bezier-a <=> root.panel-bezier-a;
                    bezier-b <=> root.panel-bezier-b;
                    bezier-c <=> root.panel-bezier-c;
                    bezier-d <=> root.panel-bezier-d;
                    shader-titles: root.panel-shader-titles;
                    shader-descs: root.panel-shader-descs;
                    shader-tags: root.panel-shader-tags;
                    shader-files: root.panel-shader-files;
                    shader-active-index: root.panel-shader-active-index;
                    system-active: root.panel-system-active;
                    auto-minimize: root.panel-auto-minimize;
                    minimize-seconds: root.panel-minimize-seconds;
                    language: root.panel-language;
                    tiling-mode: root.panel-tiling-mode;
                    keybinds-mode: root.panel-keybinds-mode;
                    autostart: root.panel-autostart;
                    theme: root.panel-theme;
                    restart-required: root.panel-restart-required;
                    settings-title: root.panel-settings-title;
                    restart-banner-text: root.panel-restart-banner-text;
                    restart-button-text: root.panel-restart-button-text;
                    auto-minimize-label: root.panel-auto-minimize-label;
                    timer-label: root.panel-timer-label;
                    language-label: root.panel-language-label;
                    tiling-label: root.panel-tiling-label;
                    autostart-label: root.panel-autostart-label;
                    theme-label: root.panel-theme-label;
                    reset-label: root.panel-reset-label;
                    keybinds-label: root.panel-keybinds-label;
                    about-title: root.panel-about-title;
                    about-short: root.panel-about-short;
                    about-full: root.panel-about-full;
                    about-items: root.panel-about-items;
                    tree-label: root.panel-tree-label;
                    tree-paths: root.panel-tree-paths;
                    tree-descs: root.panel-tree-descs;
                    tree-path-max: root.panel-tree-path-max;
                    docs-label: root.panel-docs-label;
                    back => { root.panel-back(); }
                    section-selected(section) => { root.panel-section-selected(section); }
                    save-theme(name) => { root.panel-save-theme(name); }
                    apply-border(idx, file) => { root.panel-apply-border(idx, file); }
                    apply-geometry(size, radius, gap-in, gap-out) => { root.panel-apply-geometry(size, radius, gap-in, gap-out); }
                    apply-animation(idx, file) => { root.panel-apply-animation(idx, file); }
                    apply-shader(idx, file) => { root.panel-apply-shader(idx, file); }
                    toggle-system(v) => { root.panel-toggle-system(v); }
                    toggle-auto-minimize(v) => { root.panel-toggle-auto-minimize(v); }
                    change-minimize-seconds(v) => { root.panel-change-minimize-seconds(v); }
                    change-language(v) => { root.panel-change-language(v); }
                    toggle-tiling-mode(v) => { root.panel-toggle-tiling-mode(v); }
                    toggle-keybinds(v) => { root.panel-toggle-keybinds(v); }
                    toggle-autostart(v) => { root.panel-toggle-autostart(v); }
                    change-theme(v) => { root.panel-change-theme(v); }
                    reset-presets => { root.panel-reset-presets(); }
                    restart-app => { root.panel-restart-app(); }
                    open-docs => { root.panel-open-docs(); }
                    }
                }

                // Input guard during Mutating (R9): absorbs wheel/click
                if root.is-mutating : Rectangle {
                    width: 100%;
                    height: 100%;
                    background: transparent;
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: default;
                        // Consume without forwarding
                        clicked => {}
                    }
                }
            }
            if root.mounted-screen == 2 : SlotPlaceholder {
                placeholder-text: root.slot-workshop-hint;
                accent: HveColors.accent-cyan;
            }
        }

        // ── Chrome bottom bar: back affordance hint ──
        Rectangle {
            height: 32px;
            background: HveColors.bg-card;

            HorizontalLayout {
                padding-left: SkwdTokens.spacing-16;
                padding-right: SkwdTokens.spacing-16;
                Text {
                    text: root.back-hint;
                    font-family: SkwdTokens.font-body;
                    font-size: SkwdTokens.size-12;
                    color: HveColors.text-muted;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Keyboard navigation (nav-shell spec R4; design D8: keyboard == mouse):
    // arrows → nav-move (Rust moves focus, mirrors `focused-card` back),
    // Return → activate the focused card, Escape → hide/minimize window (tray).
    shell-kbd := FocusScope {
        KeyBinding {
            keys: @keys(DownArrow);
            activated => { root.nav-move("down"); }
        }
        KeyBinding {
            keys: @keys(UpArrow);
            activated => { root.nav-move("up"); }
        }
        KeyBinding {
            keys: @keys(RightArrow);
            activated => { root.nav-move("right"); }
        }
        KeyBinding {
            keys: @keys(LeftArrow);
            activated => { root.nav-move("left"); }
        }
        KeyBinding {
            keys: @keys(Return);
            activated => {
                if (root.mounted-screen == 1) {
                    root.gallery-card-clicked(root.gallery-focused);
                } else {
                    root.card-activated(root.focused-card);
                }
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (root.is-mutating || root.is-panel-open) {
                    root.panel-back();
                } else {
                    root.back-activated();
                }
            }
        }
    }
}