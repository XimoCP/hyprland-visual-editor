#!/usr/bin/env python3
"""HVE IPC Client — send commands to HVE via Unix socket."""
import os, sys, socket

socket_path = os.environ.get("XDG_RUNTIME_DIR", "/tmp") + "/hve.sock"

if not os.path.exists(socket_path):
    print("HVE is not running", file=sys.stderr)
    sys.exit(1)

if len(sys.argv) < 2:
    print("Usage: hve-ipc <command>", file=sys.stderr)
    sys.exit(1)

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    sock.connect(socket_path)
    sock.sendall((" ".join(sys.argv[1:]) + "\n").encode())
    response = sock.recv(4096).decode().strip()
    if response:
        print(response)
except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)
finally:
    sock.close()
